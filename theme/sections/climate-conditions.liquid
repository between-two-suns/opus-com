{{ 'home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Climate lab. The eight everyday conditions as a typographic list; the one at the centre of the viewport
  (or under the pointer) sets the weather on a sticky stage with the four bottles. The stage is decoration:
  every word on it is in the list as text.
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.climate.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.climate.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.climate.text' | t
  endif
  assign conditions = 'sun,pollution,dust,humidity,heat,ac,change,everyday' | split: ','
  assign source = section.settings.collection | default: collections.all
-%}
<section class="section lab" data-tone="aqua" aria-labelledby="ClimateTitle-{{ section.id }}">
  <climate-lab class="container lab__inner" data-active="sun">
    <div class="lab__stage-wrap">
      <div class="lab__stage grain" aria-hidden="true">
        <span class="lab__fx lab__fx--light"></span>
        <span class="lab__fx lab__fx--haze"></span>
        <span class="lab__fx lab__fx--particles"></span>
        <span class="lab__fx lab__fx--drops"></span>
        <span class="lab__fx lab__fx--air"></span>
        <span class="lab__fx lab__fx--split"></span>
        <span class="lab__readout">
          {%- for c in conditions -%}
            {%- assign name_key = 'climate.' | append: c | append: '.name' -%}
            <span class="lab__word" data-c="{{ c }}">{{ name_key | t }}</span>
          {%- endfor -%}
        </span>
        <span class="lab__bottles">
          {%- for s in (1..4) -%}
            {%- for product in source.products limit: 12 -%}
              {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign ps = ps | strip | plus: 0 -%}
              {%- if ps == s -%}
                {%- assign cutout = product.metafields.bts.cutout.value -%}
                {%- if cutout -%}
                  <span class="lab__bottle" data-step="{{ s }}" style="--k: {{ s }}">{{ cutout | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '(min-width: 990px) 9vw, 20vw', alt: '' }}</span>
                {%- elsif product.featured_image -%}
                  <span class="lab__bottle" data-step="{{ s }}" style="--k: {{ s }}">{{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '(min-width: 990px) 9vw, 20vw', alt: '' }}</span>
                {%- endif -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </span>
      </div>
    </div>

    <div class="lab__copy">
      <header class="lab__head">
        <p class="t-eyebrow">{{ eyebrow | escape }}</p>
        <h2 class="t-display-m" id="ClimateTitle-{{ section.id }}">{{ heading | escape }}</h2>
        <p class="t-lead t-muted">{{ text | escape }}</p>
      </header>
      <ol class="lab__list" role="list">
        {%- for c in conditions -%}
          {%- assign name_key = 'climate.' | append: c | append: '.name' -%}
          {%- assign line_key = 'climate.' | append: c | append: '.line' -%}
          <li class="lab__item" data-c="{{ c }}">
            <span class="lab__index t-notation" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="lab__name">{{ name_key | t }}</h3>
            <p class="lab__line">{{ line_key | t }}</p>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.link != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}">{{ 'sections.climate.link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      {%- endif -%}
    </div>
  </climate-lab>
</section>
<script src="{{ 'lab.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:sections.climate.name",
  "settings": [
    { "type": "paragraph", "content": "t:general_schema.bilingual_fallback" },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "url", "id": "link", "label": "t:sections.climate.link_label" },
    { "type": "collection", "id": "collection", "label": "t:sections.routine.collection" }
  ],
  "presets": [{ "name": "t:sections.climate.name" }]
}
{% endschema %}
