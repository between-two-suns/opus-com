{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  FAQ accordion with FAQPage structured data. Blocks use built-in bilingual Q&A (factual, from pack copy and the
  store's own settings) or merchant-written custom Q&A. Each preset belongs to a topic (routine / products / sets /
  orders); the "hub" layout (FAQ page) adds search and topic filters. On product pages a block can be limited to
  certain steps (block setting "steps": 1–4, 0 = sets).
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'faq.heading' | t | replace: '&amp;', '&'
  endif
  assign ctx_step = ''
  if product
    capture ctx_step
      render 'product-step', product: product
    endcapture
    assign ctx_step = ctx_step | strip
  endif
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign thr = settings.free_shipping_threshold | default: 0 | times: 100
  capture thr_m
    render 'egp', cents: thr
  endcapture
  assign thr_m = thr_m | strip
  # Delivery figures come from Theme settings → Offers, so a change there updates every answer (they must match the Shopify rates).
  assign fee_c = settings.delivery_fee | default: 0 | times: 100
  capture fee_m
    render 'egp', cents: fee_c
  endcapture
  assign fee_m = fee_m | strip
  assign remote_c = settings.remote_fee | default: 0 | times: 100
  capture remote_m
    render 'egp', cents: remote_c
  endcapture
  assign remote_m = remote_m | strip
  assign remote_over_c = settings.remote_fee_over | default: 0 | times: 100
  capture remote_over_m
    render 'egp', cents: remote_over_c
  endcapture
  assign remote_over_m = remote_over_m | strip
  # Presets that wait on verified information (manufacturer or reports) show only once the block has its own answer.
  assign pending_presets = 'fragrance,sensitive,shelf_life,authenticity,pregnancy' | split: ','
  assign hub = section.settings.hub
  assign used_cats = ''
-%}
{%- capture ld -%}{%- endcapture -%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign pre = block.settings.preset
      assign q = block.settings.question
      assign a = block.settings.answer
      if pre != 'custom'
        assign qk = 'faq.items.' | append: pre | append: '.q'
        assign ak = 'faq.items.' | append: pre | append: '.a'
        if q == blank
          assign q = qk | t | replace: '&amp;', '&'
        endif
        if a == blank
          if pending_presets contains pre
            assign a = ''
          elsif pre == 'delivery_time'
            if settings.delivery_days_main != blank and settings.delivery_days_other != blank
              assign a = ak | t: main: settings.delivery_days_main, other: settings.delivery_days_other | replace: '&amp;', '&'
            endif
          elsif pre == 'delivery_cost'
            if fee_c > 0
              assign a = 'faq.items.delivery_cost.a' | t: fee: fee_m, amount: thr_m | replace: '&amp;', '&'
              if thr == 0
                assign a = 'faq.items.delivery_cost.a_flat' | t: fee: fee_m | replace: '&amp;', '&'
              endif
              if remote_c > 0
                if thr == 0
                  assign a_r = 'faq.items.delivery_cost.remote_flat' | t: remote: remote_m
                elsif remote_over_c > 0
                  assign a_r = 'faq.items.delivery_cost.remote' | t: remote: remote_m, remote_over: remote_over_m, amount: thr_m
                else
                  assign a_r = 'faq.items.delivery_cost.remote_free' | t: remote: remote_m, amount: thr_m
                endif
                assign a = a | append: ' ' | append: a_r
              endif
              assign a_c = 'faq.items.delivery_cost.checkout' | t
              assign a = a | append: ' ' | append: a_c | replace: '&amp;', '&'
            endif
          else
            assign a = ak | t: amount: thr_m | replace: '&amp;', '&'
          endif
        endif
      endif
      if pre == 'cod' and settings.show_cod == false
        assign q = ''
      endif
      if pre == 'delivery_free' and thr == 0
        assign q = ''
      endif
      if pre == 'returns' and shop.refund_policy
        assign a = a | append: ' <a href="' | append: shop.refund_policy.url | append: '">' | append: shop.refund_policy.title | append: '</a>'
      endif
      assign only = block.settings.steps | remove: ' ' | split: ','
      if ctx_step != blank and block.settings.steps != blank
        unless only contains ctx_step
          assign q = ''
        endunless
      endif
      case pre
        when 'order', 'am_pm', 'all_four', 'start_where', 'spf_last', 'reapply'
          assign cat = 'routine'
        when 'set_full_size', 'set_saving'
          assign cat = 'sets'
        when 'delivery_free', 'delivery_time', 'delivery_cost', 'cod', 'payment', 'returns', 'contact_reply'
          assign cat = 'orders'
        when 'custom'
          assign cat = 'other'
        else
          assign cat = 'products'
      endcase
    -%}
    {%- if q != blank and a != blank -%}
      {%- unless used_cats contains cat -%}{%- assign used_cats = used_cats | append: cat | append: ',' -%}{%- endunless -%}
      <details class="accordion faq__item" data-cat="{{ cat }}" {{ block.shopify_attributes }}>
        <summary><span class="faq__q">{{ q | escape }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
        <div class="accordion__content rte">{{ a }}</div>
      </details>
      {%- capture ld_item -%}{"@type":"Question","name":{{ q | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | strip_html | json }}}},{%- endcapture -%}
      {%- assign ld = ld | append: ld_item -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<section class="section faq{% if section.settings.compact %} faq--compact{% endif %}{% if hub %} faq--hub{% endif %}" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="container faq__inner">
    {%- unless hub -%}
    <div class="faq__head">
      {%- unless hub -%}<p class="t-eyebrow faq__eyebrow">{{ 'faq.eyebrow' | t }}</p>{%- endunless -%}
      <h2 class="{% if section.settings.compact %}t-display-m{% else %}t-display-l{% endif %}" id="FaqTitle-{{ section.id }}">{{ heading | escape }}</h2>
      {%- if section.settings.show_contact -%}
        <p class="t-muted">{{ 'pages.faq.contact_cta' | t }} <a href="{{ root }}/pages/contact">{{ 'pages.faq.contact_link' | t }}</a></p>
      {%- endif -%}
    </div>
    {%- endunless -%}
    <faq-list class="faq__list" data-hub="{{ hub }}">
      {%- if hub -%}
        <div class="faq__tools">
          <label class="faq__search">
            <span class="visually-hidden">{{ 'faq.search' | t }}</span>
            {% render 'icon', name: 'search', class: 'icon--sm' %}
            <input type="search" placeholder="{{ 'faq.search' | t }}" data-faq-search autocomplete="off">
          </label>
          <div class="cluster faq__cats" role="group" aria-label="{{ 'faq.topics' | t }}">
            <button type="button" class="chip" data-faq-cat="" aria-pressed="true">{{ 'faq.cats.all' | t }}</button>
            {%- assign cats = used_cats | split: ',' -%}
            {%- for c in cats -%}{%- if c != blank -%}{%- assign ck = 'faq.cats.' | append: c -%}<button type="button" class="chip" data-faq-cat="{{ c }}" aria-pressed="false">{{ ck | t }}</button>{%- endif -%}{%- endfor -%}
          </div>
          <p class="t-small t-muted" role="status" data-faq-empty hidden>{{ 'faq.no_results' | t }}</p>
        </div>
      {%- endif -%}
      {{ items }}
      {%- if hub -%}
        <div class="faq__help">
          <span class="faq__help-mark" aria-hidden="true"></span>
          <div>
            <p class="faq__help-title">{{ 'faq.help_title' | t }}</p>
            <p class="t-muted">{{ 'faq.help_text' | t }}</p>
          </div>
          <a class="btn" href="{{ root }}/pages/contact">{{ 'pages.faq.contact_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </div>
      {%- endif -%}
    </faq-list>
  </div>
  {%- assign ld = ld | strip | remove_last: ',' -%}
  {%- if ld != blank and section.settings.schema -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ ld }}]}</script>
  {%- endif -%}
</section>
{%- if hub -%}
<script type="module">
  class FaqList extends HTMLElement {
    connectedCallback() {
      const items = [...this.querySelectorAll('.faq__item')];
      const input = this.querySelector('[data-faq-search]');
      const chips = [...this.querySelectorAll('[data-faq-cat]')];
      const empty = this.querySelector('[data-faq-empty]');
      let cat = '';
      const apply = () => {
        const q = (input?.value || '').trim().toLowerCase();
        let n = 0;
        items.forEach((d) => {
          const show = (!cat || d.dataset.cat === cat) && (!q || d.textContent.toLowerCase().includes(q));
          d.hidden = !show; if (show) n += 1;
          if (q && show) d.open = true;
        });
        if (empty) empty.hidden = n > 0;
      };
      input?.addEventListener('input', apply);
      chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.faqCat; chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c))); apply(); }));
    }
  }
  if (!customElements.get('faq-list')) customElements.define('faq-list', FaqList);
</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
    { "type": "checkbox", "id": "compact", "label": "t:sections.faq.compact", "default": false },
    { "type": "checkbox", "id": "show_contact", "label": "t:sections.faq.show_contact", "default": true },
    { "type": "checkbox", "id": "schema", "label": "t:sections.faq.schema", "default": true },
    { "type": "checkbox", "id": "hub", "label": "t:sections.faq.hub", "default": false }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "t:sections.faq.block",
      "settings": [
        {
          "type": "select",
          "id": "preset",
          "label": "t:sections.faq.preset",
          "options": [
            { "value": "order", "label": "Routine order" },
            { "value": "am_pm", "label": "Morning & evening" },
            { "value": "reapply", "label": "SPF reapplication" },
            { "value": "inci", "label": "Ingredient lists" },
            { "value": "skin_type", "label": "Skin types" },
            { "value": "made", "label": "Where it's made" },
            { "value": "climate", "label": "What climate-adapted means" },
            { "value": "fragrance", "label": "Fragrance (needs answer)" },
            { "value": "spf_last", "label": "SPF: where it goes" },
            { "value": "set_full_size", "label": "Sets: full-size products" },
            { "value": "set_saving", "label": "Sets: how the saving works" },
            { "value": "payment", "label": "Payment (only if configured)" },
            { "value": "start_where", "label": "Which set to start with" },
            { "value": "all_four", "label": "Do I need all four steps" },
            { "value": "delivery_free", "label": "Free delivery (uses the threshold setting)" },
            { "value": "delivery_time", "label": "Delivery time (from settings)" },
            { "value": "delivery_cost", "label": "Delivery cost (from settings)" },
            { "value": "cod", "label": "Cash on delivery (if turned on)" },
            { "value": "sensitive", "label": "Sensitive skin (needs answer)" },
            { "value": "shelf_life", "label": "Shelf life / PAO (needs answer)" },
            { "value": "authenticity", "label": "Authenticity (needs answer)" },
            { "value": "pregnancy", "label": "Pregnancy (needs answer)" },
            { "value": "returns", "label": "Returns (links the refund policy)" },
            { "value": "contact_reply", "label": "How to reach us" },
            { "value": "inci_what", "label": "What INCI means" },
            { "value": "ingredients_order", "label": "Why water is listed first" },
            { "value": "ac_steps", "label": "Air-con days" },
            { "value": "cr_followers", "label": "Creators: follower count" },
            { "value": "cr_paid", "label": "Creators: is it paid" },
            { "value": "cr_rights", "label": "Creators: content usage" },
            { "value": "cr_post", "label": "Creators: posting" },
            { "value": "cr_where", "label": "Creators: who can apply" },
            { "value": "cr_disclose", "label": "Creators: ad disclosure" },
            { "value": "custom", "label": "Custom" }
          ],
          "default": "order"
        },
        { "type": "text", "id": "steps", "label": "t:sections.faq.steps", "info": "t:sections.faq.steps_info" },
        { "type": "text", "id": "question", "label": "t:sections.faq.question" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.answer" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.faq.name" }]
}
{% endschema %}
