{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About (DECISIONS 193–194): the name, told as time. Between two suns is the space between two days: today's sun (the
  home page's sage sphere) on one side, tomorrow's (the periwinkle one) on the other, and the sun's path as an arc
  between them. Scrolling runs the clock from 06:00 to 06:00: one large time counts on under the arc with what that
  hour is (morning routine, out in the day, evening, night routine, while you sleep, tomorrow's sun), a dot travels
  the arc past the two routine marks, the sky goes ivory → lilac dusk → ink night → mint dawn, today's sun sets and
  tomorrow's rises. The four lines are all in the page, one shown at a time.
  Without JS or with reduced motion: one still screen with every line, no pinning.
{%- endcomment -%}
<section class="ab-sky" data-ab-sky aria-labelledby="AbSky-{{ section.id }}">
  <div class="ab-sky__stage">
    <span class="ab-sky__stars" aria-hidden="true"></span>
    <div class="ab-sky__horizon" aria-hidden="true">
      {%- render 'about-orb', tone: 'green', side: 'start', class: 'ab-sky__sun ab-sky__sun--a', sizes: '(min-width: 750px) 30vw, 54vw' -%}
      {%- render 'about-orb', tone: 'blue', side: 'end', class: 'ab-sky__sun ab-sky__sun--b', sizes: '(min-width: 750px) 30vw, 54vw' -%}
    </div>
    <div class="container ab-sky__copy">
      <p class="t-eyebrow">{{ 'about2.eyebrow' | t }}</p>
      <h1 class="ab-sky__title" id="AbSky-{{ section.id }}">{{ 'about2.title' | t }}</h1>
      <ol class="ab-sky__beats" role="list">
        {%- for i in (1..4) -%}
          {%- assign bk = 'about2.b' | append: i -%}
          <li class="ab-sky__beat" data-beat="{{ i }}">{{ bk | t }}</li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="ab-sky__dial" aria-hidden="true">
      <svg class="ab-sky__arc" viewBox="0 0 1000 200" preserveAspectRatio="none" focusable="false">
        <path class="ab-sky__path" d="M0 200 Q500 -200 1000 200" pathLength="1"/>
        <path class="ab-sky__trail" d="M0 200 Q500 -200 1000 200" pathLength="1"/>
      </svg>
      <span class="ab-sky__mark" data-at="1" style="--x: {{ 1.0 | divided_by: 24 }}">{% render 'icon', name: 'sun', class: 'icon--sm' %}</span>
      <span class="ab-sky__mark" data-at="16" style="--x: {{ 16.0 | divided_by: 24 }}">{% render 'icon', name: 'moon', class: 'icon--sm' %}</span>
      <span class="ab-sky__dot"></span>
      <span class="ab-sky__end ab-sky__end--a">{{ 'about2.sun_a' | t }}</span>
      <span class="ab-sky__end ab-sky__end--b">{{ 'about2.sun_b' | t }}</span>
      <span class="ab-sky__clock">
        <span class="ab-sky__time" data-time>06:00</span>
        <span class="ab-sky__now" data-now>{{ 'about2.am' | t }}</span>
      </span>
      <template data-labels>
        <span>{{ 'about2.am' | t }}</span><span>{{ 'about2.clock_day' | t }}</span><span>{{ 'about2.clock_eve' | t }}</span><span>{{ 'about2.pm' | t }}</span><span>{{ 'about2.clock_sleep' | t }}</span><span>{{ 'about2.sun_b' | t }}</span>
      </template>
    </div>
    <p class="ab-sky__hint" aria-hidden="true">{{ 'about2.scroll' | t }}<span class="ab-sky__hint-line"></span></p>
  </div>
</section>
<script src="{{ 'about.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "About · two suns",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
