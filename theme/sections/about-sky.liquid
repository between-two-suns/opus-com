{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About (DECISIONS 193–194): the name, told as time. Between two suns is the space between two days: today's sun (the
  home page's sage sphere) on one side, tomorrow's (the periwinkle one) on the other, and the sun's path as an arc
  between them. Scrolling runs the clock from 06:00 to 06:00: one large time counts on under the arc with what that
  hour is (morning routine, out in the day, evening, night routine, while you sleep, tomorrow's sun), a dot travels
  the arc past the two routine marks, the sky goes ivory → lilac dusk → ink night → mint dawn, today's sun sets and
  tomorrow's rises (its glow comes up under the horizon through the night). The title rises in on load, the clock's
  digits roll as they change, and the second line links to the Climate page's hour-by-hour day (DECISIONS 195).
  The four lines are all in the page, one shown at a time.
  Without JS or with reduced motion: one still screen with every line, no pinning.
{%- endcomment -%}
<section class="ab-sky" data-ab-sky aria-labelledby="AbSky-{{ section.id }}">
  <div class="ab-sky__stage">
    <span class="ab-sky__stars" aria-hidden="true"></span>
    <div class="ab-sky__horizon" aria-hidden="true">
      <span class="ab-sky__dawn"></span>
      {%- render 'about-orb', tone: 'green', side: 'start', class: 'ab-sky__sun ab-sky__sun--a', sizes: '(min-width: 750px) 30vw, 54vw', priority: true -%}
      {%- render 'about-orb', tone: 'blue', side: 'end', class: 'ab-sky__sun ab-sky__sun--b', sizes: '(min-width: 750px) 30vw, 54vw' -%}
    </div>
    <div class="container ab-sky__copy">
      <p class="t-eyebrow">{% if section.settings.t_about2_eyebrow != blank %}{{ section.settings.t_about2_eyebrow }}{% else %}{{ 'about2.eyebrow' | t }}{% endif %}</p>
      {%- assign title_words = 'about2.title' | t | split: ' ' -%}
      <h1 class="ab-sky__title" id="AbSky-{{ section.id }}">{% for w in title_words %}<span class="w" style="--i: {{ forloop.index0 }}"><span>{{ w }}</span></span>{% unless forloop.last %}{{ ' ' }}{% endunless %}{% endfor %}</h1>
      <ol class="ab-sky__beats" role="list">
        {%- for i in (1..4) -%}
          {%- assign bk = 'about2.b' | append: i -%}
          <li class="ab-sky__beat" data-beat="{{ i }}">{{ bk | t }}{% if i == 2 %} <a class="ab-sky__more" href="{{ routes.root_url | append: '/pages/climate' | replace: '//', '/' }}">{% if section.settings.t_about2_climate_link != blank %}{{ section.settings.t_about2_climate_link }}{% else %}{{ 'about2.climate_link' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>{% endif %}</li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="ab-sky__dial" aria-hidden="true">
      <svg class="ab-sky__arc" viewBox="0 0 1000 200" preserveAspectRatio="none" focusable="false">
        <path class="ab-sky__path" d="M0 200 Q500 -200 1000 200" pathLength="1"/>
        <path class="ab-sky__trail" d="M0 200 Q500 -200 1000 200" pathLength="1"/>
      </svg>
      <span class="ab-sky__mark" data-at="1" style="--x: {{ 1.0 | divided_by: 24 }}">{% render 'icon', name: 'sun', class: 'icon--sm' %}</span>
      <span class="ab-sky__mark" data-at="16" style="--x: {{ 16.0 | divided_by: 24 }}">{% render 'icon', name: 'moon', class: 'icon--sm' %}</span>
      <span class="ab-sky__dot"></span>
      <span class="ab-sky__end ab-sky__end--a">{% if section.settings.t_about2_sun_a != blank %}{{ section.settings.t_about2_sun_a }}{% else %}{{ 'about2.sun_a' | t }}{% endif %}</span>
      <span class="ab-sky__end ab-sky__end--b">{% if section.settings.t_about2_sun_b != blank %}{{ section.settings.t_about2_sun_b }}{% else %}{{ 'about2.sun_b' | t }}{% endif %}</span>
      <span class="ab-sky__clock">
        <span class="ab-sky__time" data-time><span>0</span><span>6</span><span class="ab-sky__colon">:</span><span>0</span><span>0</span></span>
        <span class="ab-sky__now" data-now>{% if section.settings.t_about2_am != blank %}{{ section.settings.t_about2_am }}{% else %}{{ 'about2.am' | t }}{% endif %}</span>
      </span>
      <template data-labels>
        <span>{% if section.settings.t_about2_am != blank %}{{ section.settings.t_about2_am }}{% else %}{{ 'about2.am' | t }}{% endif %}</span><span>{% if section.settings.t_about2_clock_day != blank %}{{ section.settings.t_about2_clock_day }}{% else %}{{ 'about2.clock_day' | t }}{% endif %}</span><span>{% if section.settings.t_about2_clock_eve != blank %}{{ section.settings.t_about2_clock_eve }}{% else %}{{ 'about2.clock_eve' | t }}{% endif %}</span><span>{% if section.settings.t_about2_pm != blank %}{{ section.settings.t_about2_pm }}{% else %}{{ 'about2.pm' | t }}{% endif %}</span><span>{% if section.settings.t_about2_clock_sleep != blank %}{{ section.settings.t_about2_clock_sleep }}{% else %}{{ 'about2.clock_sleep' | t }}{% endif %}</span><span>{% if section.settings.t_about2_sun_b != blank %}{{ section.settings.t_about2_sun_b }}{% else %}{{ 'about2.sun_b' | t }}{% endif %}</span>
      </template>
    </div>
    <p class="ab-sky__hint" aria-hidden="true">{% if section.settings.t_about2_scroll != blank %}{{ section.settings.t_about2_scroll }}{% else %}{{ 'about2.scroll' | t }}{% endif %}<span class="ab-sky__hint-line"></span></p>
  </div>
</section>
{%- comment -%} Scroll mode is set before the first paint, so the page doesn't shift when about.js arrives. (The space between the title's words is printed with {{ ' ' }}: Shopify drops a block that holds only whitespace.) {%- endcomment -%}
<script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.previousElementSibling.classList.add('is-live');</script>
<script src="{{ 'about.js' | asset_url }}" type="module" defer></script>

