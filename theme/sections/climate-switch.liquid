{{ 'home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Climate, compact: five conditions as an icon switch. The chosen one sets the light around the bottles
  (glare, dust, droplets, air-con airflow, heat haze) and lifts the steps that matter for it, with one tap
  to add them. Same condition → step mapping as the forecast. Prices are the products' real prices.
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.climate.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.climate_switch.heading' | t
  endif
  assign source = section.settings.collection | default: collections.all
  assign conditions = 'sun,city,humidity,ac,heat' | split: ','
-%}
<section class="section cs" data-tone="aqua" aria-labelledby="CsTitle-{{ section.id }}">
  <climate-switch
    class="container cs__inner"
    data-active="sun"
    data-key-steps='{"sun":[4,2],"city":[1,3],"humidity":[1,2],"ac":[3,2],"heat":[1,4]}'
    data-money="{{ shop.money_format | escape }}"
    data-coming-soon="{% if settings.zero_price_coming_soon %}true{% endif %}"
    data-str-cta="{{ 'sections.climate_switch.cta' | t: count: '__N__' | escape }}"
  >
    <header class="cs__head">
      <p class="t-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="t-display-m" id="CsTitle-{{ section.id }}">{{ heading | escape }}</h2>
    </header>

    <div class="cs__switch" role="group" aria-label="{{ 'sections.climate_switch.label' | t }}">
      {%- for c in conditions -%}
        {%- liquid
          case c
            when 'sun'
              assign ic = 'sun'
            when 'city'
              assign ic = 'dust'
            when 'humidity'
              assign ic = 'drop'
            when 'ac'
              assign ic = 'ac'
            else
              assign ic = 'thermo'
          endcase
          assign ck = 'sections.forecast.conditions.' | append: c
        -%}
        <button type="button" class="cs__opt" data-c="{{ c }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="cs__ico">{% render 'icon', name: ic %}</span>
          <span class="cs__opt-label">{{ ck | t }}</span>
        </button>
      {%- endfor -%}
    </div>

    <div class="cs__stage lab__stage grain" aria-hidden="true">
      <span class="lab__fx lab__fx--light"></span>
      <span class="lab__fx lab__fx--haze"></span>
      <span class="lab__fx lab__fx--particles"></span>
      <span class="lab__fx lab__fx--drops"></span>
      <span class="lab__fx lab__fx--air"></span>
      <span class="cs__bottles">
        {%- for s in (1..4) -%}
          {%- for product in source.products limit: 12 -%}
            {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
            {%- assign ps = ps | strip | plus: 0 -%}
            {%- if ps == s -%}
              {%- assign cutout = product.metafields.bts.cutout.value -%}
              <span class="cs__bottle" data-step="{{ s }}">
                {%- if cutout -%}
                  {{ cutout | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '(min-width: 990px) 10vw, 22vw', alt: '' }}
                {%- elsif product.featured_image -%}
                  {{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '(min-width: 990px) 10vw, 22vw', alt: '' }}
                {%- endif -%}
              </span>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </span>
    </div>

    <div class="cs__read" aria-live="polite">
      {%- for c in conditions -%}
        {%- if c == 'city' -%}{%- assign line_key = 'climate.dust.line' -%}{%- else -%}{%- assign line_key = 'climate.' | append: c | append: '.line' -%}{%- endif -%}
        <p class="cs__line" data-c="{{ c }}"{% unless forloop.first %} hidden{% endunless %}>{{ line_key | t }}</p>
      {%- endfor -%}
      <ul class="cs__keys" role="list">
        {%- for s in (1..4) -%}
          {%- for product in source.products limit: 12 -%}
            {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
            {%- assign ps = ps | strip | plus: 0 -%}
            {%- if ps == s -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              <li class="cs__key" data-step="{{ s }}" data-id="{{ v.id }}" data-price="{{ v.price }}"{% unless v.available %} data-unavailable{% endunless %} hidden>
                <span class="bundle__dot" aria-hidden="true"></span>
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      <product-form class="cs__form">
        <form method="post" action="{{ routes.cart_add_url }}">
          <button type="submit" class="btn" data-magnetic data-cta>
            <span class="btn__label" data-cta-label></span>
            <span class="btn__sep" aria-hidden="true">·</span>
            <span class="btn__price" data-total></span>
          </button>
          <p class="t-xs t-muted" data-form-error hidden></p>
        </form>
      </product-form>
      {%- if section.settings.link != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}">{{ 'sections.climate.link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      {%- endif -%}
    </div>
  </climate-switch>
</section>
<script src="{{ 'climate-switch.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:sections.climate_switch.name",
  "settings": [
    { "type": "paragraph", "content": "t:general_schema.bilingual_fallback" },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "url", "id": "link", "label": "t:sections.climate.link_label" },
    { "type": "collection", "id": "collection", "label": "t:sections.routine.collection" }
  ],
  "presets": [{ "name": "t:sections.climate_switch.name" }]
}
{% endschema %}
