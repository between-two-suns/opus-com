{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Contact: header with photo, the ways to reach us (only channels that are set: email here, WhatsApp and
  Instagram from Theme settings), and the form in a card with topic chips (sent as "Topic" with the message).
  Shopify's contact form: messages arrive in the store's contact email.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign img = section.settings.image | default: images['bts-portrait-window-wide.jpg']
  assign topics = 'product,order,routine,creators,other' | split: ','
  assign wa = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
-%}
<section class="ct" aria-labelledby="CtTitle-{{ section.id }}">
  <div class="container ct__top">
    <div class="ct__intro">
      <p class="t-eyebrow">{{ 'page_presets.contact.eyebrow' | t }}</p>
      <h1 class="ct__title" id="CtTitle-{{ section.id }}">{{ 'pages.contact.title' | t }}</h1>
      <p class="t-lead">{{ 'pages.contact.lede' | t }}</p>
    </div>
    {%- if img -%}<div class="ct__photo">{{ img | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 46vw, 100vw', alt: '' }}</div>{%- endif -%}
  </div>

  <div class="container ct__grid">
    <ul class="ct__ways" role="list">
      {%- if section.settings.email != blank -%}
        <li><a class="ct__way" href="mailto:{{ section.settings.email }}" data-step="1">
          <span class="ct__way-icon">{% render 'icon', name: 'mail' %}</span>
          <span class="ct__way-text"><span class="ct__way-title">{{ 'pages.contact.way_email' | t }}</span><span class="ct__way-sub">{{ section.settings.email }}</span></span>
          {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}
        </a></li>
      {%- endif -%}
      {%- if wa != blank -%}
        <li><a class="ct__way" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener" data-step="2">
          <span class="ct__way-icon">{% render 'icon', name: 'chat' %}</span>
          <span class="ct__way-text"><span class="ct__way-title">WhatsApp</span><span class="ct__way-sub">{{ 'pages.contact.way_wa' | t }} <span class="visually-hidden">{{ 'general.opens_new_window' | t }}</span></span></span>
          {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}
        </a></li>
      {%- endif -%}
      {%- if settings.social_instagram != blank -%}
        <li><a class="ct__way" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" data-step="3">
          <span class="ct__way-icon">{% render 'icon', name: 'instagram' %}</span>
          <span class="ct__way-text"><span class="ct__way-title">Instagram</span><span class="ct__way-sub">{{ 'pages.contact.way_ig' | t }} <span class="visually-hidden">{{ 'general.opens_new_window' | t }}</span></span></span>
          {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}
        </a></li>
      {%- endif -%}
      <li><a class="ct__way" href="{{ root }}/pages/faq" data-step="4">
        <span class="ct__way-icon">{% render 'icon', name: 'search' %}</span>
        <span class="ct__way-text"><span class="ct__way-title">{{ 'pages.contact.way_faq' | t }}</span><span class="ct__way-sub">{{ 'pages.contact.way_faq_sub' | t }}</span></span>
        {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}
      </a></li>
      <li><a class="ct__way" href="{{ root }}/pages/creators" data-step="3">
        <span class="ct__way-icon">{% render 'icon', name: 'sun' %}</span>
        <span class="ct__way-text"><span class="ct__way-title">{{ 'pages.contact.way_creators' | t }}</span><span class="ct__way-sub">{{ 'pages.contact.way_creators_sub' | t }}</span></span>
        {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}
      </a></li>
    </ul>

    <div class="ct__card">
      {%- form 'contact', id: 'ContactForm', class: 'ct__form', novalidate: 'novalidate' -%}
        {%- if form.posted_successfully? -%}
          <div class="ct__done" role="status" tabindex="-1">
            <span class="ct__done-mark" aria-hidden="true"></span>
            <p class="ct__done-title">{{ 'pages.contact.done_title' | t }}</p>
            <p>{{ 'pages.contact.success' | t }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-status form-status--error" role="alert" tabindex="-1">
              <ul>
                {%- for field in form.errors -%}
                  <li><a href="#Contact-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }}</a> {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <fieldset class="ct__topics">
            <legend class="field__label">{{ 'pages.contact.topic' | t }}</legend>
            <div class="cluster">
              {%- for tp in topics -%}
                {%- assign tk = 'pages.contact.topics.' | append: tp -%}
                <label class="chip ct__topic"><input class="visually-hidden" type="radio" name="contact[topic]" value="{{ tk | t | escape }}"{% if forloop.first %} checked{% endif %}><span>{{ tk | t }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <div class="ct__row">
            <div class="field">
              <label for="Contact-name">{{ 'pages.contact.name' | t }}</label>
              <input id="Contact-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="field">
              <label for="Contact-email">{{ 'pages.contact.email' | t }} <span class="t-muted">({{ 'pages.contact.required' | t }})</span></label>
              <input id="Contact-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
          </div>
          <div class="field">
            <label for="Contact-phone">{{ 'pages.contact.phone' | t }}</label>
            <input id="Contact-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label for="Contact-body">{{ 'pages.contact.message' | t }}</label>
            <textarea id="Contact-body" name="contact[body]" rows="5" placeholder="{{ 'pages.contact.message_ph' | t }}">{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn btn--full ct__send">{{ 'pages.contact.send' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</button>
          <p class="t-xs t-muted">{{ 'pages.contact.note' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact.name",
  "settings": [
    { "type": "text", "id": "email", "label": "t:sections.contact.email", "default": "hello@betweentwosuns.co" },
    { "type": "image_picker", "id": "image", "label": "t:sections.page_hero.image" }
  ]
}
{% endschema %}
