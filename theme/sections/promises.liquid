{%- comment -%}
  "What you can count on" (DECISIONS 247): four plain promises that give a first-time buyer peace of mind, each one a
  fact the site already shows (full ingredient lists, full-size sets, where it's made, the contact reply time). The
  four step colours mark them, as a quiet row of lines: no cards, so it reads differently from the ingredient cards.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url | remove_last: '/'
  assign icons = 'flask,layers,globe,chat' | split: ','
  assign urls = '/pages/ingredients,/pages/sets,/pages/about,/pages/contact' | split: ','
-%}
<section class="section promises" aria-labelledby="Promises-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'promises.eyebrow' | t }}</p>
        <h2 class="t-display-m" id="Promises-{{ section.id }}">{{ 'promises.heading' | t }}</h2>
      </div>
    </div>
    <ul class="promises__list" role="list">
      {%- for i in (1..4) -%}
        {%- assign k = 'promises.p' | append: i -%}
        <li class="promises__item" data-step="{{ i }}">
          <span class="promises__icon" aria-hidden="true">{% render 'icon', name: icons[forloop.index0] %}</span>
          <h3 class="promises__h">{{ k | append: '_h' | t }}</h3>
          <p class="promises__t">{{ k | append: '_t' | t }}</p>
          <a class="promises__link" href="{{ root }}{{ urls[forloop.index0] }}">{{ k | append: '_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Promises",
  "settings": [],
  "presets": [{ "name": "Promises" }]
}
{% endschema %}
