{%- comment -%}
  Set pages (DECISIONS 276–277): right after the buy area, the textures of the products inside, side by side and edge to
  edge, each with its step ("01 Cleanse"); then delivery shown as dates. Loads assets/set-page.css (the set page's brand-face
  headings, one-line "Best for", stars and set-card pictures). Renders nothing on single products.
{%- endcomment -%}
{%- liquid
  capture bdef
    render 'bundle-def', handle: product.handle
  endcapture
  assign bdef = bdef | strip
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
-%}
{%- if bdef != blank -%}
  {{ 'set-page.css' | asset_url | stylesheet_tag }}
  {%- assign units = bdef | split: '|' | first | split: ',' | uniq -%}
  {%- liquid
    comment
      each texture is 1/n of the width on laptop, half (or all, for one) on phones, so the right image size is fetched
    endcomment
    assign tex_vw = 100 | divided_by: units.size
    assign tex_ph = '50vw'
    if units.size == 1
      assign tex_ph = '100vw'
    endif
    assign tex_sizes = '(min-width: 750px) ' | append: tex_vw | append: 'vw, ' | append: tex_ph
  -%}
  <section class="pdp-break pdp-break--set" style="--n: {{ units.size }}" aria-label="{{ 'product.texture' | t }}">
    {%- for st in units -%}
      {%- assign si = st | plus: 0 -%}
      {%- assign comp = all_products[step_handles[si]] -%}
      {%- assign tk = 'bts-' | append: step_handles[si] | append: '-texture.jpg' -%}
      {%- assign tp = images[tk] -%}
      <div class="pdp-break__panel" data-step="{{ si }}">
        {%- if tp != blank -%}{{ tp | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1400,2000', sizes: tex_sizes, alt: '', class: 'pdp-break__img' }}{%- endif -%}
        <p class="pdp-break__label"><span>0{{ si }}</span>{{ comp.metafields.bts.step_label.value | default: comp.title | escape }}</p>
      </div>
    {%- endfor -%}
  </section>
<template id="DeliveryDates" data-main="{{ settings.delivery_days_main | escape }}" data-other="{{ settings.delivery_days_other | escape }}" data-tpl="{{ 'pdp2.delivery_dates' | t: main: '__M__', other: '__O__' }}"></template>
<script>
  /* Set pages (DECISIONS 276–277): "1–3 business days" as dates. Egypt's working week is Sunday–Thursday; day 1 is the next
     working day after today (Cairo time). Public holidays are not known here, so they are not skipped. */
  (() => {
    const cfg = document.getElementById('DeliveryDates')?.dataset;
    const els = document.querySelectorAll('[data-delivery-line]');
    if (!cfg || !els.length) return;
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Cairo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    const base = new Date(today + 'T12:00:00Z');
    const work = (d) => d.getUTCDay() !== 5 && d.getUTCDay() !== 6;
    const after = (n) => { const d = new Date(base); let k = 0; while (k < n) { d.setUTCDate(d.getUTCDate() + 1); if (work(d)) k++; } return d; };
    const ar = document.documentElement.lang === 'ar';
    const lang = ar ? 'ar-EG-u-nu-latn' : 'en-GB';
    const part = (d, o) => new Intl.DateTimeFormat(lang, { ...o, timeZone: 'UTC' }).format(d);
    // "Tue 3 Nov"; a range in one month says the month once: "Tue 3 – Thu 5 Nov"
    const day = (d, month) => [part(d, { weekday: 'short' }), part(d, { day: 'numeric' }), month ? part(d, { month: 'short' }) : ''].filter(Boolean).join('\u00a0');
    const range = (r) => {
      const [a, b] = String(r).split(/[–-]/).map((x) => parseInt(x, 10));
      if (isNaN(a) || isNaN(b)) return null;
      const x = after(a), y = after(b);
      return day(x, x.getUTCMonth() !== y.getUTCMonth()) + '\u00a0–\u00a0' + day(y, true); // each range stays on one line
    };
    els.forEach((el) => {
      const m = range(cfg.main), o = range(cfg.other);
      if (m && o) el.textContent = cfg.tpl.replace('__M__', m).replace('__O__', o);
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Set textures",
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
