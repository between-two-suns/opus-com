{{ 'creators.css' | asset_url | stylesheet_tag }}
<script src="{{ 'creators.js' | asset_url }}" defer></script>
{%- comment -%}
  Creators landing ("Film the space between"; DECISIONS 224). Hero, one "how it works" timeline (apply, hear back in
  7 days, free products chosen for skin and channel, post and earn: 10% off for followers, 10% commission), "the more
  you create, the more you get", ideas as photo cards (the brand's own photos, as prompts), the rules, then the
  application. Who gets which products, and the thresholds for more, stay in the private creator kit. No follower
  counts, views, earnings figures or deadlines are shown or promised; no limit on places.
  Frames are phone-shaped "reels" built from the real product cutouts and the brand's climate conditions.
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'creators.eyebrow' | t | replace: '&amp;', '&'
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'creators.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'creators.text' | t | replace: '&amp;', '&'
  endif
  assign frames = 'daily-reset-cleanser:city:dust:1,clarity-serum:humidity:drop:2,daily-barrier-moisturizing-cream:ac:ac:3,daily-defense-sunscreen-spf-50:sun:sun:4' | split: ','
  assign step_icons = 'mail,chat,truck,cash' | split: ','
  assign grows = 'keep:refresh,featured:globe,top:arrow-up' | split: ','
  assign ideas = 'review:chat:bts-portrait-window-tall.jpg,morning:sun:bts-climate-heat-tall.jpg,night:moon:bts-demo-night.jpg,texture:layers:bts-clarity-serum-application-2.jpg,grwm:scan:bts-daily-defense-sunscreen-spf-50-application-2.jpg,unboxing:truck:bts-the-full-ritual.jpg' | split: ','
-%}
<div class="creators">
  <section class="cr-hero grain" aria-labelledby="CrTitle-{{ section.id }}">
    <span class="cr-hero__mark" aria-hidden="true"></span>
    <div class="container cr-hero__inner">
      <div class="cr-hero__copy">
        <p class="t-eyebrow">{{ eyebrow | escape }}</p>
        <h1 class="t-display-l cr-hero__title" id="CrTitle-{{ section.id }}">{{ heading | escape }}</h1>
        <p class="t-lead">{{ text | escape }}</p>
        <div class="cluster cr-hero__ctas">
          <a class="btn" href="#CreatorApply" data-magnetic>{{ 'creators.cta' | t }}</a>
          <a class="link-arrow" href="#CrHow-{{ section.id }}">{{ 'creators.how_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </div>
      </div>
      <ul class="cr-reels" role="list" aria-hidden="true">
        {%- for f in frames -%}
          {%- assign parts = f | split: ':' -%}
          {%- assign p = all_products[parts[0]] -%}
          {%- assign cut = p.metafields.bts.cutout.value -%}
          {%- assign ck = 'sections.forecast.conditions.' | append: parts[1] -%}
          {%- assign cap = 'creators.reel_captions.' | append: parts[1] -%}
          {%- assign shot = p.media[1] -%}
          <li class="cr-reel{% if shot %} cr-reel--photo{% endif %}" style="--sku: var(--c-step-{{ parts[3] }}); --sku-tint: var(--c-step-{{ parts[3] }}-tint); --i: {{ forloop.index0 }}">
            <span class="cr-reel__chip">{% render 'icon', name: parts[2], class: 'icon--sm' %}{{ ck | t }}</span>
            <span class="cr-reel__media">
              {%- if shot -%}
                {{ shot | image_url: width: 520 | image_tag: loading: 'eager', widths: '260,390,520', sizes: '(min-width: 990px) 14vw, 28vw', alt: '' }}
              {%- elsif cut -%}
                {{ cut | image_url: width: 420 | image_tag: loading: 'eager', widths: '210,320,420', sizes: '(min-width: 990px) 12vw, 28vw', alt: '' }}
              {%- elsif p.featured_image -%}
                {{ p.featured_image | image_url: width: 420 | image_tag: loading: 'eager', widths: '210,320,420', sizes: '(min-width: 990px) 12vw, 28vw', alt: '' }}
              {%- endif -%}
            </span>
            <span class="cr-reel__cap">{{ cap | t }}</span>
            <span class="cr-reel__bar"><span></span></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} How it works: one timeline, each step with what the creator gets at that point (DECISIONS 224) {%- endcomment -%}
  <section class="section cr-how" id="CrHow-{{ section.id }}" aria-labelledby="CrHowTitle-{{ section.id }}">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="t-eyebrow">{{ 'creators.how_eyebrow' | t }}</p>
          <h2 class="t-display-m" id="CrHowTitle-{{ section.id }}">{{ 'creators.how_heading' | t }}</h2>
        </div>
      </div>
      <ol class="cr-line" role="list">
        {%- for n in (1..4) -%}
          {%- assign tk = 'creators.steps.s' | append: n | append: '.title' -%}
          {%- assign bk = 'creators.steps.s' | append: n | append: '.text' -%}
          {%- assign ic = step_icons[forloop.index0] -%}
          <li class="cr-line__step">
            <span class="cr-line__ico" aria-hidden="true">{% render 'icon', name: ic %}</span>
            <h3 class="cr-line__title">{{ tk | t }}</h3>
            <p class="cr-line__text">{{ bk | t }}</p>
          </li>
        {%- endfor -%}
      </ol>
      <div class="cr-grow">
        <h3 class="cr-grow__title">{{ 'creators.grow_heading' | t }}</h3>
        <ul class="cr-grow__list" role="list">
          {%- for g in grows -%}
            {%- assign parts = g | split: ':' -%}
            {%- assign tk = 'creators.grow.' | append: parts[0] | append: '.title' -%}
            {%- assign bk = 'creators.grow.' | append: parts[0] | append: '.text' -%}
            <li>{% render 'icon', name: parts[1] %}<span><strong>{{ tk | t }}</strong> {{ bk | t }}</span></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} Ideas: simple formats people know (review, morning, night, close-up, reel, unboxing), each on one of the brand's own photos; clearly ideas, never presented as creators' work. Then the rules. {%- endcomment -%}
  <section class="section cr-ideas" aria-labelledby="CrIdeas-{{ section.id }}">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <p class="t-eyebrow">{{ 'creators.ideas_eyebrow' | t }}</p>
          <h2 class="t-display-m" id="CrIdeas-{{ section.id }}">{{ 'creators.ideas_heading' | t }}</h2>
          <p class="t-lead">{{ 'creators.ideas_text' | t }}</p>
        </div>
      </div>
    </div>
    <ul class="cr-cards" role="list">
      {%- for i in ideas -%}
        {%- assign parts = i | split: ':' -%}
        {%- assign ik = 'creators.ideas.' | append: parts[0] -%}
        {%- assign tg = 'creators.tags.' | append: parts[0] -%}
        {%- assign im = images[parts[2]] -%}
        <li class="cr-cardx">
          {%- if im != blank -%}{{ im | image_url: width: 720, height: 900, crop: 'center' | image_tag: loading: 'lazy', widths: '360,540,720', sizes: '(min-width: 990px) 30vw, 62vw', alt: '', class: 'cr-cardx__img' }}{%- endif -%}
          <span class="cr-cardx__chip">{% render 'icon', name: parts[1], class: 'icon--sm' %}{{ tg | t }}</span>
          <span class="cr-cardx__idea">{{ ik | t }}</span>
        </li>
      {%- endfor -%}
    </ul>
    <div class="container">
      <div class="cr-rules">
        <h3 class="cr-rules__title">{{ 'creators.rules_heading' | t }}</h3>
        <ul class="cr-rules__list" role="list">
          {%- for n in (1..4) -%}
            {%- assign rk = 'creators.rules.r' | append: n -%}
            <li>{% render 'icon', name: 'check', class: 'icon--sm' %}<span>{{ rk | t }}</span></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} Phones: once the hero has scrolled away, a pinned Apply bar until the form is in view {%- endcomment -%}
  <div class="cr-bar" data-cr-bar>
    <a class="btn" href="#CreatorApply">{{ 'creators.cta' | t }}</a>
    <span class="cr-bar__note">{{ 'creators.bar_note' | t }}</span>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.creators.name",
  "settings": [
    { "type": "paragraph", "content": "t:general_schema.bilingual_fallback" },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" }
  ],
  "presets": [{ "name": "t:sections.creators.name" }]
}
{% endschema %}
