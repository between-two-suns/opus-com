{{ 'product.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Set pages only (renders nothing on single products): what's inside, the order to use it morning and night,
  who it suits, and the saving worked out line by line. Everything is computed from the set definition
  (snippets/bundle-def) and the products' own records and prices, so nothing here can drift from the store.
{%- endcomment -%}
{%- liquid
  capture bdef
    render 'bundle-def', handle: product.handle
  endcapture
  assign bdef = bdef | strip
-%}
{%- if bdef != blank -%}
{%- liquid
  assign bundle_steps = bdef | split: '|' | first | split: ','
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign buniq = bundle_steps | uniq
  assign variant = product.selected_or_first_available_variant
  assign singles = 0
  for st in bundle_steps
    assign si = st | plus: 0
    assign comp = all_products[step_handles[si]]
    assign singles = singles | plus: comp.price
  endfor
  assign saving = singles | minus: variant.price
  assign who_key = 'bundle_inside.who.' | append: product.handle
  assign who = who_key | t | replace: '&amp;', '&'
  assign has_am = false
  assign has_pm = false
-%}
<section class="section bi" aria-labelledby="BiTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'bundle_inside.eyebrow' | t }}</p>
        <h2 class="t-display-m" id="BiTitle-{{ section.id }}">{{ 'bundle_inside.heading' | t: count: bundle_steps.size }}</h2>
      </div>
      {%- unless who contains 'translation missing' -%}<p class="t-lead t-muted bi__who">{{ who }}</p>{%- endunless -%}
    </div>

    <ol class="bi__items" role="list" style="--n: {{ buniq.size | at_least: 2 }}">
      {%- for st in buniq -%}
        {%- liquid
          assign si = st | plus: 0
          assign comp = all_products[step_handles[si]]
          assign q = 0
          for x in bundle_steps
            if x == st
              assign q = q | plus: 1
            endif
          endfor
          assign studio_key = 'bts-' | append: comp.handle | append: '-studio.jpg'
          assign studio = images[studio_key]
          if si == 4
            assign has_am = true
          else
            assign has_am = true
            assign has_pm = true
          endif
        -%}
        <li class="bi__item" data-step="{{ st }}">
          <a class="bi__link" href="{{ comp.url }}">
            <span class="bi__media">
              {%- if studio -%}
                {{ studio | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(min-width: 990px) 22vw, 44vw', alt: '' }}
              {%- elsif comp.featured_media -%}
                {{ comp.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 22vw, 44vw', alt: '', class: 'bi__img--contain' }}
              {%- endif -%}
              {%- if q > 1 -%}<span class="bi__qty">× {{ q }}</span>{%- endif -%}
            </span>
            <span class="bi__body">
              <span class="step-tag">{{ 'product.step' | t: number: st }}{% if comp.metafields.bts.step_label != blank %} · {{ comp.metafields.bts.step_label.value | escape }}{% endif %}</span>
              <span class="bi__name">{{ comp.title | escape }}</span>
              {%- if comp.metafields.bts.benefit != blank -%}<span class="bi__benefit">{{ comp.metafields.bts.benefit.value | escape }}</span>{%- endif -%}
              <span class="bi__meta">
                {%- if comp.metafields.bts.size != blank -%}<span class="u-ltr">{{ comp.metafields.bts.size.value }}</span> · {% endif -%}
                {%- if comp.metafields.bts.when_to_use != blank -%}{{ comp.metafields.bts.when_to_use.value | escape }}{%- endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ol>

    <div class="bi__grid">
      <div class="bi__card bi__use">
        <h3 class="bi__h">{{ 'bundle_inside.order_heading' | t }}</h3>
        {%- if has_am -%}
          <div class="bi__row">
            <p class="bi__when">{% render 'icon', name: 'sun', class: 'icon--sm' %}{{ 'bundle_inside.morning' | t }}</p>
            <ol class="bi__seq" role="list">
              {%- for st in buniq -%}
                {%- assign si = st | plus: 0 -%}
                {%- assign comp = all_products[step_handles[si]] -%}
                <li data-step="{{ st }}"><span class="bi__dot" aria-hidden="true"></span>{{ comp.metafields.bts.step_label.value | default: comp.title | escape }}</li>
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
        {%- if has_pm -%}
          <div class="bi__row">
            <p class="bi__when">{% render 'icon', name: 'moon', class: 'icon--sm' %}{{ 'bundle_inside.night' | t }}</p>
            <ol class="bi__seq" role="list">
              {%- for st in buniq -%}
                {%- if st != '4' -%}
                  {%- assign si = st | plus: 0 -%}
                  {%- assign comp = all_products[step_handles[si]] -%}
                  <li data-step="{{ st }}"><span class="bi__dot" aria-hidden="true"></span>{{ comp.metafields.bts.step_label.value | default: comp.title | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
        {%- if buniq contains '4' -%}<p class="t-small t-muted">{{ 'bundle_inside.spf_note' | t }}</p>{%- endif -%}
      </div>

      {%- if saving > 0 -%}
        <div class="bi__card bi__save">
          <h3 class="bi__h">{{ 'bundle_inside.saving_heading' | t }}</h3>
          <dl class="bi__sum">
            {%- for st in bundle_steps -%}
              {%- assign si = st | plus: 0 -%}
              {%- assign comp = all_products[step_handles[si]] -%}
              <div><dt>{{ comp.title | escape }}</dt><dd>{% render 'egp', cents: comp.price %}</dd></div>
            {%- endfor -%}
            <div class="bi__sum-total"><dt>{{ 'bundle_inside.separately' | t }}</dt><dd><s>{% render 'egp', cents: singles %}</s></dd></div>
            <div class="bi__sum-set"><dt>{{ product.title | escape }}</dt><dd>{% render 'egp', cents: variant.price %}</dd></div>
          </dl>
          {%- capture save_m -%}{% render 'egp', cents: saving %}{%- endcapture -%}
          <p class="bi__saved">{{ 'bundles.save_vs' | t: amount: save_m }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.bundle_inside.name",
  "settings": [{ "type": "paragraph", "content": "t:sections.bundle_inside.info" }]
}
{% endschema %}
