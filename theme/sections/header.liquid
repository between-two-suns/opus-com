{%- liquid
  assign menu = section.settings.menu
  assign mega_collection = section.settings.mega_collection | default: collections.all
  comment
    The four routine steps in order (never sets): by handle, so the order doesn't depend on the collection.
  endcomment
  assign mega_handles = 'daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
-%}
<site-header class="site-header-wrap">
  <header class="site-header" data-header>
    <div class="container site-header__inner">
      <div class="site-header__start">
        <button
          type="button"
          class="header-icon header-only-mobile"
          aria-controls="MenuDrawer"
          aria-expanded="false"
          data-open-dialog="MenuDrawer"
        >
          {% render 'icon', name: 'menu', class: 'icon--lg' %}
          <span class="visually-hidden">{{ 'header.menu' | t }}</span>
        </button>

        <nav class="site-nav" aria-label="{{ 'header.primary_nav' | t }}">
          <ul class="site-nav__list" role="list">
            {%- if menu.links.size > 0 -%}
              {%- for link in menu.links -%}
                <li class="site-nav__item">
                  {%- if forloop.first and section.settings.enable_mega and mega_collection.products_count > 0 -%}
                    {%- comment -%} Clicking Shop goes to all products; pointing at it (or ↓ on the keyboard) opens the menu (DECISIONS 266) {%- endcomment -%}
                    <a class="site-nav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} aria-expanded="false" aria-controls="MegaShop" data-mega-toggle>
                      {{ link.title | escape }}
                      {% render 'icon', name: 'chevron-down', class: 'icon--sm' %}
                    </a>
                  {%- else -%}
                    <a class="site-nav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="site-nav__item"><a class="site-nav__link" href="{{ routes.all_products_collection_url }}" aria-expanded="false" aria-controls="MegaShop" data-mega-toggle>{{ 'header.nav.shop' | t }} {% render 'icon', name: 'chevron-down', class: 'icon--sm' %}</a></li>
              <li><a class="site-nav__link" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{{ 'header.nav.sets' | t }}</a></li>
              <li><a class="site-nav__link" href="{{ routes.root_url | append: '/pages/climate' | replace: '//', '/' }}">{{ 'header.nav.climate' | t }}</a></li>
              <li><a class="site-nav__link" href="{{ routes.root_url | append: '/pages/ingredients' | replace: '//', '/' }}">{{ 'header.nav.ingredients' | t }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      </div>

      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ 'header.home' | t: shop: shop.name }}">
        {%- render 'logo', variant: 'wordmark' -%}
      </a>

      <div class="site-header__end">
        <a
          href="{{ routes.search_url }}"
          class="header-icon header-hide-mobile"
          data-open-dialog="SearchModal"
          aria-controls="SearchModal"
          aria-haspopup="dialog"
        >
          {% render 'icon', name: 'search' %}
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </a>
        <span class="header-lang">{% render 'language-switch', form_id: 'HeaderLang' %}</span>
        {%- if shop.customer_accounts_enabled -%}
          {%- comment -%} Our account page: sign-in when signed out, the customer's home when signed in (DECISIONS 273, 275) {%- endcomment -%}
          <a href="{{ routes.root_url | append: '/pages/account' | replace: '//', '/' }}" class="header-icon header-hide-mobile">
            {% render 'icon', name: 'account' %}
            <span class="visually-hidden">{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.log_in' | t }}{% endif %}</span>
          </a>
        {%- endif -%}
        <a
          href="{{ routes.cart_url }}"
          class="header-icon header-hide-mobile"
          id="CartToggle"
          data-open-dialog="CartDrawer"
          aria-controls="CartDrawer"
          aria-haspopup="dialog"
        >
          {% render 'icon', name: 'cart' %}
          <span class="visually-hidden" data-cart-label>{{ 'cart.count_label' | t: count: cart.item_count }}</span>
          <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}" aria-hidden="true">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
        </a>
      </div>
    </div>

  </header>
  {%- if section.settings.enable_mega -%}
    <div class="mega" id="MegaShop" hidden data-mega>
      <div class="container mega-ed">
        {%- comment -%} Editorial (DECISIONS 268–270): the four names large; pointing at a product shows its photo, at a set its page's first picture {%- endcomment -%}
        <div class="dm-b">
          <div class="dm-b__names">
            <p class="t-eyebrow t-muted">{{ 'shop_menu.mega_routine' | t }}</p>
            <ol class="dm-names" role="list">
              {%- for mh in mega_handles -%}{%- assign product = all_products[mh] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
                {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}{%- assign step = step | strip -%}
                <li><a class="dm-name" href="{{ product.url }}" data-step="{{ step }}" data-i="{{ forloop.index }}"><span class="step-num">0{{ step }}</span><span class="dm-name__t">{{ product.title | escape }}</span></a></li>
              {%- endfor -%}
            </ol>
            <a class="btn btn--primary btn--small dm-all" href="{{ routes.all_products_collection_url }}">{{ 'shop_menu.shop_all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
          </div>
          <div class="dm-b__side">
            <p class="t-eyebrow t-muted">{{ 'shop_menu.mega_sets' | t }}</p>
            <ul class="dm-links" role="list">
              {%- assign set_handles = 'the-full-ritual,the-night-ritual,the-clear-protect-trio' | split: ',' -%}
              {%- for sh in set_handles -%}{%- assign product = all_products[sh] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
                <li><a class="dm-set" href="{{ product.url }}" data-i="{{ forloop.index | plus: 4 }}">{{ product.title | escape }}{%- render 'price', product: product, class: 'dm-price' -%}</a></li>
              {%- endfor -%}
            </ul>
            <p class="t-eyebrow t-muted">{{ 'shop_menu.mega_more' | t }}</p>
            <ul class="dm-links" role="list">
              <li><a href="{{ routes.root_url | append: '/pages/ingredients' | replace: '//', '/' }}">{{ 'header.nav.ingredients' | t }}</a></li>
              <li><a href="{{ routes.root_url | append: '/pages/creators' | replace: '//', '/' }}">{{ 'footer.links.creators' | t }}</a></li>
            </ul>
          </div>
          <div class="dm-view" aria-hidden="true">
            {%- comment -%} first: what shows before pointing at anything (The Full Ritual) {%- endcomment -%}
            {%- assign product = all_products['the-full-ritual'] -%}
            {%- if product.id -%}
              <span class="dm-fig dm-fig--rest">{% render 'mega-set-stage', handle: 'the-full-ritual' %}<span class="dm-fig__cap"><span class="pick-chip">{{ 'shop_menu.pick' | t }}</span>{{ product.title | escape }}{%- render 'price', product: product, class: 'dm-price' -%}</span></span>
            {%- endif -%}
            {%- for mh in mega_handles -%}{%- assign product = all_products[mh] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
              {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}{%- assign step = step | strip -%}
              {%- assign studio_key = 'bts-' | append: product.handle | append: '-studio.jpg' -%}{%- assign studio = images[studio_key] -%}
              <span class="dm-fig" data-step="{{ step }}" data-i="{{ forloop.index }}">
                {%- if studio != blank -%}{{ studio | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '420px', alt: '' }}{%- elsif product.featured_media -%}{{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '420px', alt: '' }}{%- endif -%}
                <span class="dm-fig__cap">{% if product.metafields.bts.step_label != blank %}{{ product.metafields.bts.step_label.value }}{% endif %}{%- render 'price', product: product, class: 'dm-price' -%}</span>
              </span>
            {%- endfor -%}
            {%- for sh in set_handles -%}{%- assign product = all_products[sh] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
              <span class="dm-fig" data-i="{{ forloop.index | plus: 4 }}">{% render 'mega-set-stage', handle: sh %}<span class="dm-fig__cap">{{ product.title | escape }}{%- render 'price', product: product, class: 'dm-price' -%}</span></span>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</site-header>

{%- comment -%} Mobile menu {%- endcomment -%}
<dialog class="drawer drawer--start" id="MenuDrawer" aria-labelledby="MenuDrawerTitle">
  <div class="drawer__head">
    {%- comment -%} Opening the menu focuses its (hidden) title, not the logo link, so no focus ring is drawn on the logo {%- endcomment -%}
    <h2 class="visually-hidden" id="MenuDrawerTitle" tabindex="-1" autofocus>{{ 'header.menu' | t }}</h2>
    <a class="menu-drawer__logo" href="{{ routes.root_url }}" aria-label="{{ 'header.home' | t: shop: shop.name }}">{%- render 'logo', variant: 'wordmark' -%}</a>
    <button type="button" class="header-icon" data-close-dialog>
      {% render 'icon', name: 'close', class: 'icon--lg' %}
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
    </button>
  </div>
  <div class="drawer__body">
    {%- comment -%}
      Links first, with Shop opening in place like the laptop menu (open when the menu opens): the four steps in a slim row,
      The Full Ritual, Shop all; then Sets, Find Your Routine, The Climate, About (DECISIONS 265–267). Home is the logo and
      the dock; Ingredients is in the footer; Creators is in the small row.
    {%- endcomment -%}
    <nav class="pmenu" aria-label="{{ 'header.primary_nav' | t }}">
      <details class="pmenu__shop" open>
        <summary class="menu-drawer__link">{% if menu.links.size > 0 %}{{ menu.links.first.title | escape }}{% else %}{{ 'header.nav.shop' | t }}{% endif %} {% render 'icon', name: 'chevron-down', class: 'pmenu__chev' %}</summary>
        <div class="pmenu__panel">
          <div class="pmenu__row">
            {%- for mh in mega_handles -%}{%- assign product = all_products[mh] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
              {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign step = step | strip -%}
              {%- assign studio_key = 'bts-' | append: product.handle | append: '-studio.jpg' -%}
              {%- assign studio = images[studio_key] -%}
              {%- assign short_key = 'shop_menu.short.' | append: product.handle -%}
              <a class="pmenu__p" href="{{ product.url }}" data-step="{{ step }}">
                {%- if studio != blank -%}{{ studio | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '84px', alt: '' }}{%- elsif product.featured_media -%}{{ product.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '84px', alt: '' }}{%- endif -%}
                <small><span class="step-dot" aria-hidden="true"></span>0{{ step }}</small>
                <span>{{ short_key | t }}</span>
                {%- render 'price', product: product, class: 'pmenu__price' -%}
              </a>
            {%- endfor -%}
          </div>
          {%- assign ritual = all_products['the-full-ritual'] -%}
          {%- if ritual.id -%}
            <a class="ritual-card" href="{{ ritual.url }}">
              {%- if ritual.featured_media -%}{{ ritual.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '88px', alt: '' }}{%- endif -%}
              <span><span class="pick-chip">{{ 'shop_menu.pick' | t }}</span><strong>{{ ritual.title | escape }}</strong><em>{{ 'shop_menu.all_four' | t }}</em></span>
              <span class="ritual-card__price">{% render 'price', product: ritual %}</span>
            </a>
          {%- endif -%}
          <a class="pmenu__all" href="{{ routes.all_products_collection_url }}">{{ 'shop_menu.shop_all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </div>
      </details>
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links offset: 1 -%}
          <a class="menu-drawer__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }} {% render 'icon', name: 'arrow', class: 'icon--flip' %}</a>
        {%- endfor -%}
      {%- else -%}
        <a class="menu-drawer__link" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{{ 'header.nav.sets' | t }} {% render 'icon', name: 'arrow', class: 'icon--flip' %}</a>
        <a class="menu-drawer__link" href="{{ routes.root_url | append: '/pages/routines' | replace: '//', '/' }}">{{ 'header.nav.routines' | t }} {% render 'icon', name: 'arrow', class: 'icon--flip' %}</a>
        <a class="menu-drawer__link" href="{{ routes.root_url | append: '/pages/climate' | replace: '//', '/' }}">{{ 'header.nav.climate' | t }} {% render 'icon', name: 'arrow', class: 'icon--flip' %}</a>
        <a class="menu-drawer__link" href="{{ routes.root_url | append: '/pages/ingredients' | replace: '//', '/' }}">{{ 'header.nav.ingredients' | t }} {% render 'icon', name: 'arrow', class: 'icon--flip' %}</a>
      {%- endif -%}
    </nav>
    <div class="menu-drawer__secondary">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.root_url | append: '/pages/account' | replace: '//', '/' }}">{% render 'icon', name: 'account', class: 'icon--sm' %}&nbsp;{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.log_in' | t }}{% endif %}</a>
      {%- endif -%}
      <a href="{{ routes.root_url | append: '/pages/faq' | replace: '//', '/' }}">{{ 'header.nav.faq' | t }}</a>
      <a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">{{ 'header.nav.contact' | t }}</a>
      <a href="{{ routes.root_url | append: '/pages/creators' | replace: '//', '/' }}">{{ 'footer.links.creators' | t }}</a>
      {% render 'language-switch', form_id: 'DrawerLang', class: 'chip', show_label: true %}
    </div>
  </div>
</dialog>

{%- comment -%} Search {%- endcomment -%}
<dialog class="search-modal" id="SearchModal" aria-labelledby="SearchModalTitle">
  <div class="search-modal__panel">
    <div class="container search-modal__inner">
      <h2 class="visually-hidden" id="SearchModalTitle">{{ 'search.title' | t }}</h2>
      <predictive-search data-url="{{ routes.predictive_search_url }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
          <label class="visually-hidden" for="SearchModalInput">{{ 'search.label' | t }}</label>
          {% render 'icon', name: 'search', class: 'icon--lg' %}
          <input
            id="SearchModalInput"
            class="search-modal__input"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="PredictiveResults"
            aria-autocomplete="list"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="button" class="header-icon" data-close-dialog>
            {% render 'icon', name: 'close', class: 'icon--lg' %}
            <span class="visually-hidden">{{ 'general.close' | t }}</span>
          </button>
        </form>
        <div class="search-modal__suggest" data-suggestions>
          <p class="t-eyebrow t-muted">{{ 'search.popular' | t }}</p>
          <div class="cluster u-mt-s">
            {%- assign terms = 'search.popular_terms' | t | split: ',' -%}
            {%- for term in terms -%}
              <a class="chip" href="{{ routes.search_url }}?q={{ term | strip | url_encode }}">{{ term | strip }}</a>
            {%- endfor -%}
          </div>
        </div>
        <div id="PredictiveResults" class="search-modal__results" data-results aria-live="polite"></div>
      </predictive-search>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.menu",
      "default": "main-menu",
      "info": "t:sections.header.menu_info"
    },
    {
      "type": "checkbox",
      "id": "enable_mega",
      "label": "t:sections.header.enable_mega",
      "default": true
    },
    {
      "type": "collection",
      "id": "mega_collection",
      "label": "t:sections.header.mega_collection"
    }
  ]
}
{% endschema %}
