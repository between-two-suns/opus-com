{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign preset = section.settings.preset
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign eyebrow = section.settings.eyebrow
  if preset != 'none'
    assign hk = 'page_presets.' | append: preset | append: '.heading'
    assign tk = 'page_presets.' | append: preset | append: '.text'
    assign ek = 'page_presets.' | append: preset | append: '.eyebrow'
    if heading == blank
      assign heading = hk | t | replace: '&amp;', '&'
    endif
    if text == blank
      assign text = tk | t | replace: '&amp;', '&'
    endif
    if eyebrow == blank
      assign eyebrow = ek | t | replace: '&amp;', '&'
    endif
  endif
  if heading == blank
    assign heading = page.title | default: page_title
  endif
-%}
{%- assign img = section.settings.image -%}
<div class="page-hero{% if section.settings.compact %} page-hero--compact{% endif %}{% if img %} page-hero--media{% endif %}">
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {%- if eyebrow != blank -%}<p class="t-eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
      <h1 class="t-display-l">{{ heading | escape }}</h1>
      {%- if text != blank -%}<p class="t-lead page-hero__text">{{ text | escape }}</p>{%- endif -%}
      {%- if preset == 'sets' or preset == 'routines' -%}{%- render 'skin-check-link', key: 'skin_check.cta_sets' -%}{%- endif -%}
    </div>
    {%- if img -%}
      <div class="page-hero__media">
        {{ img | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: img.alt | default: '' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.page_hero.name",
  "settings": [
    {
      "type": "select",
      "id": "preset",
      "label": "t:sections.page_hero.preset",
      "options": [
        { "value": "none", "label": "Page title" },
        { "value": "routines", "label": "Routines" },
        { "value": "ingredients", "label": "Ingredients" },
        { "value": "climate", "label": "Climate" },
        { "value": "about", "label": "About" },
        { "value": "faq", "label": "FAQ" },
        { "value": "contact", "label": "Contact" },
        { "value": "scan", "label": "Scan" },
        { "value": "sets", "label": "Sets" }
      ],
      "default": "none"
    },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "image_picker", "id": "image", "label": "t:sections.page_hero.image" },
    { "type": "checkbox", "id": "compact", "label": "t:sections.page_hero.compact", "default": false }
  ],
  "presets": [{ "name": "t:sections.page_hero.name" }]
}
{% endschema %}
