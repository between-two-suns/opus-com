{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Editorial story rows (field | seam | field). Each block is a built-in bilingual story preset or custom copy + optional image.
{%- endcomment -%}
{%- assign packs = 'pack-reset.webp,pack-clarity.webp,pack-barrier.webp,pack-defense.webp' | split: ',' -%}
<section class="section story{% if section.settings.dark %} story--dark{% endif %}">
  <div class="container story__list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.preset
        assign heading = block.settings.heading
        assign text = block.settings.text
        assign eyebrow = ''
        if p != 'custom'
          assign hk = 'stories.' | append: p | append: '.heading'
          assign tk = 'stories.' | append: p | append: '.text'
          assign ek = 'stories.' | append: p | append: '.eyebrow'
          if heading == blank
            assign heading = hk | t
          endif
          if text == blank
            assign text = tk | t
          endif
          assign eyebrow = ek | t
        endif
      -%}
      <article class="story__row{% if forloop.index0 == 1 or forloop.index0 == 3 %} story__row--flip{% endif %} reveal" {{ block.shopify_attributes }}>
        <div class="story__media grain">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width: 990px) 45vw, 92vw', alt: block.settings.image.alt | default: '' }}
          {%- else -%}
            {%- liquid
              assign visual = block.settings.visual | default: 'auto'
              if visual == 'auto'
                case p
                  when 'routine'
                    assign visual = 'lineup'
                  when 'transparent'
                    assign visual = 'step2'
                  when 'not_summer'
                    assign visual = 'step4'
                  when 'light'
                    assign visual = 'step3'
                  else
                    assign visual = 'number'
                endcase
              endif
            -%}
            {%- if visual == 'number' -%}
              <span class="story__art" data-variant="{{ forloop.index | modulo: 4 }}" aria-hidden="true">
                <span class="sun sun--warm"></span><span class="sun sun--cool"></span>
                <span class="story__num t-display-xl">0{{ forloop.index }}</span>
              </span>
            {%- elsif visual == 'lineup' -%}
              <span class="story__art story__art--lineup" aria-hidden="true">
                <span class="sun sun--warm"></span><span class="sun sun--cool"></span>
                <span class="story__packs">
                  {%- for pack in packs -%}
                    <img class="story__pack" data-step="{{ forloop.index }}" src="{{ pack | asset_url }}" alt="" width="290" height="900" loading="lazy" decoding="async">
                  {%- endfor -%}
                </span>
              </span>
            {%- else -%}
              {%- assign s = visual | remove: 'step' | plus: 0 -%}
              {%- assign pack_index = s | minus: 1 -%}
              <span class="story__art story__art--single" data-step="{{ s }}" aria-hidden="true">
                <span class="story__glow"></span>
                <img class="story__pack" src="{{ packs[pack_index] | asset_url }}" alt="" width="290" height="900" loading="lazy" decoding="async">
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
        <div class="story__text">
          {%- if eyebrow != blank -%}<p class="t-eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
          <h2 class="t-display-m">{{ heading | escape }}</h2>
          <p class="t-lead">{{ text | escape }}</p>
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="link-arrow" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.story.name",
  "settings": [
    { "type": "checkbox", "id": "dark", "label": "t:sections.story.dark", "default": false }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.story.row",
      "settings": [
        {
          "type": "select",
          "id": "preset",
          "label": "t:sections.story.preset",
          "options": [
            { "value": "between", "label": "The space between" },
            { "value": "routine", "label": "A routine, not a cabinet" },
            { "value": "made", "label": "Made in Egypt" },
            { "value": "transparent", "label": "Nothing hidden" },
            { "value": "not_summer", "label": "Not just summer skincare" },
            { "value": "light", "label": "Light textures" },
            { "value": "custom", "label": "Custom" }
          ],
          "default": "between"
        },
        { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
        { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
        { "type": "image_picker", "id": "image", "label": "t:sections.story.image" },
        {
          "type": "select",
          "id": "visual",
          "label": "t:sections.story.visual",
          "info": "t:sections.story.visual_info",
          "options": [
            { "value": "auto", "label": "t:sections.story.visual_auto" },
            { "value": "number", "label": "t:sections.story.visual_number" },
            { "value": "lineup", "label": "t:sections.story.visual_lineup" },
            { "value": "step1", "label": "01 Reset" },
            { "value": "step2", "label": "02 Clarity" },
            { "value": "step3", "label": "03 Barrier" },
            { "value": "step4", "label": "04 Defense" }
          ],
          "default": "auto"
        },
        { "type": "text", "id": "link_label", "label": "t:sections.story.link_label" },
        { "type": "url", "id": "link", "label": "t:sections.story.link" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.story.name" }]
}
{% endschema %}
