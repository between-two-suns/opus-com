{%- comment -%}
  Cart drawer. Re-rendered through the Section Rendering API (?sections=cart-drawer) after every cart change.
  Only [data-cart-root] is swapped so the <dialog> open state and focus are preserved.
{%- endcomment -%}
{%- liquid
  assign upsell_source = settings.routine_collection | default: collections.all
  assign in_cart_steps = ''
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign has_ritual = false
  assign duo_line = nil
  for item in cart.items
    capture s
      render 'product-step', product: item.product
    endcapture
    assign s = s | strip
    assign in_cart_steps = in_cart_steps | append: '|' | append: s
    capture bdef
      render 'bundle-def', handle: item.product.handle
    endcapture
    assign bdef = bdef | strip
    if bdef != blank
      assign bsteps = bdef | split: '|' | first | split: ','
      for b in bsteps
        assign in_cart_steps = in_cart_steps | append: '|' | append: b
      endfor
      if bdef contains '|ritual' or bdef contains '|trio'
        assign has_ritual = true
      endif
      if item.product.handle == 'the-core-duo' or item.product.handle == 'clear-protect-duo'
        assign duo_line = item
      endif
    endif
  endfor
-%}
<dialog class="drawer cart-drawer" id="CartDrawer" aria-labelledby="CartDrawerTitle">
  <div class="cart-drawer__root" data-cart-root data-count="{{ cart.item_count }}" style="display:flex;flex-direction:column;block-size:100%;">
    <div class="drawer__head">
      {%- comment -%} Opening the bag focuses its title, not the close button, so no focus ring is drawn on open {%- endcomment -%}
      <h2 class="drawer__title" id="CartDrawerTitle" tabindex="-1" autofocus>
        {{ 'cart.title' | t }}
        {%- if cart.item_count > 0 %} <span class="t-muted">({{ cart.item_count }})</span>{% endif -%}
      </h2>
      <button type="button" class="header-icon" data-close-dialog>
        {% render 'icon', name: 'close', class: 'icon--lg' %}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>

    <div class="drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty demo-off">
          <p class="t-display-s">{{ 'cart.empty_title' | t }}</p>
          <p class="t-muted">{{ 'cart.empty_text' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_routine' | t }}</a>
        </div>
        {%- comment -%} Demo only (DECISIONS 265, `?demo=1`): the empty bag offers the routine, like the empty bag page (160) {%- endcomment -%}
        <div class="demo-on demo-empty">
          <p class="t-display-s">{{ 'cart.empty_title' | t }}</p>
          <p class="t-muted">{{ 'demo.empty_lead' | t }}</p>
          {%- assign demo_ritual = all_products['the-full-ritual'] -%}
          {%- if demo_ritual.id -%}
            <a class="demo-ritual" href="{{ demo_ritual.url }}">
              {%- if demo_ritual.featured_media -%}{{ demo_ritual.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '88px', alt: '' }}{%- endif -%}
              <span><span class="demo-pick">{{ 'demo.pick' | t }}</span><strong>{{ demo_ritual.title | escape }}</strong><em>{{ 'demo.all_four' | t }}</em></span>
              <span class="demo-ritual__price">{% render 'price', product: demo_ritual %}</span>
            </a>
          {%- endif -%}
          <div class="demo-empty__tiles">
            {%- for h in step_handles offset: 1 -%}{%- assign product = all_products[h] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
              {%- assign studio_key = 'bts-' | append: product.handle | append: '-studio.jpg' -%}{%- assign studio = images[studio_key] -%}
              {%- assign short_key = 'demo.short.' | append: product.handle -%}
              <a class="demo-empty__tile" href="{{ product.url }}" data-step="{{ forloop.index }}">
                {%- if studio != blank -%}{{ studio | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: '' }}{%- elsif product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: '' }}{%- endif -%}
                <span>0{{ forloop.index }} · {{ short_key | t }}{%- render 'price', product: product, class: 'demo-empty__price' -%}</span>
              </a>
            {%- endfor -%}
          </div>
          <a class="demo-empty__quiz" href="{{ routes.root_url | append: '/pages/routines' | replace: '//', '/' }}"><span>{{ 'demo.finder' | t }}</span>{% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </div>
      {%- else -%}
        {%- comment -%} Routine progress: which of the four steps are in the bag {%- endcomment -%}
        <div class="cart-routine">
          {%- assign steps_in = 0 -%}{%- for n in (1..4) -%}{%- assign needle = '|' | append: n -%}{%- if in_cart_steps contains needle -%}{%- assign steps_in = steps_in | plus: 1 -%}{%- endif -%}{%- endfor -%}
          <p class="t-small cart-routine__label"><strong>{{ 'cart.routine_progress' | t }}</strong><span class="t-muted">{{ 'cart.routine_count' | t: count: steps_in }}</span></p>
          <div class="cart-progress" aria-hidden="true">
            {%- for n in (1..4) -%}
              {%- assign needle = '|' | append: n -%}
              <span data-step="{{ n }}"{% if in_cart_steps contains needle %} class="is-on"{% endif %}></span>
            {%- endfor -%}
          </div>
        </div>

        {%- render 'cart-incentives' -%}

        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            {%- render 'cart-line', item: item, index: forloop.index, prefix: 'Drawer' -%}
          {%- endfor -%}
        </ul>

        {%- comment -%} Spec: duo → Clear & Protect Trio upgrade, phrased net of the delivery fee it saves. {%- endcomment -%}
        {%- assign trio = all_products['the-clear-protect-trio'] -%}
        {%- assign threshold = settings.free_shipping_threshold | default: 0 | times: 100 -%}
        {%- assign fee = settings.delivery_fee | default: 0 | times: 100 -%}
        {%- if duo_line and trio.id and has_ritual == false and threshold > 0 and fee > 0 -%}
          {%- assign dv = trio.selected_or_first_available_variant -%}
          {%- assign after = cart.total_price | minus: duo_line.final_line_price | plus: dv.price -%}
          {%- if cart.total_price < threshold and after >= threshold and dv.available and duo_line.quantity == 1 -%}
            {%- if duo_line.product.handle == 'the-core-duo' -%}{%- assign missing = all_products[step_handles[4]] -%}{%- else -%}{%- assign missing = all_products[step_handles[1]] -%}{%- endif -%}
            {%- assign extra = dv.price | minus: duo_line.final_line_price | minus: fee -%}
            {%- capture extra_money -%}{% render 'egp', cents: extra %}{%- endcapture -%}
            {%- assign trio_name = 'bundles.names.the-clear-protect-trio' | t | replace: '&amp;', '&' -%}
            <div class="cart-upgrade" data-step="{% if duo_line.product.handle == 'the-core-duo' %}4{% else %}1{% endif %}">
              <p class="t-small"><strong>{{ 'bundles.upgrade' | t: product: missing.title, amount: extra_money }}</strong></p>
              <button type="button" class="btn btn--deep btn--small" data-upgrade-line="{{ duo_line.key }}" data-upgrade-to="{{ dv.id }}">
                <span class="btn__label">{{ 'bundles.upgrade_cta' | t: bundle: trio_name }}</span>
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} A three-step set in the bag: switching to The Full Ritual beats adding its missing step alone, so offer that instead. {%- endcomment -%}
        {%- capture swap -%}{% render 'ritual-swap' %}{%- endcapture -%}
        {%- assign swap = swap | strip | split: '|' -%}
        {%- assign swap_step = 0 -%}
        {%- if swap.size == 5 -%}{%- assign swap_step = swap[2] | plus: 0 -%}{%- endif -%}
        {%- if settings.cart_routine_upsell or swap_step > 0 -%}
          {%- capture upsell_items -%}
            {%- if swap_step > 0 -%}{%- render 'ritual-swap-item', swap: swap -%}{%- endif -%}
            {%- for s in (1..4) -%}
              {%- unless settings.cart_routine_upsell -%}{%- break -%}{%- endunless -%}
              {%- assign needle = '|' | append: s -%}
              {%- if s == swap_step -%}{%- continue -%}{%- endif -%}
              {%- unless in_cart_steps contains needle -%}
                {%- for product in upsell_source.products limit: 12 -%}
                  {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
                  {%- assign ps = ps | strip | plus: 0 -%}
                  {%- if ps == s and product.available -%}
                    {%- assign v = product.selected_or_first_available_variant -%}
                    {%- assign cutout = product.metafields.bts.cutout.value -%}
                    <li class="cart-upsell__item" data-step="{{ s }}">
                      {%- assign uk = 'bts-' | append: product.handle | append: '-studio.jpg' -%}{%- assign up_studio = images[uk] -%}{%- if up_studio == blank -%}{%- assign up_studio = false -%}{%- endif -%}
                      <span class="cart-upsell__img{% if up_studio %} cart-upsell__img--photo{% endif %}" aria-hidden="true">
                        {%- if up_studio -%}
                          {{ up_studio | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '64px', alt: '' }}
                        {%- elsif cutout -%}
                          {{ cutout | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '52px', alt: '' }}
                        {%- elsif product.featured_media -%}
                          {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '52px', alt: '' }}
                        {%- endif -%}
                      </span>
                      <span>
                        <span class="step-tag">{{ 'product.step' | t: number: s }}</span><br>
                        <a href="{{ product.url }}" class="cart-upsell__name">{{ product.title | escape }}</a>
                        {%- if product.metafields.bts.benefit != blank -%}<span class="cart-upsell__why">{{ product.metafields.bts.benefit.value | split: '. ' | first | remove: '.' }}</span>{%- endif -%}
                      </span>
                      {%- unless v.price == 0 and settings.zero_price_coming_soon -%}
                        <product-form>
                          <form method="post" action="{{ routes.cart_add_url }}">
                            <input type="hidden" name="id" value="{{ v.id }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn--secondary btn--small" aria-label="{{ 'cart.add_item' | t: product: product.title  }}">
                              <span class="btn__label">{{ 'cart.add_short' | t }} · {% render 'egp', cents: v.price %}</span>
                            </button>
                          </form>
                        </product-form>
                      {%- endunless -%}
                    </li>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if upsell_items != blank -%}
            <div class="cart-upsell">
              <p class="t-subheading">{{ 'cart.complete_routine' | t }}</p>
              <ul class="cart-lines" role="list" style="gap:12px">{{ upsell_items }}</ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__foot">
        <form action="{{ routes.cart_url }}" method="post" class="cart-totals">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-totals__row t-small" style="color:var(--c-success)">
              <span>{{ discount.title | escape }}</span><span>−{% render 'egp', cents: discount.total_allocated_amount %}</span>
            </div>
          {%- endfor -%}
          <div class="cart-totals__row">
            <span class="t-subheading">{{ 'cart.subtotal' | t }}</span>
            <span class="cart-totals__subtotal">{% render 'egp', cents: cart.total_price %}</span>
          </div>
          <p class="cart-note-line">{% render 'cart-ship-note' %}</p>
          {%- if settings.show_cod -%}
            <p class="cart-note-line cart-note-line--icon">{% render 'icon', name: 'cash', class: 'icon--sm' %}<span>{{ 'cart.cod_available' | t }}</span></p>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn btn--checkout u-mt-s">
            <span class="btn--checkout__label">{% render 'icon', name: 'lock', class: 'icon--sm' %}{{ 'cart.checkout' | t }}</span>
            <span class="btn--checkout__total">{% render 'egp', cents: cart.total_price %}</span>
          </button>
          <a class="cart-drawer__full" href="{{ routes.cart_url }}">{{ 'cart.view_full' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
          {%- render 'payment-icons', class: 'u-mt-s' -%}
        </form>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
