{%- if section.settings.show -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    <div class="container announcement__inner">
      {%- if section.blocks.size == 0 -%}
        {%- comment -%} Free-delivery line only when a threshold is set (Theme settings → Offers); it must mirror the shipping rates. {%- endcomment -%}
        {%- if settings.free_shipping_threshold > 0 -%}
          {%- assign fs_cents = settings.free_shipping_threshold | times: 100 -%}
          {%- capture fs_amt -%}{% render 'egp', cents: fs_cents %}{%- endcapture -%}
          <p>{{ 'announcement.free_delivery' | t: amount: fs_amt }}</p>
          <span class="announcement__dot announcement__wide" aria-hidden="true"></span>
          <p class="announcement__wide">{% if section.settings.t_announcement_default_1 != blank %}{{ section.settings.t_announcement_default_1 }}{% else %}{{ 'announcement.default_1' | t }}{% endif %}</p>
        {%- else -%}
          <p>{% if section.settings.t_announcement_default_1 != blank %}{{ section.settings.t_announcement_default_1 }}{% else %}{{ 'announcement.default_1' | t }}{% endif %}</p>
          <span class="announcement__dot" aria-hidden="true"></span>
          <p>{% if section.settings.t_announcement_default_2 != blank %}{{ section.settings.t_announcement_default_2 }}{% else %}{{ 'announcement.default_2' | t }}{% endif %}</p>
        {%- endif -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 -%}<span class="announcement__dot" aria-hidden="true"></span>{%- endif -%}
        <p {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "checkbox",
      "id": "show",
      "label": "t:sections.announcement.show",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:sections.announcement.fallback_info"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_announcement_default_1",
      "label": "Default 1",
      "info": "Now: “Climate-adapted skincare”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_announcement_default_2",
      "label": "Default 2",
      "info": "Now: “Made in Egypt”. Leave empty to keep it (English and Arabic)."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement.message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement.text",
          "info": "t:sections.announcement.text_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement.name"
    }
  ]
}
{% endschema %}
