{%- if section.settings.show -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    <div class="container announcement__inner">
      {%- if section.blocks.size == 0 -%}
        {%- comment -%} Free-delivery line only when a threshold is set (Theme settings → Offers); it must mirror the shipping rates. {%- endcomment -%}
        {%- if settings.free_shipping_threshold > 0 -%}
          {%- assign fs_cents = settings.free_shipping_threshold | times: 100 -%}
          {%- capture fs_amt -%}{% render 'egp', cents: fs_cents %}{%- endcapture -%}
          <p>{{ 'announcement.free_delivery' | t: amount: fs_amt }}</p>
          <span class="announcement__dot announcement__wide" aria-hidden="true"></span>
          <p class="announcement__wide">{{ 'announcement.default_1' | t }}</p>
        {%- else -%}
          <p>{{ 'announcement.default_1' | t }}</p>
          <span class="announcement__dot" aria-hidden="true"></span>
          <p>{{ 'announcement.default_2' | t }}</p>
        {%- endif -%}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 -%}<span class="announcement__dot" aria-hidden="true"></span>{%- endif -%}
        <p {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "show", "label": "t:sections.announcement.show", "default": true },
    { "type": "paragraph", "content": "t:sections.announcement.fallback_info" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement.message",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.announcement.text", "info": "t:sections.announcement.text_info" },
        { "type": "url", "id": "link", "label": "t:sections.announcement.link" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.announcement.name" }]
}
{% endschema %}
