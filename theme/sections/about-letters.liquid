    </li>
    <li class="al-p" style="--i: 5; --m: var(--al-E); --bx: 45%; --by: 40%">
      <button type="button" class="al-b" aria-expanded="false" aria-label="20:00. Humid evenings. Sticky air, shiny skin.">
        <span class="al-ph" style="background-image: url('{{ 'bts-climate-humidity-tall.jpg' | file_img_url: '1400x' }}')"></span>
        <span class="al-full" style="background-image: url('{{ 'bts-climate-humidity-tall.jpg' | file_img_url: '1400x' }}')"></span>
