  </ol>
  <div class="al-foot">
    <p class="al-end">Today’s sun</p>
    <p class="al-cap">Between two suns, a whole day happens to your skin. <span data-hint>Open a letter.</span></p>
    <p class="al-end al-end--b">Tomorrow’s sun</p>
  </div>
</section>
<script>
(() => {
  const el = document.currentScript.previousElementSibling; if (!el || !el.matches('[data-al]')) return;
  const row = el.querySelector('[data-row]'), panels = [...row.children];
  const touch = matchMedia('(hover: none)').matches;
  const hint = el.querySelector('[data-hint]'); if (hint) hint.textContent = touch ? 'Tap a letter.' : 'Open a letter.';
  const open = (p) => { panels.forEach((x) => { const on = x === p; x.classList.toggle('is-open', on); x.firstElementChild.setAttribute('aria-expanded', String(on)); }); row.classList.toggle('has-open', !!p); };
  panels.forEach((p) => {
    const b = p.firstElementChild;
    if (!touch) { p.addEventListener('pointerenter', () => open(p)); b.addEventListener('focus', () => open(p)); }
    b.addEventListener('click', () => open(touch && p.classList.contains('is-open') ? null : p));
  });
  if (!touch) row.addEventListener('pointerleave', () => { if (!row.contains(document.activeElement)) open(null); });
  document.addEventListener('pointerdown', (e) => { if (!row.contains(e.target)) open(null); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(null); });
  // the letters are windows: the pictures shift a little with the pointer
  if (!touch && !matchMedia('(prefers-reduced-motion: reduce)').matches) el.addEventListener('pointermove', (e) => { row.style.setProperty('--par', (e.clientX / innerWidth * 2 - 1).toFixed(3)); });
})();
</script>

