{{ 'pages.css' | asset_url | stylesheet_tag }}
<section class="notfound" aria-labelledby="NotFoundTitle">
  <div class="suns" aria-hidden="true"><span class="sun sun--warm notfound__sun-a"></span><span class="sun sun--cool notfound__sun-b"></span></div>
  <div class="container notfound__inner">
    <p class="notfound__code t-display-xl" aria-hidden="true">404</p>
    <h1 class="t-display-m" id="NotFoundTitle">{% if section.settings.t_errors_404_title != blank %}{{ section.settings.t_errors_404_title }}{% else %}{{ 'errors.404_title' | t }}{% endif %}</h1>
    <p class="t-lead">{% if section.settings.t_errors_404_text != blank %}{{ section.settings.t_errors_404_text }}{% else %}{{ 'errors.404_text' | t }}{% endif %}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label class="visually-hidden" for="NotFoundSearch">{% if section.settings.t_search_label != blank %}{{ section.settings.t_search_label }}{% else %}{{ 'search.label' | t }}{% endif %}</label>
      <input id="NotFoundSearch" class="search-modal__input" type="search" name="q" placeholder="{% if section.settings.t_search_placeholder != blank %}{{ section.settings.t_search_placeholder }}{% else %}{{ 'search.placeholder' | t }}{% endif %}">
      <button type="submit" class="btn btn--secondary">{% if section.settings.t_search_submit != blank %}{{ section.settings.t_search_submit }}{% else %}{{ 'search.submit' | t }}{% endif %}</button>
    </form>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{% if section.settings.t_errors_404_cta != blank %}{{ section.settings.t_errors_404_cta }}{% else %}{{ 'errors.404_cta' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_errors_404_title",
      "label": "Errors · Title",
      "info": "Now: “This page went out in the sun.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "textarea",
      "id": "t_errors_404_text",
      "label": "Errors · Paragraph",
      "info": "Now: “We couldn’t find what you were looking for. Try exploring the routine or searching for a product.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_search_label",
      "label": "Search · Label",
      "info": "Now: “Search the store”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_search_placeholder",
      "label": "Search · Box hint text",
      "info": "Now: “Search products or ingredients”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_search_submit",
      "label": "Search · Submit",
      "info": "Now: “Search”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_errors_404_cta",
      "label": "Errors · Button text",
      "info": "Now: “Shop the routine”. Leave empty to keep it (English and Arabic)."
    }
  ]
}
{% endschema %}
