{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  comment
    DECISIONS 245: the story page in the journal card's language. Topic and reading time over a large title, the
    summary as the lede, the photo wide, then a 680 px reading column; numbered lists are the routine steps.
  endcomment
  assign ar_topic = ''
  for tg in article.tags
    assign tgh = tg | handle
    unless tgh contains 'step-'
      assign ar_topic = tg
      comment
        A topic is shown in the page's language when blog.topics has it ("Routine" → "روتين"); otherwise as tagged
      endcomment
      assign tk = 'blog.topics.' | append: tgh
      assign tt = tk | t
      unless tt contains 'ranslation missing' or tt == tk
        assign ar_topic = tt
      endunless
      break
    endunless
  endfor
  assign ar_words = article.content | strip_html | split: ' ' | size
  assign ar_min = ar_words | divided_by: 200 | floor | plus: 1
-%}
<article class="article" aria-labelledby="ArticleTitle">
  <header class="article__head">
    <div class="container article__head-inner">
      <a class="link-arrow article__back" href="{{ blog.url }}">{% render 'icon', name: 'arrow', class: 'icon--sm icon--flip article__back-icon' %} {{ 'blog.back' | t }}</a>
      <p class="article-card__meta">{% if ar_topic != blank %}{{ ar_topic | escape }}<span aria-hidden="true"> · </span>{% endif %}{{ 'blog.minutes' | t: count: ar_min }}</p>
      <h1 class="t-display-l article__title" id="ArticleTitle">{{ article.title | escape }}</h1>
      {%- if article.excerpt != blank -%}<p class="t-lead article__lede">{{ article.excerpt | strip_html }}</p>{%- endif -%}
      <p class="article__date">{{ article.published_at | time_tag: format: 'date' }}</p>
    </div>
  </header>
  {%- if article.image -%}
    <figure class="container article__image">
      {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000', sizes: '(min-width: 1400px) 1300px, 94vw', alt: article.image.alt | default: '' }}
    </figure>
  {%- endif -%}
  <div class="article__main">
    <div class="container article__col">
      <div class="rte article__body">{{ article.content }}</div>
    </div>
  </div>
</article>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": { "@type": "Organization", "name": "Between Two Suns" },
    "publisher": { "@type": "Organization", "name": "Between Two Suns" },
    "mainEntityOfPage": {{ request.origin | append: article.url | json }}
  }
</script>

{% schema %}
{ "name": "t:sections.main_article.name", "settings": [] }
{% endschema %}
