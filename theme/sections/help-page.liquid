{{ 'help.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Help pages (DECISIONS 256): Shipping and Returns in one designed layout, demo at /pages/shipping?view=help and
  /pages/returns?view=help. The words are the page's own (the legal text in admin, EN/AR), shown unchanged; the design
  adds what a reader needs in five seconds before it starts:
  - a header with the help area's tabs (Shipping · Returns · FAQ · Contact),
  - three facts in the step colours; on Returns, "How it works" in three steps on the brand's dotted line (Shipping has
    none: its steps only repeated the facts, DECISIONS 258),
  - the full policy as numbered sections with an "On this page" list on laptops, its tables as cards.
  The numbers (free-delivery threshold, fees, days, cash on delivery) come from the theme settings that checkout copy
  and the FAQ use, so they cannot drift apart. Any other page handle gets the header, tabs and styled text only.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url | remove_last: '/'
  assign kind = 'other'
  if page.handle contains 'shipping' or page.handle contains 'delivery'
    assign kind = 'shipping'
  elsif page.handle contains 'return' or page.handle contains 'refund'
    assign kind = 'returns'
  endif
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  capture free_from
    render 'egp', cents: threshold
  endcapture
  assign free_from = free_from | strip
  # word joiners keep "1–3" on one line
  assign days_main = settings.delivery_days_main | default: '1–3' | replace: '–', '⁠–⁠'
  assign days_other = settings.delivery_days_other | default: '3–5' | replace: '–', '⁠–⁠'
  assign parts = page.content | split: '<h2>'
-%}
<section class="help" data-kind="{{ kind }}">
  <div class="container help__head">
    <p class="t-eyebrow">{% if section.settings.t_help_eyebrow != blank %}{{ section.settings.t_help_eyebrow }}{% else %}{{ 'help.eyebrow' | t }}{% endif %}</p>
    <h1 class="t-display-l help__title">{{ page.title | escape }}</h1>
    {%- if kind == 'shipping' -%}
      <p class="t-lead help__lead">{% if section.settings.t_help_shipping_lead != blank %}{{ section.settings.t_help_shipping_lead }}{% else %}{{ 'help.shipping.lead' | t }}{% endif %}</p>
    {%- elsif kind == 'returns' -%}
      <p class="t-lead help__lead">{% if section.settings.t_help_returns_lead != blank %}{{ section.settings.t_help_returns_lead }}{% else %}{{ 'help.returns.lead' | t }}{% endif %}</p>
    {%- endif -%}
    <nav class="help__tabs" aria-label="{% if section.settings.t_help_nav != blank %}{{ section.settings.t_help_nav }}{% else %}{{ 'help.nav' | t }}{% endif %}">
      <a href="{{ root }}/pages/shipping"{% if kind == 'shipping' %} aria-current="page"{% endif %}>{% render 'icon', name: 'truck', class: 'icon--sm' %}{% if section.settings.t_footer_links_shipping != blank %}{{ section.settings.t_footer_links_shipping }}{% else %}{{ 'footer.links.shipping' | t }}{% endif %}</a>
      <a href="{{ root }}/pages/returns"{% if kind == 'returns' %} aria-current="page"{% endif %}>{% render 'icon', name: 'refresh', class: 'icon--sm' %}{% if section.settings.t_footer_links_returns != blank %}{{ section.settings.t_footer_links_returns }}{% else %}{{ 'footer.links.returns' | t }}{% endif %}</a>
      <a href="{{ root }}/pages/faq">{% render 'icon', name: 'info', class: 'icon--sm' %}{% if section.settings.t_footer_links_faq != blank %}{{ section.settings.t_footer_links_faq }}{% else %}{{ 'footer.links.faq' | t }}{% endif %}</a>
      <a href="{{ root }}/pages/contact">{% render 'icon', name: 'mail', class: 'icon--sm' %}{% if section.settings.t_footer_links_contact != blank %}{{ section.settings.t_footer_links_contact }}{% else %}{{ 'footer.links.contact' | t }}{% endif %}</a>
    </nav>
  </div>

  {%- if kind != 'other' -%}
    <div class="container">
      <ul class="help__facts" role="list">
        {%- if kind == 'shipping' -%}
          <li class="help__fact" data-step="1">{% render 'icon', name: 'truck' %}<strong>{% if section.settings.t_help_shipping_f1 != blank %}{{ section.settings.t_help_shipping_f1 }}{% else %}{{ 'help.shipping.f1' | t }}{% endif %}</strong><span>{{ 'help.shipping.f1_sub' | t: amount: free_from }}</span></li>
          <li class="help__fact" data-step="2">{% render 'icon', name: 'city' %}<strong>{{ 'help.shipping.f2' | t: days: days_main }}</strong><span>{{ 'help.shipping.f2_sub' | t: days: days_other }}</span></li>
          {%- if settings.show_cod -%}
            <li class="help__fact" data-step="4">{% render 'icon', name: 'cash' %}<strong>{% if section.settings.t_help_shipping_f3_cod != blank %}{{ section.settings.t_help_shipping_f3_cod }}{% else %}{{ 'help.shipping.f3_cod' | t }}{% endif %}</strong><span>{% if section.settings.t_help_shipping_f3_cod_sub != blank %}{{ section.settings.t_help_shipping_f3_cod_sub }}{% else %}{{ 'help.shipping.f3_cod_sub' | t }}{% endif %}</span></li>
          {%- else -%}
            <li class="help__fact" data-step="4">{% render 'icon', name: 'refresh' %}<strong>{% if section.settings.t_help_shipping_f3_dmg != blank %}{{ section.settings.t_help_shipping_f3_dmg }}{% else %}{{ 'help.shipping.f3_dmg' | t }}{% endif %}</strong><span>{% if section.settings.t_help_shipping_f3_dmg_sub != blank %}{{ section.settings.t_help_shipping_f3_dmg_sub }}{% else %}{{ 'help.shipping.f3_dmg_sub' | t }}{% endif %}</span></li>
          {%- endif -%}
        {%- else -%}
          <li class="help__fact" data-step="1">{% render 'icon', name: 'refresh' %}<strong>{% if section.settings.t_help_returns_f1 != blank %}{{ section.settings.t_help_returns_f1 }}{% else %}{{ 'help.returns.f1' | t }}{% endif %}</strong><span>{% if section.settings.t_help_returns_f1_sub != blank %}{{ section.settings.t_help_returns_f1_sub }}{% else %}{{ 'help.returns.f1_sub' | t }}{% endif %}</span></li>
          <li class="help__fact" data-step="2">{% render 'icon', name: 'check' %}<strong>{% if section.settings.t_help_returns_f2 != blank %}{{ section.settings.t_help_returns_f2 }}{% else %}{{ 'help.returns.f2' | t }}{% endif %}</strong><span>{% if section.settings.t_help_returns_f2_sub != blank %}{{ section.settings.t_help_returns_f2_sub }}{% else %}{{ 'help.returns.f2_sub' | t }}{% endif %}</span></li>
          <li class="help__fact" data-step="4">{% render 'icon', name: 'cash' %}<strong>{% if section.settings.t_help_returns_f3 != blank %}{{ section.settings.t_help_returns_f3 }}{% else %}{{ 'help.returns.f3' | t }}{% endif %}</strong><span>{% if section.settings.t_help_returns_f3_sub != blank %}{{ section.settings.t_help_returns_f3_sub }}{% else %}{{ 'help.returns.f3_sub' | t }}{% endif %}</span></li>
        {%- endif -%}
      </ul>

      {%- if kind == 'returns' -%}
      <div class="help__how">
        <h2 class="t-display-m">{% if section.settings.t_help_how != blank %}{{ section.settings.t_help_how }}{% else %}{{ 'help.how' | t }}{% endif %}</h2>
        <ol class="help__steps" role="list">
          {%- for n in (1..3) -%}
            {%- assign sk = 'help.' | append: kind | append: '.s' | append: n -%}
            {%- assign st = sk | append: '_t' -%}
            {%- assign sd = sk | append: '_d' -%}
            <li class="help__step" data-step="{% if n == 3 %}4{% else %}{{ n }}{% endif %}">
              <span class="help__num" aria-hidden="true">0{{ n }}</span>
              <strong>{{ st | t }}</strong>
              <span>{{ sd | t }}</span>
            </li>
          {%- endfor -%}
        </ol>
      </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="container help__body">
    {%- if parts.size > 1 -%}
      <nav class="help__toc" aria-label="{% if section.settings.t_help_toc != blank %}{{ section.settings.t_help_toc }}{% else %}{{ 'help.toc' | t }}{% endif %}">
        <p class="t-eyebrow">{% if section.settings.t_help_toc != blank %}{{ section.settings.t_help_toc }}{% else %}{{ 'help.toc' | t }}{% endif %}</p>
        <ol role="list">
          {%- for part in parts offset: 1 -%}
            {%- assign head = part | split: '</h2>' | first | strip_html | strip -%}
            <li><a href="#help-{{ forloop.index }}">{{ head }}</a></li>
          {%- endfor -%}
        </ol>
      </nav>
      <div class="help__text rte">
        {%- if parts[0] != blank -%}<div class="help__intro">{{ parts[0] }}</div>{%- endif -%}
        {%- for part in parts offset: 1 -%}
          {%- assign head = part | split: '</h2>' | first -%}
          {%- assign rest = part | remove_first: head | remove_first: '</h2>' -%}
          <section class="help__part" id="help-{{ forloop.index }}" aria-labelledby="help-h-{{ forloop.index }}">
            <h2 id="help-h-{{ forloop.index }}"><span class="help__pn" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ head }}</h2>
            {{ rest }}
          </section>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="help__text rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

