{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign entries = shop.metaobjects.bts_ingredient.values
  assign source = section.settings.collection | default: collections.all
-%}
<section class="section glossary" aria-label="{{ 'header.nav.ingredients' | t }}">
  <div class="container">
    <nav class="glossary__jump" aria-label="{{ 'pages.ingredients.jump_label' | t }}">
      <ul class="cluster" role="list">
        {%- if entries.size > 0 -%}<li><a class="chip" href="#key-ingredients">{{ 'pages.ingredients.key_heading' | t }}</a></li>{%- endif -%}
        <li><a class="chip" href="#all-ingredients">{{ 'pages.ingredients.az_heading' | t }}</a></li>
        <li><a class="chip" href="#full-lists">{{ 'pages.ingredients.full_lists' | t }}</a></li>
      </ul>
    </nav>
    {%- if entries.size > 0 -%}
      <div class="glossary__block" id="key-ingredients">
        <div class="glossary__head">
          <h2 class="t-display-m">{{ 'pages.ingredients.key_heading' | t }}</h2>
          <p class="t-muted">{{ 'pages.ingredients.key_text' | t }}</p>
        </div>
        <ul class="glossary__grid" role="list">
          {%- for entry in entries -%}
            <li class="glossary__item" id="ing-{{ entry.system.handle | default: entry.handle }}">
              <div class="ing-tile__dots" aria-hidden="true">
                {%- for p in entry.products.value -%}
                  {%- capture step -%}{% render 'product-step', product: p %}{%- endcapture -%}
                  <span data-step="{{ step | strip }}"></span>
                {%- endfor -%}
              </div>
              <h3 class="glossary__name">{{ entry.name.value | escape }}</h3>
              <p class="glossary__inci"><span class="t-muted">{{ 'pages.ingredients.inci_label' | t }}:</span> <span lang="en" dir="ltr">{{ entry.inci.value | escape }}</span></p>
              <p>{{ entry.role.value | escape }}</p>
              {%- if entry.products.value.size > 0 -%}
                <p class="t-small"><span class="t-muted">{{ 'pages.ingredients.in_products' | t }}:</span>
                  {% for p in entry.products.value -%}<a href="{{ p.url }}">{{ p.title | escape }}</a>{% unless forloop.last %}, {% endunless %}{%- endfor %}
                </p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- paginate shop.metaobjects.bts_inci.values by 250 -%}
      {%- assign all = shop.metaobjects.bts_inci.values -%}
      {%- if all.size > 0 -%}
        {%- comment -%} Sort A–Z by INCI name whatever order the API returns: key§row¶ strings. {%- endcomment -%}
        {%- capture rows -%}
          {%- for e in all -%}
            {%- assign handle = e.system.handle | default: e.handle -%}
            {%- assign group_key = 'pages.ingredients.groups.' | append: e.group.value -%}
            {%- capture handles -%}{% for p in e.products.value %}{{ p.handle }} {% endfor %}{%- endcapture -%}
            {{- e.inci.value | downcase -}}§
            <li class="dict__row" id="inci-{{ handle }}" data-products="{{ handles | strip }}" data-search="{{ e.inci.value | downcase | escape }} {{ e.name.value | downcase | escape }}">
              <div class="dict__name">
                <h3 class="dict__inci" lang="en" dir="ltr">{{ e.inci.value | escape }}</h3>
                {%- assign common = e.name.value | strip -%}
                {%- assign common_d = common | downcase -%}
                {%- assign inci_d = e.inci.value | downcase -%}
                {%- if common != blank and common_d != inci_d -%}<p class="dict__common">{{ common | escape }}</p>{%- endif -%}
              </div>
              <p class="dict__group"><span class="visually-hidden">{{ 'pages.ingredients.function_label' | t }}: </span><span class="pill pill--quiet">{{ group_key | t }}</span></p>
              <p class="dict__desc">{{ e.description.value | escape }}</p>
              <div class="dict__in">
                <span class="visually-hidden">{{ 'pages.ingredients.in_products' | t }}:</span>
                <ul class="dict__products" role="list">
                  {%- for p in e.products.value -%}
                    {%- capture step -%}{% render 'product-step', product: p %}{%- endcapture -%}
                    <li><a href="{{ p.url }}" class="dict__product" data-step="{{ step | strip }}"><span class="dict__dot" aria-hidden="true"></span>{{ p.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- assign key = e.key_ingredient.value -%}
                {%- if key -%}
                  <a class="dict__key" href="#ing-{{ key.system.handle | default: key.handle }}">{{ 'pages.ingredients.key_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
                {%- endif -%}
              </div>
            </li>¶
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign sorted = rows | split: '¶' | sort -%}

        <div class="glossary__block dict" id="all-ingredients">
          <div class="glossary__head">
            <h2 class="t-display-m">{{ 'pages.ingredients.az_heading' | t }}</h2>
            <p class="t-muted">{{ 'pages.ingredients.az_text' | t: count: all.size }}</p>
          </div>

          <ingredient-filter class="dict__filter js-only">
            <label class="field">
              <span class="field__label">{{ 'pages.ingredients.search_label' | t }}</span>
              <input type="search" placeholder="{{ 'pages.ingredients.search_placeholder' | t }}" data-filter-input autocomplete="off">
            </label>
            <div class="cluster dict__chips" role="group" aria-label="{{ 'pages.ingredients.filter_products' | t }}">
              <button type="button" class="chip" data-product="" aria-pressed="true">{{ 'pages.ingredients.filter_all' | t }}</button>
              {%- for s in (1..4) -%}
                {%- for p in source.products limit: 12 -%}
                  {%- capture ps -%}{% render 'product-step', product: p %}{%- endcapture -%}
                  {%- assign ps = ps | strip | plus: 0 -%}
                  {%- if ps == s -%}
                    <button type="button" class="chip" data-product="{{ p.handle }}" data-step="{{ s }}" aria-pressed="false"><span class="dict__dot" aria-hidden="true"></span>{{ p.title | escape }}</button>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
            <p class="t-small t-muted dict__count" role="status" data-filter-count data-template="{{ 'pages.ingredients.count' | t: count: '__COUNT__' | escape }}">{{ 'pages.ingredients.count' | t: count: all.size }}</p>
          </ingredient-filter>

          <ol class="dict__list" role="list" data-glossary>
            {%- for r in sorted -%}
              {%- assign parts = r | split: '§' -%}
              {%- if parts.size > 1 -%}{{ parts.last }}{%- endif -%}
            {%- endfor -%}
          </ol>
          <p class="t-muted dict__empty" data-filter-empty hidden>{{ 'pages.ingredients.no_results' | t }}</p>
          <p class="t-xs t-muted dict__note">{{ 'pages.ingredients.groups_note' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

    <div class="glossary__inci-all" id="full-lists">
      <h2 class="t-display-m">{{ 'pages.ingredients.full_lists' | t }}</h2>
      <p class="t-muted">{{ 'pages.ingredients.full_lists_text' | t }}</p>
      {%- for s in (1..4) -%}
        {%- for p in source.products limit: 12 -%}
          {%- capture ps -%}{% render 'product-step', product: p %}{%- endcapture -%}
          {%- assign ps = ps | strip | plus: 0 -%}
          {%- if ps == s and p.metafields.bts.inci != blank -%}
            <details class="accordion" data-step="{{ s }}">
              <summary><span><span class="step-tag">{{ 'product.step' | t: number: s }}</span><br>{{ p.title | escape }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
              <div class="accordion__content">
                {%- render 'inci-links', inci: p.metafields.bts.inci.value, base: '' -%}
                <a class="link-arrow" href="{{ p.url }}">{{ 'product.view_full' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
              </div>
            </details>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="module">
  class IngredientFilter extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('[data-filter-input]');
      const count = this.querySelector('[data-filter-count]');
      const chips = [...this.querySelectorAll('[data-product]')];
      const scope = this.closest('.dict') || document;
      const items = [...scope.querySelectorAll('[data-glossary] > li')];
      const empty = scope.querySelector('[data-filter-empty]');
      let product = '';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let n = 0;
        items.forEach((li) => {
          const inProduct = !product || li.dataset.products.split(' ').includes(product);
          const matches = !q || li.dataset.search.includes(q) || li.textContent.toLowerCase().includes(q);
          li.hidden = !(inProduct && matches);
          if (!li.hidden) n++;
        });
        count.textContent = count.dataset.template.replace('__COUNT__', n);
        if (empty) empty.hidden = n > 0;
      };
      input.addEventListener('input', apply);
      chips.forEach((chip) => chip.addEventListener('click', () => {
        product = chip.dataset.product;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      }));
      // Deep link from a PDP (#inci-…): make sure the target row is visible.
      const reveal = () => {
        const target = location.hash && scope.querySelector(location.hash.replace(/[^#\w-]/g, ''));
        if (target && target.hidden) { input.value = ''; chips[0]?.click(); }
      };
      window.addEventListener('hashchange', reveal);
    }
  }
  if (!customElements.get('ingredient-filter')) customElements.define('ingredient-filter', IngredientFilter);
</script>

{% schema %}
{
  "name": "t:sections.glossary.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.ingredients.info" },
    { "type": "collection", "id": "collection", "label": "t:sections.routine.collection" }
  ],
  "presets": [{ "name": "t:sections.glossary.name" }]
}
{% endschema %}
