{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign entries = shop.metaobjects.bts_ingredient.values
  assign source = section.settings.collection | default: collections.all
-%}
<section class="section glossary{% if section.settings.reference %} glossary--ref{% endif %}" aria-label="{% if section.settings.t_header_nav_ingredients != blank %}{{ section.settings.t_header_nav_ingredients }}{% else %}{{ 'header.nav.ingredients' | t }}{% endif %}">
  <div class="container">
    {%- if section.settings.reference -%}
      <div class="glossary__ref-head">
        <p class="t-eyebrow">{% if section.settings.t_pages_ingredients_ref_eyebrow != blank %}{{ section.settings.t_pages_ingredients_ref_eyebrow }}{% else %}{{ 'pages.ingredients.ref_eyebrow' | t }}{% endif %}</p>
        <h2 class="t-display-m">{% if section.settings.t_pages_ingredients_ref_heading != blank %}{{ section.settings.t_pages_ingredients_ref_heading }}{% else %}{{ 'pages.ingredients.ref_heading' | t }}{% endif %}</h2>
        <p class="t-lead t-muted">{% if section.settings.t_pages_ingredients_ref_text != blank %}{{ section.settings.t_pages_ingredients_ref_text }}{% else %}{{ 'pages.ingredients.ref_text' | t }}{% endif %}</p>
      </div>
      <details class="glossary__ref" id="all-ingredients-ref">
        <summary class="btn btn--secondary glossary__ref-btn"><span data-closed>{% if section.settings.t_pages_ingredients_ref_open != blank %}{{ section.settings.t_pages_ingredients_ref_open }}{% else %}{{ 'pages.ingredients.ref_open' | t }}{% endif %}</span><span data-open>{% if section.settings.t_pages_ingredients_ref_close != blank %}{{ section.settings.t_pages_ingredients_ref_close }}{% else %}{{ 'pages.ingredients.ref_close' | t }}{% endif %}</span>{% render 'icon', name: 'chevron-down', class: 'icon--sm' %}</summary>
    {%- else -%}
    <nav class="glossary__jump" aria-label="{% if section.settings.t_pages_ingredients_jump_label != blank %}{{ section.settings.t_pages_ingredients_jump_label }}{% else %}{{ 'pages.ingredients.jump_label' | t }}{% endif %}">
      <ul class="cluster" role="list">
        {%- if entries.size > 0 -%}<li><a class="chip" href="#key-ingredients">{% if section.settings.t_pages_ingredients_key_heading != blank %}{{ section.settings.t_pages_ingredients_key_heading }}{% else %}{{ 'pages.ingredients.key_heading' | t }}{% endif %}</a></li>{%- endif -%}
        <li><a class="chip" href="#all-ingredients">{% if section.settings.t_pages_ingredients_az_heading != blank %}{{ section.settings.t_pages_ingredients_az_heading }}{% else %}{{ 'pages.ingredients.az_heading' | t }}{% endif %}</a></li>
        <li><a class="chip" href="#full-lists">{% if section.settings.t_pages_ingredients_full_lists != blank %}{{ section.settings.t_pages_ingredients_full_lists }}{% else %}{{ 'pages.ingredients.full_lists' | t }}{% endif %}</a></li>
      </ul>
    </nav>
    {%- endif -%}
    {%- if entries.size > 0 and section.settings.reference != true -%}
      <div class="glossary__block" id="key-ingredients">
        <div class="glossary__head">
          <h2 class="t-display-m">{% if section.settings.t_pages_ingredients_key_heading != blank %}{{ section.settings.t_pages_ingredients_key_heading }}{% else %}{{ 'pages.ingredients.key_heading' | t }}{% endif %}</h2>
          <p class="t-muted">{% if section.settings.t_pages_ingredients_key_text != blank %}{{ section.settings.t_pages_ingredients_key_text }}{% else %}{{ 'pages.ingredients.key_text' | t }}{% endif %}</p>
        </div>
        <ul class="glossary__grid" role="list">
          {%- for entry in entries -%}
            <li class="glossary__item" id="ing-{{ entry.system.handle | default: entry.handle }}">
              <div class="ing-tile__dots" aria-hidden="true">
                {%- for p in entry.products.value -%}
                  {%- capture step -%}{% render 'product-step', product: p %}{%- endcapture -%}
                  <span data-step="{{ step | strip }}"></span>
                {%- endfor -%}
              </div>
              <h3 class="glossary__name">{{ entry.name.value | escape }}</h3>
              <p class="glossary__inci"><span class="t-muted">{% if section.settings.t_pages_ingredients_inci_label != blank %}{{ section.settings.t_pages_ingredients_inci_label }}{% else %}{{ 'pages.ingredients.inci_label' | t }}{% endif %}:</span> <span lang="en" dir="ltr">{{ entry.inci.value | escape }}</span></p>
              <p>{{ entry.role.value | escape }}</p>
              {%- if entry.products.value.size > 0 -%}
                <p class="t-small"><span class="t-muted">{% if section.settings.t_pages_ingredients_in_products != blank %}{{ section.settings.t_pages_ingredients_in_products }}{% else %}{{ 'pages.ingredients.in_products' | t }}{% endif %}:</span>
                  {% for p in entry.products.value -%}<a href="{{ p.url }}">{{ p.title | escape }}</a>{% unless forloop.last %}, {% endunless %}{%- endfor %}
                </p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- paginate shop.metaobjects.bts_inci.values by 250 -%}
      {%- assign all = shop.metaobjects.bts_inci.values -%}
      {%- if all.size > 0 -%}
        {%- comment -%} Sort A–Z by INCI name whatever order the API returns: key§row¶ strings. {%- endcomment -%}
        {%- capture rows -%}
          {%- for e in all -%}
            {%- assign handle = e.system.handle | default: e.handle -%}
            {%- assign group_key = 'pages.ingredients.groups.' | append: e.group.value -%}
            {%- capture handles -%}{% for p in e.products.value %}{{ p.handle }} {% endfor %}{%- endcapture -%}
            {{- e.inci.value | downcase -}}§
            <li class="dict__row" id="inci-{{ handle }}" data-products="{{ handles | strip }}" data-search="{{ e.inci.value | downcase | escape }} {{ e.name.value | downcase | escape }}">
              <div class="dict__name">
                <h3 class="dict__inci" lang="en" dir="ltr">{{ e.inci.value | escape }}</h3>
                {%- assign common = e.name.value | strip -%}
                {%- assign common_d = common | downcase -%}
                {%- assign inci_d = e.inci.value | downcase -%}
                {%- if common != blank and common_d != inci_d -%}<p class="dict__common">{{ common | escape }}</p>{%- endif -%}
              </div>
              <p class="dict__group"><span class="visually-hidden">{% if section.settings.t_pages_ingredients_function_label != blank %}{{ section.settings.t_pages_ingredients_function_label }}{% else %}{{ 'pages.ingredients.function_label' | t }}{% endif %}: </span><span class="pill pill--quiet">{{ group_key | t }}</span></p>
              <p class="dict__desc">{{ e.description.value | escape }}</p>
              <div class="dict__in">
                <span class="visually-hidden">{% if section.settings.t_pages_ingredients_in_products != blank %}{{ section.settings.t_pages_ingredients_in_products }}{% else %}{{ 'pages.ingredients.in_products' | t }}{% endif %}:</span>
                <ul class="dict__products" role="list">
                  {%- for p in e.products.value -%}
                    {%- capture step -%}{% render 'product-step', product: p %}{%- endcapture -%}
                    <li><a href="{{ p.url }}" class="dict__product" data-step="{{ step | strip }}"><span class="dict__dot" aria-hidden="true"></span>{{ p.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- assign key = e.key_ingredient.value -%}
                {%- if key -%}
                  <a class="dict__key" href="#ing-{{ key.system.handle | default: key.handle }}">{% if section.settings.t_pages_ingredients_key_link != blank %}{{ section.settings.t_pages_ingredients_key_link }}{% else %}{{ 'pages.ingredients.key_link' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
                {%- endif -%}
              </div>
            </li>¶
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign sorted = rows | split: '¶' | sort -%}

        <div class="glossary__block dict" id="all-ingredients">
          <div class="glossary__head">
            <h2 class="t-display-m">{% if section.settings.t_pages_ingredients_az_heading != blank %}{{ section.settings.t_pages_ingredients_az_heading }}{% else %}{{ 'pages.ingredients.az_heading' | t }}{% endif %}</h2>
            <p class="t-muted">{{ 'pages.ingredients.az_text' | t: count: all.size }}</p>
          </div>

          <ingredient-filter class="dict__filter js-only">
            <label class="field">
              <span class="field__label">{% if section.settings.t_pages_ingredients_search_label != blank %}{{ section.settings.t_pages_ingredients_search_label }}{% else %}{{ 'pages.ingredients.search_label' | t }}{% endif %}</span>
              <input type="search" placeholder="{% if section.settings.t_pages_ingredients_search_placeholder != blank %}{{ section.settings.t_pages_ingredients_search_placeholder }}{% else %}{{ 'pages.ingredients.search_placeholder' | t }}{% endif %}" data-filter-input autocomplete="off">
            </label>
            <div class="cluster dict__chips" role="group" aria-label="{% if section.settings.t_pages_ingredients_filter_products != blank %}{{ section.settings.t_pages_ingredients_filter_products }}{% else %}{{ 'pages.ingredients.filter_products' | t }}{% endif %}">
              <button type="button" class="chip" data-product="" aria-pressed="true">{% if section.settings.t_pages_ingredients_filter_all != blank %}{{ section.settings.t_pages_ingredients_filter_all }}{% else %}{{ 'pages.ingredients.filter_all' | t }}{% endif %}</button>
              {%- for s in (1..4) -%}
                {%- for p in source.products limit: 12 -%}
                  {%- capture ps -%}{% render 'product-step', product: p %}{%- endcapture -%}
                  {%- assign ps = ps | strip | plus: 0 -%}
                  {%- if ps == s -%}
                    <button type="button" class="chip" data-product="{{ p.handle }}" data-step="{{ s }}" aria-pressed="false"><span class="dict__dot" aria-hidden="true"></span>{{ p.title | escape }}</button>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
            <p class="t-small t-muted dict__count" role="status" data-filter-count data-template="{{ 'pages.ingredients.count' | t: count: '__COUNT__'  }}">{{ 'pages.ingredients.count' | t: count: all.size }}</p>
          </ingredient-filter>

          <ol class="dict__list" role="list" data-glossary>
            {%- for r in sorted -%}
              {%- assign parts = r | split: '§' -%}
              {%- if parts.size > 1 -%}{{ parts.last }}{%- endif -%}
            {%- endfor -%}
          </ol>
          <p class="t-muted dict__empty" data-filter-empty hidden>{% if section.settings.t_pages_ingredients_no_results != blank %}{{ section.settings.t_pages_ingredients_no_results }}{% else %}{{ 'pages.ingredients.no_results' | t }}{% endif %}</p>
          <p class="t-xs t-muted dict__note">{% if section.settings.t_pages_ingredients_groups_note != blank %}{{ section.settings.t_pages_ingredients_groups_note }}{% else %}{{ 'pages.ingredients.groups_note' | t }}{% endif %}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

    <div class="glossary__inci-all" id="full-lists">
      <h2 class="t-display-m">{% if section.settings.t_pages_ingredients_full_lists != blank %}{{ section.settings.t_pages_ingredients_full_lists }}{% else %}{{ 'pages.ingredients.full_lists' | t }}{% endif %}</h2>
      <p class="t-muted">{% if section.settings.t_pages_ingredients_full_lists_text != blank %}{{ section.settings.t_pages_ingredients_full_lists_text }}{% else %}{{ 'pages.ingredients.full_lists_text' | t }}{% endif %}</p>
      {%- for s in (1..4) -%}
        {%- for p in source.products limit: 12 -%}
          {%- capture ps -%}{% render 'product-step', product: p %}{%- endcapture -%}
          {%- assign ps = ps | strip | plus: 0 -%}
          {%- if ps == s and p.metafields.bts.inci != blank -%}
            <details class="accordion" data-step="{{ s }}">
              <summary><span><span class="step-tag">{{ 'product.step' | t: number: s }}</span><br>{{ p.title | escape }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
              <div class="accordion__content">
                {%- render 'inci-links', inci: p.metafields.bts.inci.value, base: '' -%}
                <a class="link-arrow" href="{{ p.url }}">{% if section.settings.t_product_view_full != blank %}{{ section.settings.t_product_view_full }}{% else %}{{ 'product.view_full' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
              </div>
            </details>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.reference -%}</details>{%- endif -%}
  </div>
</section>
<script type="module">
  class IngredientFilter extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('[data-filter-input]');
      const count = this.querySelector('[data-filter-count]');
      const chips = [...this.querySelectorAll('[data-product]')];
      const scope = this.closest('.dict') || document;
      const items = [...scope.querySelectorAll('[data-glossary] > li')];
      const empty = scope.querySelector('[data-filter-empty]');
      let product = '';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let n = 0;
        items.forEach((li) => {
          const inProduct = !product || li.dataset.products.split(' ').includes(product);
          const matches = !q || li.dataset.search.includes(q) || li.textContent.toLowerCase().includes(q);
          li.hidden = !(inProduct && matches);
          if (!li.hidden) n++;
        });
        count.textContent = count.dataset.template.replace('__COUNT__', n);
        if (empty) empty.hidden = n > 0;
      };
      input.addEventListener('input', apply);
      chips.forEach((chip) => chip.addEventListener('click', () => {
        product = chip.dataset.product;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      }));
      // Deep link from a PDP (#inci-…): make sure the target row is visible.
      const reveal = () => {
        const target = location.hash && scope.querySelector(location.hash.replace(/[^#\w-]/g, ''));
        if (target && target.hidden) { input.value = ''; chips[0]?.click(); }
      };
      window.addEventListener('hashchange', reveal);
    }
  }
  if (!customElements.get('ingredient-filter')) customElements.define('ingredient-filter', IngredientFilter);
  // Closing the long list from further down brings you back to its button instead of leaving you past the page's end
  // (the page gets far shorter); it also makes Safari re-measure the page (DECISIONS 231).
  document.querySelectorAll('.glossary__ref').forEach((ref) => {
    ref.addEventListener('toggle', () => {
      if (ref.open) return;
      const btn = ref.querySelector('summary');
      if (btn.getBoundingClientRect().top < 0) btn.scrollIntoView({ block: 'center' });
    });
  });
</script>

