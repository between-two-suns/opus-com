{%- comment -%}
  About story, owner's compact layout (DECISIONS 370). Copy as approved (DECISIONS 368).
  1 Title left; opening paragraph and the bold lead-in right.
  2 The question as the centre moment (inset on laptops), filling from pale to full as she scrolls; "felt like us?" in
    mint. The four phrases on one letter-spaced line under it (two per line on phones).
  3 Two columns split by one thin mint line: "Not just made here…" + the two lines | "So we created / Between Two
    Suns." + "Born in Egypt…".
  4 The footer-mint card, white text, soft palm shadow, and the )( mark large and white on the right (small, top, on
    phones). No photo mark at the top any more (the hero's suns come just before).
  Site container and eyebrow; no hairlines. Motion: a short rise per block + the question fill. Arabic mirrors.
{%- endcomment -%}
{%- liquid
  assign s2 = 'about3.s2_p1' | t | split: '. '
  assign lead = 'about3.s2_head' | t | split: '. '
  if section.settings.shadow != blank
    assign shadow_url = section.settings.shadow | image_url: width: 1400
  else
    assign shadow_url = 'bts-palm-shadow.png' | asset_url
  endif
-%}
<style>
  .ab7 { overflow: clip; }
  .ab7 p { margin: 0; }
  .ab7__d { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.92; letter-spacing: -0.005em; }
  :lang(ar) .ab7__d { text-transform: none; line-height: 1.3; letter-spacing: 0; }
  .ab7__body { font-size: clamp(16px, 1.45vw, 20px); line-height: 1.6; color: color-mix(in srgb, var(--c-ink) 86%, transparent); }
  .ab7__strong { color: var(--c-ink); font-weight: 700; }
  .ab7__mint { color: var(--c-step-1); }

  /* 1 */
  .ab7__s1 { display: grid; gap: clamp(20px, 3vw, 40px); padding-block: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 40px); }
  .ab7__title { margin: 14px 0 0; font-size: clamp(56px, 8vw, 116px); line-height: 0.9; }
  .ab7__title > span { display: block; }
  .ab7__t2 { max-inline-size: 3.6em; }
  :lang(ar) .ab7__t2 { max-inline-size: none; }
  .ab7__intro { display: grid; gap: 14px; align-content: center; max-inline-size: 32rem; }

  /* 2 */
  .ab7__s2 { display: grid; gap: clamp(16px, 2vw, 28px); padding-block: clamp(32px, 4vw, 64px); }
  .ab7__q { font-size: clamp(44px, 6.6vw, 100px); line-height: 0.92; max-inline-size: 15em; }
  .ab7 [role='list'].ab7__four { display: flex; flex-wrap: wrap; gap: 0.6em 2.2em; margin: 0; padding: 0; list-style: none; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(16px, 1.6vw, 22px); letter-spacing: 0.3em; line-height: 1.2; }
  :lang(ar) .ab7 [role='list'].ab7__four { text-transform: none; letter-spacing: 0; font-size: clamp(18px, 1.8vw, 24px); }

  /* 3 */
  .ab7__s3 { display: grid; gap: clamp(36px, 5vw, 56px); padding-block: clamp(32px, 4vw, 64px) clamp(40px, 5vw, 72px); }
  .ab7__col { display: grid; gap: 16px; align-content: start; }
  .ab7__lead { font-weight: 700; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.2; letter-spacing: -0.02em; color: var(--c-ink); }
  .ab7__lead span { display: block; }
  :lang(ar) .ab7__lead { letter-spacing: 0; line-height: 1.45; }
  .ab7__created { font-size: clamp(22px, 2.2vw, 32px); }
  .ab7__name { font-size: clamp(56px, 7.6vw, 112px); line-height: 0.88; max-inline-size: 4.4em; margin: 0; }
  :lang(ar) .ab7__name { line-height: 0.92; text-transform: uppercase; direction: ltr; text-align: end; margin-inline-start: auto; }
  .ab7__born { margin-block-start: clamp(14px, 1.6vw, 22px) !important; font-weight: 700; font-size: clamp(18px, 1.8vw, 26px); line-height: 1.3; color: var(--c-ink); max-inline-size: 22em; }

  /* 4 */
  .ab7__s4 { padding-block: 0 clamp(56px, 7vw, 104px); }
  .ab7__card { position: relative; overflow: hidden; border-radius: var(--radius-l); background: var(--c-step-1); color: #fff; padding: clamp(32px, 5vw, 68px) clamp(24px, 5vw, 68px); display: grid; gap: clamp(14px, 1.6vw, 20px); }
  .ab7__card::after { content: ''; position: absolute; inset-block: 0; inset-inline-end: 0; inline-size: 58%; background: var(--shadow) right center / cover no-repeat; pointer-events: none; }
  [dir='rtl'] .ab7__card::after { transform: scaleX(-1); }
  .ab7__card > * { position: relative; z-index: 1; }
  .ab7__card-mark { position: absolute; z-index: 1; inset-inline-end: clamp(32px, 6vw, 110px); inset-block: 14%; aspect-ratio: 501 / 547; background: #fff; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .ab7__close { font-size: clamp(18px, 2vw, 26px); line-height: 1.35; max-inline-size: 20em; }
  .ab7__sign { font-size: clamp(46px, 7vw, 100px); line-height: 0.94; }
  .ab7__sign span { display: block; }
  :lang(ar) .ab7__sign { line-height: 1.35; }

  @media (min-width: 990px) {
    .ab7__s1 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(32px, 4vw, 64px); align-items: center; }
    .ab7__s2 { padding-inline-start: calc(var(--gutter) + 10%); }
    .ab7__s3 { grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr); column-gap: clamp(40px, 5vw, 80px); }
    .ab7__vline { background: var(--c-step-1); }
    .ab7__card { padding-inline-end: clamp(280px, 30vw, 440px); }
  }
  @media (max-width: 989px) {
    .ab7__vline { display: none; }
    .ab7 [role='list'].ab7__four { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; letter-spacing: 0.2em; }
    :lang(ar) .ab7__q { font-size: 10vw; }
    .ab7__card { padding-block-start: 128px; }
    .ab7__card::after { inline-size: 100%; opacity: 0.6; }
    .ab7__card-mark { inset-block: 28px auto; block-size: 76px; inset-inline-end: 28px; }
  }
  .ab7.is-live [data-r] { opacity: 0; transform: translateY(22px); transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out); transition-delay: calc(var(--d, 0) * 1ms); }
  .ab7.is-live [data-r].is-in { opacity: 1; transform: none; }
  /* The question fills word by word from pale to full colour as she scrolls (the highlight; no slant). */
  .ab7.is-live [data-fill] .w { opacity: 0.12; transition: opacity 0.3s linear; }
  .ab7.is-live [data-fill] .w.is-on { opacity: 1; }
</style>
<section class="ab7" aria-labelledby="Ab7-{{ section.id }}">
  <div class="container ab7__s1">
    <div data-r>
      <p class="t-eyebrow">{{ 'about3.eyebrow' | t }}</p>
      <h2 class="ab7__title ab7__d" id="Ab7-{{ section.id }}"><span>{{ 'about3.title_1' | t }}</span> <span class="ab7__t2">{{ 'about3.title_2' | t }}</span></h2>
    </div>
    <div class="ab7__intro" data-r style="--d: 150">
      <p class="ab7__body">{{ 'about3.p1' | t }}</p>
      <p class="ab7__body ab7__strong">{{ 'about4.q_lead' | t }}</p>
    </div>
  </div>

  <div class="container ab7__s2">
    <p class="ab7__q ab7__d" data-fill>{{ 'about4.q_1' | t }} {{ 'about4.q_2' | t }} {{ 'about4.q_3a' | t }} <span class="ab7__mint">{{ 'about4.q_3b' | t }}</span></p>
    {%- if s2.size > 4 -%}
      <ul class="ab7__four" role="list" data-r>{%- for k in (0..3) -%}<li>{{ s2[k] }}.</li>{%- endfor -%}</ul>
    {%- endif -%}
  </div>

  <div class="container ab7__s3">
    <div class="ab7__col" data-r>
      <p class="ab7__lead">{%- for l in lead -%}<span>{{ l }}{%- unless forloop.last -%}.{%- endunless -%}</span>{%- endfor -%}</p>
      <p class="ab7__body">{{ 'about6.mind_1' | t }}</p>
      <p class="ab7__body">{{ 'about6.mind_2' | t }}</p>
    </div>
    <span class="ab7__vline" aria-hidden="true"></span>
    <div class="ab7__col" data-r style="--d: 150">
      <p class="ab7__created ab7__d ab7__mint">{{ 'about4.created' | t }}</p>
      <h3 class="ab7__name ab7__d">{{ 'about5.name' | t }}</h3>
      <p class="ab7__born">{{ 'about3.s3_p1' | t }}</p>
    </div>
  </div>

  <div class="container ab7__s4">
    <div class="ab7__card" data-r style="--shadow: url('{{ shadow_url }}')">
      <span class="ab7__card-mark" aria-hidden="true"></span>
      <p class="ab7__close">{{ 'about3.close' | t }}</p>
      {%- assign sw = 'about3.close_2' | t | split: ' ' -%}{%- assign half = sw.size | divided_by: 2 -%}
      <p class="ab7__sign ab7__d"><span>{{ sw | slice: 0, half | join: ' ' }}</span> <span>{{ sw | slice: half, 20 | join: ' ' }}</span></p>
    </div>
  </div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('is-live');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    root.querySelectorAll('[data-r]').forEach((el) => io.observe(el));
    const fills = [...root.querySelectorAll('[data-fill]')].map((el) => {
      const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT); const nodes = []; while (walk.nextNode()) nodes.push(walk.currentNode);
      nodes.forEach((n) => { const f = document.createDocumentFragment(); n.textContent.split(/(\s+)/).forEach((t) => { if (!t) return; if (/^\s+$/.test(t)) f.append(t); else { const w = document.createElement('span'); w.className = 'w'; w.textContent = t; f.append(w); } }); n.replaceWith(f); });
      return { el, words: [...el.querySelectorAll('.w')] };
    });
    let ticking = false;
    // Starts when the question's top reaches 85% of the screen; fully coloured by the time it reaches the middle.
    const tick = () => { ticking = false; const h = innerHeight; fills.forEach(({ el, words }) => { const r = el.getBoundingClientRect(); const p = Math.min(1, Math.max(0, (h * 0.85 - r.top) / (h * 0.35))); const n = p * words.length; words.forEach((w, i) => w.classList.toggle('is-on', i < n)); }); };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    addEventListener('resize', tick); tick();
  })();
</script>

{% schema %}
{
  "name": "About · story (mock)",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "shadow", "label": "Shadow image on the closing card", "info": "A soft palm/leaf shadow photo. Empty = the built-in stand-in." }
  ]
}
{% endschema %}
