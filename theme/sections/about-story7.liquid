{%- comment -%}
  About story, built from the owner's own mock (DECISIONS 366). Copy as in the mock.
  1 Split: eyebrow, title, opening paragraph and the bold lead-in on the left; the photo mark on the right.
  2 "But we kept asking": the question large on the left, a hairline, the four phrases small and spaced on the right.
  3 "Not just made here. Made with our lives in mind." left, hairline, the two paragraphs right.
  4 "So we created / Between Two Suns." left, hairline, the two lines right.
  5 The footer-mint card with a soft palm shadow on its right side (stand-in lifted from the owner's mock; swap with
    the "Shadow image" setting) and white text.
  Motion: a short rise per block; fully readable at the end. Arabic mirrors.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image | default: images['bts-portrait-terrace-wide.jpg']
  assign s2 = 'about3.s2_p1' | t | split: '. '
  assign lead = 'about3.s2_head' | t | split: '. '
  if section.settings.shadow != blank
    assign shadow_url = section.settings.shadow | image_url: width: 1400
  else
    assign shadow_url = 'bts-palm-shadow.png' | asset_url
  endif
-%}
<style>
  .ab7 { --g: clamp(20px, 4.4vw, 64px); overflow: clip; }
  .ab7 p { margin: 0; }
  .ab7__w { inline-size: min(100% - 2 * var(--g), 1100px); margin-inline: auto; }
  .ab7__d { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.92; letter-spacing: -0.005em; }
  :lang(ar) .ab7__d { text-transform: none; line-height: 1.3; letter-spacing: 0; }
  .ab7__eb { font-size: 14px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  :lang(ar) .ab7__eb { letter-spacing: 0; text-transform: none; font-size: 15px; }
  .ab7__body { font-size: clamp(16px, 1.75vw, 22px); line-height: 1.6; color: color-mix(in srgb, var(--c-ink) 86%, transparent); }
  .ab7__strong { color: var(--c-ink); font-weight: 650; }
  .ab7__mint { color: var(--c-step-1); }
  .ab7__row { display: grid; gap: clamp(24px, 3vw, 40px); padding-block: clamp(36px, 4vw, 56px); border-block-start: 1px solid var(--c-line); }
  .ab7__row:first-child { border: 0; }
  .ab7__side { display: grid; gap: 14px; align-content: center; }

  /* 1 */
  .ab7__s1 { display: grid; gap: clamp(28px, 4vw, 48px); align-items: start; padding-block: clamp(40px, 5vw, 72px) clamp(28px, 3vw, 44px); }
  .ab7__s1-copy { display: grid; gap: 18px; }
  .ab7__title { margin: 0; font-size: clamp(56px, 8.4vw, 120px); line-height: 0.9; }
  .ab7__title > span { display: block; }
  .ab7__t2 { max-inline-size: 3.6em; }
  :lang(ar) .ab7__t2 { max-inline-size: none; }
  .ab7__mark { position: relative; overflow: hidden; inline-size: min(100%, 600px); aspect-ratio: 501 / 547; justify-self: end; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .ab7__mark img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 43% 26%; }

  /* 2 */
  .ab7__q { font-size: clamp(44px, 6.4vw, 92px); margin-block-start: 14px; }
  .ab7__q > span { display: block; }
  .ab7 [role='list'].ab7__four { display: grid; gap: clamp(12px, 1.6vw, 22px); margin: 0; padding: 0; list-style: none; align-content: center; }
  .ab7__four li { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(20px, 2.3vw, 32px); letter-spacing: 0.14em; line-height: 1.1; }
  :lang(ar) .ab7__four li { text-transform: none; letter-spacing: 0; font-size: clamp(22px, 2vw, 28px); }

  /* 3 + 4 */
  .ab7__lead { font-weight: 700; font-size: clamp(24px, 3vw, 40px); line-height: 1.2; letter-spacing: -0.02em; }
  .ab7__lead span { display: block; }
  :lang(ar) .ab7__lead { letter-spacing: 0; line-height: 1.45; }
  .ab7__copy { display: grid; gap: 1em; max-inline-size: 34rem; }
  .ab7__copy p:first-child { color: var(--c-ink); font-weight: 600; font-size: clamp(17px, 1.8vw, 22px); line-height: 1.45; }
  .ab7__created { font-size: clamp(26px, 2.8vw, 40px); }
  .ab7__name { font-size: clamp(56px, 8.8vw, 128px); line-height: 0.88; margin-block-start: 6px; max-inline-size: 4.4em; }
  :lang(ar) .ab7__name { text-transform: uppercase; line-height: 0.92; direction: ltr; text-align: end; margin-inline-start: auto; }
  .ab7__copy--big p:first-child { font-weight: 700; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.25; }

  /* 5 */
  .ab7__s5 { padding-block: clamp(8px, 1vw, 16px) clamp(56px, 7vw, 104px); }
  .ab7__card { position: relative; overflow: hidden; border-radius: var(--radius-l); background: var(--c-step-1); color: #fff; padding: clamp(32px, 5vw, 68px) clamp(24px, 5vw, 68px); display: grid; gap: clamp(14px, 1.6vw, 20px); }
  .ab7__card::after { content: ''; position: absolute; inset-block: 0; inset-inline-end: 0; inline-size: 58%; background: var(--shadow) right center / cover no-repeat; pointer-events: none; }
  [dir='rtl'] .ab7__card::after { transform: scaleX(-1); }
  .ab7__card > * { position: relative; z-index: 1; }
  .ab7__close { font-size: clamp(18px, 2.3vw, 28px); line-height: 1.3; max-inline-size: 18em; }
  .ab7__sign { font-size: clamp(46px, 7.6vw, 104px); line-height: 0.94; }
  .ab7__sign span { display: block; }
  :lang(ar) .ab7__sign { line-height: 1.35; }

  @media (min-width: 990px) {
    .ab7__s1 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(24px, 3vw, 48px); }
    .ab7__row { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); column-gap: clamp(28px, 3.6vw, 56px); align-items: center; }
    .ab7__row--q { grid-template-columns: minmax(0, 2.3fr) auto minmax(0, 1fr); }
    .ab7__rule { inline-size: 1px; align-self: stretch; background: var(--c-line-strong); }
  }
  @media (max-width: 989px) {
    :lang(ar) .ab7__q { font-size: 9.6vw; }
    .ab7__mark { margin-block-start: -8px; }
    .ab7__rule { display: none; }
    .ab7__mark { inline-size: min(70vw, 300px); }
    .ab7__card::after { inline-size: 100%; opacity: 0.6; }
  }
  .ab7.is-live [data-r] { opacity: 0; transform: translateY(22px); transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out); transition-delay: calc(var(--d, 0) * 1ms); }
  .ab7.is-live [data-r].is-in { opacity: 1; transform: none; }
</style>
<section class="ab7" aria-labelledby="Ab7-{{ section.id }}">
  <div class="ab7__w ab7__s1">
    <div class="ab7__s1-copy" data-r>
      <p class="ab7__eb">{{ 'about3.eyebrow' | t }}</p>
      <h2 class="ab7__title ab7__d" id="Ab7-{{ section.id }}"><span>{{ 'about3.title_1' | t }}</span> <span class="ab7__t2">{{ 'about3.title_2' | t }}</span></h2>
      <p class="ab7__body" style="max-inline-size: 26rem">{{ 'about3.p1' | t }}</p>
      <p class="ab7__body ab7__strong">{{ 'about4.q_lead' | t }}</p>
    </div>
    {%- if img != blank and img.width != blank -%}
      <div class="ab7__mark" data-r style="--d: 200">{{ img | image_url: width: 1000 | image_tag: loading: 'eager', widths: '400,700,1000', sizes: '(min-width: 990px) 360px, 70vw', alt: '' }}</div>
    {%- endif -%}
  </div>

  <div class="ab7__w ab7__row ab7__row--q" data-r>
    <div>
      <p class="ab7__eb">{{ 'about5.asking' | t }}</p>
      <p class="ab7__q ab7__d"><span>{{ 'about4.q_1' | t }}</span> <span>{{ 'about4.q_2' | t }} {{ 'about4.q_3a' | t }}</span> <span class="ab7__mint">{{ 'about4.q_3b' | t }}</span></p>
    </div>
    <span class="ab7__rule" aria-hidden="true"></span>
    {%- if s2.size > 4 -%}
      <ul class="ab7__four" role="list">{%- for k in (0..3) -%}<li>{{ s2[k] }}.</li>{%- endfor -%}</ul>
      {%- assign rest = s2 | slice: 4, 20 | join: '. ' -%}
    {%- else -%}
      <span></span>
      {%- assign rest = 'about3.s2_p1' | t -%}
    {%- endif -%}
  </div>

  <div class="ab7__w ab7__row" data-r>
    <p class="ab7__lead">{%- for l in lead -%}<span>{{ l }}{%- unless forloop.last -%}.{%- endunless -%}</span>{%- endfor -%}</p>
    <span class="ab7__rule" aria-hidden="true"></span>
    <div class="ab7__copy ab7__body"><p>{{ rest }}</p><p>{{ 'about5.wanted' | t }}</p></div>
  </div>

  <div class="ab7__w ab7__row" data-r>
    <div>
      <p class="ab7__created ab7__d ab7__mint">{{ 'about4.created' | t }}</p>
      <h3 class="ab7__name ab7__d">{{ 'about5.name' | t }}</h3>
    </div>
    <span class="ab7__rule" aria-hidden="true"></span>
    <div class="ab7__copy ab7__copy--big ab7__body"><p>{{ 'about3.s3_p1' | t }}</p><p>{{ 'about3.s3_p2' | t }}</p></div>
  </div>

  <div class="ab7__w ab7__s5">
    <div class="ab7__card" data-r style="--shadow: url('{{ shadow_url }}')">
      <p class="ab7__close">{{ 'about3.close' | t }}</p>
      {%- assign sw = 'about3.close_2' | t | split: ' ' -%}{%- assign half = sw.size | divided_by: 2 -%}
      <p class="ab7__sign ab7__d"><span>{{ sw | slice: 0, half | join: ' ' }}</span> <span>{{ sw | slice: half, 20 | join: ' ' }}</span></p>
    </div>
  </div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('is-live');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    root.querySelectorAll('[data-r]').forEach((el) => io.observe(el));
  })();
</script>

{% schema %}
{
  "name": "About · story (mock)",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo inside the mark", "info": "Empty = the terrace portrait (stand-in until the shoot)." },
    { "type": "image_picker", "id": "shadow", "label": "Shadow image on the closing card", "info": "A soft palm/leaf shadow photo. Empty = the built-in stand-in." }
  ]
}
{% endschema %}
