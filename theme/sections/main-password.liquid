<section class="password" aria-labelledby="PasswordTitle">
  <div class="suns" aria-hidden="true"><span class="sun sun--warm notfound__sun-a"></span><span class="sun sun--cool notfound__sun-b"></span></div>
  <div class="container password__inner">
    <span class="password__logo">{% render 'logo', variant: 'wordmark' %}</span>
    <h1 class="t-display-l" id="PasswordTitle">{% if section.settings.t_password_heading != blank %}{{ section.settings.t_password_heading }}{% else %}{{ 'password.heading' | t }}{% endif %}</h1>
    <p class="t-lead">{% if shop.password_message != blank %}{{ shop.password_message | escape }}{% else %}{% if section.settings.t_password_text != blank %}{{ section.settings.t_password_text }}{% else %}{{ 'password.text' | t }}{% endif %}{% endif %}</p>
    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{% if section.settings.t_newsletter_success != blank %}{{ section.settings.t_newsletter_success }}{% else %}{{ 'newsletter.success' | t }}{% endif %}</p>
      {%- else -%}
        <div class="inline-form">
          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{% if section.settings.t_newsletter_email_label != blank %}{{ section.settings.t_newsletter_email_label }}{% else %}{{ 'newsletter.email_label' | t }}{% endif %}</label>
            <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{% if section.settings.t_newsletter_email_label != blank %}{{ section.settings.t_newsletter_email_label }}{% else %}{{ 'newsletter.email_label' | t }}{% endif %}" required>
          </div>
          <button type="submit" class="btn">{% if section.settings.t_newsletter_submit != blank %}{{ section.settings.t_newsletter_submit }}{% else %}{{ 'newsletter.submit' | t }}{% endif %}</button>
        </div>
        <p class="t-xs t-muted">{% if section.settings.t_newsletter_consent != blank %}{{ section.settings.t_newsletter_consent }}{% else %}{{ 'newsletter.consent' | t }}{% endif %}</p>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="link-arrow">{% if section.settings.t_password_login != blank %}{{ section.settings.t_password_login }}{% else %}{{ 'password.login' | t }}{% endif %}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="field__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="inline-form">
          <div class="field">
            <label class="visually-hidden" for="StorePassword">{% if section.settings.t_password_password != blank %}{{ section.settings.t_password_password }}{% else %}{{ 'password.password' | t }}{% endif %}</label>
            <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{% if section.settings.t_password_password != blank %}{{ section.settings.t_password_password }}{% else %}{{ 'password.password' | t }}{% endif %}">
          </div>
          <button type="submit" class="btn btn--secondary">{% if section.settings.t_password_enter != blank %}{{ section.settings.t_password_enter }}{% else %}{{ 'password.enter' | t }}{% endif %}</button>
        </div>
      {%- endform -%}
      <p class="t-xs t-muted">{% if section.settings.t_password_admin != blank %}{{ section.settings.t_password_admin }}{% else %}{{ 'password.admin' | t }}{% endif %} <a href="/admin">{% if section.settings.t_password_admin_link != blank %}{{ section.settings.t_password_admin_link }}{% else %}{{ 'password.admin_link' | t }}{% endif %}</a></p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_password_heading",
      "label": "Password · Heading",
      "info": "Now: “Opening soon”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "textarea",
      "id": "t_password_text",
      "label": "Password · Paragraph",
      "info": "Now: “Skincare for life between two suns, made in Egypt. Leave your email and we’ll tell you first.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_newsletter_success",
      "label": "Newsletter · Success",
      "info": "Now: “You’re in. Watch your inbox.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_newsletter_email_label",
      "label": "Newsletter · Label",
      "info": "Now: “Email address”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_newsletter_submit",
      "label": "Newsletter · Submit",
      "info": "Now: “Sign up”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_newsletter_consent",
      "label": "Newsletter · Consent",
      "info": "Now: “By signing up you agree to receive emails from Between Two Suns. Unsubscribe any time.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_password_login",
      "label": "Password · Login",
      "info": "Now: “Enter with password”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_password_password",
      "label": "Password · Password",
      "info": "Now: “Password”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_password_enter",
      "label": "Password · Enter",
      "info": "Now: “Enter”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_password_admin",
      "label": "Password · Admin",
      "info": "Now: “Are you the store owner?”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_password_admin_link",
      "label": "Password · Link text",
      "info": "Now: “Log in here”. Leave empty to keep it (English and Arabic)."
    }
  ]
}
{% endschema %}
