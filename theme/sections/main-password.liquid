<section class="password" aria-labelledby="PasswordTitle">
  <div class="suns" aria-hidden="true"><span class="sun sun--warm notfound__sun-a"></span><span class="sun sun--cool notfound__sun-b"></span></div>
  <div class="container password__inner">
    <span class="password__logo">{% render 'logo', variant: 'wordmark' %}</span>
    <h1 class="t-display-l" id="PasswordTitle">{{ 'password.heading' | t }}</h1>
    <p class="t-lead">{% if shop.password_message != blank %}{{ shop.password_message | escape }}{% else %}{{ 'password.text' | t }}{% endif %}</p>
    {%- form 'customer', id: 'PasswordNewsletter', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="inline-form">
          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.email_label' | t }}</label>
            <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.email_label' | t }}" required>
          </div>
          <button type="submit" class="btn">{{ 'newsletter.submit' | t }}</button>
        </div>
        <p class="t-xs t-muted">{{ 'newsletter.consent' | t }}</p>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="link-arrow">{{ 'password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="field__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="inline-form">
          <div class="field">
            <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
            <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          </div>
          <button type="submit" class="btn btn--secondary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="t-xs t-muted">{{ 'password.admin' | t }} <a href="/admin">{{ 'password.admin_link' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{ "name": "t:sections.main_password.name", "settings": [] }
{% endschema %}
