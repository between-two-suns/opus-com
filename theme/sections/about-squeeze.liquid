{%- comment -%}
  About hero prototype D · "The space between" (demo only, /pages/about?view=squeeze).
  White, bright, typographic. The two suns (the home page's spheres) hold the name between them, and the name is
  elastic: its letters always fill exactly the space between the suns. Move the pointer (or drag on a phone) and the
  suns part or close; the letters stretch wide or squeeze tall and narrow with a springy settle, each line hugging
  the curve of the spheres. Left alone it breathes slowly. The four packs stand in the space between. Scrolling on,
  the suns roll away and the name opens to the full width. One screen, nothing pinned, no clock, no dark sky.
  Reduced motion: a still screen at rest. Prototype: English only.
{%- endcomment -%}
<style>
.aq { position: relative; margin-block-start: calc(-1 * var(--header-h)); block-size: 100svh; min-block-size: 560px; overflow: clip; isolation: isolate; background: #fff; color: var(--c-ink); touch-action: pan-y; }
.aq-sun { position: absolute; z-index: 2; left: 0; top: 0; will-change: transform; pointer-events: none; visibility: hidden; }
.aq.is-ready .aq-sun, .aq.is-ready .aq-line { visibility: visible; }
.aq-roll { position: absolute; inset: 0; border-radius: 50%; background: rgb(var(--c)); will-change: transform; }
.aq-roll img { display: block; inline-size: 100%; block-size: 100%; }
.aq-sun i { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at var(--hx) 34%, rgb(255 255 255 / .3), rgb(255 255 255 / .08) 20%, transparent 42%, rgb(30 40 55 / .07) 62%, rgb(30 40 55 / .26) 100%); }
.aq-sun--l { --c: 171 208 182; --hx: 70%; } .aq-sun--r { --c: 171 193 233; --hx: 30%; }
.aq-eyebrow { position: absolute; inset-inline: 0; z-index: 1; margin: 0; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
.aq-line { position: absolute; z-index: 1; left: 50%; top: 0; overflow: visible; transform-origin: 50% 50%; will-change: transform; visibility: hidden; }
.aq-line text { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; fill: currentColor; }
.aq-sub { position: absolute; z-index: 1; left: 50%; margin: 0; translate: -50% 0; text-align: center; font-size: clamp(16px, 1.45vw, 22px); line-height: 1.34; font-weight: 520; letter-spacing: -.01em; text-wrap: balance; }
.aq-packs { position: absolute; z-index: 1; inset-inline: 0; margin: 0; padding: 0; list-style: none; display: flex; justify-content: center; align-items: flex-end; gap: clamp(5px, 1vw, 16px); pointer-events: none; }
.aq-pack { block-size: calc(var(--h) * 100%); aspect-ratio: 357 / 1100; }
.aq-pack img { display: block; inline-size: 100%; block-size: 100%; object-fit: contain; object-position: bottom; filter: drop-shadow(0 16px 16px rgba(32, 35, 58, .18)); animation: aq-up 1s cubic-bezier(.2, .75, .2, 1) both; animation-delay: calc(.7s + var(--i) * .09s); }
@keyframes aq-up { from { opacity: 0; transform: translateY(40px); } }
@media (max-width: 749px) { .aq { margin-block-start: 0; block-size: calc(100svh - var(--header-h)); } .aq-sub { font-size: 15px; } }
@media (prefers-reduced-motion: reduce) { .aq-pack img { animation: none; } }
</style>
<section class="aq" data-aq aria-labelledby="AqTitle-{{ section.id }}">
  <span class="aq-sun aq-sun--l" aria-hidden="true"><span class="aq-roll"><img src="{{ 'orb-green-1200.webp' | asset_url }}" alt="" width="1200" height="1200"></span><i></i></span>
  <span class="aq-sun aq-sun--r" aria-hidden="true"><span class="aq-roll"><img src="{{ 'orb-blue-1200.webp' | asset_url }}" alt="" width="1200" height="1200"></span><i></i></span>
  <p class="aq-eyebrow">About</p>
  <h1 class="visually-hidden" id="AqTitle-{{ section.id }}">Between two suns</h1>
  <svg class="aq-line" aria-hidden="true" focusable="false"><text>BETWEEN</text></svg>
  <svg class="aq-line" aria-hidden="true" focusable="false"><text>TWO SUNS</text></svg>
  <p class="aq-sub">Today’s sun, and tomorrow’s. The space between them is what we make skincare for.</p>
  <ul class="aq-packs" role="list" aria-hidden="true">
    <li class="aq-pack" style="--h: 1; --i: 0"><img src="{{ 'cut-daily-reset-cleanser.webp' | asset_url }}" alt=""></li>
    <li class="aq-pack" style="--h: .65; --i: 1"><img src="{{ 'cut-clarity-serum.webp' | asset_url }}" alt=""></li>
    <li class="aq-pack" style="--h: .81; --i: 2"><img src="{{ 'cut-daily-barrier-moisturizing-cream.webp' | asset_url }}" alt=""></li>
    <li class="aq-pack" style="--h: .81; --i: 3"><img src="{{ 'cut-daily-defense-sunscreen-spf-50.webp' | asset_url }}" alt=""></li>
  </ul>
</section>
<script>
(() => {
  const el = document.currentScript.previousElementSibling; if (!el || !el.matches('[data-aq]')) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sunL = el.querySelector('.aq-sun--l'), sunR = el.querySelector('.aq-sun--r'), rollL = sunL.firstElementChild, rollR = sunR.firstElementChild;
  const lines = [...el.querySelectorAll('.aq-line')], sub = el.querySelector('.aq-sub'), packs = el.querySelector('.aq-packs'), eyebrow = el.querySelector('.aq-eyebrow');
  const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v)), mix = (a, b, k) => a + (b - a) * k;
  let G = null, g = 0, v = 0, pointer = null, t0 = performance.now(), raf = 0, seen = true;
  const measure = () => {
    const W = el.clientWidth, H = el.clientHeight, phone = W < 750;
    const hdr = phone ? 0 : parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 76;
    const dock = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dock-h')) || 0;
    const R = (phone ? H * 1.02 : H * 1.3) / 2, cy = phone ? H * .44 : H * .5 + hdr * .25;
    const top = hdr + (phone ? H * .1 : H * .075), packH = phone ? Math.min(H * .2, W * .42) : H * .23;
    const bottom = H - dock - (phone ? 14 : H * .045), subH = phone ? 60 : 62;
    const typeH = bottom - packH - subH - (phone ? 26 : H * .05) - top - 26, gapL = typeH * .06, hc = (typeH - gapL) / 2;
    // the display face's capital height, measured from the font itself
    const cx = document.createElement('canvas').getContext('2d'); cx.font = "700 200px 'BTS Display', 'Arial Narrow', sans-serif";
    const cap = (cx.measureText('E').actualBoundingBoxAscent || 144) / 200, F = hc / cap;
    eyebrow.style.top = top + 'px';
    const L = lines.map((svg, i) => {
      const tx = svg.firstElementChild; tx.setAttribute('font-size', F.toFixed(2)); tx.setAttribute('y', hc.toFixed(2)); tx.setAttribute('x', 0);
      const w = tx.getComputedTextLength(); svg.setAttribute('width', w); svg.setAttribute('height', hc); svg.style.marginLeft = (-w / 2) + 'px';
      const y = top + 26 + i * (hc + gapL); svg.style.top = y + 'px';
      // the narrowest the space is across this line's height (the spheres curve away above and below their middle)
      const dy = cy < y ? y - cy : cy > y + hc ? cy - (y + hc) : 0;
      return { svg, w, extra: 2 * (R - Math.sqrt(Math.max(0, R * R - dy * dy))) };
    });
    const subY = top + 26 + typeH + (phone ? 14 : H * .028); sub.style.top = subY + 'px';
    packs.style.blockSize = packH + 'px'; packs.style.top = (bottom - packH) + 'px';
    const dys = Math.abs(subY - cy);
    G = { W, H, phone, R, cy, L, pad: phone ? 10 : W * .016, min: phone ? W * .34 : W * .2, max: phone ? W * .82 : W * .6, rest: phone ? W * .6 : W * .4, subExtra: 2 * (R - Math.sqrt(Math.max(0, R * R - dys * dys))) };
    [sunL, sunR].forEach((s) => { s.style.width = s.style.height = 2 * R + 'px'; });
  };
  const draw = () => {
    const { W, R, cy, L, pad } = G;
    const xl = W / 2 - g / 2 - 2 * R, xr = W / 2 + g / 2, roll = (g - G.rest) / (2 * R) * 180 / Math.PI * .9;
    sunL.style.transform = `translate3d(${xl.toFixed(1)}px, ${(cy - R).toFixed(1)}px, 0)`; sunR.style.transform = `translate3d(${xr.toFixed(1)}px, ${(cy - R).toFixed(1)}px, 0)`;
    rollL.style.transform = `rotate(${(-roll).toFixed(2)}deg)`; rollR.style.transform = `rotate(${roll.toFixed(2)}deg)`;
    L.forEach((l) => { const avail = Math.min(Math.max(12, g + l.extra - 2 * pad), W - 2 * pad * 1.5); l.svg.style.transform = `scaleX(${(avail / l.w).toFixed(4)})`; });
    sub.style.maxInlineSize = Math.max(140, Math.min(g + G.subExtra - 2 * pad - 16, G.phone ? 300 : 520)).toFixed(0) + 'px';
  };
  const target = (now) => {
    const { W, H, min, max, rest } = G;
    let tg = pointer != null ? mix(min, max, clamp(Math.abs(pointer - W / 2) / (W * .4))) : rest + Math.sin((now - t0) / 1000 * .7) * W * (G.phone ? .05 : .035);
    const r = el.getBoundingClientRect(), s = clamp(-r.top / (H * .85));           // scrolling on: the suns roll away
    return mix(tg, W * 1.12, s * s);
  };
  const frame = (now) => {
    raf = 0; if (!G) measure();
    const tg = target(now); v = (v + (tg - g) * .075) * .8; g += v; draw();
    if (seen) raf = requestAnimationFrame(frame);
  };
  const ask = () => { if (!raf) raf = requestAnimationFrame(frame); };
  const start = () => {
    measure(); g = G.W * .03; el.classList.add('is-ready');
    if (reduce) { g = G.rest; draw(); addEventListener('resize', () => { measure(); draw(); }); return; }
    draw(); ask();
    el.addEventListener('pointermove', (e) => { if (e.pointerType === 'touch' && !e.isPrimary) return; pointer = e.clientX - el.getBoundingClientRect().left; });
    el.addEventListener('pointerleave', () => { pointer = null; }); el.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') pointer = null; }); el.addEventListener('pointercancel', () => { pointer = null; });
    addEventListener('resize', () => { measure(); });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) ask(); }).observe(el);
  };
  const fonts = document.fonts && document.fonts.load ? document.fonts.load("700 100px 'BTS Display'").catch(() => {}) : Promise.resolve();
  Promise.race([fonts, new Promise((r) => setTimeout(r, 1500))]).then(() => { if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true }); });
})();
</script>

{% schema %}
{
  "name": "About · space between",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
