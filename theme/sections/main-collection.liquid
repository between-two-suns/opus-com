{{ 'home.css' | asset_url | stylesheet_tag }}
{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign concern_ids = 'oiliness,dark_spots,dehydration,barrier,sun,pollution' | split: ','
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
-%}
<section class="collection" aria-labelledby="CollectionTitle">
  <div class="page-hero page-hero--compact">
    <div class="container page-hero__inner">
      <p class="t-eyebrow">{% if section.settings.t_collection_eyebrow != blank %}{{ section.settings.t_collection_eyebrow }}{% else %}{{ 'collection.eyebrow' | t }}{% endif %}</p>
      <h1 class="t-display-l" id="CollectionTitle">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="t-lead page-hero__text rte">{{ collection.description }}</div>
      {%- else -%}
        <p class="t-lead page-hero__text">{% if section.settings.t_collection_lead != blank %}{{ section.settings.t_collection_lead }}{% else %}{{ 'collection.lead' | t }}{% endif %}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="container section--tight">
    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <concern-filter class="collection__filter" data-grid="CollectionGrid">
          <p class="t-eyebrow t-muted" id="ConcernFilterLabel">{% if section.settings.t_collection_filter_label != blank %}{{ section.settings.t_collection_filter_label }}{% else %}{{ 'collection.filter_label' | t }}{% endif %}</p>
          <div class="cluster" role="group" aria-labelledby="ConcernFilterLabel">
            <a class="chip" href="{{ collection.url }}" data-concern="" aria-current="true">{% if section.settings.t_concerns_all != blank %}{{ section.settings.t_concerns_all }}{% else %}{{ 'concerns.all' | t }}{% endif %}</a>
            {%- for id in concern_ids -%}
              {%- assign key = 'concerns.' | append: id -%}
              <a class="chip" href="{{ collection.url }}?concern={{ id }}" data-concern="{{ id }}" aria-current="false">{{ key | t }}</a>
            {%- endfor -%}
          </div>
          <p class="t-small t-muted" role="status" data-filter-status data-template="{{ 'collection.showing' | t: count: '__COUNT__'  }}">{{ 'collection.count' | t: count: collection.products_count }}</p>
        </concern-filter>

        <ul class="product-grid collection__grid" id="CollectionGrid" role="list">
          {%- for s in (1..4) -%}
            {%- for product in collection.products -%}
              {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign step = step | strip | plus: 0 -%}
              {%- if step == s -%}
                <li>{% render 'product-card', product: product, section_id: section.id, heading_tag: 'h2', loading: 'eager' %}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>

        {%- comment -%} Sets live in their own rail under the four products, never mixed into the grid; highest price first (DECISIONS 240). {%- endcomment -%}
        {%- assign sets_by_price = collection.products | sort: 'price' | reverse -%}
        {%- capture sets_html -%}
          {%- for product in sets_by_price -%}
            {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}
            {%- assign step = step | strip | plus: 0 -%}
            {%- if step == 0 -%}
              {%- render 'bundle-card', product: product, heading_tag: 'h3' -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if sets_html contains 'class="bundle"' -%}
          {{ 'bundles.css' | asset_url | stylesheet_tag }}
          <section class="collection__sets" aria-labelledby="CollectionSets">
            <div class="section-head">
              <div class="section-head__text">
                <p class="t-eyebrow">{% if section.settings.t_sections_bundles_eyebrow != blank %}{{ section.settings.t_sections_bundles_eyebrow }}{% else %}{{ 'sections.bundles.eyebrow' | t }}{% endif %}</p>
                <h2 class="t-display-m" id="CollectionSets">{% if section.settings.t_collection_sets_heading != blank %}{{ section.settings.t_collection_sets_heading }}{% else %}{{ 'collection.sets_heading' | t }}{% endif %}</h2>
              </div>
              <a class="link-arrow" href="{{ root }}/pages/sets">{% if section.settings.t_collection_sets_builder != blank %}{{ section.settings.t_collection_sets_builder }}{% else %}{{ 'collection.sets_builder' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
            </div>
            <ul class="sets-rail" role="list">{{ sets_html }}</ul>
          </section>
        {%- endif -%}

        <aside class="collection__cta" aria-labelledby="CollectionCta">
          <div>
            <h2 class="t-heading" id="CollectionCta">{% if section.settings.t_collection_routine_card_title != blank %}{{ section.settings.t_collection_routine_card_title }}{% else %}{{ 'collection.routine_card_title' | t }}{% endif %}</h2>
            <p class="t-muted">{% if section.settings.t_collection_routine_card_text != blank %}{{ section.settings.t_collection_routine_card_text }}{% else %}{{ 'collection.routine_card_text' | t }}{% endif %}</p>
          </div>
          <a class="btn" href="{{ root }}/pages/routines">{% if section.settings.t_collection_routine_card_cta != blank %}{{ section.settings.t_collection_routine_card_cta }}{% else %}{{ 'collection.routine_card_cta' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        </aside>

        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <p class="t-display-s">{% if section.settings.t_collection_empty != blank %}{{ section.settings.t_collection_empty }}{% else %}{{ 'collection.empty' | t }}{% endif %}</p>
          <a class="btn" href="{{ routes.root_url }}">{% if section.settings.t_general_back_home != blank %}{{ section.settings.t_general_back_home }}{% else %}{{ 'general.back_home' | t }}{% endif %}</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

