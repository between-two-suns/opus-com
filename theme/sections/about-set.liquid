      sun.position.copy(focus).addScaledVector(dir, 7); sun.target.position.copy(focus); sun.target.updateMatrixWorld();
      sun.color.copy(cWarm).lerp(cNoon, clamp(elev * 1.5)); sun.intensity = 4.3 * up * mix(.8, 1, elev);
      const night = 1 - clamp(up * 3 + (day >= 0 ? 0 : 0)), nk = day >= 0 ? sm(.9, 1, day) : dawn >= 0 ? 1 - sm(0, .8, dawn) : 1;
      hemi.color.copy(cSkyD).lerp(cSkyN, nk); hemi.groundColor.copy(cGrD).lerp(cGrN, nk); hemi.intensity = mix(1.25, 1.05, nk);
      lamp.intensity = 2.2 * sm(.35, 1, nk); bounce.intensity = mix(.4, .22, nk);
      renderer.toneMappingExposure = mix(1.12, 1.0, nk);
