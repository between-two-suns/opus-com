      gobo.position.copy(focus).addScaledVector(dir, 2.7); gobo.lookAt(sun.position);
      fronds.forEach((f) => { f.rotation.z = f.userData.rot + Math.sin(now / 1700 + f.userData.ph) * .07 + Math.sin(now / 610 + f.userData.ph * 2) * .02; });
      
      el.toggleAttribute('data-dark', nk > .8);
      let k = 0; while (k < STORY.length - 1 && t >= STORY[k + 1][0]) k++;
      if (k !== step) { step = k; timeEl.textContent = STORY[k][1]; nowEl.textContent = STORY[k][2]; lines.forEach((li, i) => li.classList.toggle('is-on', i === STORY[k][3])); }
      cam.position.set(px * .16, focus.y + .02 - py * .06, portrait ? 5.0 : 4.25); cam.lookAt(focus.x + px * .05, focus.y, 0);
    };
