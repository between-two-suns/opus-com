    const wallTex = new T.CanvasTexture(wallCv); wallTex.colorSpace = T.SRGBColorSpace; wallTex.anisotropy = 8;
    const paintWall = (portrait) => {
      const c = wallCv.getContext('2d'), W = wallCv.width, H = wallCv.height, u = W / WALL.w;
      c.fillStyle = '#f7f2e9'; c.fillRect(0, 0, W, H);
      for (let i = 0; i < 90; i++) { const x = rnd() * W, y = rnd() * H, r = 120 + rnd() * 520, g = c.createRadialGradient(x, y, 0, x, y, r); const d = rnd() > .5; g.addColorStop(0, d ? 'rgba(120,96,70,.05)' : 'rgba(255,252,246,.09)'); g.addColorStop(1, 'rgba(0,0,0,0)'); c.fillStyle = g; c.fillRect(x - r, y - r, 2 * r, 2 * r); }
      for (let i = 0; i < 26000; i++) { c.fillStyle = rnd() > .5 ? 'rgba(110,90,70,.05)' : 'rgba(255,255,255,.07)'; const z = .6 + rnd() * 2.4; c.fillRect(rnd() * W, rnd() * H, z, z); }
      // the name, painted on the wall
      const box = portrait ? { x0: -1.02, x1: 1.02, top: 1.98 } : { x0: -1.74, x1: -.02, top: 1.6 };
      const toX = (x) => (x - (WALL.cx - WALL.w / 2)) * u, toY = (y) => (WALL.cy + WALL.h / 2 - y) * u;
      c.fillStyle = '#20233a'; c.textBaseline = 'alphabetic';
      let F = 400; c.font = `700 ${F}px 'BTS Display', 'Arial Narrow', sans-serif`;
      const bw = (box.x1 - box.x0) * u; F *= bw / c.measureText('TWO SUNS').width; c.font = `700 ${F}px 'BTS Display', 'Arial Narrow', sans-serif`;
      const cap = c.measureText('E').actualBoundingBoxAscent, gap = cap * .11;
      ['BETWEEN', 'TWO SUNS'].forEach((t, i) => { const w = c.measureText(t).width; c.save(); c.translate(toX(box.x0), toY(box.top) + cap + i * (cap + gap)); c.scale(bw / w, 1); c.fillText(t, 0, 0); c.restore(); });
      // paint is never perfectly even
      c.globalCompositeOperation = 'source-atop'; for (let i = 0; i < 9000; i++) { c.fillStyle = 'rgba(247,242,233,.10)'; const z = 1 + rnd() * 2.6; c.fillRect(toX(box.x0) + rnd() * bw, toY(box.top) + rnd() * (2 * cap + gap), z, z); } c.globalCompositeOperation = 'source-over';
      wallTex.needsUpdate = true;
    };
    const wall = new T.Mesh(new T.PlaneGeometry(WALL.w, WALL.h), new T.MeshStandardMaterial({ map: wallTex, roughness: .96, metalness: 0 }));
    wall.position.set(WALL.cx, WALL.cy, -.62); wall.receiveShadow = true; scene.add(wall);
    const stoneCv = document.createElement('canvas'); stoneCv.width = 2048; stoneCv.height = 1024;
    { const c = stoneCv.getContext('2d'), W = 2048, H = 1024; c.fillStyle = '#e3d5bf'; c.fillRect(0, 0, W, H);
      for (let i = 0; i < 260; i++) { const y = rnd() * H; c.strokeStyle = rnd() > .5 ? `rgba(150,120,86,${.03 + rnd() * .06})` : `rgba(255,250,240,${.04 + rnd() * .08})`; c.lineWidth = 1 + rnd() * 7; c.beginPath(); c.moveTo(0, y); for (let x = 0; x <= W; x += 128) c.lineTo(x, y + Math.sin(x / 200 + i) * 6 + (rnd() - .5) * 5); c.stroke(); }
      for (let i = 0; i < 900; i++) { c.fillStyle = `rgba(120,96,70,${.05 + rnd() * .12})`; c.beginPath(); c.ellipse(rnd() * W, rnd() * H, 1 + rnd() * 7, .6 + rnd() * 2.2, 0, 0, 7); c.fill(); } }
    const stoneTex = new T.CanvasTexture(stoneCv); stoneTex.colorSpace = T.SRGBColorSpace; stoneTex.anisotropy = 8;
    const ledge = new T.Mesh(new T.BoxGeometry(8, .6, 3.2), new T.MeshStandardMaterial({ map: stoneTex, roughness: .82, metalness: 0 }));
    ledge.position.set(0, -.3, .9); ledge.receiveShadow = true; scene.add(ledge);

    /* ---- the packs: the store's own cut-outs, given a round body so the light wraps and glints ---- */
    const packs = new T.Group(); scene.add(packs);
    const HS = [1, .65, .81, .81], PH = .64, loader = new T.TextureLoader(); loader.setCrossOrigin('anonymous');
    let pending = 4, ready = false;
    el.dataset.packs.split('|').forEach((url, i) => {
      const im = new Image(); im.crossOrigin = 'anonymous';
      im.onload = () => {
        const w = im.naturalWidth, h = im.naturalHeight, a = document.createElement('canvas'); a.width = w; a.height = h; const ac = a.getContext('2d'); ac.drawImage(im, 0, 0);
        const src = ac.getImageData(0, 0, w, h).data, n = document.createElement('canvas'); n.width = w; n.height = h; const nc = n.getContext('2d'), out = nc.createImageData(w, h);
        for (let y = 0; y < h; y++) { let l = -1, r = -1; for (let x = 0; x < w; x++) if (src[(y * w + x) * 4 + 3] > 40) { if (l < 0) l = x; r = x; }
          for (let x = 0; x < w; x++) { const k = (y * w + x) * 4; let nx = 0; if (l >= 0 && r > l) nx = Math.max(-1, Math.min(1, ((x - l) / (r - l)) * 2 - 1)) * .94; const nz = Math.sqrt(1 - nx * nx); out.data[k] = (nx * .5 + .5) * 255; out.data[k + 1] = 128; out.data[k + 2] = (nz * .5 + .5) * 255; out.data[k + 3] = 255; } }
        nc.putImageData(out, 0, 0);
        const map = new T.CanvasTexture(a); map.colorSpace = T.SRGBColorSpace; map.anisotropy = 8; const nm = new T.CanvasTexture(n);
        const ph = PH * HS[i], pw = ph * w / h;
        const m = new T.Mesh(new T.PlaneGeometry(pw, ph), new T.MeshStandardMaterial({ map, normalMap: nm, normalScale: new T.Vector2(1.15, 1.15), alphaTest: .5, roughness: .38, metalness: 0, side: T.DoubleSide }));
        m.castShadow = true; m.userData = { i, pw, ph }; packs.add(m);
