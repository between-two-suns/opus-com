      if (x0 != null) { t = (((tAt + (e.clientX - x0) / (W * 1.4)) % 1) + 1) % 1; hold = performance.now() + 2500; } }, { passive: true });
    const end = () => { x0 = null; el.classList.remove('is-drag'); }; addEventListener('pointerup', end); addEventListener('pointercancel', end);
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) ask(); }).observe(el);
    const go = () => { size(); ask(); };
    (document.fonts && document.fonts.load ? document.fonts.load("700 100px 'BTS Display'").catch(() => {}) : Promise.resolve()).then(go);
    el.__at = { set: (v) => { t = v; hold = 1e15; } };
  }
})();
</script>

