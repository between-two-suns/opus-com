    });
    const blobCv = document.createElement('canvas'); blobCv.width = blobCv.height = 128; { const c = blobCv.getContext('2d'), g = c.createRadialGradient(64, 64, 4, 64, 64, 62); g.addColorStop(0, 'rgba(40,30,22,.75)'); g.addColorStop(1, 'rgba(40,30,22,0)'); c.fillStyle = g; c.fillRect(0, 0, 128, 128); }
    const blobTex = new T.CanvasTexture(blobCv);

    /* ---- palm shadows: fronds that hang between the sun and the wall, seen only as their shadows ---- */
    const frondCv = document.createElement('canvas'); frondCv.width = frondCv.height = 512;
    { const c = frondCv.getContext('2d'); c.translate(256, 500); c.strokeStyle = '#000'; c.fillStyle = '#000'; c.lineCap = 'round';
      c.lineWidth = 7; c.beginPath(); c.moveTo(0, 0); c.quadraticCurveTo(-30, -250, 40, -470); c.stroke();
      for (let i = 0; i < 26; i++) { const k = i / 25, y = -30 - k * 430, x = -30 * Math.sin(k * 2.2) + k * k * 40, len = 190 * Math.sin(Math.PI * (.12 + k * .85)) + 30;
        [-1, 1].forEach((sd) => { c.save(); c.translate(x, y); c.rotate(sd * (1.02 - k * .5) + .12); c.beginPath(); c.moveTo(0, 0); c.quadraticCurveTo(len * .5, -9, len, 3); c.quadraticCurveTo(len * .5, 12, 0, 5); c.fill(); c.restore(); }); } }
    const frondTex = new T.CanvasTexture(frondCv);
    const gobo = new T.Group(); scene.add(gobo); const fronds = [];
    [[-1.5, 1.2, 0, 2.3, .5], [-.55, 1.55, .12, 2.0, -.35], [.5, 1.35, -.1, 2.2, .2], [1.5, 1.6, .2, 1.9, -.6], [-2.3, .6, 0, 1.8, 1.1]].forEach(([x, y, z, sz, rot], i) => {
      const m = new T.Mesh(new T.PlaneGeometry(sz, sz), new T.MeshBasicMaterial({ map: frondTex, alphaTest: .5, side: T.DoubleSide, colorWrite: false, depthWrite: false }));
      m.position.set(x, y, z); m.rotation.z = rot; m.castShadow = true; m.userData = { rot, ph: i * 1.7 }; gobo.add(m); fronds.push(m);
    });

    /* ---- the light ---- */
    const sun = new T.DirectionalLight(0xffffff, 3); sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048); sun.shadow.radius = 7; sun.shadow.blurSamples = 14; sun.shadow.bias = -.0004;
    const sc = sun.shadow.camera; sc.left = -3.4; sc.right = 3.4; sc.top = 3.2; sc.bottom = -1.6; sc.near = .5; sc.far = 16; scene.add(sun, sun.target);
    const hemi = new T.HemisphereLight(0xdfe9ff, 0xe6d6bd, .9); scene.add(hemi);
    const lamp = new T.PointLight(0xffb776, 0, 9, 1.6); lamp.position.set(2.6, 1.1, 1.6); scene.add(lamp);
    const bounce = new T.DirectionalLight(0xfff1dc, .25); bounce.position.set(0, .6, 5); scene.add(bounce);

    let W = 0, H = 0, portrait = null, focus = new T.Vector3(0, .62, 0), packX = 1;
    const layout = () => {
      let x = packX / packs.scale.x - packs.children.filter((m) => m.userData.pw).reduce((a, m) => a + m.userData.pw + .05, -.05) / 2;
      [0, 1, 2, 3].forEach((i) => { const m = packs.children.find((c) => c.userData.i === i), b = packs.children.find((c) => c.userData.blobOf === i); if (!m) return; m.position.set(x + m.userData.pw / 2, m.userData.ph / 2, .3); if (b) b.position.set(m.position.x, .004, .33); x += m.userData.pw + .05; });
    };
    const size = () => {
      W = el.clientWidth; H = el.clientHeight; renderer.setPixelRatio(Math.min(devicePixelRatio || 1, W < 750 ? 2 : 1.6)); renderer.setSize(W, H, false);
      const p = W / H < .9; cam.aspect = W / H;
      if (p) { const need = 2.3 / cam.aspect; cam.fov = 2 * Math.atan(need / 2 / 5.0) * 180 / Math.PI; focus.set(0, .47, 0); packX = 0; packs.scale.setScalar(1.45); } else { cam.fov = 28; focus.set(0, .66, 0); packX = 1.02; packs.scale.setScalar(1); }
      cam.updateProjectionMatrix(); if (p !== portrait) { portrait = p; paintWall(p); } if (ready) layout();
    };

    /* ---- the day: 0 sunrise → .58 sunset → blue hour → 1 the next sunrise ---- */
    const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v)), mix = (a, b, k) => a + (b - a) * k, sm = (a, b, v) => { const k = clamp((v - a) / (b - a)); return k * k * (3 - 2 * k); };
    const cWarm = new T.Color(0xffb26a), cNoon = new T.Color(0xfff8ee), cSkyD = new T.Color(0xeaf0ff), cSkyN = new T.Color(0x93a2ee), cGrD = new T.Color(0xf0e6d6), cGrN = new T.Color(0x6a70b4), tmp = new T.Color();
    const SET = .58, lines = [...el.querySelectorAll('.at-lines li')], timeEl = el.querySelector('[data-time]'), nowEl = el.querySelector('[data-now]');
    const STORY = [[0, '06:00', 'Today’s sun', 0], [.1, '13:00', 'Out in the day', 1], [.46, '18:00', 'Evening', 1], [.6, '22:00', 'Night', 2], [.9, '06:00', 'Tomorrow’s sun', 3]];
    let t = .03, step = -1, px = 0, py = 0;
    const apply = (now) => {
      const day = t < SET ? t / SET : -1, dawn = t > .9 ? (t - .9) / .1 : -1;
