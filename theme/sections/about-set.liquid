{%- comment -%}
  About hero prototype G · "One day of light" (demo only, /pages/about?view=set).
  A sunlit still life, rendered live (three.js). The four packs stand on a stone ledge in front of a plaster wall
  with the name painted on it. A real light moves through one whole day: today's sun rises low and warm from one
  side, climbs, crosses and sets on the other; the blue hour, with a warm lamp; then tomorrow's sun rises. Because
  the light is real, so is everything it does: the packs' shadows swing across the wall and over the name, stretch
  long at the ends of the day, palm shadows drift in the breeze, the stone and the wall warm and cool. It plays
  slowly by itself; drag sideways to move the sun. One screen, nothing pinned, no running clock.
  No WebGL, or reduced motion: a still picture of the morning (the packs and the name), no script.
  Prototype: English only; three.js is loaded from cdnjs for the demo.
{%- endcomment -%}
<style>
.at { position: relative; margin-block-start: calc(-1 * var(--header-h)); block-size: 100svh; min-block-size: 560px; overflow: clip; isolation: isolate; background: #efe7da; color: var(--c-ink); touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
.at.is-drag { cursor: grabbing; }
.at[data-dark] { color: #fff; }
.at-gl { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; z-index: -1; opacity: 0; transition: opacity 1.2s ease; }
.at.is-live .at-gl { opacity: 1; }
.at-still { position: absolute; inset: 0; z-index: -2; display: grid; align-content: center; justify-items: center; gap: 4svh; padding-block-start: var(--header-h); transition: opacity .8s ease; }
.at.is-live .at-still { opacity: 0; }
.at-still h1 { margin: 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: .9; font-size: clamp(64px, 11vw, 200px); text-align: center; }
.at-still ul { margin: 0; padding: 0; list-style: none; display: flex; align-items: flex-end; gap: 12px; block-size: 30svh; }
.at-still li { block-size: calc(var(--h) * 100%); aspect-ratio: 357 / 1100; } .at-still img { inline-size: 100%; block-size: 100%; object-fit: contain; object-position: bottom; }
.at-eyebrow { position: absolute; inset-inline-end: var(--gutter); inset-block-start: calc(var(--header-h) + 4svh); margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; transition: color .6s; }
.at-cap { position: absolute; inset-inline-start: var(--gutter); inset-block-end: calc(var(--dock-h, 0px) + clamp(18px, 4svh, 44px)); margin: 0; display: grid; gap: 8px; max-inline-size: 30ch; transition: color .6s; pointer-events: none; }
.at-now { display: inline-flex; align-items: baseline; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
.at-now b { font-family: var(--font-display); font-size: 26px; letter-spacing: .03em; font-variant-numeric: tabular-nums; }
.at-lines { display: grid; margin: 0; padding: 0; list-style: none; }
.at-lines li { grid-area: 1 / 1; font-size: clamp(17px, 1.5vw, 23px); line-height: 1.32; font-weight: 520; letter-spacing: -.01em; opacity: 0; translate: 0 8px; transition: opacity .7s ease, translate .8s cubic-bezier(.2, .75, .2, 1); text-wrap: balance; }
.at-lines li.is-on { opacity: 1; translate: 0 0; }
.at-hint { position: absolute; inset-inline-end: var(--gutter); inset-block-end: calc(var(--dock-h, 0px) + clamp(18px, 4svh, 44px)); margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; opacity: .75; pointer-events: none; transition: color .6s; }
@media (max-width: 749px) {
  .at { margin-block-start: 0; block-size: calc(100svh - var(--header-h)); }
  .at-eyebrow { display: none; }
  .at-cap { inset-inline: 18px; max-inline-size: none; justify-items: center; text-align: center; inset-block-end: calc(var(--dock-h, 0px) + 12px); }
  .at-lines li { font-size: 15px; }
  .at-hint { display: none; }
}
</style>
<section class="at" data-at aria-labelledby="AtTitle-{{ section.id }}"
  data-three="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js"
  data-packs="{{ 'cut-daily-reset-cleanser.webp' | asset_url }}|{{ 'cut-clarity-serum.webp' | asset_url }}|{{ 'cut-daily-barrier-moisturizing-cream.webp' | asset_url }}|{{ 'cut-daily-defense-sunscreen-spf-50.webp' | asset_url }}">
  <canvas class="at-gl" aria-hidden="true"></canvas>
  <div class="at-still">
    <h1 id="AtTitle-{{ section.id }}">Between<br>two suns</h1>
    <ul role="list" aria-hidden="true">
      <li style="--h: 1"><img src="{{ 'cut-daily-reset-cleanser.webp' | asset_url }}" alt=""></li><li style="--h: .65"><img src="{{ 'cut-clarity-serum.webp' | asset_url }}" alt=""></li><li style="--h: .81"><img src="{{ 'cut-daily-barrier-moisturizing-cream.webp' | asset_url }}" alt=""></li><li style="--h: .81"><img src="{{ 'cut-daily-defense-sunscreen-spf-50.webp' | asset_url }}" alt=""></li>
    </ul>
  </div>
  <p class="at-eyebrow">About</p>
  <div class="at-cap">
    <p class="at-now" style="margin: 0" aria-hidden="true"><b data-time>06:00</b><span data-now>Today’s sun</span></p>
    <ol class="at-lines" role="list">
      <li class="is-on">Two suns: today’s, and tomorrow’s.</li>
      <li>Between them, a whole day happens to your skin.</li>
      <li>Then the night, and the second half of the routine.</li>
      <li>That space between is what we make skincare for.</li>
    </ol>
  </div>
  <p class="at-hint" aria-hidden="true">Drag to move the sun</p>
</section>
<script>
(() => {
  const el = document.currentScript.previousElementSibling; if (!el || !el.matches('[data-at]')) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const probe = document.createElement('canvas'); if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) return;
  const s = document.createElement('script'); s.src = el.dataset.three; s.async = true; s.onload = () => { try { boot(); } catch (e) { console.warn('about-set', e); } }; document.head.appendChild(s);

  function boot() {
    const T = window.THREE, cv = el.querySelector('.at-gl');
    const renderer = new T.WebGLRenderer({ canvas: cv, antialias: true, powerPreference: 'high-performance' });
    renderer.shadowMap.enabled = true; renderer.shadowMap.type = T.VSMShadowMap;
    renderer.toneMapping = T.ACESFilmicToneMapping; renderer.outputColorSpace = T.SRGBColorSpace;
    const scene = new T.Scene(), cam = new T.PerspectiveCamera(28, 1, .1, 60);
    const rnd = (() => { let a = 7; return () => ((a = (a * 16807) % 2147483647) / 2147483647); })();

