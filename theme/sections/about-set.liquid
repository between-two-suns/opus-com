        const blob = new T.Mesh(new T.PlaneGeometry(pw * 1.7, pw * .7), new T.MeshBasicMaterial({ map: blobTex, transparent: true, depthWrite: false, opacity: .5 })); blob.rotation.x = -Math.PI / 2; blob.userData = { blobOf: i }; packs.add(blob);
        if (!--pending) { ready = true; layout(); el.classList.add('is-live'); }
