{%- comment -%}
  Routines hero · studio demo (DECISIONS 206–208, shown at /pages/routines?view=light while it is reviewed). Flat ivory by day, ink
  with stars by night; the packs grounded and large with a tight contact shadow; one sun (the home page's sage sphere) peeking in
  behind them. The AM/PM switch sets the sun (it slides out of the frame) as the night and its stars fade in, and brings it back
  for the morning; the sunscreen steps away. Everything runs on one timeline (DECISIONS 208: the circle reveal flashed blank on
  Safari). Same copy, switch, buttons and links as the hero-routine section.
{%- endcomment -%}
{%- liquid
  assign full = all_products['the-full-ritual']
  assign night = all_products['the-night-ritual']
  assign all_url = routes.collections_url | append: '/all'
  assign handles = 'daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign hs = '1,.65,.81,.81' | split: ','
  assign ars = '357/1100,366/1100,343/1100,339/1100' | split: ','
  assign after = 'sections.hero_routine.after' | t
-%}
<style>
.hr-copy { position: absolute; z-index: 4; inset-inline-start: 6vw; top: calc(var(--hdr, var(--header-h)) + 7svh); width: min(560px, 40vw); }
.hr-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
.hr-title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: .96; letter-spacing: -.01em; margin-top: 18px; font-size: clamp(60px, min(8vw, 13.6svh), 160px); }
/* the rolling word's window reaches just past the letters' foot (at this line height the line box ends above the baseline), so nothing is clipped at rest. Both words share one grid cell,
   so the box is always as wide as the wider word and the headline wraps the same in the morning and the evening */
.hr-title .hr-swap { display: inline-grid; overflow: hidden; vertical-align: top; padding-bottom: .08em; margin-bottom: -.08em; }
.hr-title .hr-swap > span { grid-area: 1 / 1; justify-self: start; transition: translate 1s cubic-bezier(.7,0,.2,1), opacity .6s; }
.hr-title .hr-swap .hr-pm { translate: 0 calc(100% + .3em); opacity: 0; }
/* the evening word is drawn from data-w, so the page's heading reads "Your morning routine." to search engines (not "morningevening", DECISIONS 209) */
.hr-title .hr-swap .hr-pm::before { content: attr(data-w); }
.lh-hero[data-mode='pm'] .hr-title .hr-swap .hr-am { translate: 0 calc(-100% - .3em); opacity: 0; }
.lh-hero[data-mode='pm'] .hr-title .hr-swap .hr-pm { translate: 0 0; opacity: 1; }
.hr-lede { margin-top: 20px; font-size: 17px; line-height: 1.55; color: color-mix(in srgb, currentColor 76%, transparent); max-width: 34ch; }
.hr-lede { display: grid; } .hr-lede > span { grid-area: 1 / 1; transition: opacity .45s ease .45s, visibility 0s; }
.hr-lede .hr-pm, .lh-hero[data-mode='pm'] .hr-lede .hr-am { opacity: 0; visibility: hidden; transition: opacity .35s ease, visibility 0s linear .35s; }
.lh-hero[data-mode='pm'] .hr-lede .hr-pm { opacity: 1; visibility: visible; transition: opacity .45s ease .45s, visibility 0s; }

/* the switch is the mark: left arc, the first sun; right arc, the second */
.hr-switch { position: relative; display: inline-flex; align-items: center; margin-top: 28px; padding: 6px; border-radius: 999px; background: color-mix(in srgb, currentColor 7%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 16%, transparent); transition: background .6s, box-shadow .6s; }
.hr-switch::before { content: ''; position: absolute; top: 6px; bottom: 6px; inset-inline-start: 6px; width: calc(50% - 6px); border-radius: 999px; background: var(--c-ink); transition: translate .7s cubic-bezier(.65,0,.25,1), background .6s; }
.lh-hero[data-mode='pm'] .hr-switch::before { background: #f7f3ee; }
.lh-hero[data-mode='pm'] .hr-switch::before { translate: calc(100% * var(--dir)) 0; }
.hr-switch button { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 10px; font: inherit; font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: inherit;
  background: none; border: 0; padding: 12px 22px; border-radius: 999px; cursor: pointer; opacity: .62; transition: opacity .4s, color .5s; min-width: 116px; justify-content: center; }
.hr-switch button[aria-checked='true'] { opacity: 1; color: #f7f3ee; }
.lh-hero[data-mode='pm'] .hr-switch button[aria-checked='true'] { color: var(--c-ink); }
.hr-switch .hr-mark { position: absolute; z-index: 2; left: 50%; top: 50%; translate: -50% -50%; height: 30px; width: auto; pointer-events: none; }
.hr-arc { transition: fill .7s; }
.hr-arc--am { fill: rgb(125 185 147); } .hr-arc--pm { fill: rgb(28 30 48 / .22); }
.lh-hero[data-mode='pm'] .hr-arc--am { fill: rgb(255 255 255 / .28); } .lh-hero[data-mode='pm'] .hr-arc--pm { fill: rgb(171 193 233); }

.hr-ctas { margin-top: 22px; flex-wrap: nowrap; }
.hr-base { position: absolute; z-index: 4; inset-inline: 6vw; bottom: 4svh; }
.hr-ctas { display: flex; gap: 12px; flex-wrap: nowrap; }
.hr-btn { display: inline-flex; align-items: center; gap: 12px; white-space: nowrap; padding: 17px 26px; border-radius: 999px; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; transition: background .3s, gap .3s; }
.hr-btn--main { background: var(--c-ink); color: #F4EFE7; transition: background .5s, color .5s, gap .3s; } .hr-btn--main:hover { gap: 18px; }
.hr-btn--ghost { color: inherit; background: transparent; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, currentColor 70%, transparent); }
.lh-hero[data-mode='pm'] .hr-btn--main { background: #f7f3ee; color: var(--c-ink); }
/* the main button flips at the middle of the switch (label and colours together), so it is never grey on grey */
.lh-hero .hr-btn--main { transition: background .12s linear calc(var(--t) * .4), color .12s linear calc(var(--t) * .4), gap .3s; }
/* both labels share one cell (the button keeps one width) and change at the middle of the switch, with its colours */
.hr-lbl { display: inline-grid; } .hr-lbl > span { grid-area: 1 / 1; justify-self: center; transition: visibility 0s linear calc(var(--t) * .45); }
.hr-lbl .hr-pm, .lh-hero[data-mode='pm'] .hr-lbl .hr-am { visibility: hidden; } .lh-hero[data-mode='pm'] .hr-lbl .hr-pm { visibility: visible; }
.hr-climate { display: flex; gap: 8px 18px; flex-wrap: wrap; list-style: none; padding: 0; font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: color-mix(in srgb, currentColor 64%, transparent); }
.hr-climate li + li::before { content: '·'; margin-inline-end: 18px; }


/* ---------- Routines hero, studio demo (DECISIONS 207–208) ----------
   Calm studio: flat ivory by day, ink by night, the packs grounded and large with only a tight contact shadow. No faked
   light. The switch is the moment, on one timeline (--t): the sun slides down and out of the frame as the night and its
   stars fade in and the type turns light; the packs glide together and the sunscreen steps away. Morning reverses it. */
.lh-hero { --dir: 1; --t: 1.1s; --ease: cubic-bezier(.65,0,.3,1); position: relative; height: calc(100svh - 36px); min-height: 620px; margin-top: calc(-1 * var(--hdr, var(--header-h))); overflow: hidden; isolation: isolate; color: var(--c-ink); transition: color calc(var(--t) * .8) var(--ease) calc(var(--t) * .1); }
[dir='rtl'] .lh-hero { --dir: -1; }
.lh-hero[data-mode='pm'] { color: #f7f3ee; }
.lh-sky { position: absolute; inset: 0; z-index: -3; background: var(--c-daylight, #F5F1EA); }
/* the night: one ink layer over the day, opacity only */
.lh-night { position: absolute; inset: 0; z-index: -2; background: #22263d; opacity: 0; transition: opacity var(--t) var(--ease); }
.lh-hero[data-mode='pm'] .lh-night { opacity: 1; }
/* stars: two fields that come out after the dark has settled and drift up a touch; the smaller ones twinkle slowly */
.lh-stars { position: absolute; inset: 0; opacity: 0; translate: 0 10px; transition: opacity .5s ease, translate .5s ease; }
.lh-hero[data-mode='pm'] .lh-stars { opacity: 1; translate: 0 0; transition: opacity 1.2s ease calc(var(--t) * .55), translate 1.6s cubic-bezier(.2,.7,.2,1) calc(var(--t) * .55); }
.lh-stars--b { transition-delay: 0s; }
.lh-hero[data-mode='pm'] .lh-stars--b { transition-delay: calc(var(--t) * .8); }
.lh-stars--a { background:
  radial-gradient(1.6px 1.6px at 7% 16%, #fff 99%, transparent), radial-gradient(1.3px 1.3px at 19% 34%, #fff 99%, transparent),
  radial-gradient(1.8px 1.8px at 31% 11%, #fff 99%, transparent), radial-gradient(1.2px 1.2px at 46% 27%, #fff 99%, transparent),
  radial-gradient(1.6px 1.6px at 58% 8%, #fff 99%, transparent), radial-gradient(1.3px 1.3px at 71% 21%, #fff 99%, transparent),
  radial-gradient(2px 2px at 84% 12%, #fff 99%, transparent), radial-gradient(1.4px 1.4px at 94% 31%, #fff 99%, transparent),
  radial-gradient(1.2px 1.2px at 3% 61%, #fff 99%, transparent), radial-gradient(1.5px 1.5px at 38% 52%, #fff 99%, transparent),
  radial-gradient(1.2px 1.2px at 64% 44%, #fff 99%, transparent), radial-gradient(1.6px 1.6px at 89% 56%, #fff 99%, transparent); }
.lh-stars--b > span { position: absolute; inset: 0; animation: lh-twinkle 5s ease-in-out infinite alternate; background:
  radial-gradient(1px 1px at 12% 8%, rgb(255 255 255 / .8) 99%, transparent), radial-gradient(1px 1px at 25% 22%, rgb(255 255 255 / .7) 99%, transparent),
  radial-gradient(1px 1px at 37% 39%, rgb(255 255 255 / .8) 99%, transparent), radial-gradient(1px 1px at 52% 17%, rgb(255 255 255 / .7) 99%, transparent),
  radial-gradient(1px 1px at 66% 33%, rgb(255 255 255 / .8) 99%, transparent), radial-gradient(1px 1px at 77% 6%, rgb(255 255 255 / .7) 99%, transparent),
  radial-gradient(1px 1px at 91% 19%, rgb(255 255 255 / .8) 99%, transparent), radial-gradient(1px 1px at 9% 45%, rgb(255 255 255 / .7) 99%, transparent),
  radial-gradient(1px 1px at 28% 68%, rgb(255 255 255 / .6) 99%, transparent), radial-gradient(1px 1px at 55% 60%, rgb(255 255 255 / .6) 99%, transparent),
  radial-gradient(1px 1px at 79% 41%, rgb(255 255 255 / .7) 99%, transparent), radial-gradient(1px 1px at 97% 48%, rgb(255 255 255 / .6) 99%, transparent); }
.lh-stars--b > span + span { animation-duration: 7s; animation-delay: -3s; translate: 3% 5%; }
@keyframes lh-twinkle { from { opacity: .25; } to { opacity: 1; } }
.lh-hero[data-mode='am'] .lh-stars--b > span { animation-play-state: paused; }
/* the sun: one sphere peeking in from the edge behind the packs; in the evening it slides down and out of the frame */
.lh-suns { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
.lh-sun { --sd: min(76svh, 50vw); inline-size: var(--sd); inset-inline-end: calc(var(--sd) * -.34); top: calc(var(--hdr, var(--header-h)) - 2svh);
  transition: translate var(--t) cubic-bezier(.5,0,.25,1) calc(var(--t) * .12); }
.lh-hero[data-mode='pm'] .lh-sun { translate: calc(var(--sd) * .78 * var(--dir)) calc(var(--sd) * .42); transition: translate var(--t) cubic-bezier(.6,0,.4,1); }

/* the stage: the right part of the screen on laptops */
.lh-stage { position: absolute; z-index: 1; inset-block: var(--hdr, var(--header-h)) 0; inset-inline: 42vw 4vw; }
/* the packs: low and large, standing on the floor of the frame */
.lh-lineup { --gap: clamp(10px, 1.4vw, 22px); --base: min(59svh, 30vw, 540px); --slot: calc(var(--base) * .81 * 339 / 1100 + 2 * var(--gap));
  position: absolute; z-index: 2; inset-inline: 0; inset-block-end: 13svh; margin: 0; padding: 0; list-style: none; display: flex; justify-content: center; align-items: flex-end; }
.lh-pack { position: relative; height: calc(var(--h) * var(--base)); aspect-ratio: var(--ar); margin-inline: var(--gap); }
.lh-g { position: absolute; inset: 0; transition: translate .9s cubic-bezier(.65,0,.2,1); }
.lh-img { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; transition: translate .5s cubic-bezier(.2,.75,.2,1); }
/* where the pack meets the floor: one tight, soft contact shadow */
.lh-contact { position: absolute; z-index: 2; inset-inline: 3%; inset-block-end: -7px; block-size: 14px; border-radius: 50%;
  background: radial-gradient(closest-side, rgb(32 35 58 / .3), transparent); filter: blur(2px); transition: background .6s; }
.lh-hero[data-mode='pm'] .lh-contact { background: radial-gradient(closest-side, rgb(0 0 0 / .6), transparent); }
/* evening: the sunscreen steps away and the other three glide over to stay centred */
.lh-hero[data-mode='pm'] .lh-pack:not(.lh-pack--spf) .lh-g { translate: calc(var(--slot) / 2 * var(--dir)) 0; transition-delay: .1s; }
.lh-pack--spf .lh-g { transition: translate .9s cubic-bezier(.65,0,.2,1), opacity .5s ease .2s, visibility 0s; }
.lh-hero[data-mode='pm'] .lh-pack--spf .lh-g { translate: calc(var(--slot) * .8 * var(--dir)) 0; opacity: 0; visibility: hidden; transition: translate .9s cubic-bezier(.65,0,.2,1), opacity .35s ease, visibility 0s linear .9s; }
.lh-g a { position: absolute; inset: 0; z-index: 6; }
@media (hover: hover) { .lh-pack:hover .lh-img, .lh-pack:focus-within .lh-img { translate: 0 -8px; } }
.lh-g a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

/* copy: the same headline, switch and buttons as before */
.hr-copy { top: calc(var(--hdr, var(--header-h)) + 8svh); }
.lh-foot { display: none; }

/* phones and portrait tablets: copy on top, the stage in the middle, buttons at the foot */
@media (max-width: 760px), (max-aspect-ratio: 4/5) {
  .lh-hero { display: flex; flex-direction: column; box-sizing: border-box; min-height: 0;
    padding: calc(var(--hdr, var(--header-h)) + 3svh) 5vw calc(var(--dock-h, 0px) + 2.4svh); }
  .hr-copy { position: relative; inset: auto; top: auto; width: auto; text-align: center; }
  .hr-eyebrow, .hr-lede, .hr-copy .hr-ctas { display: none; }
  .hr-title { font-size: min(15.4vw, 8svh); margin-top: 0; }
  .hr-switch { margin-top: 16px; } .hr-switch button { min-width: 104px; padding: 11px 16px; font-size: 12px; }
  .lh-stage { position: relative; inset: auto; flex: 1 1 0; min-height: 0; margin-top: 1svh; }
  .lh-lineup { container-type: size; inset-block: 0 6%; inset-inline: 0; --gap: 5px;
    --base: min(86cqh, (100cqw - 8 * var(--gap)) / 1.1, 420px); }
  .lh-sun { --sd: min(92vw, 52svh); inset-inline-end: calc(var(--sd) * -.4); top: 27%; }
  .lh-foot { display: block; position: relative; flex: none; margin-top: 1.5svh; }
  .lh-foot .hr-ctas { display: flex; width: 100%; flex-direction: column; } .lh-foot .hr-btn { justify-content: center; padding: 16px; } .lh-foot .hr-btn--ghost { display: none; }
}
@media (max-height: 760px) and (min-width: 761px) and (min-aspect-ratio: 4/5) { .hr-title { font-size: clamp(52px, min(8vw, 12svh), 150px); } }
.lh-hero.is-instant, .lh-hero.is-instant *, .lh-hero.is-instant *::before, .lh-hero.is-instant *::after { transition: none !important; }
@media (prefers-reduced-motion: reduce) { .lh-hero *, .lh-hero *::before, .lh-hero *::after { transition-duration: 0s !important; animation: none !important; } }
/* a gentle entrance */
.js .lh-pack { animation: lh-rise 1.1s cubic-bezier(.2,.75,.2,1) both; animation-delay: calc(var(--i) * 90ms + 150ms); }
@keyframes lh-rise { from { opacity: 0; transform: translateY(24px); } }
@keyframes hr-in { from { opacity: 0; translate: 0 24px; } }
.js .hr-copy > * { animation: hr-in .9s cubic-bezier(.2,.75,.2,1) both; }
.js .hr-copy > :nth-child(2) { animation-delay: .06s; } .js .hr-copy > :nth-child(3) { animation-delay: .12s; } .js .hr-copy > :nth-child(4) { animation-delay: .18s; } .js .hr-copy > :nth-child(5) { animation-delay: .24s; }
@media (prefers-reduced-motion: reduce) { .js .lh-pack, .js .hr-copy > * { animation: none; } }
:lang(ar) .hr-title { text-transform: none; line-height: 1.15; font-size: clamp(56px, min(7.6vw, 12svh), 150px); }
:lang(ar) .hr-eyebrow, :lang(ar) .hr-switch button, :lang(ar) .hr-btn, :lang(ar) .hr-climate { letter-spacing: 0; }
@media (max-width: 760px), (max-aspect-ratio: 4/5) { :lang(ar) .hr-title { font-size: min(14vw, 7.4svh); } }
[dir='rtl'] .hr-btn--main svg { transform: scaleX(-1); }
</style>
<section class="lh-hero" id="Hr-{{ section.id }}" data-mode="am" data-am-href="{{ full.url | default: all_url }}" data-pm-href="{{ night.url | default: all_url }}" aria-labelledby="HrTitle-{{ section.id }}">
  <div class="lh-sky" aria-hidden="true"></div>
  <div class="lh-night" aria-hidden="true"><span class="lh-stars lh-stars--a"></span><span class="lh-stars lh-stars--b"><span></span><span></span></span></div>
  <div class="lh-suns" aria-hidden="true">
    {%- render 'about-orb', tone: 'green', side: 'start', class: 'lh-sun ab-orb--top', sizes: '(min-width: 761px) 40vw, 86vw', priority: true -%}
  </div>
  <div class="hr-copy">
    <p class="hr-eyebrow">{{ 'sections.hero_panels.eyebrow' | t }}</p>
    <h1 class="hr-title" id="HrTitle-{{ section.id }}">{{ 'sections.hero_routine.before' | t }} <span class="hr-swap"><span class="hr-am">{{ 'sections.hero_routine.am' | t }}</span><span class="hr-pm" aria-hidden="true" data-w="{{ 'sections.hero_routine.pm' | t | escape }}"></span></span>{% if after != blank %}{{ ' ' }}<br>{{ after }}{% endif %}</h1>
    <p class="hr-lede"><span class="hr-am">{{ 'sections.hero_routine.lede_am' | t }}</span><span class="hr-pm">{{ 'sections.hero_routine.lede_pm' | t }}</span></p>
    <div class="hr-switch" role="radiogroup" aria-label="{{ 'sections.hero_routine.switch' | t }}">
      <button type="button" role="radio" aria-checked="true" data-mode="am"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg> {{ 'sections.hero_routine.am_label' | t }}</button>
      <button type="button" role="radio" aria-checked="false" data-mode="pm">{{ 'sections.hero_routine.pm_label' | t }} <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" fill="currentColor"/></svg></button>
      <svg class="hr-mark" viewBox="0 0 501 547" aria-hidden="true" focusable="false"><path class="hr-arc hr-arc--am" d="M2.66924 0.000534727C13.8978 -0.0776124 39.3353 8.4295 50.0693 12.562C114.374 37.317 161.913 86.5377 189.447 149.42C222.326 223.262 224.551 307.181 195.63 382.669C169.731 448.998 122.891 498.719 57.8246 527.266C50.9638 530.162 10.5353 546.188 6.16675 540.003C6.92711 537.615 15.4177 533.15 18.0182 531.551C30.9838 523.498 43.1447 514.212 54.3322 503.821C179.437 386.891 178.378 158.888 54.6155 41.6992C44.6109 32.2678 33.7982 23.7363 22.3013 16.2048C19.3235 14.2527 0.603598 3.34994 0 2.08782C0.691623 0.563537 0.721794 0.963506 2.66924 0.000534727Z"/><path class="hr-arc hr-arc--pm" d="M485.418 540.727C480.323 539.813 474.472 538.204 469.48 536.683C404.162 517.048 349.518 471.926 317.896 411.514C280.569 341.252 275.216 259.053 298.519 183.413C318.991 116.957 361.294 57.7036 423.579 24.8168C443.344 14.348 464.402 6.52641 486.21 1.5537C488.907 0.960578 499.257 -1.65223 500.343 1.60242C498.945 4.48993 493.684 7.08592 490.864 8.67457C476.842 16.5752 464.296 25.8703 452.206 36.5702C432.023 54.3842 414.677 75.1723 400.767 98.2165C355.36 172.084 341.72 271.124 362.152 354.995C381.198 433.175 420.724 493.087 489.395 535.312C491.257 536.374 493.389 537.263 494.398 539.062L494.341 540.198C492.035 542.156 488.17 541.287 485.418 540.727Z"/></svg>
    </div>
    <div class="hr-ctas">
      <a class="hr-btn hr-btn--main" href="{{ full.url | default: all_url }}"><span class="hr-lbl"><span class="hr-am">{{ 'sections.hero_routine.cta_am' | t }}</span><span class="hr-pm">{{ 'sections.hero_routine.cta_pm' | t }}</span></span> {% render 'icon', name: 'arrow', class: 'icon--sm' %}</a>
      <a class="hr-btn hr-btn--ghost" href="{{ all_url }}">{{ 'sections.hero_routine.cta_all' | t }}</a>
    </div>
  </div>
  <div class="lh-stage">
    <ul class="lh-lineup" role="list" aria-label="{{ 'sections.hero_routine.lineup' | t }}">
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {%- unless p.id -%}{%- continue -%}{%- endunless -%}
        {%- capture img -%}{%- render 'cut-src', handle: h, width: 360 -%}{%- endcapture -%}{%- capture img2 -%}{%- render 'cut-src', handle: h, width: 140 -%}{%- endcapture -%}{%- capture img3 -%}{%- render 'cut-src', handle: h, width: 200 -%}{%- endcapture -%}{%- capture img4 -%}{%- render 'cut-src', handle: h, width: 280 -%}{%- endcapture -%}
        {%- capture price -%}{% render 'egp', cents: p.selected_or_first_available_variant.price %}{%- endcapture -%}
        <li class="lh-pack{% if forloop.last %} lh-pack--spf{% endif %}" style="--h: {{ hs[forloop.index0] }}; --ar: {{ ars[forloop.index0] }}; --i: {{ forloop.index0 }}">
          <span class="lh-g">
            <span class="lh-contact" aria-hidden="true"></span>
            <img class="lh-img" src="{{ img | strip }}" srcset="{{ img2 | strip }} 140w, {{ img3 | strip }} 200w, {{ img4 | strip }} 280w, {{ img | strip }} 360w" sizes="(min-width: 761px) calc(13vw * {{ hs[forloop.index0] }}), calc(26vw * {{ hs[forloop.index0] }})" alt="" width="350" height="1100" fetchpriority="high">
            <a href="{{ p.url }}"><span class="visually-hidden">{{ p.title | escape }}, {{ price | strip }}</span></a>
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <div class="lh-foot">
    <div class="hr-ctas">
      <a class="hr-btn hr-btn--main" href="{{ full.url | default: all_url }}"><span class="hr-lbl"><span class="hr-am">{{ 'sections.hero_routine.cta_am' | t }}</span><span class="hr-pm">{{ 'sections.hero_routine.cta_pm' | t }}</span></span> {% render 'icon', name: 'arrow', class: 'icon--sm' %}</a>
      <a class="hr-btn hr-btn--ghost" href="{{ all_url }}">{{ 'sections.hero_routine.cta_all' | t }}</a>
    </div>
  </div>
</section>
<script>
(() => {
  const hero = document.getElementById('Hr-{{ section.id }}'); if (!hero) return;
  // tuck under the header by its section box (<site-header> is inline, and Safari measures an inline element by its text line only)
  const hw = document.querySelector('.site-header-wrap')?.closest('.shopify-section');
  const hdr = () => hero.style.setProperty('--hdr', hw.offsetHeight + 'px');
  if (hw) { hdr(); if (window.ResizeObserver) new ResizeObserver(hdr).observe(hw); }
  const btns = [...hero.querySelectorAll('.hr-switch [role=radio]')];
  function set(mode, focus) {
    hero.dataset.mode = mode;
    hero.querySelectorAll('.hr-btn--main').forEach((a) => { a.href = mode === 'pm' ? hero.dataset.pmHref : hero.dataset.amHref; });
    btns.forEach((b) => { const on = b.dataset.mode === mode; b.setAttribute('aria-checked', on); b.tabIndex = on ? 0 : -1; if (on && focus) b.focus(); });
    hero.querySelectorAll('.hr-swap > span').forEach((s) => s.toggleAttribute('aria-hidden', !s.classList.contains('hr-' + mode)));
  }
  btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.mode)));
  hero.querySelector('.hr-switch').addEventListener('keydown', (e) => {
    if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) { e.preventDefault(); set(hero.dataset.mode === 'am' ? 'pm' : 'am', true); }
  });
  // always opens on the morning routine (?mode=pm can link straight to the evening)
  const start = new URLSearchParams(location.search).get('mode') === 'pm' ? 'pm' : 'am';
  hero.classList.add('is-instant'); set(start); requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.remove('is-instant')));
})();
</script>

