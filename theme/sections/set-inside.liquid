{%- comment -%}
  Set pages (DECISIONS 189–190): what's inside. One card per product that opens its own page (the stage's packs jump
  here, #set-item-N), and the sizes, which are the same full sizes sold on their own. The saving is shown once, in the buy box (DECISIONS 228). Sizes are on each card, so no separate sizes list. Morning/night moves to "Your day" (set-day) and other sets to the
  comparison table (set-compare). Computed from the set definition (snippets/bundle-def) and live prices.
  Renders nothing on single products.
{%- endcomment -%}
{%- liquid
  capture bdef
    render 'bundle-def', handle: product.handle
  endcapture
  assign bdef = bdef | strip
-%}
{%- if bdef != blank -%}
{%- liquid
  assign bundle_steps = bdef | split: '|' | first | split: ','
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign buniq = bundle_steps | uniq
  assign who_key = 'bundle_inside.who.' | append: product.handle
  assign who = who_key | t | replace: '&amp;', '&'
  assign name_key = 'bundles.names.' | append: product.handle
  assign set_name = name_key | t | replace: '&amp;', '&'
  if set_name contains 'ranslation missing'
    assign set_name = product.title
  endif
-%}
<section class="section section--flow bi s2-inside" aria-labelledby="S2In-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'bundle_inside.eyebrow' | t }}</p>
        <h2 class="t-display-m" id="S2In-{{ section.id }}">{{ 'bundle_inside.heading' | t: count: bundle_steps.size }}</h2>
      </div>
      <div class="s2-inside__lede">
        {%- unless who contains 'ranslation missing' -%}<p class="t-lead t-muted bi__who">{{ who }}</p>{%- endunless -%}
        <p class="s2-inside__full">{% render 'icon', name: 'check', class: 'icon--sm' %}{{ 'set2.full_size' | t }}</p>
      </div>
    </div>

    <ol class="bi__items" role="list" style="--n: {{ buniq.size | at_least: 2 }}">
      {%- for st in buniq -%}
        {%- liquid
          assign si = st | plus: 0
          assign comp = all_products[step_handles[si]]
          assign q = 0
          for x in bundle_steps
            if x == st
              assign q = q | plus: 1
            endif
          endfor
          assign studio_key = 'bts-' | append: comp.handle | append: '-studio.jpg'
          assign studio = images[studio_key]
          if studio == blank
            assign studio = false
          endif
        -%}
        <li class="bi__item" data-step="{{ st }}" id="set-item-{{ st }}">
          <a class="bi__link" href="{{ comp.url }}">
            <span class="bi__media">
              {%- if studio -%}
                {{ studio | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(min-width: 990px) 22vw, 44vw', alt: '' }}
              {%- elsif comp.featured_media -%}
                {{ comp.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 22vw, 44vw', alt: '', class: 'bi__img--contain' }}
              {%- endif -%}
              {%- if q > 1 -%}<span class="bi__qty">× {{ q }}</span>{%- endif -%}
            </span>
            <span class="bi__body">
              <span class="step-tag">{{ 'product.step' | t: number: st }}{% if comp.metafields.bts.step_label != blank %} · {{ comp.metafields.bts.step_label.value | escape }}{% endif %}</span>
              <span class="bi__name">{{ comp.title | escape }}</span>
              {%- if comp.metafields.bts.benefit != blank -%}<span class="bi__benefit">{{ comp.metafields.bts.benefit.value | escape }}</span>{%- endif -%}
              <span class="bi__meta">
                {%- if comp.metafields.bts.size != blank -%}<span class="u-ltr">{{ comp.metafields.bts.size.value }}</span> · {% endif -%}
                {%- if comp.metafields.bts.when_to_use != blank -%}{{ comp.metafields.bts.when_to_use.value | escape }}{%- endif -%}
              </span>
              <span class="s2-inside__price">{% render 'egp', cents: comp.price %}{% if q > 1 %} × {{ q }}{% endif %}</span>
              <span class="s2-inside__view">{{ 'set2.view' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ol>

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Inside the set",
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
