{{ 'forecast.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.forecast.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.forecast.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.forecast.text' | t
  endif
  assign source = section.settings.collection | default: collections.all
  assign conditions = 'sun,city,humidity,ac,heat' | split: ','
  assign icons = 'sun,city,drop,wind,thermo' | split: ','
-%}
<skin-forecast
  class="forecast"
  id="forecast"
  data-money-format="{{ shop.money_format | escape }}"
  data-key-steps='{"sun":[4,2],"city":[1,3],"humidity":[1,2],"ac":[3,2],"heat":[1,4]}'
  data-time="am"
  data-zero-soon="{{ settings.zero_price_coming_soon }}"
  aria-labelledby="ForecastTitle-{{ section.id }}"
>
  <div class="forecast__ambient" aria-hidden="true">
    <span class="forecast__layer forecast__layer--base"></span>
    {%- for c in conditions -%}
      <span class="forecast__layer forecast__layer--{{ c }}"></span>
    {%- endfor -%}
  </div>

  <div class="container forecast__inner">
    <div class="forecast__panel">
      <p class="t-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="t-display-l forecast__title" id="ForecastTitle-{{ section.id }}">{{ heading | escape }}</h2>
      <p class="t-lead forecast__intro">{{ text | escape }}</p>

      <div class="forecast__instrument js-only">
        <fieldset class="forecast__time">
          <legend class="forecast__legend">{{ 'sections.forecast.time_legend' | t }}</legend>
          <div class="forecast__dial" aria-hidden="true">
            <svg viewBox="0 0 200 110" class="forecast__arc">
              <path d="M10 100 A90 90 0 0 1 190 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 6"/>
              <line x1="0" y1="100" x2="200" y2="100" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span class="forecast__orb forecast__orb--am"></span>
            <span class="forecast__orb forecast__orb--pm"></span>
          </div>
          <div class="forecast__seg" role="radiogroup" aria-label="{{ 'sections.forecast.time_legend' | t }}">
            <button type="button" class="forecast__seg-btn" role="radio" aria-checked="true" data-time-btn="am">
              {% render 'icon', name: 'sun', class: 'icon--sm' %} {{ 'sections.forecast.am' | t }}
            </button>
            <button type="button" class="forecast__seg-btn" role="radio" aria-checked="false" data-time-btn="pm">
              {% render 'icon', name: 'moon', class: 'icon--sm' %} {{ 'sections.forecast.pm' | t }}
            </button>
          </div>
        </fieldset>

        <fieldset class="forecast__conditions">
          <legend class="forecast__legend">{{ 'sections.forecast.conditions_legend' | t }}</legend>
          <div class="forecast__chips">
            {%- for c in conditions -%}
              {%- assign key = 'sections.forecast.conditions.' | append: c -%}
              <button type="button" class="chip forecast__chip" aria-pressed="false" data-condition="{{ c }}">
                {% render 'icon', name: icons[forloop.index0], class: 'icon--sm' %}
                <span>{{ key | t }}</span>
                <span class="forecast__arrow" aria-hidden="true">↑</span>
              </button>
            {%- endfor -%}
          </div>
          <p
            class="forecast__readout t-notation"
            aria-hidden="true"
            data-readout
            data-empty="{{ 'sections.forecast.readout_empty' | t | escape }}"
            {%- for c in conditions -%}
              {%- assign rk = 'sections.forecast.readout.' | append: c %} data-{{ c }}="{{ rk | t | escape }}"
            {%- endfor -%}
          >{{ 'sections.forecast.readout_empty' | t }}</p>
        </fieldset>
      </div>
    </div>

    <div class="forecast__routine">
      <div class="forecast__routine-head">
        <h3 class="t-subheading" data-routine-title data-am="{{ 'sections.forecast.routine_am' | t | escape }}" data-pm="{{ 'sections.forecast.routine_pm' | t | escape }}">{{ 'sections.forecast.routine_am' | t }}</h3>
        <p class="t-small t-muted js-only" data-routine-count data-template="{{ 'sections.forecast.count' | t: count: '__COUNT__' | escape }}"></p>
      </div>
      <ol class="forecast__steps" role="list">
        {%- for s in (1..4) -%}
          {%- for product in source.products limit: 12 -%}
            {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}
            {%- assign step = step | strip | plus: 0 -%}
            {%- if step == s -%}
              {%- liquid
                assign v = product.selected_or_first_available_variant
                assign cutout = product.metafields.bts.cutout.value
                assign pm = true
                if s == 4
                  assign pm = false
                endif
                assign default_reason = product.metafields.bts.benefit | default: product.metafields.bts.hero_ingredients
              -%}
              <li
                class="forecast__step"
                data-step="{{ s }}"
                data-variant="{{ v.id }}"
                data-price="{{ v.price }}"
                data-available="{{ v.available }}"
                data-pm="{{ pm }}"
                data-reason-default="{{ default_reason | escape }}"
                {%- for c in conditions -%}
                  {%- assign mf = 'forecast_' | append: c -%}
                  {%- assign r = product.metafields.bts[mf] -%}
                  {%- if r != blank %} data-reason-{{ c }}="{{ r | escape }}"{% endif -%}
                {%- endfor -%}
              >
                <label class="forecast__step-row">
                  <input type="checkbox" class="forecast__check js-only" checked data-include aria-describedby="ForecastReason-{{ section.id }}-{{ s }}">
                  <span class="forecast__thumb" aria-hidden="true">
                    {%- if cutout -%}
                      {{ cutout | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '64px', alt: '' }}
                    {%- elsif product.featured_media -%}
                      {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '64px', alt: '' }}
                    {%- endif -%}
                  </span>
                  <span class="forecast__step-text">
                    <span class="step-tag">{{ 'product.step' | t: number: s }}</span>
                    <span class="forecast__step-name">{{ product.title | escape }}</span>
                    <span class="forecast__reason" id="ForecastReason-{{ section.id }}-{{ s }}" data-reason>{{ default_reason | escape }}</span>
                  </span>
                  <span class="forecast__step-side">
                    <span class="forecast__key t-xs" data-key hidden>{{ 'sections.forecast.key_today' | t }}</span>
                    {%- render 'price', product: product, variant: v, class: 't-small' -%}
                  </span>
                </label>
                <a class="forecast__step-link t-xs" href="{{ product.url }}">{{ 'sections.forecast.view' | t }}<span class="visually-hidden"> {{ product.title | escape }}</span></a>
                <p class="forecast__pm-note t-xs t-muted" data-pm-note hidden>{{ 'sections.forecast.pm_skip' | t }}</p>
              </li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ol>

      <product-form data-multi data-forecast-form>
        <form method="post" action="{{ routes.cart_add_url }}" class="forecast__form">
          {%- for s in (1..4) -%}
            {%- for product in source.products limit: 12 -%}
              {%- capture step -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign step = step | strip | plus: 0 -%}
              {%- if step == s -%}
                <input type="hidden" name="items[][id]" value="{{ product.selected_or_first_available_variant.id }}" data-item-id="{{ s }}">
                <input type="hidden" name="items[][quantity]" value="1" data-item-qty="{{ s }}">
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          <button type="submit" class="btn btn--full forecast__cta" data-forecast-cta>
            <span class="btn__label" data-cta-label>{{ 'sections.forecast.cta' | t }}</span>
            <span class="btn__sep js-only" aria-hidden="true">·</span>
            <span class="btn__price js-only" data-total aria-live="polite"></span>
          </button>
          <p class="t-xs t-muted forecast__fine">{{ 'sections.forecast.fine' | t }}</p>
        </form>
      </product-form>
    </div>
  </div>
</skin-forecast>

<script src="{{ 'forecast.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:sections.forecast.name",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "t:general_schema.bilingual_fallback" },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "collection", "id": "collection", "label": "t:sections.forecast.collection" },
    { "type": "paragraph", "content": "t:sections.forecast.data_info" }
  ],
  "presets": [{ "name": "t:sections.forecast.name" }]
}
{% endschema %}
