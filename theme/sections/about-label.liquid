{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About, "Read the label with us" (DECISIONS 350, demo). One real pack (the Clarity Serum), large and still, while the
  reader scrolls six short notes; each note lights up one part of the printed label: front (key ingredients, what it
  does, the mark), then the pack turns to its back (directions in two languages, the full ingredient list in order,
  Made in Egypt). Everything pointed at is printed on the pack, so nothing is claimed that the pack doesn't say.
  Laptops: notes on one side, the pack sticky on the other, zooming gently to the part being read. Phones: the pack
  sticks to the top half, the notes scroll under it. Without JS or with reduced motion: the front, no highlight.
  Spot boxes are % of the 2:3 pack photo (bts-clarity-serum-front/back.png).
{%- endcomment -%}
{%- liquid
  assign front = images['bts-clarity-serum-front.png']
  assign back = images['bts-clarity-serum-back.png']
  assign gl_url = routes.root_url | append: '/pages/ingredients' | replace: '//', '/'
  comment
    side|left|top|width|height (in % of the photo)
  endcomment
  assign spots = 'f|30|74.4|40|4.2,f|34|77.8|32|5.8,f|44.5|82.6|11|7,b|29|50.4|42|8.6,b|29|69.6|42|9.6,b|29|83.6|19|10.2' | split: ','
-%}
<section class="section ab-lb" data-ab-lb aria-labelledby="AbLb-{{ section.id }}">
  <div class="container">
    <div class="ab-lb__head">
      <p class="t-eyebrow">{{ 'about2.lb_eyebrow' | t }}</p>
      <h2 class="t-display-m" id="AbLb-{{ section.id }}">{{ 'about2.lb_heading' | t }}</h2>
    </div>
    <div class="ab-lb__grid">
      <figure class="ab-lb__stage" data-side="f" aria-hidden="true">
        <div class="ab-lb__pack">
          {%- if front != blank and front.width != blank -%}{{ front | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 40vw, 80vw', alt: '', class: 'ab-lb__img ab-lb__img--f' }}{%- endif -%}
          {%- if back != blank and back.width != blank -%}{{ back | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 40vw, 80vw', alt: '', class: 'ab-lb__img ab-lb__img--b' }}{%- endif -%}
          {%- for sp in spots -%}
            {%- assign p = sp | split: '|' -%}
            <span class="ab-lb__spot" data-i="{{ forloop.index }}" data-side="{{ p[0] }}" style="--x: {{ p[1] }}%; --y: {{ p[2] }}%; --w: {{ p[3] }}%; --h: {{ p[4] }}%;"></span>
          {%- endfor -%}
        </div>
      </figure>
      <ol class="ab-lb__notes" role="list">
        {%- for sp in spots -%}
          {%- assign p = sp | split: '|' -%}
          {%- assign tk = 'about2.lb_' | append: forloop.index | append: '_t' -%}
          {%- assign bk = 'about2.lb_' | append: forloop.index | append: '_b' -%}
          <li class="ab-lb__note" data-i="{{ forloop.index }}" data-side="{{ p[0] }}">
            <span class="ab-lb__n" aria-hidden="true">0{{ forloop.index }}</span>
            <h3 class="ab-lb__t">{{ tk | t }}</h3>
            <p class="ab-lb__b">{{ bk | t }}</p>
            {%- if forloop.index == 5 -%}<a class="link-arrow" href="{{ gl_url }}">{{ 'about2.made_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !('IntersectionObserver' in window)) return;
    const stage = root.querySelector('.ab-lb__stage');
    const notes = [...root.querySelectorAll('.ab-lb__note')];
    const spots = [...root.querySelectorAll('.ab-lb__spot')];
    root.classList.add('is-live');
    const pick = (n) => {
      const i = n.dataset.i;
      stage.dataset.side = n.dataset.side;
      stage.dataset.i = i;
      notes.forEach((x) => x.classList.toggle('is-on', x === n));
      spots.forEach((s) => s.classList.toggle('is-on', s.dataset.i === i));
      const s = spots.find((x) => x.dataset.i === i);
      if (s) {
        stage.style.setProperty('--ox', `calc(${s.style.getPropertyValue('--x')} + ${s.style.getPropertyValue('--w')} / 2)`);
        stage.style.setProperty('--oy', `calc(${s.style.getPropertyValue('--y')} + ${s.style.getPropertyValue('--h')} / 2)`);
      }
    };
    // Laptops: the note crossing the middle of the screen. Phones: the pack sits over the top half, so the note whose
    // number has just come out from under it (a thin band just below the pack).
    const wide = matchMedia('(min-width: 990px)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && pick(e.target.closest('.ab-lb__note'))), { rootMargin: wide ? '-45% 0px -45% 0px' : '-56% 0px -36% 0px' });
    notes.forEach((n) => io.observe(wide ? n : n.querySelector('.ab-lb__n')));
    pick(notes[0]);
  })();
</script>

{% schema %}
{
  "name": "About · read the label",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
