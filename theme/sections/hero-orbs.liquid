{%- comment -%}
  Hero preview · "Two suns" orbs (only on /?view=orbs while it is reviewed; the other hero options stay as they are).
  The hand-off, framed by the two suns: two tactile spheres (sage left, periwinkle right; matte, powdery, dewy).
  Each sphere is three layers: its surface (assets/orb-*.webp, rendered with no direction of light, so it can turn),
  a fixed light on top (CSS: lit from the space between, shaded away from it) and a one-off glint on the dew
  (masked by assets/orb-*-drops.webp). They roll in from the edges on load, drift with the pointer on desktop, and
  roll off the screen during the hand-off (turning by the distance they travel). Before the surface has loaded,
  the same light on a flat colour already reads as the sphere, so nothing pops in. The packs pick up a faint
  bounce of each sun's colour on the edge that faces it. Then, as before:
  The four steps stand large in front of the headline. Scrolling, the stage holds while three of them step aside
  (the way the next steps arrive in the section below), the cleanser glides and grows into exactly the place
  where "Four steps" shows it, and the room turns that section's colour. When the section below takes over,
  its own bottle is already in place: one continuous move, no fades. The flying bottle is the same picture the
  section below uses (product cutout), so the swap is invisible. Reduced motion or no JS: a still first screen.
{%- endcomment -%}
{%- liquid
  assign full = all_products['the-full-ritual']
  assign all_url = routes.collections_url | append: '/all'
  assign line_1 = 'sections.hero_panels.line_1' | t | replace: '&amp;', '&'
  assign line_2 = 'sections.hero_panels.line_2' | t | replace: '&amp;', '&'
  assign w1 = line_1 | split: ' '
  assign w2 = line_2 | split: ' '
  assign handles = 'daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign hs = '1,.8,.86,.86' | split: ','
  assign first = all_products['daily-reset-cleanser']
  assign first_cut = first.metafields.bts.cutout.value
-%}
<style>
.hh { --f: 1; position: relative; height: calc(100vh - var(--ann, 36px)); height: calc(100svh - var(--ann, 36px)); min-height: 524px; margin-top: calc(-1 * var(--hdr, var(--header-h))); color: var(--c-ink); background: var(--c-daylight); }
.hh-stage { position: relative; height: 100%; overflow: hidden; display: flex; flex-direction: column; align-items: center;
  padding: calc(var(--hdr, var(--header-h)) + clamp(18px, 4vh, 44px)) 0 calc(var(--dock-h, 0px) + clamp(16px, 3.4vh, 36px));
  --fs: clamp(58px, min(9.6vw, 14vh), 178px); }
/* the two suns peek in from the edges, a little offset so the frame feels alive */
.ho-orbs { position: absolute; inset: 0; z-index: 0; pointer-events: none; --d: min(94vh, 62vw); --peek: min(21vw, 320px); }
.ho-o { position: absolute; width: var(--d); aspect-ratio: 1; will-change: transform; }
.ho-o--l { left: calc(var(--peek) - var(--d)); top: calc(44% - var(--d) / 2); --c: 171 208 182; --hx: 68%; }
.ho-o--r { right: calc(var(--peek) - var(--d)); top: calc(60% - var(--d) / 2); --c: 171 193 233; --hx: 32%; }
/* .ho-p: the sphere (pointer drift, roll-in); flat colour first, so the light already shapes it before the surface arrives */
.ho-p { position: absolute; inset: 0; background: radial-gradient(circle closest-side, rgb(var(--c)) 99.4%, rgb(var(--c) / 0) 100%); will-change: transform; animation: ho-in-l 1.4s cubic-bezier(.2,.75,.2,1) .05s both; }
.ho-o--r .ho-p { animation-name: ho-in-r; animation-delay: .15s; }
@keyframes ho-in-l { from { transform: translateX(-35%); opacity: 0; } 30% { opacity: 1; } }
@keyframes ho-in-r { from { transform: translateX(35%); opacity: 0; } 30% { opacity: 1; } }
/* .ho-spin: the surface turns (rolling in, rolling out); the light below never does */
.ho-spin { position: absolute; inset: 0; will-change: transform; animation: ho-roll-l 1.4s cubic-bezier(.2,.75,.2,1) .05s both; }
.ho-o--r .ho-spin { animation-name: ho-roll-r; animation-delay: .15s; }
@keyframes ho-roll-l { from { transform: rotate(-40deg); } }
@keyframes ho-roll-r { from { transform: rotate(40deg); } }
.ho-s { display: block; width: 100%; height: 100%; transition: opacity .8s ease; }
.js .ho-s:not(.is-in) { opacity: 0; }
/* the light: brightest toward the space between, shading away from it */
.ho-l { position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle at var(--hx) 34%, rgb(30 40 55 / 0) 0%, rgb(30 40 55 / 0) 17%, rgb(30 40 55 / .06) 40%, rgb(30 40 55 / .2) 74%, rgb(30 40 55 / .29) 100%); }
.ho-l::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at var(--hx) 32%, rgb(255 255 255 / .34), rgb(255 255 255 / .1) 20%, transparent 42%); }
/* the dew catches the light once, after the entrance */
.ho-g { position: absolute; inset: 0; -webkit-mask: var(--dm) center / 100% 100% no-repeat; mask: var(--dm) center / 100% 100% no-repeat;
  background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / .95) 50%, transparent 62%) 130% 0 / 300% 100% no-repeat; animation: ho-glint 1.8s ease-in-out 1.7s both; }
.ho-o--r .ho-g { animation-delay: 2.1s; background-image: linear-gradient(75deg, transparent 38%, rgb(255 255 255 / .95) 50%, transparent 62%); }
@keyframes ho-glint { from { background-position: 130% 0; } to { background-position: -30% 0; } }
@media (max-width: 760px) { .ho-orbs { --d: 112vw; --peek: 31vw; } .ho-o--l { top: calc(27% - var(--d) / 2); } .ho-o--r { top: calc(74% - var(--d) / 2); } }
@media (min-width: 700px) and (max-aspect-ratio: 4/5) { .ho-orbs { --d: 84vw; --peek: 20vw; } .ho-o--l { top: calc(30% - var(--d) / 2); } .ho-o--r { top: calc(74% - var(--d) / 2); } }
.hh-copy { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; padding-inline: 5vw; }
.hh-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
.hh-eyebrow svg { height: 15px; width: auto; }
.hh-title { margin-top: clamp(10px, 2vh, 22px); font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: .96; letter-spacing: -.01em; font-size: var(--fs); }
/* the word mask reaches past the letters' foot (the display font's line box ends above the baseline), so round letters keep their curves */
.hh-title .hh-w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .16em; margin-bottom: -.16em; }
.hh-title .hh-w > span { display: inline-block; animation: hh-rise 1s cubic-bezier(.2,.75,.2,1) both; animation-delay: calc(.2s + var(--i) * .06s); }
@keyframes hh-rise { from { transform: translateY(130%); } }
/* the line-up stands in front of the last line of the headline and takes the height that is left */
.hh-stage .hh-row { position: relative; z-index: 2; flex: 1 1 0; min-height: 0; width: 100%; margin: clamp(14px, 3vh, 34px) 0 0; padding: 0; list-style: none;
  display: flex; justify-content: center; align-items: flex-end; gap: clamp(10px, 1.6vw, 28px); }
.hh-b { position: relative; box-sizing: border-box; height: calc(var(--h) * (100% - 26px) + 26px); padding-bottom: 26px; display: flex; flex-direction: column; align-items: center; will-change: transform; }
.hh-b a { display: block; height: 100%; }
.hh-b img { display: block; height: 100%; width: auto; filter: drop-shadow(0 18px 18px rgba(32, 35, 58, .2)); transition: transform .5s cubic-bezier(.2,.75,.2,1); animation: hh-up 1s cubic-bezier(.2,.75,.2,1) both; animation-delay: calc(.7s + var(--i) * .1s); }
/* the packs land in routine order, 01 to 04, with a soft settle */
@keyframes hh-up { from { opacity: 0; transform: translateY(44px); } 62% { opacity: 1; transform: translateY(-5px); } }
/* each pack waits for its picture, so they never land half-loaded */
.js .hh-row:not(.is-ready) img, .js .hh:not(.is-ready) .hh-fly img { animation-play-state: paused; }
/* a soft pool of each pack's own colour on the floor */
.hh-b::before { content: ''; position: absolute; z-index: -1; left: -30%; right: -30%; bottom: 10px; height: 34px; border-radius: 50%;
  background: radial-gradient(closest-side, color-mix(in srgb, var(--sku) 55%, transparent), transparent); filter: blur(6px); opacity: calc(var(--f) * .9); animation: hh-pool .8s ease both; animation-delay: calc(.9s + var(--i) * .1s); }
@keyframes hh-pool { from { opacity: 0; } }
.js .hh-row:not(.is-ready) .hh-b::before { animation-play-state: paused; }
.hh-lab { position: absolute; bottom: 0; opacity: var(--f); white-space: nowrap; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: rgb(28 30 48 / .72); }
.hh-lab b { font-family: var(--font-display); font-size: 13px; letter-spacing: .04em; margin-inline-end: 6px; color: var(--c-ink); }
.hh-foot { position: relative; z-index: 3; margin-top: clamp(16px, 3vh, 32px); display: flex; gap: 10px; justify-content: center; }
.hh-sub { display: none; }
/* desktop: a poster grid — caption bottom left, the line-up in front of the headline, actions bottom right */
@media (min-width: 990px) and (min-aspect-ratio: 1/1) {
  .hh-stage .hh-row { margin-top: clamp(6px, 1.2vh, 14px); }
  .hh-sub { display: block; position: absolute; z-index: 3; inset-inline-start: 4.5vw; bottom: clamp(24px, 5vh, 52px); max-width: 30ch; font-size: 15px; line-height: 1.5; color: rgb(28 30 48 / .78); opacity: var(--f); }
  .hh-foot { position: absolute; inset-inline-end: 4.5vw; bottom: clamp(24px, 5vh, 52px); margin: 0; flex-direction: column; align-items: stretch; opacity: var(--f); }
  .hh-foot .hh-btn { justify-content: center; }
  .hh-stage { padding-bottom: clamp(20px, 4vh, 44px); }
}
.hh-btn { display: inline-flex; align-items: center; gap: 12px; padding: 17px 30px; border-radius: 999px; text-decoration: none; font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; transition: transform .3s cubic-bezier(.2,.75,.2,1); }
.hh-btn--main { background: #8FC4A2; color: var(--c-ink); } .hh-btn--ghost { color: var(--c-ink); box-shadow: inset 0 0 0 1.5px rgb(28 30 48 / .55); }
.hh-btn:hover { transform: translateY(-2px); }
.hh-btn:focus-visible, .hh-b a:focus-visible { outline: 2px solid var(--c-ink); outline-offset: 3px; }
[dir='rtl'] .hh-btn--main svg { transform: scaleX(-1); }
@media (hover: hover) { .hh-b a:hover img, .hh-b a:focus-visible img { transform: translateY(-8px); } }
.hh-b a { position: relative; }
/* the flying bottle: drawn exactly where the section below will draw it, carried there by one transform */
.hh-fly { position: fixed; z-index: 40; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; pointer-events: none; will-change: transform; visibility: hidden; }
/* hidden, not removed, until it takes over: its entrance then runs in step with the line-up's */
.hh-fly img { display: block; width: 100%; height: 100%; filter: drop-shadow(0 26px 26px rgba(32, 35, 58, .18)); animation: hh-up 1s cubic-bezier(.2,.75,.2,1) .7s both; transition: translate .5s cubic-bezier(.2,.75,.2,1); }
.hh-fly.is-lift img { translate: 0 calc(-8px / var(--s, 1)); }
.hh.is-live .hh-fly { visibility: visible; }
/* during the hand-over the section's own cleanser sits right under this one: only it casts the shadow, so it never doubles */
.hh-fly.is-docked img { filter: none; }
.hh.is-live .hh-b--first img { visibility: hidden; }
@media (max-width: 760px) {
  .hh-stage { --fs: min(14vw, 7.6svh); padding-top: calc(var(--hdr, var(--header-h)) + clamp(14px, 2.6vh, 26px)); }
  .hh-title br.hh-d { display: none; } .hh-title { max-width: 9ch; }
  .hh-eyebrow { font-size: 10px; letter-spacing: .2em; white-space: nowrap; }
  /* never wider than the screen: the four packs together are about 1.12 × their height */
  .hh-stage .hh-row { gap: 6px; margin-top: auto; padding-top: clamp(12px, 2.4vh, 22px); max-height: calc((100vw - 52px) / 1.12 + 24px); }
  .hh-lab { display: none; } .hh-b { padding-bottom: 12px; height: calc(var(--h) * (100% - 12px) + 12px); }
  .hh-btn { padding: 14px 18px; font-size: 12px; letter-spacing: .1em; gap: 8px; }
}
@media (min-width: 700px) and (max-aspect-ratio: 4/5) { .hh-stage { --fs: 11.4vw; } }
/* small phones: the eyebrow stays on one line */
@media (max-width: 379px) { .hh-eyebrow { letter-spacing: .12em; gap: 8px; } }
:lang(ar) .hh-title { text-transform: none; line-height: 1.18; letter-spacing: 0; font-size: calc(var(--fs) * .795); }
:lang(ar) .hh-title .hh-w { overflow: visible; padding: 0; margin: 0; }
:lang(ar) .hh-title .hh-w > span { animation-name: hh-fade; }
@keyframes hh-fade { from { opacity: 0; transform: translateY(.25em); } }
@media (max-width: 760px) { :lang(ar) .hh-title { font-size: 12vw; max-width: none; } :lang(ar) .hh-title br.hh-d { display: inline; } }
:lang(ar) .hh-eyebrow, :lang(ar) .hh-lab, :lang(ar) .hh-btn { letter-spacing: 0; }
@media (prefers-reduced-motion: reduce) {
  .hh-title .hh-w > span, .hh-b img, .hh-b::before, .ho-o, .ho-p, .ho-spin, .ho-g { animation: none; }
  .ho-g { display: none; }
}
</style>
<section class="hh" id="Hh-{{ section.id }}" aria-labelledby="HhTitle-{{ section.id }}">
  <div class="hh-stage">
    <div class="ho-orbs" aria-hidden="true">
      <span class="ho-o ho-o--l" style="--dm: url('{{ 'orb-green-drops.webp' | asset_url }}')"><span class="ho-p">
        <span class="ho-spin"><img class="ho-s" src="{{ 'orb-green-1200.webp' | asset_url }}" srcset="{{ 'orb-green-900.webp' | asset_url }} 900w, {{ 'orb-green-1200.webp' | asset_url }} 1200w, {{ 'orb-green-1500.webp' | asset_url }} 1500w" sizes="(min-width: 761px) min(94vh, 62vw), 400px" width="1500" height="1500" alt="" fetchpriority="high"><span class="ho-g"></span></span>
        <span class="ho-l"></span>
      </span></span>
      <span class="ho-o ho-o--r" style="--dm: url('{{ 'orb-blue-drops.webp' | asset_url }}')"><span class="ho-p">
        <span class="ho-spin"><img class="ho-s" src="{{ 'orb-blue-1200.webp' | asset_url }}" srcset="{{ 'orb-blue-900.webp' | asset_url }} 900w, {{ 'orb-blue-1200.webp' | asset_url }} 1200w, {{ 'orb-blue-1500.webp' | asset_url }} 1500w" sizes="(min-width: 761px) min(94vh, 62vw), 400px" width="1500" height="1500" alt="" fetchpriority="high"><span class="ho-g"></span></span>
        <span class="ho-l"></span>
      </span></span>
    </div>
    <div class="hh-copy">
      <p class="hh-eyebrow"><svg viewBox="0 0 501 547" aria-hidden="true" focusable="false"><path fill="currentColor" d="M2.66924 0.000534727C13.8978 -0.0776124 39.3353 8.4295 50.0693 12.562C114.374 37.317 161.913 86.5377 189.447 149.42C222.326 223.262 224.551 307.181 195.63 382.669C169.731 448.998 122.891 498.719 57.8246 527.266C50.9638 530.162 10.5353 546.188 6.16675 540.003C6.92711 537.615 15.4177 533.15 18.0182 531.551C30.9838 523.498 43.1447 514.212 54.3322 503.821C179.437 386.891 178.378 158.888 54.6155 41.6992C44.6109 32.2678 33.7982 23.7363 22.3013 16.2048C19.3235 14.2527 0.603598 3.34994 0 2.08782C0.691623 0.563537 0.721794 0.963506 2.66924 0.000534727Z"/><path fill="currentColor" d="M485.418 540.727C480.323 539.813 474.472 538.204 469.48 536.683C404.162 517.048 349.518 471.926 317.896 411.514C280.569 341.252 275.216 259.053 298.519 183.413C318.991 116.957 361.294 57.7036 423.579 24.8168C443.344 14.348 464.402 6.52641 486.21 1.5537C488.907 0.960578 499.257 -1.65223 500.343 1.60242C498.945 4.48993 493.684 7.08592 490.864 8.67457C476.842 16.5752 464.296 25.8703 452.206 36.5702C432.023 54.3842 414.677 75.1723 400.767 98.2165C355.36 172.084 341.72 271.124 362.152 354.995C381.198 433.175 420.724 493.087 489.395 535.312C491.257 536.374 493.389 537.263 494.398 539.062L494.341 540.198C492.035 542.156 488.17 541.287 485.418 540.727Z"/></svg>{{ 'sections.hero_panels.eyebrow' | t }}</p>
      <h1 class="hh-title" id="HhTitle-{{ section.id }}">
        {%- for w in w1 -%}{% unless forloop.first %}{{ ' ' }}{% endunless %}<span class="hh-w"><span style="--i: {{ forloop.index0 }}">{{ w }}</span></span>{%- endfor -%}
        <br class="hh-d">{{ ' ' }}
        {%- for w in w2 -%}{% unless forloop.first %}{{ ' ' }}{% endunless %}<span class="hh-w"><span style="--i: {{ forloop.index0 | plus: w1.size }}">{{ w }}</span></span>{%- endfor -%}
      </h1>
    </div>
    <p class="hh-sub">{{ 'sections.hero_panels.subcopy' | t }}</p>
    <div class="hh-foot">
      <a class="hh-btn hh-btn--main" href="{{ full.url | default: all_url }}">{{ 'sections.hero_suns.cta' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm' %}</a>
      <a class="hh-btn hh-btn--ghost" href="{{ all_url }}">{{ 'sections.hero_routine.cta_all' | t }}</a>
    </div>
    <ul class="hh-row" role="list" aria-label="{{ 'sections.hero_routine.lineup' | t }}">
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {%- unless p.id -%}{%- continue -%}{%- endunless -%}
        {%- assign img = 'cut-' | append: h | append: '.webp' | asset_url -%}
        {%- assign st = forloop.index -%}
        <li class="hh-b{% if forloop.first %} hh-b--first{% endif %}" data-step="{{ st }}" style="--h: {{ hs[forloop.index0] }}; --i: {{ forloop.index0 }}">
          <a href="{{ p.url }}"><img src="{{ img }}" alt="" width="357" height="1100" fetchpriority="high"><span class="visually-hidden">{{ p.title | escape }}</span></a>
          <span class="hh-lab" aria-hidden="true"><b>0{{ st }}</b>{{ p.metafields.bts.step_label.value | default: p.title | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- if first_cut -%}
    {%- assign fly_src = first_cut | image_url: width: 900 -%}
    <div class="hh-fly" aria-hidden="true">
      <img src="{{ fly_src }}" alt="" width="{{ first_cut.width }}" height="{{ first_cut.height }}" fetchpriority="high">
      
    </div>
  {%- endif -%}
</section>
<script>
(() => {
  const root = document.getElementById('Hh-{{ section.id }}'); if (!root) return;
  // the hero tucks under the header by the header's real height (a fixed guess was covering the bar above it). It measures the
  // header's section box: <site-header> itself is inline, and Safari reports an inline element's height as its text line only
  const hw = document.querySelector('.site-header-wrap')?.closest('.shopify-section');
  const hdr = () => { if (hw) root.style.setProperty('--hdr', hw.offsetHeight + 'px'); };
  hdr(); if (hw && window.ResizeObserver) new ResizeObserver(hdr).observe(hw);
  // the suns' surfaces fade in over their flat colour when they arrive
  root.querySelectorAll('.ho-s').forEach((im) => { const on = () => im.classList.add('is-in'); if (im.complete && im.naturalWidth) on(); else im.addEventListener('load', on, { once: true }); });
  // the packs land once their pictures are in (or after 1.5s, whichever comes first)
  const whenLoaded = (imgs, cb) => { let n = imgs.length, done = false; const go = () => { if (!done) { done = true; cb(); } };
    if (!n) return go(); imgs.forEach((im) => { if (im.complete) { if (!--n) go(); } else { const f = () => { if (!--n) go(); }; im.addEventListener('load', f, { once: true }); im.addEventListener('error', f, { once: true }); } });
    setTimeout(go, 1500); };
  // (the cleanser that flies is its own picture: the row waits for it too, so 01 still lands first)
  const row = root.querySelector('.hh-row'), flyImg = root.querySelector('.hh-fly img');
  whenLoaded([...row.querySelectorAll('img'), ...(flyImg ? [flyImg] : [])], () => { row.classList.add('is-ready'); root.classList.add('is-ready'); });
  // the section below comes later in the page: start once the whole page is parsed
  const init = () => {
  const hero = root, fly = hero.querySelector('.hh-fly');
  const firstLi = hero.querySelector('.hh-b--first'), slot = firstLi && firstLi.querySelector('img');
  const others = [...hero.querySelectorAll('.hh-b:not(.hh-b--first)')];
  const orbL = hero.querySelector('.ho-o--l'), orbR = hero.querySelector('.ho-o--r'), spinL = orbL.querySelector('.ho-spin'), spinR = orbR.querySelector('.ho-spin');
  const fades = [row, hero.querySelector('.hh-foot'), hero.querySelector('.hh-sub'), fly].filter(Boolean);
  const dl = document.querySelector('.dayline'), track = dl && dl.querySelector('.dayline__track'), dstage = dl && dl.querySelector('.dayline__stage');
  const anchor = dl && dl.querySelector('.dayline__step[data-index="0"] .dayline__bottle'), dimg = anchor && anchor.querySelector('img');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !fly || !slot || !dimg || getComputedStyle(dstage).position !== 'sticky') return;
  // where the bottle is inside the flying picture (transparent margins), as fractions of its width and height
  const V = [.2514, .0462, .6921, .9495];
  const sign = document.documentElement.dir === 'rtl' ? -1 : 1;
  const clamp = (v) => Math.max(0, Math.min(1, v));
  const io = (t) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const fimg = fly.querySelector('img');
  dimg.loading = 'eager'; if (dimg.decode) dimg.decode().catch(() => {});
  hero.classList.add('is-live');
  // the hero ends exactly at the fold, whatever the height of the announcement bar above it
  const fit = () => { hero.style.setProperty('--ann', Math.max(0, hero.getBoundingClientRect().top + scrollY) + 'px'); };
  fit();
  // Geometry is measured only when the layout changes, never while scrolling: each scroll frame then only
  // writes transforms (no layout, no style rewrites), which keeps it smooth in Safari too.
  let G = null, need = true, last = {};
  const put = (el, k, v) => { const id = k + (el.dataset.k || (el.dataset.k = Math.random().toString(36).slice(2))); if (last[id] !== v) { last[id] = v; if (k[0] === '-') el.style.setProperty(k, v); else el.style[k] = v; } };
  function measure() {
    const y = scrollY, D = track.getBoundingClientRect().top + y;
    if (y > D - 1) return;                                           // the section below is pinned: its bottle may be moving; measure later
    // the line-up's cleanser at rest: its list item (never moved) plus the picture's own layout box (ignores its entrance motion)
    const li = firstLi.getBoundingClientRect(), Lx = li.left + slot.offsetLeft, Ly = li.top + y + slot.offsetTop, Lh = slot.offsetHeight;
    const ar = anchor.getBoundingClientRect(), sr = dstage.getBoundingClientRect();
    const bw = ar.width, bh = ar.height, ia = (fimg.naturalWidth || 2) / (fimg.naturalHeight || 3);
