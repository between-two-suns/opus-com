    }
    const f = clamp(1 - P * 5).toFixed(3); fades.forEach((el) => put(el, '--f', f));
    // the suns roll off: each turns by the distance it travels (angle = distance / radius)
    const o = io(clamp(P / .7)) * G.W * .75, turn = o / G.r * 180 / Math.PI;
    put(orbL, 'transform', o ? `translate3d(${(-o).toFixed(1)}px, 0, 0)` : ''); put(orbR, 'transform', o ? `translate3d(${o.toFixed(1)}px, 0, 0)` : '');
    put(spinL, 'rotate', turn ? `${(-turn).toFixed(2)}deg` : ''); put(spinR, 'rotate', turn ? `${turn.toFixed(2)}deg` : '');
    others.forEach((li, k) => {
      // the one nearest the edge leaves first, so they never cross
      const q = io(clamp((P - .06 * (others.length - 1 - k)) / .55));
      put(li, 'transform', q ? `translate3d(${(sign * q * G.W * .8).toFixed(1)}px, ${(q * 30).toFixed(1)}px, 0) rotate(${(sign * q * 12).toFixed(2)}deg)` : '');
