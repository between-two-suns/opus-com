    const tilt = -sign * 7 * Math.sin(Math.PI * e);
    put(fly, 'transform', `translate3d(${(G.tx0 * (1 - e)).toFixed(2)}px, ${(G.ty0 * (1 - e)).toFixed(2)}px, 0) scale(${sc.toFixed(4)})` + (Math.abs(tilt) > .01 ? ` translate(${G.cx.toFixed(1)}px, ${G.cy.toFixed(1)}px) rotate(${tilt.toFixed(2)}deg) translate(${(-G.cx).toFixed(1)}px, ${(-G.cy).toFixed(1)}px)` : ''));
    // the hand-over: the section's own cleanser appears the moment it pins and takes over from the flying one
    // (two frames of overlap, nothing more: just enough that no frame is ever left without a cleanser)
    const docked = y >= G.D - .5;
    if (docked !== wasDocked) {
      wasDocked = docked; dimg.style.opacity = docked ? '' : '0'; fly.classList.toggle('is-docked', docked);
      const tok = ++dockTok;
