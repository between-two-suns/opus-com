{{ 'home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Full-bleed editorial photo with one line and one link (default: to the About page; the copy is the brand story, DECISIONS 294).
  The photo defaults to the brand's walking shot in Files, on phones too (cropped around her); an optional phone photo can be set in the editor.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image | default: images['bts-editorial-walk.png']
  assign img_m = section.settings.image_mobile
  if img == blank
    assign img = false
  endif
  if img_m == blank
    assign img_m = false
  endif
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.editorial_band.eyebrow' | t | replace: '&amp;', '&'
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.editorial_band.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.editorial_band.text' | t | replace: '&amp;', '&'
  endif
  assign link = section.settings.link
  if link == blank
    assign link = routes.root_url | append: '/pages/about' | replace: '//', '/'
  endif
-%}
<section class="eb" aria-labelledby="EbTitle-{{ section.id }}">
  <picture class="eb__media">
    {%- if img_m -%}<source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
    {%- if img -%}{{ img | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1000,1400,1800,2400', sizes: '100vw', alt: '', class: 'eb__img' }}{%- endif -%}
  </picture>
  <div class="container eb__inner">
    <div class="eb__card">
      <p class="t-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="t-display-m" id="EbTitle-{{ section.id }}">{{ heading | escape }}</h2>
      <p class="t-body-l">{{ text | escape }}</p>
      <a class="btn" href="{{ link }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label }}{% else %}{{ 'sections.editorial_band.cta' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.editorial_band.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "paragraph",
      "content": "t:general_schema.bilingual_fallback"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (laptop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photo (phone)",
      "info": "Empty: uses the laptop photo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "Empty: the About page."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button text",
      "info": "Built-in: “Get to know us”."
    }
  ],
  "presets": [
    {
      "name": "t:sections.editorial_band.name"
    }
  ]
}
{% endschema %}
