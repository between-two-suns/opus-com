{{ 'home.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Full-bleed editorial photo with one line and one link (default: to the Climate page).
  The photo defaults to the brand's walking shot in Files, on phones too (cropped around her); an optional phone photo can be set in the editor.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image | default: images['bts-editorial-walk.png']
  assign img_m = section.settings.image_mobile
  if img == blank
    assign img = false
  endif
  if img_m == blank
    assign img_m = false
  endif
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.editorial_band.eyebrow' | t | replace: '&amp;', '&'
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.editorial_band.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.editorial_band.text' | t | replace: '&amp;', '&'
  endif
  assign link = section.settings.link
  if link == blank
    assign link = routes.root_url | append: '/pages/climate' | replace: '//', '/'
  endif
-%}
{%- if section.settings.style == 'sun' -%}
{%- comment -%}
  "Sun" style (home demo, DECISIONS 234): the closing moment of the day. The photo runs edge to edge and drifts
  slowly as you scroll; the headline sits on the photo, no card; the photo's foot melts into the page's light
  (body --tone, which the day-light section moves from morning to dusk); the second sun is its light: a low,
  warm glow that sinks below the bottom edge as the band passes, so the page closes on the idea it opened with.
  Reduced motion: still.
{%- endcomment -%}
<section class="eb eb--sun" aria-labelledby="EbTitle-{{ section.id }}">
  <picture class="eb__media">
    {%- if img_m -%}<source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
    {%- if img -%}{{ img | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1000,1400,1800,2400', sizes: '100vw', alt: '', class: 'eb__img' }}{%- endif -%}
  </picture>
  <span class="eb__fade" aria-hidden="true"></span>
  <span class="eb__sun" aria-hidden="true"></span>
  <div class="container eb__inner">
    <div class="eb__text">
      <p class="t-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="t-display-l" id="EbTitle-{{ section.id }}">{{ heading | escape }}</h2>
      <p class="t-lead">{{ text | escape }}</p>
      <a class="btn" href="{{ link }}">{{ 'sections.editorial_band.cta' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </div>
  </div>
</section>
{%- else -%}
<section class="eb" aria-labelledby="EbTitle-{{ section.id }}">
  <picture class="eb__media">
    {%- if img_m -%}<source media="(max-width: 749px)" srcset="{{ img_m | image_url: width: 800 }} 800w, {{ img_m | image_url: width: 1200 }} 1200w" sizes="100vw">{%- endif -%}
    {%- if img -%}{{ img | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1000,1400,1800,2400', sizes: '100vw', alt: '', class: 'eb__img' }}{%- endif -%}
  </picture>
  <div class="container eb__inner">
    <div class="eb__card">
      <p class="t-eyebrow">{{ eyebrow | escape }}</p>
      <h2 class="t-display-m" id="EbTitle-{{ section.id }}">{{ heading | escape }}</h2>
      <p class="t-body-l">{{ text | escape }}</p>
      <a class="btn" href="{{ link }}">{{ 'sections.editorial_band.cta' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.editorial_band.name",
  "settings": [
    { "type": "paragraph", "content": "t:general_schema.bilingual_fallback" },
    { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "card", "label": "Photo with card" }, { "value": "sun", "label": "Sunset (headline on the photo)" }], "default": "card" },
    { "type": "image_picker", "id": "image", "label": "t:sections.editorial_band.image" },
    { "type": "image_picker", "id": "image_mobile", "label": "t:sections.editorial_band.image_mobile" },
    { "type": "text", "id": "eyebrow", "label": "t:general_schema.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "url", "id": "link", "label": "t:sections.editorial_band.link" }
  ],
  "presets": [{ "name": "t:sections.editorial_band.name" }]
}
{% endschema %}
