{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About (DECISIONS 193): the close, back to the name: "Until the next sun", with tomorrow's sun (the home page's
  periwinkle sphere) rising from the bottom edge. Two ways on: the skin check (when its page is set) and the Full Ritual.
{%- endcomment -%}
{%- liquid
  assign set = all_products['the-full-ritual']
  assign sk = settings.skin_check_page
  assign set_name = 'bundles.names.the-full-ritual' | t | replace: '&amp;', '&'
  if set_name contains 'ranslation missing'
    assign set_name = set.title
  endif
-%}
<section class="ab-close" aria-labelledby="AbClose-{{ section.id }}">
  {%- render 'about-orb', tone: 'blue', side: 'top', class: 'ab-close__sun ab-orb--top', sizes: '(min-width: 750px) 56vw, 300px' -%}
  <div class="container ab-close__inner">
    <h2 class="ab-close__title" id="AbClose-{{ section.id }}">{% if section.settings.t_about2_close_heading != blank %}{{ section.settings.t_about2_close_heading }}{% else %}{{ 'about2.close_heading' | t }}{% endif %}</h2>
    {%- if section.settings.t_about2_close_text != blank -%}
      <p class="t-lead ab-close__text">{{ section.settings.t_about2_close_text }}</p>
    {%- elsif section.settings.copy_v2 -%}
      <p class="t-lead ab-close__text">{{ 'about2.v2_close_text' | t }}</p>
      <p class="ab-close__line">{{ 'about2.v2_close_line' | t }}</p>
    {%- else -%}
      <p class="t-lead ab-close__text">{{ 'about2.close_text' | t }}</p>
    {%- endif -%}
    <div class="ab-close__ctas">
      {%- if sk != blank and sk.url != blank -%}
        <a class="btn" href="{{ sk.url }}">{% if section.settings.t_about2_close_cta != blank %}{{ section.settings.t_about2_close_cta }}{% else %}{{ 'about2.close_cta' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      {%- endif -%}
      {%- if set.id -%}
        <a class="btn btn--secondary" href="{{ set.url }}">{{ 'about2.close_cta2' | t: name: set_name }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  // Tomorrow's sun rises as she scrolls. Chrome does it in CSS (animation-timeline); Safari and Firefox on laptops
  // don't support that yet, so the same motion is done here (DECISIONS 375). Reduced motion: no movement.
  (() => {
    const root = document.currentScript.previousElementSibling;
    const sun = root && root.querySelector('.ab-close__sun');
    if (!sun || matchMedia('(prefers-reduced-motion: reduce)').matches || (window.CSS && CSS.supports('animation-timeline: view()'))) return;
    let ticking = false;
    const tick = () => {
      ticking = false;
      const r = root.getBoundingClientRect(), h = innerHeight;
      // Same range as the CSS: from 10% into the screen until the section is 60% scrolled through.
      const start = h - r.height * 0.1, end = h - (h + r.height) * 0.6;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
      sun.style.transform = 'translateY(' + ((1 - p) * 26).toFixed(2) + '%)';
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    addEventListener('resize', tick);
    tick();
  })();
</script>

{% schema %}
{
  "name": "About · close",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    { "type": "checkbox", "id": "copy_v2", "label": "Use the copy master text", "default": false, "info": "On: the copy master's closing paragraph and line (“Made for the days you actually have.”)." },
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_about2_close_heading",
      "label": "Heading",
      "info": "Now: “Until the next sun.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_about2_close_text",
      "label": "Paragraph",
      "info": "Now: “Not sure where to start? Answer a few quick questions and we’ll suggest a routine.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_about2_close_cta",
      "label": "Button text",
      "info": "Now: “Find your routine”. Leave empty to keep it (English and Arabic)."
    }
  ]
}
{% endschema %}
