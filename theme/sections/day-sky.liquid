{{ 'day.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The page as one day: as you scroll, the ground drifts from dawn to dusk and a small clock (desktop) runs from the
  first sun to the second, showing each chapter's own hour (data-hour) as it reaches the middle of the screen. Decorative only (aria-hidden); without JS the page keeps its usual daylight ground.
  The night chapter brings its own ink, so the drift stops at dusk.
{%- endcomment -%}
<day-sky class="dsky" aria-hidden="true" data-from="{{ section.settings.from | default: 6 }}" data-to="{{ section.settings.to | default: 21 }}">
  <span class="dsky__rail"><span class="dsky__dot"></span></span>
  <span class="dsky__time u-ltr">07:00</span>
</day-sky>
<script type="module">
  if (!customElements.get('day-sky')) {
    const stops = [[0, '#f8ede3'], [0.22, '#f5f1ea'], [0.45, '#e9f0ec'], [0.62, '#f4ecdf'], [0.82, '#f2ecef'], [1, '#e6dfeb']];
    const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const mix = (t) => {
      let i = 1;
      while (i < stops.length - 1 && t > stops[i][0]) i++;
      const [t0, c0] = stops[i - 1], [t1, c1] = stops[i];
      const k = Math.min(1, Math.max(0, (t - t0) / (t1 - t0 || 1)));
      const a = hex(c0), b = hex(c1);
      return `rgb(${a.map((v, j) => Math.round(v + (b[j] - v) * k)).join(',')})`;
    };
    customElements.define('day-sky', class extends HTMLElement {
      connectedCallback() {
        this.from = Number(this.dataset.from) || 6;
        this.to = Number(this.dataset.to) || 21;
        this.timeEl = this.querySelector('.dsky__time');
        this.night = document.querySelector('.dc--night');
        document.documentElement.classList.add('has-day-sky');
        this.onScroll = () => { if (!this.raf) this.raf = requestAnimationFrame(() => { this.raf = 0; this.update(); }); };
        addEventListener('scroll', this.onScroll, { passive: true });
        addEventListener('resize', this.onScroll);
        this.update();
      }
      disconnectedCallback() { removeEventListener('scroll', this.onScroll); removeEventListener('resize', this.onScroll); }
      update() {
        // The ground drifts from the top of the page to the night chapter (or the end of the page).
        const vh = innerHeight, top = (el) => el.getBoundingClientRect().top + scrollY;
        const end = this.night ? top(this.night) - vh * 0.4 : document.documentElement.scrollHeight - vh;
        const t = Math.min(1, Math.max(0, scrollY / Math.max(1, end)));
        document.body.style.backgroundColor = mix(t);
        // The clock is pinned to the chapters: each shows its own hour as it reaches the middle of the screen.
        const marks = [[0, this.from], ...[...document.querySelectorAll('[data-hour]')].map((el) => {
          const [hh, mm] = el.dataset.hour.split(':').map(Number);
          return [top(el) - vh * 0.5, hh + (mm || 0) / 60];
        }), [document.documentElement.scrollHeight - vh, this.to]].filter((m) => !Number.isNaN(m[1])).sort((a, b) => a[0] - b[0]);
        let hours = marks[marks.length - 1][1];
        for (let i = 1; i < marks.length; i++) {
          if (scrollY <= marks[i][0]) { const [y0, h0] = marks[i - 1], [y1, h1] = marks[i]; hours = h0 + (h1 - h0) * Math.min(1, Math.max(0, (scrollY - y0) / Math.max(1, y1 - y0))); break; }
        }
        hours = Math.max(this.from, Math.min(this.to, hours));
        const h = Math.floor(hours), m = Math.floor((hours - h) * 4) * 15;
        this.timeEl.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
        this.style.setProperty('--t', ((hours - this.from) / Math.max(1, this.to - this.from)).toFixed(4));
        this.toggleAttribute('data-night', !!this.night && this.night.getBoundingClientRect().top < vh * 0.5 && this.night.getBoundingClientRect().bottom > vh * 0.5);
      }
    });
  }
</script>

{% schema %}
{
  "name": "t:sections.day_sky.name",
  "settings": [
    { "type": "range", "id": "from", "label": "t:sections.day_sky.from", "min": 5, "max": 9, "step": 1, "default": 6 },
    { "type": "range", "id": "to", "label": "t:sections.day_sky.to", "min": 19, "max": 23, "step": 1, "default": 21 }
  ],
  "presets": [{ "name": "t:sections.day_sky.name" }]
}
{% endschema %}
