{%- comment -%}
  The reviews design (DECISIONS 247), shown on the demo home page (/?view=trust) with SAMPLE content and a visible
  "design preview" label: no real reviews exist yet, and none are ever written for the shop.
  When real reviews arrive, the live home section (sections/reviews-home.liquid) is styled to this exact design from
  Judge.me's own feed, so every star, number and word comes from a real customer, never from this file.

  The card: the reviewed product's colour, an optional customer photo or video (4:5 frame), stars, a short title,
  the text (five lines, then "Read more"), first name + initial · city, "Verified buyer", skin type, the product.
  A gifted review says so ("Received as a gift").
{%- endcomment -%}
{%- liquid
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
-%}
{%- capture star -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9 4.8 17.6l1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endcapture -%}
<section class="section revs" aria-labelledby="Revs-{{ section.id }}">
  <div class="container">
    <p class="revs__sample" role="note">{{ 'reviews_demo.sample' | t }}</p>
    <div class="revs__head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'reviews.eyebrow' | t }}</p>
        <h2 class="t-display-m" id="Revs-{{ section.id }}">{{ 'reviews.heading' | t }}</h2>
      </div>
      <div class="revs__summary">
        <p class="revs__score"><span class="revs__avg">4.8</span><span class="revs__of"> / 5</span></p>
        <div class="revs__stars revs__stars--lg" aria-hidden="true">{% for i in (1..5) %}{{ star }}{% endfor %}</div>
        <p class="revs__count">{{ 'reviews.count' | t: count: 126 }}</p>
        <a class="link-arrow revs__all" href="#">{{ 'reviews_demo.all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      </div>
    </div>

    <ul class="revs__row" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign st = block.settings.step | plus: 0
          assign rp = all_products[step_handles[st]]
          assign media = block.settings.media
        -%}
        <li class="rev{% if media == 'none' %} rev--text{% endif %}" data-step="{{ st }}" {{ block.shopify_attributes }}>
          {%- if media != 'none' -%}
            <div class="rev__media rev__media--{{ media }}">
              <span class="rev__ph">
                {%- if media == 'video' -%}
                  <span class="rev__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
                  <span class="rev__ph-t">{{ 'reviews_demo.video' | t }}</span>
                {%- else -%}
                  <span class="rev__ph-t">{{ 'reviews_demo.photo' | t }}</span>
                {%- endif -%}
              </span>
              {%- if media == 'video' -%}<span class="rev__dur">0:24</span>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="rev__body">
            <div class="revs__stars" role="img" aria-label="{{ 'reviews_demo.stars' | t: count: block.settings.stars }}">{% for i in (1..5) %}<span{% if i > block.settings.stars %} class="is-off"{% endif %}>{{ star }}</span>{% endfor %}</div>
            <h3 class="rev__title">{{ block.settings.title | escape }}</h3>
            <p class="rev__text">{{ block.settings.text | escape }}</p>
            <p class="rev__who"><span class="rev__name">{{ block.settings.name | escape }}</span><span aria-hidden="true"> · </span>{{ block.settings.city | escape }}</p>
            <ul class="rev__tags" role="list">
              <li class="rev__tag rev__tag--ok">{% render 'icon', name: 'check', class: 'icon--sm' %}{{ 'reviews_demo.verified' | t }}</li>
              {%- if block.settings.skin != blank -%}<li class="rev__tag">{{ block.settings.skin | escape }}</li>{%- endif -%}
              {%- if block.settings.gift -%}<li class="rev__tag rev__tag--gift">{{ 'reviews_demo.gift' | t }}</li>{%- endif -%}
            </ul>
            {%- if rp.id -%}<a class="rev__product" href="{{ rp.url }}"><span class="bundle__dot" aria-hidden="true"></span>{{ rp.title | escape }}</a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Reviews (design preview)",
  "settings": [],
  "blocks": [
    {
      "type": "review",
      "name": "Sample review",
      "settings": [
        { "type": "range", "id": "step", "label": "Product step", "min": 1, "max": 4, "step": 1, "default": 1 },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "select", "id": "media", "label": "Media", "default": "none", "options": [ { "value": "none", "label": "Text only" }, { "value": "photo", "label": "Photo" }, { "value": "video", "label": "Video" } ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "skin", "label": "Skin type" },
        { "type": "checkbox", "id": "gift", "label": "Received as a gift", "default": false }
      ]
    }
  ]
}
{% endschema %}
