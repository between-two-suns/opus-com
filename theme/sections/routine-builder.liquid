{{ 'bundles.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Build your routine: tap bottles onto the shelf between the two suns. The light grows with each step,
  the total and the next mix & match saving update live, and one tap adds the routine.
  Prices are the products' real prices; savings come from Theme settings → Offers (mirroring real discounts).
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.builder.heading' | t | replace: '&amp;', '&'
  endif
-%}
<section class="section builder" aria-labelledby="BuilderTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{% if section.settings.t_sections_builder_eyebrow != blank %}{{ section.settings.t_sections_builder_eyebrow }}{% else %}{{ 'sections.builder.eyebrow' | t }}{% endif %}</p>
        <h2 class="t-display-m" id="BuilderTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <p class="t-lead t-muted bundles__text">{% if section.settings.t_sections_builder_text != blank %}{{ section.settings.t_sections_builder_text }}{% else %}{{ 'sections.builder.text' | t }}{% endif %}</p>
    </div>

    <routine-builder
      class="builder__ui"
      data-money="{{ shop.money_format | escape }}"
      data-t2="{{ settings.tier_2_pct | default: 0 }}"
      data-t3="{{ settings.tier_3_pct | default: 0 }}"
      data-t4="{{ settings.tier_4_pct | default: 0 }}"
      data-coming-soon="{% if settings.zero_price_coming_soon %}true{% endif %}"
      data-str-count="{{ 'sections.builder.count' | t: count: '__N__'  }}"
      data-str-empty="{% if section.settings.t_sections_builder_empty != blank %}{{ section.settings.t_sections_builder_empty }}{% else %}{{ 'sections.builder.empty' | t }}{% endif %}"
      data-str-next="{{ 'cart.tier_next' | t: count: '__N__', pct: '__P__'  }}"
      data-str-saving="{{ 'cart.tier_reached' | t: pct: '__P__'  }}"
      data-str-added="{{ 'sections.builder.added_step' | t: product: '__X__'  }}"
      data-str-removed="{{ 'sections.builder.removed_step' | t: product: '__X__'  }}"
    >
      <div class="builder__stage grain" data-stage style="--fill: 0">
        <span class="builder__sun builder__sun--warm" aria-hidden="true"></span>
        <span class="builder__sun builder__sun--cool" aria-hidden="true"></span>
        <ol class="builder__shelf" role="list" aria-label="{% if section.settings.t_sections_builder_shelf != blank %}{{ section.settings.t_sections_builder_shelf }}{% else %}{{ 'sections.builder.shelf' | t }}{% endif %}">
          {%- for s in (1..4) -%}
            {%- for product in source.products limit: 12 -%}
              {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign ps = ps | strip | plus: 0 -%}
              {%- if ps == s -%}
                {%- assign cutout = product.metafields.bts.cutout.value -%}
                <li class="builder__slot" data-step="{{ s }}" data-slot="{{ s }}">
                  <span class="builder__num" aria-hidden="true">0{{ s }}</span>
                  <span class="builder__bottle" aria-hidden="true">
                    {%- if cutout -%}
                      {{ cutout | image_url: width: 420 | image_tag: loading: 'lazy', widths: '200,300,420', sizes: '(min-width: 990px) 12vw, 22vw', alt: '' }}
                    {%- elsif product.featured_image -%}
                      {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '200,300,420', sizes: '(min-width: 990px) 12vw, 22vw', alt: '' }}
                    {%- endif -%}
                  </span>
                  <span class="builder__base" aria-hidden="true"></span>
                </li>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </ol>
      </div>

      <div class="builder__panel">
        <fieldset class="builder__choices">
          <legend class="t-subheading">{% if section.settings.t_sections_builder_choose != blank %}{{ section.settings.t_sections_builder_choose }}{% else %}{{ 'sections.builder.choose' | t }}{% endif %}</legend>
          {%- for s in (1..4) -%}
            {%- for product in source.products limit: 12 -%}
              {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign ps = ps | strip | plus: 0 -%}
              {%- if ps == s -%}
                {%- assign v = product.selected_or_first_available_variant -%}
                <button
                  type="button"
                  class="builder__choice"
                  data-step="{{ s }}"
                  data-id="{{ v.id }}"
                  data-price="{{ v.price }}"
                  data-title="{{ product.title | escape }}"
                  aria-pressed="false"
                  {% unless v.available %}disabled{% endunless %}
                >
                  {%- assign studio_key = 'bts-' | append: product.handle | append: '-studio.jpg' -%}
                  {%- assign studio = images[studio_key] -%}{%- if studio == blank -%}{%- assign studio = false -%}{%- endif -%}
                  {%- if studio -%}<span class="builder__thumb" aria-hidden="true">{{ studio | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200,300,400,500', sizes: '(min-width: 990px) 14vw, 44vw', alt: '' }}</span>{%- endif -%}
                  <span class="builder__check" aria-hidden="true"></span>
                  <span class="builder__choice-text">
                    <span class="builder__choice-step t-xs">{{ 'product.step' | t: number: s }} · {{ product.metafields.bts.step_label.value | default: '' | escape }}</span>
                    <span class="builder__choice-name">{{ product.title | escape }}</span>
                  </span>
                  <span class="builder__choice-price">{% if v.price == 0 and settings.zero_price_coming_soon %}{{ 'product.coming_soon' | t }}{% else %}{% render 'egp', cents: v.price %}{% endif %}</span>
                </button>
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </fieldset>

        <div class="builder__presets" role="group" aria-label="{% if section.settings.t_sections_builder_presets != blank %}{{ section.settings.t_sections_builder_presets }}{% else %}{{ 'sections.builder.presets' | t }}{% endif %}">
          {%- comment -%} Shortcuts are the real sets (DECISIONS 209), named as their products, so picking one gets that set's price {%- endcomment -%}
          {%- assign bp_handles = 'the-full-ritual,the-night-ritual,the-clear-protect-trio,clear-protect-duo,the-core-duo' | split: ',' -%}
          {%- for bh in bp_handles -%}
            {%- assign bp = all_products[bh] -%}
            {%- unless bp.id -%}{%- continue -%}{%- endunless -%}
            {%- capture bdef -%}{% render 'bundle-def', handle: bh %}{%- endcapture -%}
            <button type="button" class="chip" data-preset="{{ bdef | split: '|' | first | strip }}">{{ bp.title | escape }}</button>
          {%- endfor -%}
        </div>

        <div class="builder__summary">
          <p class="builder__count t-small" data-count aria-live="polite">{% if section.settings.t_sections_builder_empty != blank %}{{ section.settings.t_sections_builder_empty }}{% else %}{{ 'sections.builder.empty' | t }}{% endif %}</p>
          <ol class="builder__meter" role="list" aria-hidden="true">
            {%- for n in (1..4) -%}<li data-step="{{ n }}"></li>{%- endfor -%}
          </ol>
          <p class="builder__offer t-small" data-offer hidden></p>
          <product-form class="builder__form">
            <form method="post" action="{{ routes.cart_add_url }}">
              <button type="submit" class="btn btn--full" data-cta data-magnetic disabled>
                <span class="btn__label">{% if section.settings.t_sections_builder_cta != blank %}{{ section.settings.t_sections_builder_cta }}{% else %}{{ 'sections.builder.cta' | t }}{% endif %}</span>
                <span class="btn__sep" aria-hidden="true" data-total-sep hidden>·</span>
                <span class="btn__price" data-total></span>
                <s class="builder__was" data-was hidden></s>
              </button>
              <p class="t-xs bundle-match" data-bundle-match hidden></p>
              <p class="t-xs t-muted" data-form-error hidden></p>
            </form>
          </product-form>
        </div>
      </div>
    </routine-builder>
  </div>
</section>
<script src="{{ 'bundles.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:sections.builder.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:general_schema.heading",
      "info": "t:general_schema.bilingual_fallback"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.routine.collection"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_sections_builder_eyebrow",
      "label": "Small line above the heading",
      "info": "Now: “Build your own”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "textarea",
      "id": "t_sections_builder_text",
      "label": "Paragraph",
      "info": "Now: “Choose the steps you want. We’ll put them in routine order and update your total as you go.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_sections_builder_empty",
      "label": "Empty",
      "info": "Now: “Pick a step to start”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_sections_builder_shelf",
      "label": "Shelf",
      "info": "Now: “Your routine shelf”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_sections_builder_choose",
      "label": "Choose",
      "info": "Now: “Choose your steps”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_sections_builder_presets",
      "label": "Presets",
      "info": "Now: “Quick picks”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_sections_builder_cta",
      "label": "Button text",
      "info": "Now: “Add my routine”. Leave empty to keep it (English and Arabic)."
    }
  ],
  "presets": [
    {
      "name": "t:sections.builder.name"
    }
  ]
}
{% endschema %}
