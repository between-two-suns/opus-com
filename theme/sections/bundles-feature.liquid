{{ 'bundles-feature.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Sets, one hero and one companion: the pick (The Full Ritual) leads in the wider column, the companion (The Night
  Ritual) beside it with the evening photo set here. Both use the shop's one card (snippets/bundle-card). Prices and compare-at come from the Shopify bundle products.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.bundles.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.bundles_feature.text' | t | replace: '&amp;', '&'
  endif
  assign hero = section.settings.hero | default: all_products['the-full-ritual']
  assign mate = section.settings.mate | default: all_products['the-night-ritual']
-%}
<section class="section setsx" id="sets" data-tone="lilac" aria-labelledby="SetsxTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'sections.bundles.eyebrow' | t }}</p>
        <h2 class="t-display-l" id="SetsxTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <div class="setsx__aside">
        <p class="t-lead t-muted">{{ text | escape }}</p>
        <a class="link-arrow" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{{ 'sections.bundles.see_all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      </div>
    </div>

    {%- comment -%} The same card as the Sets page and the shop (DECISIONS 238); the pick leads at the wider column {%- endcomment -%}
    {{ 'bundles.css' | asset_url | stylesheet_tag }}
    <ul class="setsx__grid" role="list">
      {%- if hero.id -%}{%- render 'bundle-card', product: hero, priority: true -%}{%- endif -%}
      {%- if mate.id -%}{%- render 'bundle-card', product: mate, image: section.settings.mate_image -%}{%- endif -%}
    </ul>
    {%- comment -%} Under the sets, where "which one?" comes up (DECISIONS 234) {%- endcomment -%}
    <div class="setsx__quiz">{%- render 'skin-check-link', key: 'skin_check.cta_sets' -%}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bundles_feature.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "product", "id": "hero", "label": "t:sections.bundles_feature.hero" },
    { "type": "product", "id": "mate", "label": "t:sections.bundles_feature.mate" },
    { "type": "image_picker", "id": "mate_image", "label": "t:sections.bundles_feature.mate_image", "info": "t:sections.bundles_feature.mate_image_info" }
  ],
  "presets": [{ "name": "t:sections.bundles_feature.name" }]
}
{% endschema %}
