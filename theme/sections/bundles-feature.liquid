{{ 'bundles-feature.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Sets, one hero and one companion: the pick (The Full Ritual) leads in the wider column, the companion (The Night
  Ritual) beside it with the evening photo set here. Both use the shop's one card (snippets/bundle-card). Prices and compare-at come from the Shopify bundle products.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.bundles_feature.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.bundles_feature.text' | t | replace: '&amp;', '&'
  endif
  assign hero = section.settings.hero | default: all_products['the-full-ritual']
  assign mate = section.settings.mate | default: all_products['the-night-ritual']
-%}
<section class="section setsx" id="sets" data-tone="lilac" aria-labelledby="SetsxTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{% if section.settings.eyebrow != blank %}{{ section.settings.eyebrow }}{% else %}{{ 'sections.bundles_feature.eyebrow' | t }}{% endif %}</p>
        <h2 class="t-display-l" id="SetsxTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <div class="setsx__aside">
        <p class="t-lead t-muted">{{ text | escape }}</p>
        <a class="link-arrow" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label }}{% else %}{{ 'sections.bundles_feature.cta' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      </div>
    </div>

    {%- comment -%} The same card as the Sets page and the shop (DECISIONS 238); the pick leads at the wider column {%- endcomment -%}
    {{ 'bundles.css' | asset_url | stylesheet_tag }}
    <ul class="setsx__grid" role="list">
      {%- comment -%} Fetched first only when the section opens the page; lower down (home) it waits its turn (DECISIONS 281). {%- endcomment -%}
      {%- liquid
        assign bf_first = false
        if section.index <= 2
          assign bf_first = true
        endif
      -%}
      {%- if hero.id -%}{%- render 'bundle-card', product: hero, priority: bf_first -%}{%- endif -%}
      {%- if mate.id -%}{%- render 'bundle-card', product: mate, image: section.settings.mate_image -%}{%- endif -%}
    </ul>
    {%- comment -%} Under the sets, where "which one?" comes up (DECISIONS 234) {%- endcomment -%}
    <div class="setsx__quiz">{%- render 'skin-check-link', key: 'skin_check.cta_sets' -%}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bundles_feature.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "product",
      "id": "hero",
      "label": "Big set card"
    },
    {
      "type": "product",
      "id": "mate",
      "label": "Second set card"
    },
    {
      "type": "image_picker",
      "id": "mate_image",
      "label": "Second card photo",
      "info": "t:sections.bundles_feature.mate_image_info"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "info": "Built-in: “Shop the sets”. The link goes to the Sets page."
    }
  ],
  "presets": [
    {
      "name": "t:sections.bundles_feature.name"
    }
  ]
}
{% endschema %}
