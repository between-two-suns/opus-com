{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  capture this_step
    render 'product-step', product: product
  endcapture
  assign this_step = this_step | strip | plus: 0
  assign source = section.settings.collection | default: collections.all
-%}
{%- comment -%} Set pages explain their own order (bundle-inside), so the strip is for single products. {%- endcomment -%}
{%- if this_step > 0 -%}
<section class="section routine-strip" aria-labelledby="RoutineStrip-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'product.routine.eyebrow' | t }}</p>
        <h2 class="t-display-m" id="RoutineStrip-{{ section.id }}">{{ 'product.routine.heading' | t }}</h2>
      </div>
    </div>

    <ol class="routine-strip__steps" role="list">
      {%- for s in (1..4) -%}
        {%- for p in source.products limit: 12 -%}
          {%- capture ps -%}{% render 'product-step', product: p %}{%- endcapture -%}
          {%- assign ps = ps | strip | plus: 0 -%}
          {%- if ps == s -%}
            {%- assign cutout = p.metafields.bts.cutout.value -%}
            {%- comment -%} The close-ups (owner prefers them: no product shown twice). {%- endcomment -%}
            {%- assign rk = 'bts-' | append: p.handle | append: '-routine.jpg' -%}
            {%- assign routine_photo = images[rk] -%}{%- if routine_photo == blank -%}{%- assign routine_photo = false -%}{%- endif -%}
            {%- assign is_this = false -%}
            {%- if p.id == product.id -%}{%- assign is_this = true -%}{%- endif -%}
            <li class="routine-strip__step{% if is_this %} is-current{% endif %}" data-step="{{ s }}">
              <a class="routine-strip__link" href="{{ p.url }}"{% if is_this %} aria-current="page"{% endif %}>
                <span class="routine-strip__media{% if routine_photo %} routine-strip__media--photo{% endif %}" aria-hidden="true">
                  {%- if routine_photo -%}
                    {{ routine_photo | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 22vw, 45vw', alt: '', class: 'routine-strip__photo' }}
                    {%- if cutout -%}{{ cutout | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '64px', alt: '', class: 'routine-strip__pack' }}{%- endif -%}
                  {%- elsif cutout -%}
                    {{ cutout | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', sizes: '(min-width: 990px) 12vw, 22vw', alt: '' }}
                  {%- elsif p.featured_media -%}
                    {{ p.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', sizes: '(min-width: 990px) 12vw, 22vw', alt: '' }}
                  {%- endif -%}
                </span>
                <span class="step-num routine-strip__num" aria-hidden="true">0{{ s }}</span>
                <span class="routine-strip__name">{{ p.title | escape }}</span>
                <span class="routine-strip__when t-xs">
                  {{ 'product.routine.am' | t }}{% if s != 4 %} · {{ 'product.routine.pm' | t }}{% endif %}
                </span>
                {%- if is_this -%}<span class="badge routine-strip__this">{{ 'product.routine.this_step' | t }}</span>{%- endif -%}
              </a>
            </li>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </ol>

    {%- comment -%} Spec: every single-product page offers The Day Ritual; stock-ups only on their own product page. {%- endcomment -%}
    <div class="routine-strip__offers">
      {%- comment -%} Only offer sets that contain this product: the moisturizer (step 3) isn't in The Day Ritual. {%- endcomment -%}
      {%- if this_step == 3 -%}
        {% render 'bundle-bar', handle: 'the-night-ritual' %}
        {% render 'bundle-bar', handle: 'the-full-ritual' %}
      {%- elsif this_step > 0 -%}
        {% render 'bundle-bar', handle: 'the-day-ritual' %}
      {%- endif -%}
      {%- if this_step == 2 -%}{% render 'bundle-bar', handle: 'serum-stock-up' %}{%- endif -%}
      {%- if this_step == 4 -%}{% render 'bundle-bar', handle: 'spf-stock-up' %}{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_routine.name",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.product_routine.collection" }
  ]
}
{% endschema %}
