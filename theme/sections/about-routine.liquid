{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About (DECISIONS 193): "A routine, not a cabinet." One Morning / Night switch over the counter photo (four packs in
  the morning, three at night) and the four steps under it, each with its job, its label wording (bts.benefit) and
  when it's used, each pack at its true size standing on its step's colour (DECISIONS 195). At night the sunscreen
  steps back. Each step opens its product.
{%- endcomment -%}
{%- liquid
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign img_am = section.settings.image_am | default: images['bts-demo-morning.jpg']
  assign img_pm = section.settings.image_pm | default: images['bts-demo-night.jpg']
  assign sets_url = routes.root_url | append: '/pages/sets' | replace: '//', '/'
  comment
    True pack heights relative to the cleanser (DECISIONS 191).
  endcomment
  assign pack_h = ',1,.65,.81,.81' | split: ','
-%}
<section class="section ab-rt" data-ab-rt data-mode="am" aria-labelledby="AbRt-{{ section.id }}">
  <div class="container">
    <div class="section-head ab-rt__head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'about2.routine_eyebrow' | t }}</p>
        <h2 class="t-display-m" id="AbRt-{{ section.id }}">{{ 'about2.routine_heading' | t }}</h2>
      </div>
      <p class="t-lead t-muted ab-rt__lede">{{ 'about2.routine_text' | t }}</p>
    </div>

    <div class="ab-rt__frame">
      {%- for m in (1..2) -%}
        {%- if m == 1 -%}{%- assign img = img_am -%}{%- assign alt = 'about2.photo_am' | t -%}{%- assign key = 'am' -%}{%- else -%}{%- assign img = img_pm -%}{%- assign alt = 'about2.photo_pm' | t -%}{%- assign key = 'pm' -%}{%- endif -%}
        {%- if img != blank -%}
          <figure class="ab-rt__photo" data-photo="{{ key }}"{% if key == 'pm' %} aria-hidden="true"{% endif %}>
            {{ img | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,2000,2400', sizes: '(min-width: 1040px) 960px, calc(100vw - 2 * var(--gutter))', alt: alt }}
          </figure>
        {%- endif -%}
      {%- endfor -%}
      <div class="ab-rt__toggle" role="radiogroup" aria-label="{{ 'about2.mode_label' | t }}">
        <button type="button" role="radio" class="ab-rt__mode" aria-checked="true" data-mode="am">{% render 'icon', name: 'sun', class: 'icon--sm' %}{{ 'bundle_inside.morning' | t }}</button>
        <button type="button" role="radio" class="ab-rt__mode" aria-checked="false" tabindex="-1" data-mode="pm">{% render 'icon', name: 'moon', class: 'icon--sm' %}{{ 'bundle_inside.night' | t }}</button>
        <span class="ab-rt__pill" aria-hidden="true"></span>
      </div>
    </div>

    <ol class="ab-rt__steps" role="list">
      {%- for i in (1..4) -%}
        {%- assign p = all_products[step_handles[i]] -%}
        {%- unless p.id -%}{%- continue -%}{%- endunless -%}
        <li class="ab-rt__step{% if i == 4 %} is-am-only{% endif %}" data-step="{{ i }}">
          <a class="ab-rt__link" href="{{ p.url }}">
            <span class="ab-rt__pack" style="--h: {{ pack_h[i] }}" aria-hidden="true">
              {%- render 'cut-img', handle: p.handle, sizes: '(min-width: 990px) 90px, 64px', widths: '120,180,240,360', class: 'ab-rt__pack-img' -%}
            </span>
            <span class="ab-rt__num" aria-hidden="true">0{{ i }}</span>
            <span class="ab-rt__job">{{ p.metafields.bts.step_label.value | default: p.title | escape }}</span>
            <span class="ab-rt__name">{{ p.title | escape }}</span>
            {%- if p.metafields.bts.benefit != blank -%}<span class="ab-rt__benefit">{{ p.metafields.bts.benefit.value | escape }}</span>{%- endif -%}
            <span class="ab-rt__when">
              {%- if i == 4 -%}{% render 'icon', name: 'sun', class: 'icon--sm' %}{{ 'about2.am_only' | t }}{%- else -%}{% render 'icon', name: 'sun', class: 'icon--sm' %}{% render 'icon', name: 'moon', class: 'icon--sm' %}{{ 'about2.am_pm' | t }}{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ol>
    <a class="link-arrow ab-rt__more" href="{{ sets_url }}">{{ 'about2.sets_link' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
  </div>
</section>
<script src="{{ 'about.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "About · routine",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image_am", "label": "Morning photo" },
    { "type": "image_picker", "id": "image_pm", "label": "Night photo" }
  ]
}
{% endschema %}
