{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About, the routine (DECISIONS 329, demo): morning and night in one card. Left, a warm morning sky with today's sun
  peeking in and all four packs in the light; right, a deep night sky with stars and a small moon and only the first
  three, the sunscreen's place an empty outline ("not tonight"). Packs at true relative sizes; each opens its product.
{%- endcomment -%}
{%- liquid
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign pack_h = ',1,.65,.81,.81' | split: ','
  assign sets_url = routes.root_url | append: '/pages/sets' | replace: '//', '/'
-%}
<section class="section ab-sh" aria-labelledby="AbSh-{{ section.id }}">
  <div class="container">
    <div class="section-head ab-sh__head">
      <div class="section-head__text">
        <p class="t-eyebrow">{% if section.settings.t_about2_routine_eyebrow != blank %}{{ section.settings.t_about2_routine_eyebrow }}{% else %}{{ 'about2.routine_eyebrow' | t }}{% endif %}</p>
        <h2 class="t-display-m" id="AbSh-{{ section.id }}">{% if section.settings.t_about2_routine_heading != blank %}{{ section.settings.t_about2_routine_heading }}{% else %}{{ 'about2.routine_heading' | t }}{% endif %}</h2>
      </div>
      <div class="ab-sh__aside">
        <p class="t-lead t-muted">{% if section.settings.t_about2_routine_text != blank %}{{ section.settings.t_about2_routine_text }}{% else %}{{ 'about2.v2_routine_text' | t }}{% endif %}</p>
        <a class="link-arrow" href="{{ sets_url }}">{% if section.settings.t_about2_sets_link != blank %}{{ section.settings.t_about2_sets_link }}{% else %}{{ 'about2.sets_link' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
      </div>
    </div>

    {%- assign look = section.settings.look | default: 'texture' -%}
    {%- if look == 'sentence' -%}
      <p class="ab-sh__sentence">
        {%- for i in (1..4) -%}
          {%- assign p = all_products[step_handles[i]] -%}
          {%- unless p.id -%}{%- continue -%}{%- endunless -%}
          {%- assign nk = 'product.step_name.s' | append: i -%}
          <a class="ab-sh__w" data-step="{{ i }}" href="{{ p.url }}"><span class="ab-sh__word">{{ nk | t }}{% unless forloop.last %}{{ 'about2.sh_comma' | t }}{% else %}.{% endunless %}</span><span class="ab-sh__inline" style="--h: {{ pack_h[i] }}" aria-hidden="true">{%- render 'cut-img', handle: p.handle, sizes: '120px', widths: '120,180,240', class: 'ab-sh__inline-img' -%}</span></a>{% unless forloop.last %}{{ ' ' }}{% endunless %}
        {%- endfor -%}
      </p>
      <p class="ab-sh__note">{% render 'icon', name: 'sun', class: 'icon--sm' %} <span>{{ 'about2.sh_am' | t }}</span> <span class="ab-sh__note-gap" aria-hidden="true"></span> {% render 'icon', name: 'moon', class: 'icon--sm' %} <span>{{ 'about2.sh_pm' | t }}</span></p>
    {%- else -%}
      <ol class="ab-sh__tex" role="list">
        {%- for i in (1..4) -%}
          {%- assign p = all_products[step_handles[i]] -%}
          {%- unless p.id -%}{%- continue -%}{%- endunless -%}
          {%- assign nk = 'product.step_name.s' | append: i -%}
          {%- assign tk = 'bts-' | append: p.handle | append: '-texture.jpg' -%}
          {%- assign timg = images[tk] -%}
          <li class="ab-sh__panel" data-step="{{ i }}">
            <a class="ab-sh__plink" href="{{ p.url }}">
              {%- if timg != blank and timg.width != blank -%}
                {{ timg | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 750px) 25vw, 50vw', alt: '', class: 'ab-sh__photo' }}
              {%- endif -%}
              <span class="ab-sh__pnum" aria-hidden="true">0{{ i }}</span>
              <span class="ab-sh__pfoot">
                <span class="ab-sh__pverb">{{ nk | t }}</span>
                <span class="ab-sh__pname">{{ p.title | escape }}</span>
                <span class="ab-sh__pwhen">{%- if i == 4 -%}{% render 'icon', name: 'sun', class: 'icon--sm' %} {{ 'about2.am_only' | t }}{%- else -%}{% render 'icon', name: 'sun', class: 'icon--sm' %}{% render 'icon', name: 'moon', class: 'icon--sm' %} {{ 'about2.am_pm' | t }}{%- endif -%}</span>
              </span>
              <span class="ab-sh__ppack" style="--h: {{ pack_h[i] }}" aria-hidden="true">{%- render 'cut-img', handle: p.handle, sizes: '120px', widths: '120,180,240', class: 'ab-sh__ppack-img' -%}</span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About · routine",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "paragraph", "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English." },
    { "type": "text", "id": "t_about2_routine_eyebrow", "label": "Small line above the heading", "info": "Now: “The routine”. Leave empty to keep it (English and Arabic)." },
    { "type": "text", "id": "t_about2_routine_heading", "label": "Heading", "info": "Now: “A routine, not a cabinet.” Leave empty to keep it (English and Arabic)." },
    { "type": "textarea", "id": "t_about2_routine_text", "label": "Paragraph", "info": "Now: “More products don’t automatically mean better skincare…”. Leave empty to keep it (English and Arabic)." },
    { "type": "select", "id": "look", "label": "Look", "default": "texture", "options": [ { "value": "texture", "label": "Texture panels" }, { "value": "sentence", "label": "The routine as one sentence" } ] },
    { "type": "text", "id": "t_about2_sets_link", "label": "Link text", "info": "Now: “Find your set”. Leave empty to keep it (English and Arabic)." }
  ]
}
{% endschema %}
