{{ 'account.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The account page (DECISIONS 273), /pages/account. This store uses Shopify's new customer accounts: sign-in and the
  profile are Shopify-hosted, so this page is our own front door and home for them.
  Signed out: our sign-in. The email goes to Shopify's sign-in already filled in (login_hint), Shopify sends the
  6-digit code, and return_to brings the customer back here.
  Signed in: the customer's routine (the steps they've bought, from their own orders), reorder in one tap, their
  orders (each opens Shopify's order page with tracking), their details, and sign out.
{%- endcomment -%}
{%- liquid
  assign step_handles = 'daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign acct_base = routes.account_url | split: '?' | first
-%}
<section class="acct{% if customer %} acct--in{% else %} acct--out{% endif %}">
  {%- unless customer -%}
    {%- comment -%} The sign-in form posts to Shopify's own sign-in route, keeping its parameters and adding the email {%- endcomment -%}
    {%- liquid
      assign login_url = routes.storefront_login_url | default: '/customer_authentication/login'
      assign login_parts = login_url | split: '?'
      assign login_action = login_parts | first
      assign login_query = ''
      if login_parts.size > 1
        assign login_query = login_parts.last | split: '&'
      endif
    -%}
    <div class="acct-out">
      <div class="acct-out__stage" aria-hidden="true">
        <span class="acct-out__packs">
          {%- for h in step_handles -%}
            <span class="acct-out__pack" data-step="{{ forloop.index }}" style="--k: {{ forloop.index0 }}">{%- render 'cut-img', handle: h, sizes: '(min-width: 990px) 9vw, 18vw', widths: '120,180,240,360', loading: 'eager', class: 'acct-out__cut' -%}</span>
          {%- endfor -%}
        </span>
        <span class="acct-out__claim">
          <span class="acct-out__title">{% if section.settings.t_customer_perks_title != blank %}{{ section.settings.t_customer_perks_title }}{% else %}{{ 'customer.perks_title' | t }}{% endif %}</span>
          <span class="acct-out__perks">
            <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_reorder != blank %}{{ section.settings.t_account_page_perk_reorder }}{% else %}{{ 'account_page.perk_reorder' | t }}{% endif %}</span>
            <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_track != blank %}{{ section.settings.t_account_page_perk_track }}{% else %}{{ 'account_page.perk_track' | t }}{% endif %}</span>
            <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_address != blank %}{{ section.settings.t_account_page_perk_address }}{% else %}{{ 'account_page.perk_address' | t }}{% endif %}</span>
          </span>
        </span>
      </div>

      <div class="acct-out__panel">
        <p class="t-eyebrow t-muted">{% if section.settings.t_account_page_eyebrow != blank %}{{ section.settings.t_account_page_eyebrow }}{% else %}{{ 'account_page.eyebrow' | t }}{% endif %}</p>
        <h1 class="acct-out__h">{% if section.settings.t_account_page_title != blank %}{{ section.settings.t_account_page_title }}{% else %}{{ 'account_page.title' | t }}{% endif %}</h1>
        <p class="acct-out__lead">{% if section.settings.t_account_page_lead != blank %}{{ section.settings.t_account_page_lead }}{% else %}{{ 'account_page.lead' | t }}{% endif %}</p>
        <form class="acct-out__form" action="{{ login_action }}" method="get">
          {%- assign has_return = false -%}
          {%- for pair in login_query -%}
            {%- assign kv = pair | split: '=' -%}
            {%- if kv.first == 'return_to' -%}{%- assign has_return = true -%}{%- endif -%}
            {%- if kv.first != 'login_hint' and kv.first != blank -%}<input type="hidden" name="{{ kv.first | url_decode | escape }}" value="{{ kv.last | url_decode | escape }}">{%- endif -%}
          {%- endfor -%}
          {%- unless has_return -%}<input type="hidden" name="return_to" value="{{ request.path | escape }}">{%- endunless -%}
          <label class="acct-out__label" for="AcctEmail">{% if section.settings.t_customer_email != blank %}{{ section.settings.t_customer_email }}{% else %}{{ 'customer.email' | t }}{% endif %}</label>
          <div class="acct-out__row">
            <input id="AcctEmail" class="acct-out__input" type="email" name="login_hint" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" required placeholder="name@email.com" dir="ltr">
            <button type="submit" class="btn btn--primary acct-out__go">{% if section.settings.t_account_page_continue != blank %}{{ section.settings.t_account_page_continue }}{% else %}{{ 'account_page.continue' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</button>
          </div>
        </form>
        <p class="acct-out__how">{% if section.settings.t_account_page_how_1 != blank %}{{ section.settings.t_account_page_how_1 }}{% else %}{{ 'account_page.how_1' | t }}{% endif %}{% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}{% if section.settings.t_account_page_how_2 != blank %}{{ section.settings.t_account_page_how_2 }}{% else %}{{ 'account_page.how_2' | t }}{% endif %}{% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}{% if section.settings.t_account_page_how_3 != blank %}{{ section.settings.t_account_page_how_3 }}{% else %}{{ 'account_page.how_3' | t }}{% endif %}</p>
        {%- comment -%} On phones the benefits sit here, under the form, instead of crowding the picture {%- endcomment -%}
        <span class="acct-out__perks acct-out__perks--panel">
          <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_reorder != blank %}{{ section.settings.t_account_page_perk_reorder }}{% else %}{{ 'account_page.perk_reorder' | t }}{% endif %}</span>
          <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_track != blank %}{{ section.settings.t_account_page_perk_track }}{% else %}{{ 'account_page.perk_track' | t }}{% endif %}</span>
          <span>{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_perk_address != blank %}{{ section.settings.t_account_page_perk_address }}{% else %}{{ 'account_page.perk_address' | t }}{% endif %}</span>
        </span>
        <p class="acct-out__new">{% if section.settings.t_account_page_new_here != blank %}{{ section.settings.t_account_page_new_here }}{% else %}{{ 'account_page.new_here' | t }}{% endif %}</p>
        <p class="acct-out__legal t-muted">{{ 'account_page.legal_html' | t: privacy: '/policies/privacy-policy' }}</p>
      </div>
    </div>
  {%- else -%}
    {%- liquid
      comment
        The steps this customer has: every routine step in their orders, singles and the steps inside sets.
      endcomment
      assign owned = ''
    -%}
    {%- paginate customer.orders by 20 -%}
      {%- for order in customer.orders -%}
        {%- for li in order.line_items -%}
          {%- capture li_step -%}{% render 'product-step', product: li.product %}{%- endcapture -%}
          {%- assign li_step = li_step | strip -%}
          {%- if li_step != '' and li_step != '0' -%}
            {%- assign owned = owned | append: li_step -%}
          {%- else -%}
            {%- capture li_def -%}{% render 'bundle-def', handle: li.product.handle %}{%- endcapture -%}
            {%- assign li_steps = li_def | strip | split: '|' | first -%}
            {%- assign owned = owned | append: li_steps -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

      <header class="acct-in__head">
        <div class="container acct-in__head-inner">
          <p class="t-eyebrow t-muted">{% if section.settings.t_account_page_eyebrow != blank %}{{ section.settings.t_account_page_eyebrow }}{% else %}{{ 'account_page.eyebrow' | t }}{% endif %}</p>
          <h1 class="acct-in__h">{% if customer.first_name != blank %}{{ 'account_page.hello_name' | t: name: customer.first_name }}{% else %}{% if section.settings.t_account_page_hello != blank %}{{ section.settings.t_account_page_hello }}{% else %}{{ 'account_page.hello' | t }}{% endif %}{% endif %}</h1>
          <p class="acct-in__who"><span dir="ltr">{{ customer.email }}</span> · <a href="{{ routes.account_logout_url }}">{% if section.settings.t_account_page_sign_out != blank %}{{ section.settings.t_account_page_sign_out }}{% else %}{{ 'account_page.sign_out' | t }}{% endif %}</a></p>
        </div>
      </header>

      <div class="container acct-in__grid">
        <div class="acct-in__main">
          {%- comment -%} Your routine: the four steps, the ones they have in colour {%- endcomment -%}
          {%- assign have = 0 -%}
          {%- for h in step_handles -%}{%- assign sn = forloop.index | append: '' -%}{%- if owned contains sn -%}{%- assign have = have | plus: 1 -%}{%- endif -%}{%- endfor -%}
          <article class="acct-card acct-routine">
            <div class="acct-card__top">
              <h2 class="acct-card__h">{% if section.settings.t_account_page_routine != blank %}{{ section.settings.t_account_page_routine }}{% else %}{{ 'account_page.routine' | t }}{% endif %}</h2>
              <p class="acct-routine__count">{{ 'account_page.routine_count' | t: have: have }}</p>
            </div>
            <ol class="acct-routine__steps" role="list">
              {%- for h in step_handles -%}
                {%- assign product = all_products[h] -%}{%- unless product.id -%}{%- continue -%}{%- endunless -%}
                {%- assign sn = forloop.index | append: '' -%}
                {%- assign got = false -%}{%- if owned contains sn -%}{%- assign got = true -%}{%- endif -%}
                <li class="acct-step{% if got %} is-have{% endif %}" data-step="{{ forloop.index }}">
                  <a class="acct-step__pack" href="{{ product.url }}">{%- render 'cut-img', handle: h, sizes: '90px', widths: '120,180,240', class: 'acct-step__cut' -%}</a>
                  <span class="acct-step__num">0{{ forloop.index }}</span>
                  <span class="acct-step__name">{{ product.metafields.bts.step_label.value | default: product.title | escape }}</span>
                  {%- if got -%}
                    <span class="acct-step__state">{% render 'icon', name: 'check', class: 'icon--sm' %}{% if section.settings.t_account_page_in_routine != blank %}{{ section.settings.t_account_page_in_routine }}{% else %}{{ 'account_page.in_routine' | t }}{% endif %}</span>
                  {%- else -%}
                    <product-form class="acct-step__add" data-product-title="{{ product.title | escape }}">
                      <form method="post" action="{{ routes.cart_add_url }}">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" class="acct-step__btn">{% render 'icon', name: 'plus', class: 'icon--sm' %}{% if section.settings.t_account_page_add != blank %}{{ section.settings.t_account_page_add }}{% else %}{{ 'account_page.add' | t }}{% endif %} · {% render 'egp', cents: product.price %}</button>
                        <p class="visually-hidden" data-form-error role="alert" hidden></p>
                      </form>
                    </product-form>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ol>
            {%- if have == 4 -%}
              <p class="acct-routine__note">{% if section.settings.t_account_page_routine_full != blank %}{{ section.settings.t_account_page_routine_full }}{% else %}{{ 'account_page.routine_full' | t }}{% endif %}</p>
            {%- elsif have == 0 -%}
              {%- assign ritual = all_products['the-full-ritual'] -%}
              {%- if ritual.id -%}<a class="acct-routine__ritual" href="{{ ritual.url }}"><span class="pick-chip">{% if section.settings.t_shop_menu_pick != blank %}{{ section.settings.t_shop_menu_pick }}{% else %}{{ 'shop_menu.pick' | t }}{% endif %}</span> {{ ritual.title | escape }} · {% render 'egp', cents: ritual.price %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>{%- endif -%}
            {%- endif -%}
          </article>

          {%- comment -%} Reorder: the last order, all of it, in one tap {%- endcomment -%}
          {%- assign last = customer.last_order -%}
          {%- if last -%}
            <article class="acct-card acct-reorder">
              <div class="acct-card__top">
                <h2 class="acct-card__h">{% if section.settings.t_account_page_reorder != blank %}{{ section.settings.t_account_page_reorder }}{% else %}{{ 'account_page.reorder' | t }}{% endif %}</h2>
                <p class="t-muted acct-reorder__from">{{ 'account_page.reorder_from' | t: name: last.name }}</p>
              </div>
              <div class="acct-reorder__body">
                <ul class="acct-reorder__items" role="list">
                  {%- for li in last.line_items limit: 4 -%}
                    {%- capture li_step -%}{% render 'product-step', product: li.product %}{%- endcapture -%}{%- assign li_step = li_step | strip | plus: 0 -%}
                    <li class="acct-reorder__item">
                      <span class="acct-thumb" data-step="{{ li_step }}">{%- if li_step > 0 -%}{%- render 'cut-img', handle: li.product.handle, sizes: '44px', widths: '120', class: 'acct-thumb__cut' -%}{%- elsif li.image -%}{{ li.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
                      <span>{{ li.product.title | escape }}{% if li.quantity > 1 %} <b>× {{ li.quantity }}</b>{% endif %}</span>
                    </li>
                  {%- endfor -%}
                </ul>
                <product-form data-multi class="acct-reorder__form" data-product-title="{{ 'account_page.reorder' | t | escape }}">
                  <form method="post" action="{{ routes.cart_add_url }}">
                    {%- for li in last.line_items -%}
                      {%- if li.variant.available -%}
                        <input type="hidden" name="items[][id]" value="{{ li.variant.id }}">
                        <input type="hidden" name="items[][quantity]" value="{{ li.quantity }}">
                      {%- endif -%}
                    {%- endfor -%}
                    <button type="submit" class="btn btn--primary">{% if section.settings.t_account_page_add_all != blank %}{{ section.settings.t_account_page_add_all }}{% else %}{{ 'account_page.add_all' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</button>
                    <p class="t-small" data-form-error role="alert" hidden></p>
                  </form>
                </product-form>
              </div>
            </article>
          {%- endif -%}

          {%- comment -%} Orders: each opens Shopify's order page (status and tracking) {%- endcomment -%}
          <article class="acct-card acct-orders">
            <div class="acct-card__top">
              <h2 class="acct-card__h">{% if section.settings.t_account_page_orders != blank %}{{ section.settings.t_account_page_orders }}{% else %}{{ 'account_page.orders' | t }}{% endif %}</h2>
              {%- if customer.orders_count > 0 -%}<a class="acct-card__more" href="{{ acct_base }}/orders">{% if section.settings.t_account_page_all_orders != blank %}{{ section.settings.t_account_page_all_orders }}{% else %}{{ 'account_page.all_orders' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>{%- endif -%}
            </div>
            {%- if customer.orders.size > 0 -%}
              <ul class="acct-orders__list" role="list">
                {%- for order in customer.orders limit: 5 -%}
                  <li>
                    <a class="acct-order" href="{{ order.customer_url }}">
                      <span class="acct-thumbs acct-thumbs--sm">
                        {%- for li in order.line_items limit: 3 -%}
                          {%- capture li_step -%}{% render 'product-step', product: li.product %}{%- endcapture -%}{%- assign li_step = li_step | strip | plus: 0 -%}
                          <span class="acct-thumb" data-step="{{ li_step }}">{%- if li_step > 0 -%}{%- render 'cut-img', handle: li.product.handle, sizes: '32px', widths: '120', class: 'acct-thumb__cut' -%}{%- elsif li.image -%}{{ li.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
                        {%- endfor -%}
                      </span>
                      <span class="acct-order__main">
                        <strong>{{ order.name }}</strong>
                        <span class="t-muted">{{ order.created_at | date: format: 'account_date' }}</span>
                      </span>
                      {%- comment -%} The customer's words, not the shop's: being prepared, partly shipped, shipped, cancelled {%- endcomment -%}
                      {%- if order.cancelled -%}
                        <span class="acct-order__status is-off">{% if section.settings.t_account_page_status_cancelled != blank %}{{ section.settings.t_account_page_status_cancelled }}{% else %}{{ 'account_page.status_cancelled' | t }}{% endif %}</span>
                      {%- elsif order.fulfillment_status == 'fulfilled' -%}
                        <span class="acct-order__status is-done">{% if section.settings.t_account_page_status_shipped != blank %}{{ section.settings.t_account_page_status_shipped }}{% else %}{{ 'account_page.status_shipped' | t }}{% endif %}</span>
                      {%- elsif order.fulfillment_status == 'partial' -%}
                        <span class="acct-order__status">{% if section.settings.t_account_page_status_partial != blank %}{{ section.settings.t_account_page_status_partial }}{% else %}{{ 'account_page.status_partial' | t }}{% endif %}</span>
                      {%- else -%}
                        <span class="acct-order__status">{% if section.settings.t_account_page_status_preparing != blank %}{{ section.settings.t_account_page_status_preparing }}{% else %}{{ 'account_page.status_preparing' | t }}{% endif %}</span>
                      {%- endif -%}
                      <span class="acct-order__total">{% render 'egp', cents: order.total_price %}</span>
                      {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip acct-order__go' %}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <div class="acct-empty">
                <p>{% if section.settings.t_account_page_no_orders != blank %}{{ section.settings.t_account_page_no_orders }}{% else %}{{ 'account_page.no_orders' | t }}{% endif %}</p>
                <a class="btn" href="{{ routes.all_products_collection_url }}">{% if section.settings.t_cart_shop_routine != blank %}{{ section.settings.t_cart_shop_routine }}{% else %}{{ 'cart.shop_routine' | t }}{% endif %}</a>
              </div>
            {%- endif -%}
          </article>
        </div>

        <aside class="acct-in__side">
          <article class="acct-card acct-details">
            <h2 class="acct-card__h">{% if section.settings.t_account_page_details != blank %}{{ section.settings.t_account_page_details }}{% else %}{{ 'account_page.details' | t }}{% endif %}</h2>
            <dl class="acct-details__list">
              {%- if customer.name != blank -%}<div><dt>{% if section.settings.t_account_page_name != blank %}{{ section.settings.t_account_page_name }}{% else %}{{ 'account_page.name' | t }}{% endif %}</dt><dd>{{ customer.name | escape }}</dd></div>{%- endif -%}
              <div><dt>{% if section.settings.t_customer_email != blank %}{{ section.settings.t_customer_email }}{% else %}{{ 'customer.email' | t }}{% endif %}</dt><dd dir="ltr">{{ customer.email | escape }}</dd></div>
              <div><dt>{% if section.settings.t_account_page_address != blank %}{{ section.settings.t_account_page_address }}{% else %}{{ 'account_page.address' | t }}{% endif %}</dt><dd>{% if customer.default_address %}{{ customer.default_address.summary | escape }}{% else %}<span class="t-muted">{% if section.settings.t_account_page_no_address != blank %}{{ section.settings.t_account_page_no_address }}{% else %}{{ 'account_page.no_address' | t }}{% endif %}</span>{% endif %}</dd></div>
            </dl>
            <a class="acct-card__more" href="{{ acct_base }}/profile">{% if section.settings.t_account_page_edit != blank %}{{ section.settings.t_account_page_edit }}{% else %}{{ 'account_page.edit' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
          </article>
          <article class="acct-card acct-help">
            <h2 class="acct-card__h">{% if section.settings.t_account_page_help != blank %}{{ section.settings.t_account_page_help }}{% else %}{{ 'account_page.help' | t }}{% endif %}</h2>
            <a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">{% if section.settings.t_account_page_help_contact != blank %}{{ section.settings.t_account_page_help_contact }}{% else %}{{ 'account_page.help_contact' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
            <a href="{{ routes.root_url | append: '/pages/returns' | replace: '//', '/' }}">{% if section.settings.t_account_page_help_returns != blank %}{{ section.settings.t_account_page_help_returns }}{% else %}{{ 'account_page.help_returns' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
            <a href="{{ routes.root_url | append: '/pages/shipping' | replace: '//', '/' }}">{% if section.settings.t_account_page_help_delivery != blank %}{{ section.settings.t_account_page_help_delivery }}{% else %}{{ 'account_page.help_delivery' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
          </article>
        </aside>
      </div>
    {%- endpaginate -%}
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Account",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_customer_perks_title",
      "label": "Customer · Title",
      "info": "Now: “Your routine, remembered.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_perk_reorder",
      "label": "Account page · Perk reorder",
      "info": "Now: “Reorder your routine in one tap”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_perk_track",
      "label": "Account page · Perk track",
      "info": "Now: “Track every order”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_perk_address",
      "label": "Account page · Perk address",
      "info": "Now: “Your address saved for next time”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_eyebrow",
      "label": "Account page · Small line above the heading",
      "info": "Now: “Account”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_title",
      "label": "Account page · Title",
      "info": "Now: “Sign in or create your account.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_lead",
      "label": "Account page · Paragraph",
      "info": "Now: “No password to remember. We email you a 6-digit code to sign in.”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_customer_email",
      "label": "Customer · Email",
      "info": "Now: “Email”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_account_page_continue",
