{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About story, concept "Between" (DECISIONS 354, local mock-up only until the owner approves).
  One idea: the brand's key lines sit literally between two suns — the two arcs of the )( mark, used very large.
  A — poster title, each line fitted to the width, intro set large.
  B — the question on a full-width blue panel, between two giant arcs.
  C — the life here: four phrases as one bold typographic list, numbered in the four step colours, then the passage.
  D — "So we created Between Two Suns." between two arcs again, small.
  E — the night close (unchanged design).
  Motion: a soft rise as each part arrives, nothing else. Reduced motion or no JS: shown, still.
{%- endcomment -%}
{%- liquid
  assign close_words = 'about3.close' | t | split: ' '
  assign s2 = 'about3.s2_p1' | t | split: '. '
-%}
<style>
  .ab2 { overflow: clip; }
  .ab2 p { margin: 0; }
  .ab2__arcs { position: absolute; inset: 0; pointer-events: none; }
  .ab2__arc { position: absolute; inset-block: -6%; aspect-ratio: 0.46; background: var(--arc, #fff); -webkit-mask: var(--mark) 0 50% / 200% 100% no-repeat; mask: var(--mark) 0 50% / 200% 100% no-repeat; }
  .ab2__arc--l { inset-inline-start: -2%; }
  .ab2__arc--r { inset-inline-end: -2%; -webkit-mask-position: 100% 50%; mask-position: 100% 50%; }
  [dir='rtl'] .ab2__arc--l { -webkit-mask-position: 100% 50%; mask-position: 100% 50%; }
  [dir='rtl'] .ab2__arc--r { -webkit-mask-position: 0 50%; mask-position: 0 50%; }

  /* A */
  .ab2__a { padding-block: clamp(64px, 9vw, 140px) clamp(72px, 10vw, 160px); }
  .ab2__eyebrow { display: flex; align-items: center; gap: 10px; margin-block-end: clamp(18px, 2.4vw, 36px); }
  .ab2__title { margin: 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.94; letter-spacing: -0.01em; font-size: min(16.6vw, 250px); }
  .ab2__title span { display: block; padding-block-end: 0.02em; }
  .ab2__title span + span { text-align: end; }
  :lang(ar) .ab2__title { text-transform: none; line-height: 1.2; font-size: min(17vw, 220px); }
  .ab2 .ab2__intro { margin-block-start: clamp(28px, 4vw, 64px); font-size: clamp(20px, 2vw, 30px); line-height: 1.4; letter-spacing: -0.01em; max-inline-size: 22em; font-weight: 500; }

  /* B */
  .ab2__b { position: relative; background: var(--c-step-2-tint); --arc: #fff; padding-block: clamp(120px, 16vw, 260px); text-align: center; }
  .ab2__b-in { position: relative; display: grid; justify-items: center; gap: clamp(16px, 2vw, 28px); }
  .ab2__q-lead { font-size: clamp(14px, 1.2vw, 18px); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
  :lang(ar) .ab2__q-lead { letter-spacing: 0; text-transform: none; }
  .ab2__q { font-weight: 700; font-size: clamp(40px, 6.4vw, 112px); line-height: 0.98; letter-spacing: -0.04em; max-inline-size: 9.5em; text-wrap: balance; }
  :lang(ar) .ab2__q { letter-spacing: 0; line-height: 1.3; font-size: clamp(36px, 5.4vw, 92px); }

  /* C */
  .ab2__c { padding-block: clamp(88px, 11vw, 180px) clamp(40px, 5vw, 80px); }
  .ab2 .ab2__lead { font-weight: 700; font-size: clamp(24px, 2.6vw, 40px); line-height: 1.15; letter-spacing: -0.02em; max-inline-size: 16em; margin-block-end: clamp(24px, 3vw, 44px); }
  :lang(ar) .ab2__lead { letter-spacing: 0; line-height: 1.4; }
  .ab2 [role='list'].ab2__list { margin: 0; padding: 0; list-style: none; border-block-start: 2px solid var(--c-ink); }
  .ab2__item { display: flex; align-items: flex-start; gap: clamp(12px, 2vw, 32px); padding-block: clamp(10px, 1.4vw, 20px); border-block-end: 2px solid var(--c-ink); }
  .ab2__n { flex: none; inline-size: 2.4em; font-weight: 700; font-size: clamp(13px, 1.1vw, 16px); color: var(--c-ink); font-variant-numeric: tabular-nums; display: flex; align-items: center; gap: 8px; margin-block-start: 0.9em; }
  .ab2__n::before { content: ''; inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--sku); }
  .ab2__w { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: clamp(48px, 10.4vw, 176px); line-height: 0.9; letter-spacing: -0.005em; }
  :lang(ar) .ab2__w { text-transform: none; line-height: 1.3; font-size: clamp(42px, 8vw, 132px); }
  .ab2__body { display: grid; gap: 1em; margin-block-start: clamp(40px, 5vw, 80px); font-size: clamp(18px, 1.4vw, 21px); line-height: 1.6; color: color-mix(in srgb, var(--c-ink) 84%, transparent); }
  .ab2__body strong { color: var(--c-ink); font-weight: 700; font-size: 1.15em; line-height: 1.45; }

  /* D */
  .ab2__d { position: relative; --arc: var(--c-step-2); padding-block: clamp(100px, 13vw, 200px); text-align: center; }
  .ab2__d .ab2__arc { inset-block: 4%; opacity: 0.9; }
  .ab2__d-in { position: relative; display: grid; justify-items: center; gap: clamp(14px, 1.8vw, 24px); max-inline-size: 40rem; margin-inline: auto; font-size: clamp(18px, 1.4vw, 21px); line-height: 1.6; }
  .ab2__d-head { font-weight: 700; font-size: clamp(34px, 4.8vw, 80px); line-height: 1; letter-spacing: -0.035em; text-wrap: balance; margin-block-end: 8px; }
  :lang(ar) .ab2__d-head { letter-spacing: 0; line-height: 1.35; }
  .ab2__d-in > p:last-child { color: color-mix(in srgb, var(--c-ink) 84%, transparent); max-inline-size: 30rem; }

  @media (min-width: 990px) {
    .ab2__a-foot { display: grid; grid-template-columns: 1fr 1fr; }
    .ab2__intro { grid-column: 2; }
    .ab2__c-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(40px, 6vw, 120px); }
    .ab2__body { grid-column: 2; }
  }
  @media (max-width: 749px) {
    .ab2__arc { inset-block: auto; block-size: 92%; inset-block-start: 4%; }
    .ab2__arc--l { inset-inline-start: -30%; }
    .ab2__arc--r { inset-inline-end: -30%; }
    .ab2__b { padding-block: 120px; }
    .ab2__d .ab2__arc { block-size: 60%; inset-block-start: 20%; opacity: 0.35; }
    .ab2__d .ab2__arc--l { inset-inline-start: -26%; }
    .ab2__d .ab2__arc--r { inset-inline-end: -26%; }
  }
  /* soft rise only */
  .ab2.is-live [data-rise] { opacity: 0; transform: translateY(26px); transition: opacity 1s var(--ease-out), transform 1s var(--ease-out); }
  .ab2.is-live [data-rise].is-in { opacity: 1; transform: none; }
</style>
<section class="ab2 ab-st" data-ab-st>
  <div class="container ab2__a">
    <p class="t-eyebrow ab2__eyebrow" data-rise>{{ 'about3.eyebrow' | t }}</p>
    <h2 class="ab2__title" data-rise><span>{{ 'about3.title_1' | t }}</span><span>{{ 'about3.title_2' | t }}</span></h2>
    <div class="ab2__a-foot"><p class="ab2__intro" data-rise>{{ 'about3.p1' | t }}</p></div>
  </div>

  <div class="ab2__b">
    <div class="ab2__arcs" aria-hidden="true"><span class="ab2__arc ab2__arc--l"></span><span class="ab2__arc ab2__arc--r"></span></div>
    <div class="container ab2__b-in" data-rise>
      <p class="ab2__q-lead">{{ 'about3.q_lead' | t }}</p>
      <p class="ab2__q">{{ 'about3.q' | t }}</p>
    </div>
  </div>

  <div class="container ab2__c">
    <p class="ab2__lead" data-rise>{{ 'about3.s2_head' | t }}</p>
    {%- if s2.size > 4 -%}
      <ul class="ab2__list" role="list">
        {%- for k in (0..3) -%}
          <li class="ab2__item" data-step="{{ k | plus: 1 }}" data-rise><span class="ab2__n">0{{ k | plus: 1 }}</span><span class="ab2__w">{{ s2[k] }}.</span></li>
        {%- endfor -%}
      </ul>
      {%- assign rest = s2 | slice: 4, 20 | join: '. ' -%}
    {%- else -%}
      {%- assign rest = 'about3.s2_p1' | t -%}
    {%- endif -%}
    <div class="ab2__c-grid">
      <div class="ab2__body" data-rise>
        <p><strong>{{ rest }}</strong></p>
        <p>{{ 'about3.s2_p2' | t }}</p>
        <p>{{ 'about3.s2_p3' | t }}</p>
      </div>
    </div>
  </div>

  <div class="ab2__d">
    <div class="ab2__arcs" aria-hidden="true"><span class="ab2__arc ab2__arc--l"></span><span class="ab2__arc ab2__arc--r"></span></div>
    <div class="container"><div class="ab2__d-in" data-rise>
      <p class="ab2__d-head">{{ 'about3.s3_head' | t }}</p>
      <p><strong>{{ 'about3.s3_p1' | t }}</strong></p>
      <p>{{ 'about3.s3_p2' | t }}</p>
    </div></div>
  </div>

  <div class="ab-st__d" style="margin-block-start: 0"><div class="container ab-st__d-in">
    <p class="ab-st__close">{%- for w in close_words -%}<span class="ab-st__w">{{ w }}</span>{%- unless forloop.last -%}{{ ' ' }}{%- endunless -%}{%- endfor -%}</p>
    <p class="ab-st__sign" data-rise><span class="ab-st__mark" aria-hidden="true"></span>{{ 'about3.close_2' | t }}</p>
  </div></div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('is-live');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    root.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
    const close = root.querySelector('.ab-st__close');
    const words = [...root.querySelectorAll('.ab-st__w')];
    let ticking = false;
    const tick = () => { ticking = false; const r = close.getBoundingClientRect(), h = innerHeight; const p = Math.min(1, Math.max(0, (h * 0.85 - r.top) / (h * 0.5 + r.height * 0.5))) * words.length; words.forEach((w, i) => w.classList.toggle('is-on', i < p)); };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    tick();
  })();
</script>

{% schema %}
{
  "name": "About · our story (between)",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
