{{ 'pages.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The bag page. Left: the routine board (the four steps, what is missing one tap away) and the bag's lines.
  Right: a sticky summary (free delivery, savings, subtotal, a tucked-away order note, checkout with the total).
  Phones: the same, with the checkout pinned above the bottom bar. Quantity changes reload the page (theme.js).
{%- endcomment -%}
<section class="section section--tight cart-page" aria-labelledby="CartTitle">
  <div class="container">
    <header class="cart-page__head">
      <h1 class="cart-page__title" id="CartTitle">{% if section.settings.t_cart_title != blank %}{{ section.settings.t_cart_title }}{% else %}{{ 'cart.title' | t }}{% endif %}{% if cart.item_count > 0 %} <span class="cart-page__n">({{ cart.item_count }})</span>{% endif %}</h1>
      <a class="link-arrow cart-page__continue" href="{{ routes.all_products_collection_url }}">{% if section.settings.t_cart_continue != blank %}{{ section.settings.t_cart_continue }}{% else %}{{ 'cart.continue' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </header>
    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <div class="cart-empty">
          <p class="t-lead">{% if section.settings.t_cart_empty_title != blank %}{{ section.settings.t_cart_empty_title }}{% else %}{{ 'cart.empty_title' | t }}{% endif %}</p>
          <p class="t-muted">{% if section.settings.t_cart_empty_text != blank %}{{ section.settings.t_cart_empty_text }}{% else %}{{ 'cart.empty_text' | t }}{% endif %}</p>
          <a class="btn" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{% if section.settings.t_cart_shop_routine != blank %}{{ section.settings.t_cart_shop_routine }}{% else %}{{ 'cart.shop_routine' | t }}{% endif %}</a>
        </div>
        {%- render 'cart-routine-board' -%}
      </div>
    {%- else -%}
      <form id="CartForm" action="{{ routes.cart_url }}" method="post" hidden></form>
      <div class="cart-page__grid" data-cart-root data-count="{{ cart.item_count }}">
        <div class="cart-page__main">
          {%- render 'cart-routine-board' -%}
          <ul class="cart-lines cart-page__lines" role="list">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, index: forloop.index, prefix: 'Cart', form: 'CartForm' -%}
            {%- endfor -%}
          </ul>
        </div>
        <aside class="cart-page__summary" aria-label="{% if section.settings.t_cart_summary != blank %}{{ section.settings.t_cart_summary }}{% else %}{{ 'cart.summary' | t }}{% endif %}">
          {%- render 'cart-incentives' -%}
          <div class="cart-totals">
            {%- assign cp_saved = cart.original_total_price | minus: cart.total_price -%}
            {%- for item in cart.items -%}
              {%- if item.variant.compare_at_price > item.variant.price -%}
                {%- assign cp_diff = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity -%}
                {%- assign cp_saved = cp_saved | plus: cp_diff -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-totals__row cart-totals__row--deal"><span>{{ discount.title | escape }}</span><span>−{% render 'egp', cents: discount.total_allocated_amount %}</span></div>
            {%- endfor -%}
            {%- if cp_saved > 0 -%}
              <div class="cart-totals__row cart-totals__row--deal"><span>{% if section.settings.t_cart_you_save != blank %}{{ section.settings.t_cart_you_save }}{% else %}{{ 'cart.you_save' | t }}{% endif %}</span><span>{% render 'egp', cents: cp_saved %}</span></div>
            {%- endif -%}
            <p class="cart-note-line">{% render 'cart-ship-note' %}</p>
          </div>
          <details class="cart-note"{% if cart.note != blank %} open{% endif %}>
            <summary>{% render 'icon', name: 'chat', class: 'icon--sm' %}<span>{% if section.settings.t_cart_add_note != blank %}{{ section.settings.t_cart_add_note }}{% else %}{{ 'cart.add_note' | t }}{% endif %}</span>{% render 'icon', name: 'plus', class: 'icon--sm cart-note__plus' %}</summary>
            <label class="visually-hidden" for="CartNote">{% if section.settings.t_cart_note != blank %}{{ section.settings.t_cart_note }}{% else %}{{ 'cart.note' | t }}{% endif %}</label>
            <textarea id="CartNote" name="note" form="CartForm" rows="3" placeholder="{% if section.settings.t_cart_note_placeholder != blank %}{{ section.settings.t_cart_note_placeholder }}{% else %}{{ 'cart.note_placeholder' | t }}{% endif %}">{{ cart.note }}</textarea>
          </details>
          <noscript><button type="submit" name="update" form="CartForm" class="btn btn--secondary btn--full">{% if section.settings.t_cart_update != blank %}{{ section.settings.t_cart_update }}{% else %}{{ 'cart.update' | t }}{% endif %}</button></noscript>
          <button type="submit" name="checkout" form="CartForm" class="btn btn--checkout">
            <span class="btn--checkout__label">{% render 'icon', name: 'lock', class: 'icon--sm' %}{% if section.settings.t_cart_checkout != blank %}{{ section.settings.t_cart_checkout }}{% else %}{{ 'cart.checkout' | t }}{% endif %}</span>
            <span class="btn--checkout__total">{% render 'egp', cents: cart.total_price %}</span>
          </button>
          <ul class="cart-assure" role="list">
            {%- if settings.show_cod -%}<li>{% render 'icon', name: 'cash', class: 'icon--sm' %}{% if section.settings.t_cart_cod_available != blank %}{{ section.settings.t_cart_cod_available }}{% else %}{{ 'cart.cod_available' | t }}{% endif %}</li>{%- endif -%}
            <li>{% render 'icon', name: 'lock', class: 'icon--sm' %}{% if section.settings.t_cart_secure != blank %}{{ section.settings.t_cart_secure }}{% else %}{{ 'cart.secure' | t }}{% endif %}</li>
            {%- if settings.returns_note != blank -%}<li>{% render 'icon', name: 'refresh', class: 'icon--sm' %}{{ settings.returns_note | escape }}</li>{%- endif -%}
          </ul>
          {%- render 'payment-icons' -%}
        </aside>
      </div>
      {%- comment -%} Phones: total and checkout stay in reach {%- endcomment -%}
      <div class="cart-page__bar" aria-hidden="true">
        <div><span class="cart-page__bar-label">{% if section.settings.t_cart_subtotal != blank %}{{ section.settings.t_cart_subtotal }}{% else %}{{ 'cart.subtotal' | t }}{% endif %}</span><span class="cart-page__bar-total">{% render 'egp', cents: cart.total_price %}</span></div>
        <button type="submit" name="checkout" form="CartForm" class="btn btn--checkout btn--checkout-bar" tabindex="-1">{% render 'icon', name: 'lock', class: 'icon--sm' %}{% if section.settings.t_cart_checkout != blank %}{{ section.settings.t_cart_checkout }}{% else %}{{ 'cart.checkout' | t }}{% endif %}</button>
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  // the pinned checkout steps aside while the summary's own checkout button is on screen
  (() => {
    const bar = document.querySelector('.cart-page__bar'), own = document.querySelector('.cart-page__summary .btn--checkout');
    if (!bar || !own || !window.IntersectionObserver) return;
    new IntersectionObserver(([e]) => bar.classList.toggle('is-away', e.isIntersecting), { rootMargin: '0px 0px -60px 0px' }).observe(own);
  })();
</script>

