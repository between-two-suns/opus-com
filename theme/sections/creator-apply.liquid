{{ 'creators.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Creator application. Uses Shopify's contact form, so each application arrives in the store's
  notification email (Settings → Notifications → Staff), labelled "Creator application".
  Nothing is stored on the site. Required: name, email, main account, consent.
  With JS it works like the routine finder: one part per screen (About you, Your channels, Your content), Back and
  Next at the bottom, each part checked before moving on (assets/creators.js). Without JS all three show (DECISIONS 224).
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'creators.apply_heading' | t | replace: '&amp;', '&'
  endif
  assign platforms = 'instagram,tiktok,youtube,other' | split: ','
  assign sizes = 'under_1k,1k_10k,10k_50k,50k_100k,over_100k' | split: ','
  assign kinds = 'video,photo,review,tutorial,ugc' | split: ','
  assign skins = 'oily,combination,normal,dry,sensitive,unsure' | split: ','
  assign of_tpl = 'creators.form_steps' | t: n: '__N__', total: '__T__'
-%}
<section class="section cr-apply" id="CreatorApply" aria-labelledby="CrApplyTitle-{{ section.id }}">
  <div class="container cr-apply__inner">
    <div class="cr-apply__aside">
      <p class="t-eyebrow">{% if section.settings.t_creators_apply_eyebrow != blank %}{{ section.settings.t_creators_apply_eyebrow }}{% else %}{{ 'creators.apply_eyebrow' | t }}{% endif %}</p>
      <h2 class="t-display-m" id="CrApplyTitle-{{ section.id }}">{{ heading | escape }}</h2>
      <p class="t-lead">{% if section.settings.t_creators_apply_text != blank %}{{ section.settings.t_creators_apply_text }}{% else %}{{ 'creators.apply_text' | t }}{% endif %}</p>
      <div class="cr-who">
        <h3 class="cr-who__title">{% if section.settings.t_creators_who_heading != blank %}{{ section.settings.t_creators_who_heading }}{% else %}{{ 'creators.who_heading' | t }}{% endif %}</h3>
        <ul class="cr-who__list" role="list">
          {%- for n in (1..4) -%}{%- assign wk = 'creators.who.w' | append: n -%}<li>{% render 'icon', name: 'check', class: 'icon--sm' %}{{ wk | t }}</li>{%- endfor -%}
        </ul>
      </div>
      <p class="cr-apply__note">{% render 'icon', name: 'mail', class: 'icon--sm' %}{% if section.settings.t_creators_apply_note != blank %}{{ section.settings.t_creators_apply_note }}{% else %}{{ 'creators.apply_note' | t }}{% endif %}</p>
    </div>

    <div class="cr-apply__card">
      {%- form 'contact', id: 'CreatorForm', class: 'cr-form', data-cr-steps: '', data-of: of_tpl -%}
        {%- if form.posted_successfully? -%}
          <div class="cr-form__done" role="status" tabindex="-1" data-cr-done>
            <span class="cr-form__done-mark" aria-hidden="true"></span>
            <h3 class="t-display-s">{% if section.settings.t_creators_success_heading != blank %}{{ section.settings.t_creators_success_heading }}{% else %}{{ 'creators.success_heading' | t }}{% endif %}</h3>
            <p>{% if section.settings.t_creators_success_text != blank %}{{ section.settings.t_creators_success_text }}{% else %}{{ 'creators.success_text' | t }}{% endif %}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-status form-status--error" role="alert" tabindex="-1" data-cr-errors>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <input type="hidden" name="contact[Form]" value="Creator application">

          <fieldset class="cr-form__group" data-cr-step>
            <legend class="cr-form__legend"><span class="step-num">01</span> {% if section.settings.t_creators_form_about != blank %}{{ section.settings.t_creators_form_about }}{% else %}{{ 'creators.form.about' | t }}{% endif %}</legend>
            <div class="cr-form__row">
              <div class="field">
                <label for="Cr-name">{% if section.settings.t_creators_form_name != blank %}{{ section.settings.t_creators_form_name }}{% else %}{{ 'creators.form.name' | t }}{% endif %} <span class="t-muted">({% if section.settings.t_pages_contact_required != blank %}{{ section.settings.t_pages_contact_required }}{% else %}{{ 'pages.contact.required' | t }}{% endif %})</span></label>
                <input id="Cr-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}">
              </div>
              <div class="field">
                <label for="Cr-email">{% if section.settings.t_creators_form_email != blank %}{{ section.settings.t_creators_form_email }}{% else %}{{ 'creators.form.email' | t }}{% endif %} <span class="t-muted">({% if section.settings.t_pages_contact_required != blank %}{{ section.settings.t_pages_contact_required }}{% else %}{{ 'pages.contact.required' | t }}{% endif %})</span></label>
                <input id="Cr-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              </div>
            </div>
            <div class="field">
              <label for="Cr-city">{% if section.settings.t_creators_form_city != blank %}{{ section.settings.t_creators_form_city }}{% else %}{{ 'creators.form.city' | t }}{% endif %}</label>
              <input id="Cr-city" type="text" name="contact[City]" autocomplete="address-level2">
            </div>
          </fieldset>

          <fieldset class="cr-form__group" data-cr-step>
            <legend class="cr-form__legend"><span class="step-num">02</span> {% if section.settings.t_creators_form_channels != blank %}{{ section.settings.t_creators_form_channels }}{% else %}{{ 'creators.form.channels' | t }}{% endif %}</legend>
            <div class="cr-form__row">
              <div class="field">
                <label for="Cr-platform">{% if section.settings.t_creators_form_platform != blank %}{{ section.settings.t_creators_form_platform }}{% else %}{{ 'creators.form.platform' | t }}{% endif %}</label>
                <select id="Cr-platform" name="contact[Main platform]">
                  {%- for pl in platforms -%}
                    {%- assign pk = 'creators.form.platforms.' | append: pl -%}
                    <option value="{{ pk | t }}">{{ pk | t }}</option>
                  {%- endfor -%}
                </select>
              </div>
              <div class="field">
                <label for="Cr-handle">{% if section.settings.t_creators_form_handle != blank %}{{ section.settings.t_creators_form_handle }}{% else %}{{ 'creators.form.handle' | t }}{% endif %} <span class="t-muted">({% if section.settings.t_pages_contact_required != blank %}{{ section.settings.t_pages_contact_required }}{% else %}{{ 'pages.contact.required' | t }}{% endif %})</span></label>
                <input id="Cr-handle" type="text" name="contact[Main account]" required autocapitalize="off" spellcheck="false" placeholder="@" dir="ltr">
              </div>
            </div>
            <div class="cr-form__row">
              <div class="field">
                <label for="Cr-size">{% if section.settings.t_creators_form_audience != blank %}{{ section.settings.t_creators_form_audience }}{% else %}{{ 'creators.form.audience' | t }}{% endif %}</label>
                <select id="Cr-size" name="contact[Audience]">
                  {%- for sz in sizes -%}
                    {%- assign sk = 'creators.form.sizes.' | append: sz -%}
                    <option value="{{ sk | t }}">{{ sk | t }}</option>
                  {%- endfor -%}
                </select>
              </div>
              <div class="field">
                <label for="Cr-other">{% if section.settings.t_creators_form_other != blank %}{{ section.settings.t_creators_form_other }}{% else %}{{ 'creators.form.other' | t }}{% endif %}</label>
                <input id="Cr-other" type="text" name="contact[Other accounts]" autocapitalize="off" spellcheck="false" dir="ltr">
              </div>
            </div>
            <p class="t-xs t-muted">{% if section.settings.t_creators_form_audience_note != blank %}{{ section.settings.t_creators_form_audience_note }}{% else %}{{ 'creators.form.audience_note' | t }}{% endif %}</p>
          </fieldset>

          <fieldset class="cr-form__group" data-cr-step>
            <legend class="cr-form__legend"><span class="step-num">03</span> {% if section.settings.t_creators_form_content != blank %}{{ section.settings.t_creators_form_content }}{% else %}{{ 'creators.form.content' | t }}{% endif %}</legend>
            <div class="cr-form__checks">
              {%- for k in kinds -%}
                {%- assign kk = 'creators.form.kinds.' | append: k -%}
                <label class="cr-check">
                  <input type="checkbox" name="contact[Makes: {{ kk | t }}]" value="✓">
                  <span>{{ kk | t }}</span>
                </label>
              {%- endfor -%}
            </div>
            <div class="cr-form__row">
              <div class="field">
                <label for="Cr-best">{% if section.settings.t_creators_form_best != blank %}{{ section.settings.t_creators_form_best }}{% else %}{{ 'creators.form.best' | t }}{% endif %}</label>
                <input id="Cr-best" type="url" name="contact[Best piece]" inputmode="url" placeholder="https://" dir="ltr">
              </div>
              <div class="field">
                <label for="Cr-skin">{% if section.settings.t_creators_form_skin != blank %}{{ section.settings.t_creators_form_skin }}{% else %}{{ 'creators.form.skin' | t }}{% endif %}</label>
                <select id="Cr-skin" name="contact[Skin type]">
                  {%- for s in skins -%}
                    {%- assign kk = 'creators.form.skins.' | append: s -%}
                    <option value="{{ kk | t }}">{{ kk | t }}</option>
                  {%- endfor -%}
                </select>
              </div>
            </div>
            <div class="field">
              <label for="Cr-why">{% if section.settings.t_creators_form_why != blank %}{{ section.settings.t_creators_form_why }}{% else %}{{ 'creators.form.why' | t }}{% endif %}</label>
              <textarea id="Cr-why" name="contact[body]" rows="4" placeholder="{% if section.settings.t_creators_form_why_hint != blank %}{{ section.settings.t_creators_form_why_hint }}{% else %}{{ 'creators.form.why_hint' | t }}{% endif %}">{{ form.body }}</textarea>
            </div>

            <label class="cr-consent">
              <input type="checkbox" name="contact[Consent]" value="Agreed to be contacted about this application" required>
              <span>{% if section.settings.t_creators_form_consent != blank %}{{ section.settings.t_creators_form_consent }}{% else %}{{ 'creators.form.consent' | t }}{% endif %}{%- if shop.privacy_policy -%}{{ ' ' }}<a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">{% if section.settings.t_creators_privacy != blank %}{{ section.settings.t_creators_privacy }}{% else %}{{ 'creators.privacy' | t }}{% endif %}</a>{%- endif -%}</span>
            </label>
          </fieldset>

          <div class="cr-form__foot">
            <p class="cr-form__of" aria-live="polite" data-cr-of></p>
            <div class="cr-form__nav">
              <button type="button" class="cr-form__back" data-cr-back hidden>{% render 'icon', name: 'arrow', class: 'icon--sm' %}{% if section.settings.t_skin_check_back != blank %}{{ section.settings.t_skin_check_back }}{% else %}{{ 'creators.form.back' | t }}{% endif %}</button>
              <button type="button" class="btn cr-form__next" data-cr-next hidden>{% if section.settings.t_skin_check_next != blank %}{{ section.settings.t_skin_check_next }}{% else %}{{ 'creators.form.next' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</button>
              <button type="submit" class="btn cr-form__send" data-cr-send data-magnetic>{% if section.settings.t_creators_form_submit != blank %}{{ section.settings.t_creators_form_submit }}{% else %}{{ 'creators.form.submit' | t }}{% endif %}</button>
            </div>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>
<script>
  (() => {
    const t = document.querySelector('[data-cr-done], [data-cr-errors]');
    if (!t) return;
    const go = () => { t.scrollIntoView({ block: 'center' }); t.focus({ preventScroll: true }); };
    document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
  })();
</script>

