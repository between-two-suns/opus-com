{{ 'bundles.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Fixed-price bundles (Pricing & Offers spec). Each block picks a Shopify bundle product; the card shows its
  real price, the singles total struck through, and the saving vs buying the same products separately.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.bundles.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.bundles.text' | t | replace: '&amp;', '&'
  endif
-%}
<section class="section bundles" id="sets" data-tone="lilac" aria-labelledby="BundlesTitle-{{ section.id }}">
  <div class="container">
    {%- unless section.settings.hide_head -%}
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'sections.bundles.eyebrow' | t }}</p>
        <h2 class="t-display-l" id="BundlesTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <div class="bundles__aside">
        <p class="t-lead t-muted bundles__text">{{ text | escape }}</p>
        {%- if section.settings.show_all_link -%}
          <a class="link-arrow" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{{ 'sections.bundles.see_all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
        {%- endif -%}
        {%- render 'skin-check-link', key: 'skin_check.cta_sets' -%}
      </div>
    </div>
    {%- else -%}
      <h2 class="visually-hidden" id="BundlesTitle-{{ section.id }}">{{ heading | escape }}</h2>
    {%- endunless -%}

    {%- if section.settings.tiles -%}
      {{ 'tile.css' | asset_url | stylesheet_tag }}
      <ul class="tiles" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- if forloop.first -%}{%- assign tl_size = 'feature' -%}{%- assign tl_load = 'eager' -%}{%- else -%}{%- assign tl_size = 'standard' -%}{%- assign tl_load = 'lazy' -%}{%- endif -%}
            {%- render 'tile', product: block.settings.product, size: tl_size, loading: tl_load -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
    <ul class="bundles__grid" role="list" data-n="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- liquid
            assign bc_first = false
            if forloop.first and section.index <= 2
              assign bc_first = true
            endif
          -%}
          {%- render 'bundle-card', product: block.settings.product, priority: bc_first -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bundles.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.bundles.info" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "checkbox", "id": "hide_head", "label": "t:sections.bundles.hide_head", "default": false },
    { "type": "checkbox", "id": "show_all_link", "label": "t:sections.bundles.show_all_link", "default": false },
    { "type": "checkbox", "id": "tiles", "label": "Tile cards (demo)", "default": false }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "t:sections.bundles.set",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.bundles.product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.bundles.name",
      "blocks": [
        { "type": "bundle", "settings": { "product": "the-full-ritual" } },
        { "type": "bundle", "settings": { "product": "the-clear-protect-trio" } },
        { "type": "bundle", "settings": { "product": "clear-protect-duo" } }
      ]
    }
  ]
}
{% endschema %}
