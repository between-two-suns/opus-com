{{ 'bundles.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Curated sets. Price = sum of the products' real prices. A saving is shown only when the matching
  "mix & match" tier (Theme settings → Offers) is set, which must mirror a real Shopify automatic discount.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.bundles.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.bundles.text' | t
  endif
-%}
<section class="section bundles" id="sets" aria-labelledby="BundlesTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'sections.bundles.eyebrow' | t }}</p>
        <h2 class="t-display-l" id="BundlesTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <p class="t-lead t-muted bundles__text">{{ text | escape }}</p>
    </div>

    <ul class="bundles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.preset
          assign steps = block.settings.steps | remove: ' ' | split: ','
          assign name = block.settings.name
          assign desc = block.settings.desc
          if p != 'custom'
            if name == blank
              assign k = 'sections.bundles.sets.' | append: p | append: '.name'
              assign name = k | t
            endif
            if desc == blank
              assign k = 'sections.bundles.sets.' | append: p | append: '.desc'
              assign desc = k | t
            endif
          endif
          assign total = 0
          assign ids = ''
          assign handles = ''
          assign count = 0
          assign unpriced = false
          assign unavailable = false
        -%}
        {%- capture packs -%}
          {%- for st in steps -%}
            {%- assign s = st | plus: 0 -%}
            {%- for product in source.products limit: 12 -%}
              {%- capture ps -%}{% render 'product-step', product: product %}{%- endcapture -%}
              {%- assign ps = ps | strip | plus: 0 -%}
              {%- if ps == s -%}
                {%- liquid
                  assign v = product.selected_or_first_available_variant
                  assign total = total | plus: v.price
                  assign ids = ids | append: v.id | append: ','
                  assign count = count | plus: 1
                  if v.price == 0
                    assign unpriced = true
                  endif
                  unless v.available
                    assign unavailable = true
                  endunless
                  assign cutout = product.metafields.bts.cutout.value
                -%}
                <span class="bundle__pack" data-step="{{ s }}" style="--k: {{ count | minus: 1 }}">
                  {%- if cutout -%}
                    {{ cutout | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '120px', alt: '' }}
                  {%- elsif product.featured_image -%}
                    {{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '120px', alt: '' }}
                  {%- endif -%}
                </span>
                {%- capture li -%}<li data-step="{{ s }}"><span class="bundle__dot" aria-hidden="true"></span>{{ product.title | escape }}</li>{%- endcapture -%}
                {%- assign handles = handles | append: li -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if count > 0 -%}
          {%- capture pct -%}{% render 'offer-pct', n: count %}{%- endcapture -%}
          {%- assign pct = pct | strip | plus: 0 -%}
          {%- assign keep = 100 | minus: pct -%}
          {%- assign sale = total | times: keep | divided_by: 100 -%}
          {%- assign item_ids = ids | split: ',' -%}
          <li class="bundle reveal" data-count="{{ count }}" {{ block.shopify_attributes }}>
            <div class="bundle__stage grain" aria-hidden="true">
              <span class="bundle__glow"></span>
              <span class="bundle__packs" style="--n: {{ count }}">{{ packs }}</span>
            </div>
            <div class="bundle__body">
              <p class="bundle__count t-xs">{{ 'sections.bundles.count' | t: count: count }}</p>
              <h3 class="bundle__name">{{ name | escape }}</h3>
              <p class="t-small t-muted">{{ desc | escape }}</p>
              <ul class="bundle__items" role="list">{{ handles }}</ul>
              <div class="bundle__buy">
                <div class="bundle__price">
                  {%- if unpriced and settings.zero_price_coming_soon -%}
                    <span class="t-small t-muted">{{ 'product.coming_soon' | t }}</span>
                  {%- elsif pct > 0 -%}
                    <span class="bundle__now">{{ sale | money }}</span>
                    <s class="bundle__was"><span class="visually-hidden">{{ 'sections.bundles.was' | t }} </span>{{ total | money }}</s>
                    <span class="pill pill--save">{{ 'sections.bundles.save' | t: pct: pct }}</span>
                  {%- else -%}
                    <span class="bundle__now">{{ total | money }}</span>
                  {%- endif -%}
                </div>
                <product-form data-multi>
                  <form method="post" action="{{ routes.cart_add_url }}">
                    {%- for id in item_ids -%}
                      <input type="hidden" name="items[][id]" value="{{ id }}">
                      <input type="hidden" name="items[][quantity]" value="1">
                    {%- endfor -%}
                    <button type="submit" class="btn btn--full"{% if unavailable or unpriced and settings.zero_price_coming_soon %} disabled{% endif %}>
                      <span class="btn__label">{{ 'sections.bundles.cta' | t }}</span>
                    </button>
                    <p class="t-xs t-muted" data-form-error hidden></p>
                  </form>
                </product-form>
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if settings.tier_2_pct > 0 or settings.tier_3_pct > 0 or settings.tier_4_pct > 0 -%}
      <p class="t-xs t-muted bundles__note">{{ 'sections.bundles.note' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bundles.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.bundles.info" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" },
    { "type": "collection", "id": "collection", "label": "t:sections.routine.collection" }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "t:sections.bundles.set",
      "settings": [
        {
          "type": "select", "id": "preset", "label": "t:sections.bundles.preset", "default": "full",
          "options": [
            { "value": "full", "label": "The Full Routine" },
            { "value": "evening", "label": "The Evening Routine" },
            { "value": "oil", "label": "Oil-Control Duo" },
            { "value": "day", "label": "Day Shield Duo" },
            { "value": "starter", "label": "Everyday Starter" },
            { "value": "custom", "label": "Custom" }
          ]
        },
        { "type": "text", "id": "steps", "label": "t:sections.bundles.steps", "info": "t:sections.bundles.steps_info", "default": "1,2,3,4" },
        { "type": "text", "id": "name", "label": "t:sections.bundles.set_name", "info": "t:general_schema.bilingual_fallback" },
        { "type": "textarea", "id": "desc", "label": "t:general_schema.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.bundles.name",
      "blocks": [
        { "type": "set", "settings": { "preset": "full", "steps": "1,2,3,4" } },
        { "type": "set", "settings": { "preset": "evening", "steps": "1,2,3" } },
        { "type": "set", "settings": { "preset": "oil", "steps": "1,2" } },
        { "type": "set", "settings": { "preset": "day", "steps": "3,4" } },
        { "type": "set", "settings": { "preset": "starter", "steps": "1,4" } }
      ]
    }
  ]
}
{% endschema %}
