{{ 'bundles.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Fixed-price bundles (Pricing & Offers spec). Each block picks a Shopify bundle product; the card shows its
  real price, the singles total struck through, and the saving vs buying the same products separately.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.bundles.heading' | t | replace: '&amp;', '&'
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'sections.bundles.text' | t | replace: '&amp;', '&'
  endif
-%}
<section class="section bundles" id="sets" data-tone="lilac" aria-labelledby="BundlesTitle-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'sections.bundles.eyebrow' | t }}</p>
        <h2 class="t-display-l" id="BundlesTitle-{{ section.id }}">{{ heading | escape }}</h2>
      </div>
      <p class="t-lead t-muted bundles__text">{{ text | escape }}</p>
    </div>

    <ul class="bundles__grid" role="list" data-n="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- render 'bundle-card', product: block.settings.product -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.bundles.name",
  "settings": [
    { "type": "paragraph", "content": "t:sections.bundles.info" },
    { "type": "text", "id": "heading", "label": "t:general_schema.heading", "info": "t:general_schema.bilingual_fallback" },
    { "type": "textarea", "id": "text", "label": "t:general_schema.text" }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "t:sections.bundles.set",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.bundles.product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.bundles.name",
      "blocks": [
        { "type": "bundle", "settings": { "product": "the-day-ritual" } },
        { "type": "bundle", "settings": { "product": "the-full-ritual" } },
        { "type": "bundle", "settings": { "product": "clear-protect-duo" } }
      ]
    }
  ]
}
{% endschema %}
