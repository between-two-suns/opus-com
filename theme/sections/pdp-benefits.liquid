{%- comment -%}
  Product page demo (v2): "What's inside, and why". One card per key ingredient: what it is, why it's used in
  skincare (general ingredient knowledge, pdp2.ing.<handle>), the pack benefit it sits behind as a small tag (the
  label phrase, mapped in snippets/pdp2-benefit-map), and a link to its glossary entry. Photo: the texture shot.
  Single products only.
{%- endcomment -%}
{%- liquid
  capture step
    render 'product-step', product: product
  endcapture
  assign step = step | strip | plus: 0
  assign mf = product.metafields.bts
  capture map
    render 'pdp2-benefit-map', handle: product.handle
  endcapture
  assign idx = map | strip | split: '|' | first | split: ','
  assign kis = mf.key_ingredients.value
  assign phrases = mf.benefit.value | split: '.'
  assign glossary_url = routes.root_url | append: '/pages/ingredients' | replace: '//', '/'
  assign tex_key = 'bts-' | append: product.handle | append: '-texture.jpg'
  assign photo = images[tex_key]
  if photo == blank
    assign photo = false
    for m in product.media
      if m.preview_image.src contains '-texture'
        assign photo = m.preview_image
        break
      endif
    endfor
  endif
-%}
{%- if step > 0 and kis.size > 0 -%}
<section class="section v2-ben" data-step="{{ step }}" aria-labelledby="V2Ben-{{ section.id }}">
  <div class="container v2-ben__grid">
    {%- if photo -%}
      <div class="v2-ben__media">
        {{ photo | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width: 990px) 44vw, 100vw', alt: '' }}
        {%- if mf.texture != blank -%}
          <p class="v2-ben__tex"><span class="t-eyebrow">{{ 'product.texture' | t }}</span><span>{{ mf.texture }}</span></p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="v2-ben__body">
      <p class="t-eyebrow">{{ 'pdp2.inside_eyebrow' | t }}</p>
      <h2 class="t-display-m" id="V2Ben-{{ section.id }}">{{ 'pdp2.inside_heading' | t }}</h2>
      <ol class="v2-ben__list" role="list">
        {%- for ki in kis -%}
          {%- liquid
            assign i = forloop.index0
            assign i_s = i | append: ''
            assign h = ki.system.handle | default: ki.handle
            assign what_key = 'pdp2.ing.' | append: h | append: '.what'
            assign why_key = 'pdp2.ing.' | append: h | append: '.why'
            assign what = what_key | t
            assign why = why_key | t
            if what contains 'ranslation missing'
              assign what = ''
            endif
            if why contains 'ranslation missing'
              assign why = ki.role.value
            endif
            comment
              The label phrase this ingredient sits behind (if any): the phrase whose map entry is this index.
            endcomment
            assign tag = ''
            assign n = 0
            for ph in phrases
              assign ph_s = ph | strip
              if ph_s == blank
                continue
              endif
              if idx[n] == i_s
                assign tag = ph_s
              endif
              assign n = n | plus: 1
            endfor
            assign anchor = ki.inci.value | split: ',' | first | strip | handleize
          -%}
          <li class="v2-ben__item">
            <span class="v2-ben__num" aria-hidden="true">0{{ forloop.index }}</span>
            <div class="v2-ben__text">
              <h3 class="v2-ben__title">{{ ki.name.value | escape }}{% if what != blank %} <span class="v2-ben__what">{{ what }}</span>{% endif %}</h3>
              {%- if tag != blank -%}<p class="v2-ben__ing"><span class="v2-ben__chip">{% render 'icon', name: 'check', class: 'icon--sm' %}{{ tag }}</span></p>{%- endif -%}
              <p class="v2-ben__role">{{ why }}</p>
              <a class="v2-ben__more" href="{{ glossary_url }}#inci-{{ anchor }}">{{ 'pdp2.glossary' | t: name: ki.name.value }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Benefits (demo v2)"
}
{% endschema %}
