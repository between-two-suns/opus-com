{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About (DECISIONS 193, 199): "What we won't do." The rules the site already keeps (no invented numbers, no fake
  reviews, no false urgency, the formula in full, Arabic as a first language), set as a short manifesto on the page's
  own ivory: one wide row per rule (number, the rule in large type, one line of why), divided by thin lines in the
  step colours (the fifth is tomorrow's periwinkle). No panel, so it reads as part of the page.
{%- endcomment -%}
<section class="section ab-rules" aria-labelledby="AbRules-{{ section.id }}">
  <div class="container">
    <div class="ab-rules__head">
      <p class="t-eyebrow">{% if section.settings.t_about2_rules_eyebrow != blank %}{{ section.settings.t_about2_rules_eyebrow }}{% else %}{{ 'about2.rules_eyebrow' | t }}{% endif %}</p>
      <h2 class="t-display-m" id="AbRules-{{ section.id }}">{% if section.settings.t_about2_rules_heading != blank %}{{ section.settings.t_about2_rules_heading }}{% else %}{{ 'about2.rules_heading' | t }}{% endif %}</h2>
    </div>
    <ol class="ab-rules__list" role="list">
      {%- for i in (1..5) -%}
        {%- assign hk = 'about2.rules.r' | append: i | append: '_h' -%}
        {%- assign tk = 'about2.rules.r' | append: i -%}
        <li class="ab-rules__item" data-k="{{ i }}">
          <span class="ab-rules__n" aria-hidden="true">0{{ i }}</span>
          <span class="ab-rules__h">{{ hk | t }}</span>
          <span class="ab-rules__t">{{ tk | t }}</span>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "About · our rules",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "t_about2_rules_eyebrow",
      "label": "Small line above the heading",
      "info": "Now: “Our rules”. Leave empty to keep it (English and Arabic)."
    },
    {
      "type": "text",
      "id": "t_about2_rules_heading",
      "label": "Heading",
      "info": "Now: “What we won’t do.”. Leave empty to keep it (English and Arabic)."
    }
  ]
}
{% endschema %}
