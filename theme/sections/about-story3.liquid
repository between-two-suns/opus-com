{{ 'about.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  About story, concept "The mark" (DECISIONS 355–356, local mock-up until the owner approves).
  A — poster title in the site's long bold display face, second line to the right; the )( mark filled with a photo
      below it, her face framed inside the left curve.
  B — the story with a left/right rhythm; key paragraphs fill word by word as she scrolls:
      1 opening paragraph, left · 2 the question, right, in the display face · 3 the four phrases as a stepped
      cascade in the display face with tiny )( marks in the step colours, the rest of the passage in a right
      column · 4 "So we created Between Two Suns." centred under the mark.
  C — the night close. Arabic: the Arabic display face; the layout mirrors.
  Without JS or with reduced motion: everything shown at full strength.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image | default: images['bts-portrait-terrace-wide.jpg']
  assign s2 = 'about3.s2_p1' | t | split: '. '
-%}
<style>
  .ab3 { overflow: clip; }
  .ab3 p { margin: 0; }
  /* The accent is the site's own long bold display face (owner: "we have our long bold text"). */
  .ab3__it { font-family: var(--font-display); font-style: normal; font-weight: 700; text-transform: uppercase; letter-spacing: -0.005em; line-height: 0.92; }
  :lang(ar) .ab3__it { text-transform: none; line-height: 1.3; }
  /* A — title + mark */
  .ab3__a { padding-block: clamp(56px, 7vw, 110px) 0; }
  .ab3__title { margin: clamp(14px, 2vw, 24px) 0 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: 0.88; font-size: min(15.5vw, 236px); letter-spacing: -0.005em; position: relative; z-index: 2; }
  .ab3__title > span { display: block; }
  .ab3__title .ab3__it { display: block; text-align: end; line-height: inherit; }
  :lang(ar) .ab3__title { text-transform: none; line-height: 1.2; font-size: min(15vw, 200px); }
  .ab3__shape { position: relative; z-index: 1; overflow: hidden; margin: calc(min(15.5vw, 236px) * -0.5) auto 0; inline-size: min(66vw, 900px); aspect-ratio: 501 / 547; -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .ab3__shape img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: var(--fx, 43%) 26%; transform: scale(1.06); transition: transform 1.8s var(--ease-out); }
  .ab3.is-live .ab3__a.is-in .ab3__shape img { transform: none; }
  /* B — the story */
  .ab3__b { display: grid; gap: clamp(110px, 14vw, 220px); padding-block: clamp(96px, 12vw, 200px); }
  .ab3__open { font-weight: 500; font-size: clamp(24px, 2.7vw, 44px); line-height: 1.28; letter-spacing: -0.02em; max-inline-size: 19em; }
  .ab3__qwrap { display: grid; justify-items: end; text-align: end; gap: clamp(14px, 1.6vw, 22px); }
  .ab3__small-lead { font-size: clamp(13px, 1vw, 15px); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  :lang(ar) .ab3__small-lead { letter-spacing: 0; text-transform: none; font-size: 16px; }
  .ab3__q { font-size: clamp(52px, 8vw, 138px); max-inline-size: 8.4em; }
  :lang(ar) .ab3__q { font-size: clamp(40px, 6vw, 100px); }
  .ab3__life { display: grid; gap: clamp(20px, 2.4vw, 36px); }
  .ab3 [role='list'].ab3__cascade { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.02em; font-size: clamp(52px, 8.4vw, 150px); line-height: 1; }
  .ab3__cascade li:nth-child(2) { padding-inline-start: 1.2em; }
  .ab3__cascade li:nth-child(3) { padding-inline-start: 2.4em; }
  .ab3__cascade li:nth-child(4) { padding-inline-start: 3.6em; }
  :lang(ar) .ab3 [role='list'].ab3__cascade { line-height: 1.3; font-size: clamp(44px, 7vw, 120px); }
  .ab3__dot { display: inline-block; inline-size: 0.42em; block-size: 0.46em; margin-inline-start: 0.14em; vertical-align: 0.02em; background: var(--sku); -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .ab3__rest { display: grid; gap: 1em; max-inline-size: 31rem; justify-self: end; font-size: clamp(18px, 1.4vw, 21px); line-height: 1.6; color: color-mix(in srgb, var(--c-ink) 86%, transparent); margin-block-start: clamp(24px, 4vw, 64px); }
  .ab3__rest p:first-child { color: var(--c-ink); font-weight: 600; font-size: 1.12em; line-height: 1.45; }
  .ab3__made { display: grid; justify-items: center; text-align: center; gap: clamp(14px, 1.6vw, 22px); }
  .ab3__made-mark { inline-size: 44px; block-size: 48px; margin-block-end: 8px; background: var(--c-step-2); -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
  .ab3__brand { font-weight: 700; font-size: clamp(36px, 5vw, 84px); line-height: 1.02; letter-spacing: -0.035em; max-inline-size: 10em; text-wrap: balance; }
  :lang(ar) .ab3__brand { letter-spacing: 0; line-height: 1.35; }
  .ab3__made p:not(.ab3__brand) { max-inline-size: 32rem; font-size: clamp(18px, 1.4vw, 21px); line-height: 1.6; color: color-mix(in srgb, var(--c-ink) 86%, transparent); }
  .ab3__made strong { color: var(--c-ink); }
  /* word fill */
  .ab3.is-live [data-fill] .w { opacity: 0.16; transition: opacity 0.4s linear; }
  .ab3.is-live [data-fill] .w.is-on { opacity: 1; }
  @media (max-width: 749px) {
    .ab3__shape { inline-size: 116vw; margin-inline: -8vw; margin-block-start: calc(15.5vw * -0.45); }
    .ab3 [role='list'].ab3__cascade { font-size: 11vw; }
    :lang(ar) .ab3 [role='list'].ab3__cascade { font-size: 11vw; }
    .ab3__cascade li { white-space: nowrap; }
    .ab3__cascade li:nth-child(2) { padding-inline-start: 0.6em; }
    .ab3__cascade li:nth-child(3) { padding-inline-start: 1.2em; }
    .ab3__cascade li:nth-child(4) { padding-inline-start: 1.8em; }
  }
</style>
<section class="ab3 ab-st" data-ab3>
  <div class="ab3__a">
    <div class="container">
      <p class="t-eyebrow">{{ 'about3.eyebrow' | t }}</p>
      <h2 class="ab3__title"><span>{{ 'about3.title_1' | t }}</span><span class="ab3__it">{{ 'about3.title_2' | t }}</span></h2>
    </div>
    {%- if img != blank and img.width != blank -%}
      <div class="ab3__shape">{{ img | image_url: width: 1600 | image_tag: loading: 'eager', widths: '700,1000,1300,1600', sizes: '(min-width: 990px) 900px, 116vw', alt: '' }}</div>
    {%- endif -%}
  </div>

  <div class="container ab3__b">
    <p class="ab3__open" data-fill>{{ 'about3.p1' | t }}</p>

    <div class="ab3__qwrap">
      <p class="ab3__small-lead">{{ 'about3.q_lead' | t }}</p>
      <p class="ab3__q ab3__it" data-fill>{{ 'about3.q' | t }}</p>
    </div>

    <div class="ab3__life">
      <p class="ab3__small-lead">{{ 'about3.s2_head' | t }}</p>
      {%- if s2.size > 4 -%}
        <ul class="ab3__cascade" role="list">
          {%- for k in (0..3) -%}
            <li data-fill><span class="ab3__it">{{ s2[k] }}.</span><span class="ab3__dot" data-step="{{ k | plus: 1 }}" aria-hidden="true"></span></li>
          {%- endfor -%}
        </ul>
        {%- assign rest = s2 | slice: 4, 20 | join: '. ' -%}
      {%- else -%}
        {%- assign rest = 'about3.s2_p1' | t -%}
      {%- endif -%}
      <div class="ab3__rest">
        <p>{{ rest }}</p>
        <p>{{ 'about3.s2_p2' | t }}</p>
        <p>{{ 'about3.s2_p3' | t }}</p>
      </div>
    </div>

    <div class="ab3__made">
      <span class="ab3__made-mark" aria-hidden="true"></span>
      <p class="ab3__brand" data-fill>{{ 'about3.s3_head' | t }}</p>
      <p><strong>{{ 'about3.s3_p1' | t }}</strong></p>
      <p>{{ 'about3.s3_p2' | t }}</p>
    </div>
  </div>

  <div class="ab-st__d" style="margin-block-start: 0"><div class="container ab-st__d-in">
    <p class="ab-st__close" data-fill>{{ 'about3.close' | t }}</p>
    <p class="ab-st__sign"><span class="ab-st__mark" aria-hidden="true"></span>{{ 'about3.close_2' | t }}</p>
  </div></div>
</section>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    // Wrap each word of [data-fill] text in a span (text nodes only, so the inline marks stay put).
    const fills = [...root.querySelectorAll('[data-fill]')].map((el) => {
      const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const nodes = []; while (walk.nextNode()) nodes.push(walk.currentNode);
      nodes.forEach((n) => {
        const parts = n.textContent.split(/(\s+)/);
        const frag = document.createDocumentFragment();
        parts.forEach((p) => { if (!p) return; if (/^\s+$/.test(p)) frag.append(p); else { const s = document.createElement('span'); s.className = 'w'; s.textContent = p; frag.append(s); } });
        n.replaceWith(frag);
      });
      return { el, words: [...el.querySelectorAll('.w')] };
    });
    root.classList.add('is-live');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    io.observe(root.querySelector('.ab3__a')); root.querySelectorAll('.ab-st__sign').forEach((el) => io.observe(el));
    let ticking = false;
    const tick = () => {
      ticking = false;
      const h = innerHeight;
      fills.forEach(({ el, words }) => {
        const r = el.getBoundingClientRect();
        // Starts filling when the paragraph's top reaches 85% of the screen, done when its bottom reaches 55%.
        const p = Math.min(1, Math.max(0, (h * 0.85 - r.top) / (h * 0.3 + r.height)));
        const n = p * words.length;
        words.forEach((w, i) => w.classList.toggle('is-on', i < n));
      });
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(tick); } }, { passive: true });
    addEventListener('resize', tick);
    tick();
  })();
</script>

{% schema %}
{
  "name": "About · our story (mark)",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo inside the mark", "info": "Empty = the terrace portrait (stand-in until the shoot)." }
  ]
}
{% endschema %}
