{%- comment -%}
  About hero prototype B · "The mark opens" (demo only, /pages/about?view=mark).
  One screen, nothing pinned, nothing to scroll through. The page opens on the brand mark )( alone. The mark opens:
  its two arcs turn out to be the facing edges of the two suns (the home page's spheres), which part to the sides,
  and the name is set in the space between them. Then one day passes in the light, in about ten seconds, with one
  line of the story at a time: both suns · the day (tomorrow's sun still a ghost) · the night (ink sky, stars,
  today's sun dark) · the next morning, when both suns are lit and the four packs stand in the space between.
  No clock digits spinning: one small time label that changes four times. "Replay the day" plays it again.
  Reduced motion: the last picture, still. Prototype: English copy is written here, not yet in the locale files.
{%- endcomment -%}
<style>
.am { --sky: #fff; --n: 0; --D: min(118svh, 86vw); --peek: 19vw; position: relative; margin-block-start: calc(-1 * var(--header-h)); block-size: 100svh; min-block-size: 580px; overflow: clip; isolation: isolate; background: var(--sky); color: var(--c-ink); }
.am[data-dark] { color: #fff; }
.am-stars { position: absolute; inset: 0; z-index: -3; opacity: var(--n); pointer-events: none;
  background-image: radial-gradient(1.4px 1.4px at 31% 14%, #fff 99%, transparent), radial-gradient(1px 1px at 38% 66%, #fff 99%, transparent), radial-gradient(1.6px 1.6px at 44% 9%, #fff 99%, transparent),
    radial-gradient(1px 1px at 52% 80%, #fff 99%, transparent), radial-gradient(1.3px 1.3px at 57% 12%, #fff 99%, transparent), radial-gradient(1px 1px at 63% 72%, #fff 99%, transparent),
    radial-gradient(1.5px 1.5px at 69% 18%, #fff 99%, transparent), radial-gradient(1px 1px at 48% 92%, #fff 99%, transparent), radial-gradient(1.2px 1.2px at 35% 88%, #fff 99%, transparent), radial-gradient(1px 1px at 66% 90%, #fff 99%, transparent); }
/* the two suns: at first only the edge that faces the other one shows (the brand mark); then the whole sphere */
.am-sun { position: absolute; z-index: -2; left: 50%; top: 50%; inline-size: var(--D); block-size: var(--D); margin: calc(var(--D) / -2) 0 0 calc(var(--D) / -2); will-change: transform, opacity; pointer-events: none; visibility: hidden; }
.am.is-ready .am-sun { visibility: visible; }
.am-ball { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; background: rgb(var(--c));
  -webkit-mask-image: radial-gradient(circle at calc(50% - var(--dir) * var(--md, 9999px)) 50%, transparent calc(var(--D) / 2 - 1px), #000 calc(var(--D) / 2));
  mask-image: radial-gradient(circle at calc(50% - var(--dir) * var(--md, 9999px)) 50%, transparent calc(var(--D) / 2 - 1px), #000 calc(var(--D) / 2)); }
.am-ball img { display: block; inline-size: 100%; block-size: 100%; }
.am-ball i { position: absolute; inset: 0; background: radial-gradient(circle at var(--hx) 34%, rgb(255 255 255 / .3), rgb(255 255 255 / .06) 22%, transparent 44%, rgb(30 40 55 / .2) 100%); }
.am-ball b { position: absolute; inset: 0; background: #1b1e33; opacity: var(--sh, 0); }
.am-ball u { position: absolute; inset: 0; background: var(--c-ink); opacity: var(--ink, 1); }
.am-sun--l { --dir: 1; --c: 171 208 182; --hx: 70%; } .am-sun--r { --dir: -1; --c: 171 193 233; --hx: 30%; }
.am-copy { position: relative; block-size: 100%; box-sizing: border-box; padding: calc(var(--header-h) + clamp(18px, 4svh, 44px)) calc(var(--peek) + 2vw) 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
.am-eyebrow { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
.am-title { margin: clamp(8px, 1.6svh, 18px) 0 0; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: .9; letter-spacing: -.005em; font-size: clamp(64px, min(11vw, 19svh), 230px); padding-block-end: .1em; }
.am-title .w { display: inline-block; overflow: hidden; vertical-align: top; padding-block: .1em .2em; margin-block: -.1em -.2em; }
.am-title .w > span { display: inline-block; translate: 0 112%; transition: translate 1.1s cubic-bezier(.2, .75, .2, 1); transition-delay: calc(var(--i) * .09s); }
.am.is-open .am-title .w > span { translate: 0 0; }
.am-eyebrow, .am-now, .am-lines { opacity: 0; transition: opacity .8s ease .5s; }
.am.is-open .am-eyebrow, .am.is-open .am-now, .am.is-open .am-lines { opacity: 1; }
.am-now { margin: clamp(10px, 2svh, 22px) 0 0; display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
.am-now b { font-family: var(--font-display); font-size: 20px; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
.am-now span { opacity: .8; }
.am-lines { display: grid; margin: clamp(8px, 1.4svh, 14px) 0 0; padding: 0; list-style: none; max-inline-size: 30ch; }
.am-lines li { grid-area: 1 / 1; font-size: clamp(17px, 1.55vw, 24px); line-height: 1.32; font-weight: 520; letter-spacing: -.01em; opacity: 0; translate: 0 10px; transition: opacity .6s ease, translate .7s cubic-bezier(.2, .75, .2, 1); text-wrap: balance; }
.am-lines li.is-on { opacity: 1; translate: 0 0; }
/* the four packs, in the space between, when tomorrow's sun is up */
.am-packs { position: absolute; inset-inline: 0; inset-block-end: calc(var(--dock-h, 0px) + clamp(18px, 4svh, 44px)); block-size: clamp(130px, 27svh, 300px); margin: 0; padding: 0; list-style: none; display: flex; justify-content: center; align-items: flex-end; gap: clamp(6px, 1.1vw, 18px); pointer-events: none; }
.am-pack { block-size: calc(var(--h) * 100%); aspect-ratio: 357 / 1100; opacity: 0; translate: 0 46px; transition: opacity .7s ease, translate 1s cubic-bezier(.2, .75, .2, 1); transition-delay: calc(var(--i) * .1s); filter: drop-shadow(0 16px 16px rgba(32, 35, 58, .18)); }
.am-pack img { display: block; inline-size: 100%; block-size: 100%; object-fit: contain; object-position: bottom; }
.am.is-end .am-pack { opacity: 1; translate: 0 0; }
.am-replay { position: absolute; inset-inline-end: var(--gutter); inset-block-end: calc(var(--dock-h, 0px) + clamp(18px, 4svh, 44px)); display: inline-flex; align-items: center; gap: 8px; min-block-size: 44px; padding: 0 18px; border: 0; border-radius: 999px; background: color-mix(in srgb, currentColor 8%, transparent); color: inherit; font: inherit; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; cursor: pointer; opacity: 0; pointer-events: none; transition: opacity .6s ease; }
.am.is-end .am-replay { opacity: 1; pointer-events: auto; }
.am-replay svg { inline-size: 14px; block-size: 14px; }
@media (max-width: 749px) {
  .am { margin-block-start: 0; block-size: calc(100svh - var(--header-h)); --D: min(104svh, 150vw); --peek: 17vw; }
  .am-copy { padding-block-start: clamp(20px, 5svh, 48px); padding-inline: calc(var(--peek) + 6px); }
  .am-title { font-size: min(15vw, 11svh); }
  .am-lines { max-inline-size: 20ch; } .am-lines li { font-size: 16px; }
  .am-now b { font-size: 17px; } .am-now { font-size: 11px; letter-spacing: .14em; gap: 8px; }
  .am-packs { block-size: min(23svh, 44vw); inset-block-end: calc(var(--dock-h, 0px) + 12px); gap: 4px; }
  .am-replay { inset-block-end: auto; inset-block-start: 10px; inline-size: 44px; padding: 0; justify-content: center; font-size: 0; gap: 0; }
  .am-replay svg { inline-size: 18px; block-size: 18px; }
}
@media (prefers-reduced-motion: reduce) { .am-title .w > span, .am-lines li, .am-pack, .am-eyebrow, .am-now { transition: none; } }
</style>
<section class="am" data-am aria-labelledby="AmTitle-{{ section.id }}">
  <span class="am-stars" aria-hidden="true"></span>
  <span class="am-sun am-sun--l" aria-hidden="true"><span class="am-ball"><img src="{{ 'orb-green-1200.webp' | asset_url }}" alt="" width="1200" height="1200"><i></i><b></b><u></u></span></span>
  <span class="am-sun am-sun--r" aria-hidden="true"><span class="am-ball"><img src="{{ 'orb-blue-1200.webp' | asset_url }}" alt="" width="1200" height="1200"><i></i><b></b><u></u></span></span>
  <div class="am-copy">
    <p class="am-eyebrow">About</p>
    <h1 class="am-title" id="AmTitle-{{ section.id }}"><span class="w"><span style="--i: 0">Between</span></span><br><span class="w"><span style="--i: 1">Two</span></span> <span class="w"><span style="--i: 2">Suns</span></span></h1>
    <p class="am-now" aria-hidden="true"><b data-time>06:00</b><span data-now>Today’s sun</span></p>
    <ol class="am-lines" role="list">
      <li class="is-on">Two suns: today’s, and tomorrow’s.</li>
      <li>Between them, a whole day happens to your skin. The commute, the office air, the afternoon heat.</li>
      <li>Then the night, and the second half of the routine.</li>
      <li>That space between two days is what we make skincare for.</li>
    </ol>
  </div>
  <ul class="am-packs" role="list" aria-hidden="true">
    <li class="am-pack" style="--h: 1; --i: 0"><img src="{{ 'cut-daily-reset-cleanser.webp' | asset_url }}" alt=""></li>
    <li class="am-pack" style="--h: .65; --i: 1"><img src="{{ 'cut-clarity-serum.webp' | asset_url }}" alt=""></li>
    <li class="am-pack" style="--h: .81; --i: 2"><img src="{{ 'cut-daily-barrier-moisturizing-cream.webp' | asset_url }}" alt=""></li>
    <li class="am-pack" style="--h: .81; --i: 3"><img src="{{ 'cut-daily-defense-sunscreen-spf-50.webp' | asset_url }}" alt=""></li>
  </ul>
  <button type="button" class="am-replay" data-replay aria-label="Replay the day"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>Replay the day</button>
</section>
<script>
(() => {
  const el = document.currentScript.previousElementSibling; if (!el || !el.matches('[data-am]')) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const L = el.querySelector('.am-sun--l'), R = el.querySelector('.am-sun--r'), balls = [L.firstElementChild, R.firstElementChild];
  const lines = [...el.querySelectorAll('.am-lines li')], timeEl = el.querySelector('[data-time]'), nowEl = el.querySelector('[data-now]');
  const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const io = (x) => (x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const seg = (T, a, b) => clamp((T - a) / (b - a));
  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  // seconds: the mark holds, opens, then one day passes
  const OPEN0 = .55, OPEN1 = 2.5, DAY = 4.4, DUSK = 7.8, NIGHT = 9.6, DAWN = 11.6, END = 14.2;
  const SKY = [[0, '#ffffff'], [DUSK, '#ffffff'], [DUSK + .8, '#ecdcee'], [DUSK + 1.4, '#5a5380'], [NIGHT, '#22263d'], [DAWN, '#22263d'], [DAWN + .9, '#4a6470'], [DAWN + 1.6, '#d3e8e1'], [DAWN + 2.4, '#ffffff']].map(([t, h]) => [t, hex(h)]);
  const sky = (T) => { let i = 1; while (i < SKY.length - 1 && T > SKY[i][0]) i++; const [t0, a] = SKY[i - 1], [t1, b] = SKY[i], k = clamp((T - t0) / (t1 - t0)); return a.map((v, j) => v + (b[j] - v) * k); };
  const STORY = [[0, '06:00', 'Today’s sun'], [DAY, '13:00', 'Out in the day'], [DUSK + .9, '22:00', 'Night routine'], [DAWN + 1.2, '06:00', 'Tomorrow’s sun']];
  let G = null, step = -1;
  const measure = () => { const W = el.clientWidth, D = L.offsetWidth, peek = parseFloat(getComputedStyle(el).getPropertyValue('--peek')) / 100 * innerWidth; const s0 = Math.min(84, el.clientHeight * .12) / D;
    G = { D, s0, x0: 1.1075 * (D / 2) * s0, x1: W / 2 - peek + D / 2 }; };
  const draw = (T) => {
    if (!G) measure();
    const e = io(seg(T, OPEN0, OPEN1));
    // the mark grows into the suns: size and distance grow together (a zoom), the crescents fill out, the ink gives way to the surface
    const S = G.s0 * Math.pow(1 / G.s0, e), X = G.x0 * Math.pow(G.x1 / G.x0, e);
    const md = G.D * (.11 + .98 * Math.pow(e, 1.35)), ink = 1 - clamp((e - .12) / .5);
    // the day in the light
    const ghost = 1 - .8 * io(seg(T, DAY - .2, DAY + 1)) + .8 * io(seg(T, DAWN + .9, DAWN + 2.2));       // tomorrow's sun: here, not yet, here
    const shadeL = .86 * io(seg(T, DUSK + .5, NIGHT)) - .86 * io(seg(T, DAWN + 1.2, DAWN + 2.4));        // today's sun goes dark for the night
    const sink = io(seg(T, DUSK + .3, NIGHT)) - io(seg(T, DAWN + 1.2, DAWN + 2.4));
    L.style.transform = `translate3d(${(-X).toFixed(1)}px, ${(sink * G.D * .05).toFixed(1)}px, 0) scale(${S.toFixed(4)})`;
    R.style.transform = `translate3d(${X.toFixed(1)}px, ${((1 - ghost) * G.D * .04).toFixed(1)}px, 0) scale(${S.toFixed(4)})`;
    R.style.opacity = ghost.toFixed(3);
    balls.forEach((b) => { b.style.setProperty('--md', e >= 1 ? '9999px' : md.toFixed(1) + 'px'); b.style.setProperty('--ink', ink.toFixed(3)); });
    balls[0].style.setProperty('--sh', clamp(shadeL).toFixed(3));
    const c = sky(T), lum = (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255;
    el.style.setProperty('--sky', `rgb(${c.map(Math.round).join(',')})`); el.style.setProperty('--n', clamp((.62 - lum) / .4).toFixed(3)); el.toggleAttribute('data-dark', lum < .5);
    el.classList.toggle('is-open', T >= OPEN0 + 1.4);
    el.classList.toggle('is-end', T >= DAWN + 2.1);
    let k = 0; while (k < STORY.length - 1 && T >= STORY[k + 1][0]) k++;
    if (k !== step) { step = k; lines.forEach((li, i) => li.classList.toggle('is-on', i === k)); timeEl.textContent = STORY[k][1]; nowEl.textContent = STORY[k][2]; }
  };
  let raf = 0, t0 = 0;
  const play = (from = 0) => { cancelAnimationFrame(raf); t0 = 0; const tick = (now) => { if (!t0) t0 = now - from * 1000; const T = (now - t0) / 1000; draw(T); if (T < END) raf = requestAnimationFrame(tick); }; raf = requestAnimationFrame(tick); };
  el.querySelector('[data-replay]').addEventListener('click', () => { el.classList.remove('is-end'); step = -1; play(OPEN1 + .4); });
  const re = () => { G = null; if (!raf || el.classList.contains('is-end')) draw(END); };
  addEventListener('resize', re);
  const start = () => { measure(); draw(reduce ? END : 0); el.classList.add('is-ready'); if (!reduce) play(0); };
  if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true });
})();
</script>

{% schema %}
{
  "name": "About · the mark opens",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
