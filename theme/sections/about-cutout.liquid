{%- comment -%}
  About hero prototype I · "The sky, with the name as a window" (demo only, /pages/about?view=cutout).
  Direction 1 with the owner's ask: the picture is IN the letters. The screen is a bright pastel sky that moves
  through one day (mint dawn, white noon, warm late afternoon, lilac dusk, pale periwinkle night, dawn again); a
  soft sun crosses behind the name and sets, and the next one rises. The name is very large and cut out: its
  letters are a window onto a photograph (the store's own portrait), and the day's light falls on the photograph
  inside the letters too (it warms toward evening, cools at night, and a patch of sunlight travels across it).
  It plays slowly by itself; drag sideways to move the day. One screen, nothing pinned, no packs, no moving
  shadows, no dark sky, no clock (one word names the time of day).
  Reduced motion: a still mid-morning. Prototype: English only.
{%- endcomment -%}
<style>
.ac { --sky: #fff; position: relative; margin-block-start: calc(-1 * var(--header-h)); block-size: 100svh; min-block-size: 560px; overflow: clip; isolation: isolate; background: var(--sky); color: var(--c-ink); touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
.ac.is-drag { cursor: grabbing; }
.ac-sun { position: absolute; z-index: -1; left: 0; top: 0; inline-size: 62svh; aspect-ratio: 1; margin: -31svh 0 0 -31svh; border-radius: 50%; pointer-events: none; will-change: transform, opacity;
  background: radial-gradient(circle, rgb(var(--c, 164 214 180)) 0 46%, rgb(var(--c, 164 214 180) / .5) 58%, rgb(var(--c, 164 214 180) / 0) 72%); }
/* the name: a window onto the photograph; the day's light is blended into the same picture */
.ac-title { position: absolute; inset-inline: 0; inset-block-start: 50%; translate: 0 -53%; margin: 0; padding-block: .06em .1em; text-align: center; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; line-height: .84; letter-spacing: -.005em;
  font-size: clamp(88px, min(20.5vw, 39svh), 460px); pointer-events: none; color: transparent; -webkit-text-fill-color: transparent;
  background-image: radial-gradient(circle at var(--lx, 30%) var(--ly, 30%), rgb(255 246 226 / var(--lo, .5)) 0, rgb(255 226 180 / calc(var(--lo, .5) * .45)) 16%, transparent 38%), linear-gradient(var(--soft, transparent), var(--soft, transparent)), linear-gradient(var(--mul, transparent), var(--mul, transparent)), linear-gradient(rgb(46 40 70 / .3), rgb(46 40 70 / .3)), var(--photo);
  background-blend-mode: screen, soft-light, multiply, multiply, normal; background-size: 100% 100%, 100% 100%, 100% 100%, 100% 100%, cover; background-position: center, center, center, center, var(--pp, 50% 36%); background-repeat: no-repeat;
  -webkit-background-clip: text; background-clip: text; animation: ac-in 1.4s cubic-bezier(.2, .75, .2, 1) both; }
@keyframes ac-in { from { opacity: 0; transform: translateY(.06em) scale(1.03); } }
.ac-foot { position: absolute; inset-inline: var(--gutter); inset-block-end: calc(var(--dock-h, 0px) + clamp(18px, 4svh, 44px)); display: flex; justify-content: space-between; align-items: end; gap: 24px; pointer-events: none; }
.ac-now { margin: 0; display: grid; gap: 8px; }
.ac-word { display: grid; overflow: hidden; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
.ac-word span { grid-area: 1 / 1; translate: 0 110%; opacity: 0; transition: translate .7s cubic-bezier(.2, .75, .2, 1), opacity .5s ease; }
.ac-word span.is-on { translate: 0 0; opacity: 1; } .ac-word span.is-off { translate: 0 -110%; }
.ac-line { font-size: clamp(17px, 1.5vw, 23px); line-height: 1.32; font-weight: 520; letter-spacing: -.01em; max-inline-size: 26ch; text-wrap: balance; }
.ac-hint { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; opacity: .7; white-space: nowrap; }
.ac-m { display: none; }
.ac-eyebrow { position: absolute; inset-inline: 0; inset-block-start: calc(var(--header-h) + 4svh); margin: 0; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; pointer-events: none; }
@media (max-width: 749px) {
  .ac { margin-block-start: 0; block-size: calc(100svh - var(--header-h)); }
  .ac-eyebrow { inset-block-start: 3.5svh; }
  .ac-title { font-size: min(29vw, 20svh); translate: 0 -60%; --pp: 42% 50%; }
  .ac-m { display: inline; }
  .ac-sun { inline-size: 70vw; margin: -35vw 0 0 -35vw; }
  .ac-foot { inset-inline: 18px; justify-content: center; text-align: center; inset-block-end: calc(var(--dock-h, 76px) + 16px); }
  .ac-now { justify-items: center; } .ac-line { font-size: 16px; } .ac-hint { display: none; }
}
@media (prefers-reduced-motion: reduce) { .ac-title { animation: none; } .ac-word span { transition: none; } }
</style>
<section class="ac" data-ac aria-labelledby="AcTitle-{{ section.id }}" style="--photo: url('{{ 'bts-climate2-humidity-wide.jpg' | file_img_url: '2400x' }}')">
  <span class="ac-sun" aria-hidden="true"></span>
  <p class="ac-eyebrow">About</p>
  <h1 class="ac-title" id="AcTitle-{{ section.id }}">Between<br>two <br class="ac-m">suns</h1>
  <div class="ac-foot">
    <p class="ac-now"><span class="ac-word" aria-hidden="true"><span class="is-on">Morning</span><span>Midday</span><span>Golden hour</span><span>Dusk</span><span>Night</span><span>Tomorrow’s sun</span></span><span class="ac-line">A whole day happens to your skin between today’s sun and tomorrow’s.</span></p>
    <p class="ac-hint" aria-hidden="true">Drag to move the day</p>
  </div>
</section>
<script>
(() => {
  const el = document.currentScript.previousElementSibling; if (!el || !el.matches('[data-ac]')) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sun = el.querySelector('.ac-sun'), title = el.querySelector('.ac-title'), words = [...el.querySelectorAll('.ac-word span')];
  const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v)), mix = (a, b, k) => a + (b - a) * k;
  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  // the day, 0–1: [time, sky, light on the picture (soft-light colour, strength), shade on the picture (multiply colour, strength)]
  const KEYS = [
    [0, '#e6f4ec', '#d8f3e4', .3, '#dfe6ff', .14], [.09, '#ffffff', '#fff6e8', .1, '#ffffff', 0], [.3, '#ffffff', '#ffffff', 0, '#ffffff', 0],
    [.43, '#fff1e1', '#ffc98a', .36, '#ffe1c4', .1], [.53, '#f6e0ee', '#ff9a5c', .46, '#f6c2cf', .22], [.62, '#d2d5f9', '#d9a8e8', .34, '#bfb2ea', .4],
    [.74, '#bcc6f5', '#9fb0f2', .3, '#a3b0ee', .5], [.86, '#d5dff8', '#9fb0f2', .28, '#b3bef0', .42], [.95, '#e2f1e9', '#cfeedd', .3, '#dfe6ff', .2], [1, '#e6f4ec', '#d8f3e4', .3, '#dfe6ff', .14],
  ].map((k) => [k[0], hex(k[1]), hex(k[2]), k[3], hex(k[4]), k[5]]);
  const WORDS = [0, .14, .4, .56, .66, .9], SET = .58;
  let t = .05, day = 0, word = -1, W = 0, H = 0;
  const size = () => { W = el.clientWidth; H = el.clientHeight; };
  const draw = () => {
    let i = 1; while (i < KEYS.length - 1 && t > KEYS[i][0]) i++; const a = KEYS[i - 1], b = KEYS[i], k = clamp((t - a[0]) / (b[0] - a[0]));
    const rgb = (x, y) => x.map((v, j) => Math.round(mix(v, y[j], k))).join(' ');
    el.style.setProperty('--sky', `rgb(${rgb(a[1], b[1])})`);
    title.style.setProperty('--soft', `rgb(${rgb(a[2], b[2])} / ${mix(a[3], b[3], k).toFixed(3)})`); title.style.setProperty('--mul', `rgb(${rgb(a[4], b[4])} / ${mix(a[5], b[5], k).toFixed(3)})`);
    // today's sun crosses behind the name and goes down; tomorrow's (the other colour) comes up, and becomes today's
    let u = -1, o = 0, col = day % 2 ? '171 193 233' : '164 214 180'; if (t <= SET) { u = t / SET; o = 1; } else if (t > .88) { u = 0; o = (t - .88) / .12; col = day % 2 ? '164 214 180' : '171 193 233'; }
    if (u < 0) { sun.style.opacity = 0; title.style.setProperty('--lo', 0); } else {
      const e = Math.sin(Math.PI * u), x = W * mix(.04, .96, u), y = H * (1.12 - e * .86) + (1 - o) * H * .32;
      sun.style.setProperty('--c', col); sun.style.opacity = (o * clamp(u * 16 + .2) * clamp((1 - u) * 16)).toFixed(3); sun.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      // the same sun as a patch of light on the photograph inside the letters
      const r = title.getBoundingClientRect(), s = el.getBoundingClientRect();
      title.style.setProperty('--lx', ((x - (r.left - s.left)) / r.width * 100).toFixed(1) + '%'); title.style.setProperty('--ly', (clamp((y - (r.top - s.top)) / r.height, -.2, 1.2) * 100).toFixed(1) + '%');
      title.style.setProperty('--lo', (o * mix(.75, .42, e)).toFixed(3));
    }
    let w = 0; while (w < WORDS.length - 1 && t >= WORDS[w + 1]) w++;
    if (w !== word) { words.forEach((sp, j) => { sp.classList.toggle('is-on', j === w); sp.classList.toggle('is-off', j < w); }); word = w; }
  };
  size();
  if (reduce) { t = .2; draw(); addEventListener('resize', () => { size(); draw(); }); return; }
  let raf = 0, seen = true, last = 0, hold = 0, x0 = null, tAt = 0;
  const frame = (now) => { raf = 0; const dt = Math.min(.05, (now - (last || now)) / 1000); last = now;
    if (now > hold) { t += dt / 22; if (t >= 1) { t -= 1; day++; } } draw(); if (seen) raf = requestAnimationFrame(frame); };
  const ask = () => { if (!raf) { last = 0; raf = requestAnimationFrame(frame); } };
  el.addEventListener('pointerdown', (e) => { if (e.target.closest('a, button')) return; x0 = e.clientX; tAt = t; el.classList.add('is-drag'); });
  addEventListener('pointermove', (e) => { if (x0 != null) { t = clamp(tAt + (e.clientX - x0) / (W * 1.3), 0, .999); hold = performance.now() + 2500; } }, { passive: true });
  const end = () => { x0 = null; el.classList.remove('is-drag'); }; addEventListener('pointerup', end); addEventListener('pointercancel', end);
  addEventListener('resize', size);
  new IntersectionObserver(([e]) => { seen = e.isIntersecting; if (seen) ask(); }).observe(el);
  el.__ac = { set: (v) => { t = v; hold = 1e15; } };
  ask();
})();
</script>

{% schema %}
{
  "name": "About · sky, name as window",
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
