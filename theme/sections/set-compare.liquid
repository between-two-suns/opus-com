{%- comment -%}
  Set pages (DECISIONS 189–192, 238): "Which set is right for you?" The five routine sets in the shop's one card
  (snippets/bundle-card, with the packs picture, DECISIONS 277), in a row that scrolls; the set being viewed is left out (DECISIONS 239). Prices and savings are live (compare-at = the singles added up).
  Renders nothing on single products.
{%- endcomment -%}
{%- liquid
  capture bdef
    render 'bundle-def', handle: product.handle
  endcapture
  assign bdef = bdef | strip
-%}
{%- if bdef != blank -%}
{%- liquid
  assign rows = 'the-full-ritual,the-clear-protect-trio,the-night-ritual,clear-protect-duo,the-core-duo' | split: ','
-%}
<section class="section section--flow s2-cmp" aria-labelledby="S2Cmp-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{% if section.settings.eyebrow != blank %}{{ section.settings.eyebrow }}{% else %}{{ 'set2.cmp_eyebrow' | t }}{% endif %}</p>
        <h2 class="t-display-m" id="S2Cmp-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading }}{% else %}{{ 'set2.cmp_heading' | t }}{% endif %}</h2>
      </div>
      <a class="link-arrow" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label }}{% else %}{{ 'sections.bundles.see_all' | t }}{% endif %} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </div>
    {{ 'bundles.css' | asset_url | stylesheet_tag }}
    <ul class="s2-sets" role="list">
      {%- for h in rows -%}
        {%- assign sp = all_products[h] -%}
        {%- if sp.id == blank or h == product.handle -%}{%- continue -%}{%- endif -%}
        {%- render 'bundle-card', product: sp, stage: true -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compare sets",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Every text box starts empty and shows the site's built-in English and Arabic text. Type to replace it, then add the Arabic in Translate & Adapt (free Shopify app), or Arabic visitors will see your English."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to keep the built-in English and Arabic text."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "info": "Built-in: “See all sets”."
    }
  ]
}
{% endschema %}
