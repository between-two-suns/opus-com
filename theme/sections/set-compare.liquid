{%- comment -%}
  Set pages (DECISIONS 189–192, 238): "Which set is right for you?" The five routine sets in the shop's one card
  (snippets/bundle-card), in a row that scrolls; the set being viewed is marked "You're here". Prices and savings are live (compare-at = the singles added up).
  Renders nothing on single products.
{%- endcomment -%}
{%- liquid
  capture bdef
    render 'bundle-def', handle: product.handle
  endcapture
  assign bdef = bdef | strip
-%}
{%- if bdef != blank -%}
{%- liquid
  assign rows = 'the-full-ritual,the-clear-protect-trio,the-night-ritual,clear-protect-duo,the-core-duo' | split: ','
-%}
<section class="section section--flow s2-cmp" aria-labelledby="S2Cmp-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <p class="t-eyebrow">{{ 'set2.cmp_eyebrow' | t }}</p>
        <h2 class="t-display-m" id="S2Cmp-{{ section.id }}">{{ 'set2.cmp_heading' | t }}</h2>
      </div>
      <a class="link-arrow" href="{{ routes.root_url | append: '/pages/sets' | replace: '//', '/' }}">{{ 'sections.bundles.see_all' | t }} {% render 'icon', name: 'arrow', class: 'icon--sm icon--flip' %}</a>
    </div>
    {{ 'bundles.css' | asset_url | stylesheet_tag }}
    {%- comment -%} The shop's one card (DECISIONS 238); the set being viewed is marked "You're here" and has no add button {%- endcomment -%}
    <ul class="s2-sets" role="list">
      {%- for h in rows -%}
        {%- assign sp = all_products[h] -%}
        {%- unless sp.id -%}{%- continue -%}{%- endunless -%}
        {%- if h == product.handle -%}{%- assign here = true -%}{%- else -%}{%- assign here = false -%}{%- endif -%}
        {%- render 'bundle-card', product: sp, here: here -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compare sets",
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
