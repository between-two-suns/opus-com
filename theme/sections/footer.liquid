{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign tagline = section.settings.tagline | default: ''
  if tagline == blank
    assign tagline = 'footer.tagline' | t | replace: '&amp;', '&'
  endif
  assign description = section.settings.description
  if description == blank
    assign description = 'footer.description' | t | replace: '&amp;', '&'
  endif
  assign news_heading = section.settings.newsletter_heading
  if news_heading == blank
    assign news_heading = 'newsletter.heading' | t | replace: '&amp;', '&'
  endif
  assign news_text = section.settings.newsletter_text
  if news_text == blank
    assign news_text = 'newsletter.text' | t | replace: '&amp;', '&'
  endif
  comment
    The footer sign-up reveals the welcome code too (welcome-offer.js), so when that card can show on this page the
    footer names the offer and its terms (DECISIONS 294). Same conditions as snippets/welcome-offer.liquid.
  endcomment
  assign news_offer = settings.welcome_enable
  if settings.welcome_code == blank
    assign news_offer = false
  endif
  case template.name
    when 'cart', 'password', 'gift_card', 'customers/account', 'customers/order', 'customers/addresses'
      assign news_offer = false
  endcase
  if template.suffix == 'account' or customer and customer.accepts_marketing
    assign news_offer = false
  endif
  if news_offer and section.settings.newsletter_heading == blank and section.settings.newsletter_text == blank
    assign offer_amt_cents = settings.welcome_amount | default: 0 | times: 100
    assign offer_min_cents = settings.welcome_min | default: 0 | times: 100
    capture offer_amt
      render 'egp', cents: offer_amt_cents
    endcapture
    capture offer_min
      render 'egp', cents: offer_min_cents
    endcapture
    assign offer_amt = offer_amt | strip
    assign offer_min = offer_min | strip
    assign news_heading = 'newsletter.offer_heading' | t
    assign news_text = 'newsletter.offer_text' | t: amount: offer_amt
  else
    assign news_offer = false
  endif
-%}
<footer class="site-footer" aria-labelledby="FooterTitle">
  <h2 class="visually-hidden" id="FooterTitle">{% if section.settings.t_footer_title != blank %}{{ section.settings.t_footer_title }}{% else %}{{ 'footer.title' | t }}{% endif %}</h2>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" aria-label="{{ 'header.home' | t: shop: shop.name }}">{% render 'logo', variant: 'wordmark' %}</a>
        <p class="t-lead">{{ tagline | escape }}</p>
        <p class="t-small footer__soft">{{ description | escape }}</p>
        {%- liquid
          assign has_social = false
          if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_youtube != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <ul class="social" role="list">
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram {{ 'general.opens_new_window' | t }}</span></a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}<span class="visually-hidden">TikTok {{ 'general.opens_new_window' | t }}</span></a></li>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}<span class="visually-hidden">Facebook {{ 'general.opens_new_window' | t }}</span></a></li>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">{% render 'icon', name: 'youtube' %}<span class="visually-hidden">YouTube {{ 'general.opens_new_window' | t }}</span></a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- liquid
                assign col_heading = block.settings.heading
                if col_heading == blank
                  assign col_key = 'footer.headings.' | append: block.settings.fallback
                  assign col_heading = col_key | t | replace: '&amp;', '&'
                endif
              -%}
              <h2>{{ col_heading | escape }}</h2>
              <ul role="list">
                {%- if block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- case block.settings.fallback -%}
                    {%- when 'shop' -%}
                      <li><a href="{{ routes.all_products_collection_url }}">{% if section.settings.t_footer_links_shop_all != blank %}{{ section.settings.t_footer_links_shop_all }}{% else %}{{ 'footer.links.shop_all' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/sets">{% if section.settings.t_footer_links_sets != blank %}{{ section.settings.t_footer_links_sets }}{% else %}{{ 'footer.links.sets' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/routines">{% if section.settings.t_footer_links_routines != blank %}{{ section.settings.t_footer_links_routines }}{% else %}{{ 'footer.links.routines' | t }}{% endif %}</a></li>
                      {%- comment -%} Temporary, for the owner's testing: the ★ is a reminder. Remove this line at launch (DECISIONS 227). {%- endcomment -%}
                      <li><a href="{{ root }}/pages/scan">{% if section.settings.t_footer_links_scan != blank %}{{ section.settings.t_footer_links_scan }}{% else %}{{ 'footer.links.scan' | t }}{% endif %} ★</a></li>
                    {%- when 'learn' -%}
                      <li><a href="{{ root }}/pages/climate">{% if section.settings.t_footer_links_climate != blank %}{{ section.settings.t_footer_links_climate }}{% else %}{{ 'footer.links.climate' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/ingredients">{% if section.settings.t_footer_links_ingredients != blank %}{{ section.settings.t_footer_links_ingredients }}{% else %}{{ 'footer.links.ingredients' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/about">{% if section.settings.t_footer_links_about != blank %}{{ section.settings.t_footer_links_about }}{% else %}{{ 'footer.links.about' | t }}{% endif %}</a></li>
                      {%- if blogs.journal.articles_count > 0 -%}<li><a href="{{ root }}/blogs/journal">{% if section.settings.t_footer_links_journal != blank %}{{ section.settings.t_footer_links_journal }}{% else %}{{ 'footer.links.journal' | t }}{% endif %}</a></li>{%- endif -%}
                      <li><a href="{{ root }}/pages/creators">{% if section.settings.t_footer_links_creators != blank %}{{ section.settings.t_footer_links_creators }}{% else %}{{ 'footer.links.creators' | t }}{% endif %}</a></li>
                    {%- when 'help' -%}
                      <li><a href="{{ root }}/pages/faq">{% if section.settings.t_footer_links_faq != blank %}{{ section.settings.t_footer_links_faq }}{% else %}{{ 'footer.links.faq' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/shipping">{% if section.settings.t_footer_links_shipping != blank %}{{ section.settings.t_footer_links_shipping }}{% else %}{{ 'footer.links.shipping' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/returns">{% if section.settings.t_footer_links_returns != blank %}{{ section.settings.t_footer_links_returns }}{% else %}{{ 'footer.links.returns' | t }}{% endif %}</a></li>
                      <li><a href="{{ root }}/pages/contact">{% if section.settings.t_footer_links_contact != blank %}{{ section.settings.t_footer_links_contact }}{% else %}{{ 'footer.links.contact' | t }}{% endif %}</a></li>
                  {%- endcase -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="footer__news">
        <h2 class="t-display-s">{{ news_heading | escape }}</h2>
        <p class="t-small footer__soft">{{ news_text | escape }}</p>
        {%- form 'customer', id: 'FooterNewsletter', class: 'footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" role="status" tabindex="-1"{% unless settings.welcome_enable %} autofocus{% endunless %}>{% if news_offer %}{% if section.settings.t_newsletter_offer_success != blank %}{{ section.settings.t_newsletter_offer_success }}{% else %}{{ 'newsletter.offer_success' | t }}{% endif %}{% else %}{% if section.settings.t_newsletter_success != blank %}{{ section.settings.t_newsletter_success }}{% else %}{{ 'newsletter.success' | t }}{% endif %}{% endif %}</p>
          {%- else -%}
            <div class="inline-form">
              <div class="field">
                <label class="visually-hidden" for="FooterNewsletterEmail">{% if section.settings.t_newsletter_email_label != blank %}{{ section.settings.t_newsletter_email_label }}{% else %}{{ 'newsletter.email_label' | t }}{% endif %}</label>
                <input
                  id="FooterNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{% if section.settings.t_newsletter_email_label != blank %}{{ section.settings.t_newsletter_email_label }}{% else %}{{ 'newsletter.email_label' | t }}{% endif %}"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="FooterNewsletterError"{% endif %}
                >
              </div>
              <button type="submit" class="btn">{% if news_offer %}{{ 'newsletter.offer_submit' | t: amount: offer_amt }}{% else %}{% if section.settings.t_newsletter_submit != blank %}{{ section.settings.t_newsletter_submit }}{% else %}{{ 'newsletter.submit' | t }}{% endif %}{% endif %}</button>
            </div>
            {%- if form.errors -%}
              <p class="field__error" id="FooterNewsletterError">{% render 'icon', name: 'alert', class: 'icon--sm' %}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <p class="t-xs footer__soft">{% if news_offer %}{{ 'welcome.terms' | t: minimum: offer_min }} {% endif %}{% if section.settings.t_newsletter_consent != blank %}{{ section.settings.t_newsletter_consent }}{% else %}{{ 'newsletter.consent' | t }}{% endif %}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {% if section.settings.t_footer_copyright != blank %}{{ section.settings.t_footer_copyright }}{% else %}{{ 'footer.copyright' | t }}{% endif %} · {% if section.settings.t_footer_made_in != blank %}{{ section.settings.t_footer_made_in }}{% else %}{{ 'footer.made_in' | t }}{% endif %}<br><span class="footer__entity">{% if section.settings.t_footer_entity != blank %}{{ section.settings.t_footer_entity }}{% else %}{{ 'footer.entity' | t }}{% endif %}</span></p>
      <nav aria-label="{% if section.settings.t_footer_legal != blank %}{{ section.settings.t_footer_legal }}{% else %}{{ 'footer.legal' | t }}{% endif %}">
        <ul class="footer__legal" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
      {%- render 'language-switch', form_id: 'FooterLang', class: 'chip', show_label: true -%}
      {%- render 'payment-icons' -%}
    </div>
    <p class="footer__closing" aria-hidden="true" data-text="{{ tagline | escape }}"></p>
  </div>
  <div class="footer__mark" aria-hidden="true">{{ 'bts-icon.svg' | inline_asset_content }}</div>
</footer>

