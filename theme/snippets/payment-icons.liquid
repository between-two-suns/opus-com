{%- comment -%} Only payment types actually enabled in Shopify Payments / checkout settings. Never faked. {%- endcomment -%}
{%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons {{ class }}" role="list" aria-label="{{ 'general.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
