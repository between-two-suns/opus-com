{%- liquid
  assign bts_brand = 'Between Two Suns'
  assign default_home_description = 'Climate-adapted skincare made for sun, humidity, city pollution and changing environments. Discover the four-step Between Two Suns routine.'
  assign og_title = page_title | default: bts_brand
  if request.page_type == 'index'
    assign og_title = 'Between Two Suns — Climate-Adapted Skincare'
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: default_home_description
  assign og_image = page_image
  comment
    About (DECISIONS 195): until the page has its own SEO description in admin (Shopify otherwise falls back to the
    shop's tagline), it uses the About copy; its share card
    is the two suns (Files: bts-og-about.png).
  endcomment
  if template.name == 'page' and template.suffix contains 'about'
    assign meta_desc = 'about2.meta_description' | t
    if page.metafields.global.description_tag != blank
      assign meta_desc = page_description
    endif
    assign og_description = meta_desc
    assign page_description = meta_desc
    if og_image == blank
      assign og_about = images['bts-og-about.png']
      if og_about != blank and og_about.width
        assign og_image = og_about
      endif
    endif
  endif
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}
<title>
  {%- if request.page_type == 'index' -%}
    Between Two Suns — Climate-Adapted Skincare
  {%- else -%}
    {{ page_title | escape }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains bts_brand %} &ndash; {{ bts_brand }}{% endunless -%}
  {%- endif -%}
</title>
{%- if request.page_type == 'index' or page_description -%}
  <meta name="description" content="{{ og_description | escape }}">
{%- endif -%}
<meta property="og:site_name" content="{{ bts_brand | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
