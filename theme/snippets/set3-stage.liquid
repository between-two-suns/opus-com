{%- comment -%}
  Set pages: the first photo in the single products' style (DECISIONS 313). The set's big word behind (set2.stage_word.<handle>,
  in the set's colours, like RESET behind the cleanser), the packs grouped and tilted at their true relative sizes, and the
  callouts on the start side naming each step, with a dot in the step's colour. Tapping a pack still goes to its card in
  "Inside the set" (#set-item-N). Uses the existing pack cutouts; nothing is redrawn.
  Params: product (the set), units (its steps, repeats included), count (slides, for the label)
{%- endcomment -%}
{%- liquid
  assign step_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign textures = ',texture-foam.svg,texture-drops.svg,texture-cream.svg,texture-sand.svg' | split: ','
  assign uniq = units | uniq
  assign first = uniq | first | plus: 0
  assign last = uniq | last | plus: 0
  assign word_key = 'set2.stage_word.' | append: product.handle
  assign word = word_key | t
  if word contains 'ranslation missing'
    assign word = ''
  endif
  comment
    Each set's look (owner, DECISIONS 314): background from one step's colour to a neighbouring one, and the big word in a
    colour of its own, so the sets don't all read green. "bg-from,bg-to,word" as step numbers.
  endcomment
  case product.handle
    when 'the-full-ritual'
      assign look = '1,2,1'
    when 'the-night-ritual'
      assign look = '2,3,3'
    when 'the-clear-protect-trio'
      assign look = '1,2,2'
    when 'clear-protect-duo'
      assign look = '4,3,2'
    when 'the-core-duo'
      assign look = '2,1,1'
    else
      assign look = first | append: ',' | append: last | append: ',' | append: first
  endcase
  assign look = look | split: ','
  assign ta = look[0] | plus: 0
  assign tb = look[1] | plus: 0
  assign tex_a = textures[ta]
  assign tex_b = textures[tb]
  assign smax = '.65'
  if units contains '3' or units contains '4'
    assign smax = '.81'
  endif
  if units contains '1'
    assign smax = '1'
  endif
-%}
<div class="gallery__slide s3-stage" role="group" aria-roledescription="slide" aria-label="{{ 'accessibility.slide_n' | t: index: 1, count: count }}" data-slide style="--a: var(--c-step-{{ look[0] }}); --b: var(--c-step-{{ look[1] }}); --at: var(--c-step-{{ look[0] }}-tint); --bt: var(--c-step-{{ look[1] }}-tint); --w: var(--c-step-{{ look[2] }}); --n: {{ units.size }}; --smax: {{ smax }}">
  {%- comment -%} The two colours' own textures (bubbles, drops, cream, sand), each fading out towards the other side {%- endcomment -%}
  <span class="gallery__texture s3-stage__tex s3-stage__tex--a" aria-hidden="true" style="--tex: url('{{ tex_a | asset_url }}')"></span>
  {%- if tex_b != tex_a -%}<span class="gallery__texture s3-stage__tex s3-stage__tex--b" aria-hidden="true" style="--tex: url('{{ tex_b | asset_url }}')"></span>{%- endif -%}
  {%- if word != blank -%}<span class="gallery__word s3-stage__word" aria-hidden="true" style="--len: {{ word | size }}">{{ word | escape }}</span>{%- endif -%}
  {%- comment -%} A stock-up is one product twice: its callouts are the pack's own benefit words, as on its product page; other sets name their steps {%- endcomment -%}
  {%- assign only = all_products[step_handles[first]] -%}
  <ul class="callouts s3-stage__callouts" role="list" aria-hidden="true">
    {%- if uniq.size == 1 and only.metafields.bts.benefit != blank -%}
      {%- assign bens = only.metafields.bts.benefit | split: '.' -%}
      {%- assign shown = 0 -%}
      {%- for c in bens -%}
        {%- assign c = c | strip -%}
        {%- if c != blank and shown < 3 -%}
          <li class="callouts__item" style="--k: {{ shown }}; --sku-deep: var(--c-step-{{ first }})"><span class="callouts__text">{{ c }}</span><span class="callouts__line"></span></li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for st in uniq -%}
        {%- assign si = st | plus: 0 -%}
        {%- assign nk = 'product.step_name.s' | append: si -%}
        <li class="callouts__item" style="--k: {{ forloop.index0 }}; --sku-deep: var(--c-step-{{ si }})"><span class="callouts__text">0{{ si }} {{ nk | t }}</span><span class="callouts__line"></span></li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  <ul class="s3-stage__packs" role="list">
    {%- assign shown = '' -%}
    {%- for st in units -%}
      {%- liquid
        assign si = st | plus: 0
        assign comp = all_products[step_handles[si]]
        assign dup = false
        if shown contains st
          assign dup = true
        endif
        assign shown = shown | append: st
      -%}
      <li class="s3-pack" data-step="{{ si }}" style="--k: {{ forloop.index0 }}">
        {%- unless dup -%}
          <a class="s3-pack__link" href="#set-item-{{ si }}" aria-label="{{ 'set2.stage_go' | t: name: comp.title }}">
            {%- render 'cut-img', handle: comp.handle, sizes: '(min-width: 990px) 14vw, 30vw', widths: '120,180,240,360,480', loading: 'eager', class: 's3-pack__img', priority: true -%}
          </a>
        {%- else -%}
          <span class="s3-pack__link" aria-hidden="true">{%- render 'cut-img', handle: comp.handle, sizes: '(min-width: 990px) 14vw, 30vw', widths: '120,180,240,360,480', loading: 'eager', class: 's3-pack__img' -%}</span>
        {%- endunless -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
