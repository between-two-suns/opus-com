{%- comment -%}
  A gallery photo. Phones show the photo as shot. On laptops the frame is wider than the photo, so when Files has a
  widened copy named <photo>-4x3.jpg (same photo, background extended at the sides; DECISIONS 310) the laptop uses that.
  Params: image (an image or media), alt, loading ('lazy'), widths, class
{%- endcomment -%}
{%- liquid
  assign gp_load = loading | default: 'lazy'
  assign gp_widths = widths | default: '400,600,800,1000,1200,1400'
  assign gp_src = image.preview_image.src | default: image.src | append: ''
  assign gp_name = gp_src | split: '?' | first | split: '/' | last
  assign gp_wide = false
  if gp_name contains '.jpg'
    assign gp_key = gp_name | remove_last: '.jpg' | append: '-4x3.jpg'
    assign gp_wide = images[gp_key]
    if gp_wide.width == blank
      assign gp_wide = false
    endif
  endif
  comment
    Widened copies with all the new background on one side: keep the woman in view when the frame is narrower than 4:3
  endcomment
  assign gp_style = ''
  if gp_wide
    assign gp_r = ',bts-daily-reset-cleanser-application-4x3.jpg,bts-daily-reset-cleanser-application-2-4x3.jpg,bts-daily-barrier-moisturizing-cream-application-2-4x3.jpg,bts-daily-defense-sunscreen-spf-50-application-4x3.jpg,bts-daily-defense-sunscreen-spf-50-application-2-4x3.jpg,'
    assign gp_k = ',' | append: gp_key | append: ','
    if gp_r contains gp_k
      assign gp_style = '--gp-x: 100%'
    elsif gp_key == 'bts-clarity-serum-application-4x3.jpg'
      assign gp_style = '--gp-x: 0%'
    endif
  endif
  assign gp_ws = '800,1000,1200,1600,2000' | split: ','
-%}
{%- if gp_wide -%}<picture><source media="(min-width: 990px)" srcset="{% for w in gp_ws %}{{ gp_wide | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}" sizes="60vw">{%- endif -%}
{{ image | image_url: width: 1400 | image_tag: loading: gp_load, widths: gp_widths, sizes: '(min-width: 990px) 46vw, 92vw', alt: alt, class: class, style: gp_style }}
{%- if gp_wide -%}</picture>{%- endif -%}
