{%- comment -%}
  Inline UI icon set (24px grid, 1.6 stroke). Brand marks live in assets/ and are never redrawn here.
  Usage: {% render 'icon', name: 'cart', class: 'icon--lg' %}
{%- endcomment -%}
{%- liquid
  assign cls = 'icon'
  if class != blank
    assign cls = cls | append: ' ' | append: class
  endif
-%}
<svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'menu' -%}<path d="M3 7h18M3 12h18M3 17h18"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'chat' -%}<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A2.5 2.5 0 0 1 4 13.5z"/><path d="M8.5 9.5h7M8.5 12h4"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
    {%- when 'cart' -%}<path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'account' -%}<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c1.3-3.6 4.2-5.5 7.5-5.5s6.2 1.9 7.5 5.5"/>
    {%- when 'arrow' -%}<path d="M4 12h15M13.5 6.5L19 12l-5.5 5.5"/>
    {%- when 'arrow-up' -%}<path d="M12 20V5M6.5 10.5L12 5l5.5 5.5"/>
    {%- when 'arrow-down' -%}<path d="M12 4v15M6.5 13.5L12 19l5.5-5.5"/>
    {%- when 'chevron-down' -%}<path d="M6 9.5l6 6 6-6"/>
    {%- when 'chevron-left' -%}<path d="M14.5 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="M9.5 6l6 6-6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'check' -%}<path d="M5 12.5l4.2 4.2L19 7"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/>
    {%- when 'alert' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.4v.2"/>
    {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/>
    {%- when 'moon' -%}<path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10z"/>
    {%- when 'city' -%}<path d="M3 21V10l5-3v14M8 21V4l7 3v14M15 21v-9l6 2v7M2 21h20"/>
    {%- when 'drop' -%}<path d="M12 3.5s6 6.4 6 10.5a6 6 0 0 1-12 0c0-4.1 6-10.5 6-10.5z"/>
    {%- when 'wind' -%}<path d="M3 9h11a3 3 0 1 0-3-3M3 15h15a3 3 0 1 1-3 3M3 12h8"/>
    {%- when 'thermo' -%}<path d="M10 14.8V5a2 2 0 1 1 4 0v9.8a4 4 0 1 1-4 0z"/><path d="M12 9v7"/>
    {%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 9.5h4l3 3.3V16h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'refresh' -%}<path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v4.5h-4.5"/>
    {%- when 'cash' -%}<rect x="3" y="6.5" width="18" height="11" rx="2"/><circle cx="12" cy="12" r="2.5"/>
    {%- when 'flask' -%}<path d="M9.5 3.5h5M10.5 3.5v5.2L5.3 18a2 2 0 0 0 1.8 3h9.8a2 2 0 0 0 1.8-3l-5.2-9.3V3.5"/><path d="M7.6 14h8.8"/>
