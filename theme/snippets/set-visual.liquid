{%- comment -%}
  The picture for a set: its own photo from Files (bts-<handle>.jpg) when there is one; otherwise the set drawn as
  colour bands, one per product, from the studio photos (the same language as the home hero).
  Params: product (the set), sizes, loading ('lazy'), class, priority (true: eager + fetched first, for a page's first card),
  phone_crop (true: on phones the photo is cut to the card's 4:3 frame on Shopify's side, so hidden pixels aren't downloaded)
  Set cards show every photo at 4:3 (DECISIONS 239); a square photo is placed by the set's focus (snippets/bundle-def).
{%- endcomment -%}
{%- liquid
  capture sv_def
    render 'bundle-def', handle: product.handle
  endcapture
  assign sv_parts = sv_def | strip | split: '|'
  assign sv_steps = sv_parts[0] | split: ','
  assign sv_focus = sv_parts[4] | default: 50 | plus: 0
  assign sv_handles = ',daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ','
  assign sv_key = 'bts-' | append: product.handle | append: '.jpg'
  assign sv_photo = images[sv_key]
  if sv_photo == blank
    assign sv_photo = false
  endif
  assign sv_loading = loading | default: 'lazy'
  assign sv_sizes = sizes | default: '(min-width: 990px) 33vw, 86vw'
  assign sv_pos = 'object-position: 50% ' | append: sv_focus | append: '%'
-%}
{%- if sv_photo -%}
  {%- if phone_crop -%}
    {%- liquid
      assign sv_ch = sv_photo.width | times: 3 | divided_by: 4
      assign sv_top = sv_photo.height | minus: sv_ch | times: sv_focus | divided_by: 100
      if sv_top < 0
        assign sv_top = 0
        assign sv_ch = sv_photo.height
      endif
      assign sv_ws = '500,700,900,1100' | split: ','
    -%}
    <picture><source media="(max-width: 749px)" srcset="{% for w in sv_ws %}{% assign hh = w | times: 3 | divided_by: 4 %}{{ sv_photo | image_url: width: w, height: hh, crop: 'region', crop_left: 0, crop_top: sv_top, crop_width: sv_photo.width, crop_height: sv_ch }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}" sizes="86vw">
  {%- endif -%}
  {%- if priority -%}
    {{ sv_photo | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,700,800,1000,1200', sizes: sv_sizes, alt: '', class: 'set-visual set-visual--photo', style: sv_pos }}
  {%- else -%}
    {{ sv_photo | image_url: width: 1200 | image_tag: loading: sv_loading, widths: '400,600,700,800,1000,1200', sizes: sv_sizes, alt: '', class: 'set-visual set-visual--photo', style: sv_pos }}
  {%- endif -%}
  {%- if phone_crop -%}</picture>{%- endif -%}
{%- else -%}
  <span class="set-visual set-visual--bands {{ class }}" style="--n: {{ sv_steps.size }}" aria-hidden="true">
    {%- for st in sv_steps -%}
      {%- assign si = st | plus: 0 -%}
      {%- assign comp = all_products[sv_handles[si]] -%}
      {%- assign ck = 'bts-' | append: sv_handles[si] | append: '-studio.jpg' -%}
      {%- assign studio = images[ck] -%}{%- if studio == blank -%}{%- assign studio = false -%}{%- endif -%}
      <span class="set-visual__band" data-step="{{ si }}">
        {%- if studio -%}
          {{ studio | image_url: width: 600 | image_tag: loading: sv_loading, widths: '300,450,600', sizes: '(min-width: 990px) 14vw, 40vw', alt: '' }}
        {%- elsif comp.featured_media -%}
          {{ comp.featured_media | image_url: width: 400 | image_tag: loading: sv_loading, alt: '' }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </span>
{%- endif -%}
