<!doctype html>
{%- liquid
  assign locale_code = request.locale.iso_code | downcase
  assign is_rtl = false
  if locale_code == 'ar' or locale_code contains 'ar-'
    assign is_rtl = true
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" data-view-label="{{ 'general.view' | t }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_daylight }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if template.suffix == 'creator-kit' -%}<meta name="robots" content="noindex, nofollow">{%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="icon" type="image/svg+xml" href="{{ 'bts-icon.svg' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    {%- if is_rtl -%}
      {{ 'font-arabic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- else -%}
      {{ 'font-display.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'font-body.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <style>
      @font-face {
        font-family: 'BTS Display';
        src: url('{{ 'font-display.woff2' | asset_url }}') format('woff2');
        font-weight: 500 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'BTS Display';
        src: url('{{ 'font-arrows.woff2' | asset_url }}') format('woff2');
        font-weight: 500 700;
        font-display: swap;
        unicode-range: U+2190-2193;
      }
      @font-face {
        font-family: 'BTS Sans';
        src: url('{{ 'font-body.woff2' | asset_url }}') format('woff2');
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'BTS Arabic';
        src: url('{{ 'font-arabic.woff2' | asset_url }}') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0600-06FF, U+0750-077F, U+0870-08FF, U+200C-200E, U+2010-2011, U+FB50-FDFF, U+FE70-FEFC;
      }
      :root {
        --c-ink: {{ settings.color_ink }};
        --c-daylight: {{ settings.color_daylight }};
        --added-label: {{ 'cart.added_short' | t | replace: '&amp;', '&' | json }};
        --mark: url('{{ 'bts-icon.svg' | asset_url }}');
        --c-step-1: {{ settings.color_step_1 }};
        --c-step-2: {{ settings.color_step_2 }};
        --c-step-3: {{ settings.color_step_3 }};
        --c-step-4: {{ settings.color_step_4 }};
        --logo-h: {{ settings.logo_height }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'demo.css' | asset_url | stylesheet_tag }}
    {%- liquid
      assign tpl = template.name
      assign sfx = template.suffix | default: ''
      if tpl == 'index' or tpl == 'collection' or tpl == 'blog' or tpl == 'article' or sfx == 'climate' or sfx == 'about'
        echo 'home.css' | asset_url | stylesheet_tag
      endif
      if tpl == 'index' or sfx == 'routines'
        echo 'forecast.css' | asset_url | stylesheet_tag
      endif
      if tpl == 'product'
        echo 'product.css' | asset_url | stylesheet_tag
      endif
      if tpl != 'index' and tpl != 'product'
        echo 'pages.css' | asset_url | stylesheet_tag
      endif
    -%}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      // Demo switch (DECISIONS 265): ?demo=1 turns the proposed bag and menu changes on for this visit, ?demo=off turns them off
      try {
        const dq = location.search;
        if (/[?&]demo=off\b/.test(dq)) sessionStorage.removeItem('bts:demo');
        else if (/[?&]demo=1\b/.test(dq)) sessionStorage.setItem('bts:demo', '1');
        if (sessionStorage.getItem('bts:demo')) document.documentElement.classList.add('is-demo');
      } catch (e) {}
      window.BTS = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.predictive_search_url | json }}
        },
        motion: {{ settings.signature_motion | json }},
        {%- comment -%} Fixed-price bundles (spec) so pickers can offer the bundle when a selection matches one. {%- endcomment -%}
        bundles: [
          {%- assign bh = 'the-full-ritual,the-clear-protect-trio,clear-protect-duo,the-night-ritual,the-core-duo' | split: ',' -%}
          {%- for h in bh -%}
            {%- assign bp = all_products[h] -%}
            {%- if bp.id -%}
              {%- capture bd -%}{% render 'bundle-def', handle: h %}{%- endcapture -%}
              {%- assign bk = 'bundles.names.' | append: h -%}
              {%- assign bv = bp.selected_or_first_available_variant -%}
              { steps: {{ bd | strip | split: '|' | first | json }}, id: {{ bv.id }}, price: {{ bv.price }}, compare: {{ bv.compare_at_price | default: 0 }}, available: {{ bv.available | json }}, name: {{ bk | t | replace: '&amp;', '&' | json }} },
            {%- endif -%}
          {%- endfor -%}
        ],
        {%- comment -%} The four packs (step, variant, cutout) so a routine add can throw each of its bottles into the bag. {%- endcomment -%}
        packs: [
          {%- assign ph = 'daily-reset-cleanser,clarity-serum,daily-barrier-moisturizing-cream,daily-defense-sunscreen-spf-50' | split: ',' -%}
          {%- for h in ph -%}
            {%- assign pp = all_products[h] -%}
            {%- if pp.id -%}{%- capture cimg -%}{%- render 'cut-src', handle: h, width: 240 -%}{%- endcapture -%}{ step: {{ forloop.index }}, variant: {{ pp.selected_or_first_available_variant.id }}, img: {{ cimg | json }} },{%- endif -%}
          {%- endfor -%}
        ],
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          added: {{ 'cart.added' | t | replace: '&amp;', '&' | json }},
          viewCart: {{ 'cart.view_cart' | t | replace: '&amp;', '&' | json }},
          checkout: {{ 'cart.checkout' | t | replace: '&amp;', '&' | json }},
          completeRoutine: {{ 'cart.complete_routine' | t | replace: '&amp;', '&' | json }},
          routineComplete: {{ 'cart.routine_complete' | t | replace: '&amp;', '&' | json }},
          addedSteps: {{ 'cart.added_steps' | t: count: '__N__' | replace: '&amp;', '&' | json }},
          close: {{ 'general.close' | t | replace: '&amp;', '&' | json }},
          error: {{ 'cart.error' | t | replace: '&amp;', '&' | json }},
          addToCart: {{ 'product.add_to_cart' | t | replace: '&amp;', '&' | json }},
          adding: {{ 'product.adding' | t | replace: '&amp;', '&' | json }},
          soldOut: {{ 'product.sold_out' | t | replace: '&amp;', '&' | json }},
          cartCount: {{ 'cart.count_label' | t | replace: '&amp;', '&' | json }},
          qtyLimit: {{ 'bundles.qty_limit' | t: count: '__N__'  | replace: '&amp;', '&' | json }},
          bundleMatch: {{ 'bundles.match' | t: bundle: '__X__'  | replace: '&amp;', '&' | json }},
          saveVs: {{ 'bundles.save_vs' | t: amount: '__A__'  | replace: '&amp;', '&' | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>
    <script src="{{ 'demo.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- section 'cart-drawer' -%}
    {%- render 'bottom-dock' -%}
    <div class="demo-on demo-badge" role="status">{{ 'demo.on' | t }} <a href="?demo=off">{{ 'demo.off' | t }}</a></div>
    {%- render 'welcome-offer' -%}
    <template id="BtsMark">{{ 'bts-icon.svg' | inline_asset_content }}</template>

    <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="a11y-status"></div>

    {%- render 'structured-data-organization' -%}
    {%- if settings.whatsapp_number != blank -%}
      {%- assign wa_text = 'general.whatsapp_text' | t | url_encode -%}
      <a class="wa-fab" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}?text={{ wa_text }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'chat' %}<span>{{ 'general.whatsapp' | t }}</span>
      </a>
    {%- endif -%}
  </body>
</html>
