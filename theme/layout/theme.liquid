<!doctype html>
{%- liquid
  assign locale_code = request.locale.iso_code | downcase
  assign is_rtl = false
  if locale_code == 'ar' or locale_code contains 'ar-'
    assign is_rtl = true
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_daylight }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'bts-icon.svg' | asset_url }}">
    {%- endif -%}

    {%- if is_rtl -%}
      <link rel="preload" href="{{ 'font-arabic.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- else -%}
      <link rel="preload" href="{{ 'font-display.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
      <link rel="preload" href="{{ 'font-body.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <style>
      @font-face {
        font-family: 'BTS Display';
        src: url('{{ 'font-display.woff2' | asset_url }}') format('woff2');
        font-weight: 500 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'BTS Display';
        src: url('{{ 'font-arrows.woff2' | asset_url }}') format('woff2');
        font-weight: 500 700;
        font-display: swap;
        unicode-range: U+2190-2193;
      }
      @font-face {
        font-family: 'BTS Sans';
        src: url('{{ 'font-body.woff2' | asset_url }}') format('woff2');
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'BTS Arabic';
        src: url('{{ 'font-arabic.woff2' | asset_url }}') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
        unicode-range: U+0600-06FF, U+0750-077F, U+0870-08FF, U+200C-200E, U+2010-2011, U+FB50-FDFF, U+FE70-FEFC;
      }
      :root {
        --c-ink: {{ settings.color_ink }};
        --c-daylight: {{ settings.color_daylight }};
        --c-step-1: {{ settings.color_step_1 }};
        --c-step-2: {{ settings.color_step_2 }};
        --c-step-3: {{ settings.color_step_3 }};
        --c-step-4: {{ settings.color_step_4 }};
        --logo-h: {{ settings.logo_height }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.BTS = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.predictive_search_url | json }}
        },
        motion: {{ settings.signature_motion | json }},
        strings: {
          added: {{ 'cart.added' | t | json }},
          error: {{ 'cart.error' | t | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          adding: {{ 'product.adding' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          cartCount: {{ 'cart.count_label' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- section 'cart-drawer' -%}

    <div class="visually-hidden" aria-live="polite" aria-atomic="true" id="a11y-status"></div>

    {%- render 'structured-data-organization' -%}
  </body>
</html>
