<!doctype html>
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar'
    assign is_rtl = true
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ 'bts-icon.svg' | asset_url }}">
    <style>
      @font-face { font-family: 'BTS Display'; src: url('{{ 'font-display.woff2' | asset_url }}') format('woff2'); font-weight: 500 700; font-display: swap; }
      @font-face { font-family: 'BTS Sans'; src: url('{{ 'font-body.woff2' | asset_url }}') format('woff2'); font-weight: 300 900; font-display: swap; }
      @font-face { font-family: 'BTS Arabic'; src: url('{{ 'font-arabic.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; unicode-range: U+0600-06FF, U+0750-077F, U+FB50-FDFF, U+FE70-FEFC; }
      :root { --c-ink: {{ settings.color_ink }}; --c-daylight: {{ settings.color_daylight }}; --c-step-1: {{ settings.color_step_1 }}; --c-step-2: {{ settings.color_step_2 }}; --c-step-3: {{ settings.color_step_3 }}; --c-step-4: {{ settings.color_step_4 }}; --logo-h: 40px; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
