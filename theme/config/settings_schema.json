      {
        "type": "paragraph",
        "content": "t:settings_schema.brand.logo_note"
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 28,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "t:settings_schema.brand.logo_height",
        "default": 40
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.brand.favicon"
      }
    ]
  },
