{%- comment -%} Between Two Suns · shipping · Arabic (paste as the Arabic translation) · generated by tools/notifications/build.mjs (DECISIONS 292): edit there, not here. {%- endcomment -%}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light">
<link href="https://fonts.googleapis.com/css2?family=Antonio:wght@700&family=Figtree:wght@400;700;800&family=Alexandria:wght@400;700;800&display=swap" rel="stylesheet">
<title>طلبك في الطريق</title>
<style>@media (max-width:620px){ .bts-wrap{width:100%!important} .bts-title{font-size:44px!important} }</style>
</head>
<body style="margin:0;padding:0;background:#ffffff">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">طلبك في الطريق.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#ffffff"><tr><td align="center" style="padding:0">
<table role="presentation" class="bts-wrap" width="600" cellpadding="0" cellspacing="0" dir="rtl" style="border-collapse:collapse;width:600px;max-width:600px;text-align:right">
<tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse"><tr><td height="6" style="height:6px;line-height:6px;font-size:0;background:#7DB993">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#89C3C8">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#D7A6DA">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#FFA37B">&nbsp;</td></tr></table></td></tr>
<tr><td align="center" style="padding:36px 24px 8px">{% if shop.email_logo_url %}<img src="{{ shop.email_logo_url }}" width="{{ shop.email_logo_width | default: 120 }}" alt="{{ shop.name }}" style="display:block;height:auto;border:0">{% else %}<span style="font-family:Antonio, 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif;font-size:28px;font-weight:800;letter-spacing:.02em;line-height:.9;color:#20233A;text-transform:uppercase">Between<br>Two Suns</span>{% endif %}</td></tr>
<tr><td class="bts-pad" style="padding:28px 24px 0">
  <h1 class="bts-title" style="margin:0;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:40px;line-height:1.3;font-weight:800;letter-spacing:0;text-transform:none;color:#20233A">طلبك في الطريق</h1>
  <p style="margin:16px 0 0;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:17px;line-height:1.55;color:#20233A">طلبك <span dir="ltr">{{ order_name }}</span> خرج من عندنا. تقدر تتابعه من هنا في أي وقت.</p>
  
  {% if fulfillment.tracking_urls.size > 0 %}<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:24px 0 0"><tr><td style="border-radius:999px;background:#20233A"><a href="{{ fulfillment.tracking_urls.first }}" style="display:inline-block;padding:15px 28px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px">تتبّع الشحنة</a></td></tr></table>{% else %}<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:24px 0 0"><tr><td style="border-radius:999px;background:#20233A"><a href="{{ order_status_url }}" style="display:inline-block;padding:15px 28px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px">تتبّع الشحنة</a></td></tr></table>{% endif %}
</td></tr>

<tr><td style="padding:28px 24px 0">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse">
    {% for f in fulfillment.fulfillment_line_items %}{% assign line = f.line_item %}{% assign qty = f.quantity %}
    <tr style="border-bottom:1px solid #E6E7EA">
      <td width="64" valign="middle" style="padding:12px 0;width:64px">{% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" width="56" height="56" alt="" style="display:block;width:56px;height:56px;border-radius:12px;background:#F4F5F6;object-fit:cover">{% endif %}</td>
      <td valign="middle" style="padding:12px 0 12px 0 12px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:15px;line-height:1.4;color:#20233A"><strong>{{ line.title }}</strong><br><span style="font-size:13px;color:#565A6D">الكمية: {{ qty }}</span></td>
      
    </tr>
    {% endfor %}
  </table>
</td></tr>
<tr><td style="padding:32px 24px 0">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#F4F5F6;border-radius:18px"><tr><td style="padding:22px 24px">
    <p style="margin:0 0 14px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:12px;font-weight:700;letter-spacing:0;text-transform:none;color:#565A6D">ترتيب الروتين</p>
    <p style="margin:0 0 6px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:16px;line-height:1.5;color:#20233A"><span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#7DB993;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#89C3C8;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#D7A6DA;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#FFA37B;vertical-align:middle"></span>&nbsp;&nbsp;<strong>الصبح:</strong> تنظيف ← سيروم ← ترطيب ← حماية</p>
    <p style="margin:0 0 12px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:16px;line-height:1.5;color:#20233A"><span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#7DB993;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#89C3C8;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#D7A6DA;vertical-align:middle"></span> <span style="display:inline-block;width:10px"></span>&nbsp;&nbsp;<strong>بالليل:</strong> تنظيف ← سيروم ← ترطيب</p>
    <p style="margin:0;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:14px;line-height:1.5;color:#565A6D">واقي الشمس آخر خطوة كل صبح.</p>
  </td></tr></table>
</td></tr>
<tr><td style="padding:32px 24px 0;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:14px;line-height:1.6;color:#565A6D">عندك سؤال؟ الرد على الإيميل ده يوصلنا مباشرة، أو على {{ shop.email }}.</td></tr>
<tr><td style="padding:32px 24px 40px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-top:1px solid #E6E7EA"><tr><td style="padding-top:20px;font-family:Alexandria, Tahoma, 'Segoe UI', Arial, sans-serif;font-size:13px;line-height:1.6;color:#565A6D"><strong style="color:#20233A">بشرة منتعشة. دائماً.</strong><br>Between Two Suns · صُنع في مصر</td></tr></table></td></tr>
<tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse"><tr><td height="6" style="height:6px;line-height:6px;font-size:0;background:#7DB993">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#89C3C8">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#D7A6DA">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#FFA37B">&nbsp;</td></tr></table></td></tr>
</table>
</td></tr></table>
</body>
</html>
