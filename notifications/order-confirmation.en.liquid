{%- comment -%} Between Two Suns · confirmation · English (the template) · generated by tools/notifications/build.mjs (DECISIONS 292): edit there, not here. {%- endcomment -%}
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light">
<link href="https://fonts.googleapis.com/css2?family=Antonio:wght@700&family=Figtree:wght@400;700;800&family=Alexandria:wght@400;700;800&display=swap" rel="stylesheet">
<title>We've got your order</title>
<style>@media (max-width:620px){ .bts-wrap{width:100%!important} .bts-title{font-size:44px!important} }</style>
</head>
<body style="margin:0;padding:0;background:#ffffff">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">We've got your order and we're getting it ready.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#ffffff"><tr><td align="center" style="padding:0">
<table role="presentation" class="bts-wrap" width="600" cellpadding="0" cellspacing="0" dir="ltr" style="border-collapse:collapse;width:600px;max-width:600px;text-align:left">
<tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse"><tr><td height="6" style="height:6px;line-height:6px;font-size:0;background:#7DB993">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#89C3C8">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#D7A6DA">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#FFA37B">&nbsp;</td></tr></table></td></tr>
<tr><td align="center" style="padding:36px 24px 8px">{% if shop.email_logo_url %}<img src="{{ shop.email_logo_url }}" width="{{ shop.email_logo_width | default: 120 }}" alt="{{ shop.name }}" style="display:block;height:auto;border:0">{% else %}<span style="font-family:Antonio, 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif;font-size:28px;font-weight:800;letter-spacing:.02em;line-height:.9;color:#20233A;text-transform:uppercase">Between<br>Two Suns</span>{% endif %}</td></tr>
<tr><td class="bts-pad" style="padding:28px 24px 0">
  <h1 class="bts-title" style="margin:0;font-family:Antonio, 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif;font-size:54px;line-height:.95;font-weight:700;letter-spacing:0;text-transform:uppercase;color:#20233A">We've got your order</h1>
  <p style="margin:16px 0 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;line-height:1.55;color:#20233A">Thanks{% if customer.first_name %}, {{ customer.first_name }}{% endif %}. We're getting your order ready and we'll email you as soon as it ships.</p>
  <p style="margin:12px 0 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;color:#565A6D">Order {{ order_name }}</p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:24px 0 0"><tr><td style="border-radius:999px;background:#20233A"><a href="{{ order_status_url }}" style="display:inline-block;padding:15px 28px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px">View your order</a></td></tr></table>
</td></tr>

<tr><td style="padding:28px 24px 0">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse">
    {% for line in subtotal_line_items %}
    <tr style="border-bottom:1px solid #E6E7EA">
      <td width="64" valign="middle" style="padding:12px 0;width:64px">{% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" width="56" height="56" alt="" style="display:block;width:56px;height:56px;border-radius:12px;background:#F4F5F6;object-fit:cover">{% endif %}</td>
      <td valign="middle" style="padding:12px 12px 0 12px 12px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.4;color:#20233A"><strong>{{ line.title }}</strong><br><span style="font-size:13px;color:#565A6D">Qty: {{ line.quantity }}</span></td>
      <td valign="middle" style="padding:12px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:700;color:#20233A;text-align:right;white-space:nowrap">{{ line.final_line_price | money }}</td>
    </tr>
    {% endfor %}
  </table>
</td></tr>
<tr><td style="padding:16px 24px 0">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse">
    <tr><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;color:#565A6D">Subtotal</td><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;color:#20233A;text-align:right;white-space:nowrap">{{ subtotal_price | money }}</td></tr>
    {% if total_discounts > 0 %}<tr><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;color:#565A6D">Discount</td><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;color:#20233A;text-align:right;white-space:nowrap"><span style="color:#146C43">−{{ total_discounts | money }}</span></td></tr>{% endif %}
    <tr><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;color:#565A6D">Shipping</td><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;color:#20233A;text-align:right;white-space:nowrap">{% if shipping_price == 0 %}<span style="color:#146C43">Free</span>{% else %}{{ shipping_price | money }}{% endif %}</td></tr>
    <tr><td colspan="2" style="padding-top:8px;border-top:1px solid #E6E7EA;font-size:0;line-height:0">&nbsp;</td></tr>
    <tr><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;font-weight:800;color:#20233A">Total</td><td style="padding:4px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:17px;font-weight:800;color:#20233A;text-align:right;white-space:nowrap">{{ total_price | money }}</td></tr>
  </table>
</td></tr>{% assign bts_cod = false %}{% for tr in transactions %}{% assign g = tr.gateway | downcase %}{% if g contains 'cash' %}{% assign bts_cod = true %}{% endif %}{% endfor %}
{% if bts_cod %}<tr><td style="padding:16px 24px 0"><p style="margin:0;padding:14px 18px;border-radius:14px;background:#FFF1E8;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:15px;line-height:1.5;color:#20233A">Paying cash on delivery: please have {{ total_price | money }} ready when it arrives.</p></td></tr>{% endif %}{% if shipping_address %}<tr><td style="padding:24px 24px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.55;color:#565A6D"><strong style="color:#20233A">Delivering to</strong><br><span dir="auto">{{ shipping_address.name }}</span><br><span dir="auto">{{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}</span><br><span dir="auto">{{ shipping_address.city }}{% if shipping_address.province != blank %}, {{ shipping_address.province }}{% endif %}</span></td></tr>{% endif %}
<tr><td style="padding:32px 24px 0">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#F4F5F6;border-radius:18px"><tr><td style="padding:22px 24px">
    <p style="margin:0 0 14px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#565A6D">How to start</p>
    <p style="margin:0 0 6px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#20233A"><span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#7DB993;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#89C3C8;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#D7A6DA;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#FFA37B;vertical-align:middle"></span>&nbsp;&nbsp;<strong>Morning:</strong> Cleanse → Treat → Moisturize → Protect</p>
    <p style="margin:0 0 12px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#20233A"><span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#7DB993;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#89C3C8;vertical-align:middle"></span> <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#D7A6DA;vertical-align:middle"></span> <span style="display:inline-block;width:10px"></span>&nbsp;&nbsp;<strong>Evening:</strong> Cleanse → Treat → Moisturize</p>
    <p style="margin:0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#565A6D">Sunscreen is the last step, every morning.</p>
  </td></tr></table>
</td></tr>
<tr><td style="padding:32px 24px 0;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:1.6;color:#565A6D">Questions? Just reply to this email, or write to {{ shop.email }}.</td></tr>
<tr><td style="padding:32px 24px 40px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-top:1px solid #E6E7EA"><tr><td style="padding-top:20px;font-family:Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:13px;line-height:1.6;color:#565A6D"><strong style="color:#20233A">fresh skin. always.</strong><br>Between Two Suns · Made in Egypt</td></tr></table></td></tr>
<tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse"><tr><td height="6" style="height:6px;line-height:6px;font-size:0;background:#7DB993">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#89C3C8">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#D7A6DA">&nbsp;</td><td height="6" style="height:6px;line-height:6px;font-size:0;background:#FFA37B">&nbsp;</td></tr></table></td></tr>
</table>
</td></tr></table>
</body>
</html>
